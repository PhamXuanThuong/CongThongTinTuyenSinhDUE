      },
      {
        "step": "Vòng 2",
        "title": "HR Assessment Test",
        "desc": "Bài kiểm tra tư duy logic, xử lý tình huống nhân sự và hiểu biết xã hội."
      },
      {
        "step": "Vòng 3",
        "title": "Phỏng vấn hành vi (Behavioral Interview)",
        "desc": "Phỏng vấn chuyên sâu theo phương pháp STAR cùng Ban chủ nhiệm."
      },
      {
        "step": "Vòng 4",
        "title": "Thử thách vận hành sự kiện",
        "desc": "Tham gia vào ban tổ chức một chương trình thực tế của CLB."
      }
    ],
    "benefits": [
