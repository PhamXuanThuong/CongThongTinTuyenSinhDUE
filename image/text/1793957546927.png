<div id="lich-trinh-tsv-content" style="color: #333333; line-height: 1.7; font-size: 15.5px; max-width: 100%;">

  <!-- GIỚI THIỆU -->
  <div style="margin-bottom: 24px; text-align: center;">
    <div style="font-size: 13px; font-weight: 700; color: #F37021; text-transform: uppercase; letter-spacing: .05em; margin-bottom: 4px;">
      NĂM HỌC 2026 - 2027
    </div>
    <h3 style="font-size: 20px; font-weight: 800; color: #0072BC; margin: 0 0 8px; text-transform: uppercase;">
      Lịch trình của Tân sinh viên Khóa 52K
    </h3>
    <p style="font-size: 14.5px; color: #666666; max-width: 650px; margin: 0 auto; line-height: 1.6;">
      Các mốc thời gian quan trọng Tân sinh viên cần lưu ý để hoàn tất thủ tục nhập học và sẵn sàng bước vào giảng đường Đại học Kinh tế - ĐHĐN.
    </p>
  </div>

  <!-- TIMELINE / LỊCH TRÌNH CHI TIẾT -->
  <div style="position: relative; padding: 10px 0 20px 24px; border-left: 3px solid #0072BC; margin-left: 12px;">

    <!-- MỐC 1 -->
    <div style="position: relative; margin-bottom: 32px;">
      <!-- Dot indicator -->
      <div style="position: absolute; left: -31px; top: 0; width: 16px; height: 16px; border-radius: 50%; background: #0072BC; border: 3px solid #ffffff; box-shadow: 0 0 0 2px #0072BC;"></div>
      
      <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 16px 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.04);">
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; margin-bottom: 6px;">
          <span style="display: inline-block; padding: 3px 10px; border-radius: 20px; background: #e0f2fe; color: #0072BC; font-weight: 700; font-size: 13px;">
            MỐC 1 • KÊ KHAI và NỘP HỌC PHÍ
          </span>
          <span style="font-weight: 700; color: #b42318; font-size: 14px;">
            Từ 09h00 ngày 13/08 đến hết ngày 15/08/2026
          </span>
        </div>
        <h4 style="font-size: 16px; font-weight: 700; color: #1e293b; margin: 4px 0 8px;">
          Kê khai thông tin nhập học trực tuyến và nộp các khoản thu
        </h4>
        <p style="margin: 0 0 8px; font-size: 14.5px; color: #475569; text-align: justify;">
          Tân sinh viên đăng nhập hệ thống tại <a href="http://nhaphoc.due.udn.vn" target="_blank" style="color: #0072BC; font-weight: 600;">nhaphoc.due.udn.vn</a> bằng số CCCD và mật khẩu ngày sinh (ddmmyy), tiến hành điền thông tin, đăng ký chuyên ngành và nộp học phí tạm thu học kỳ I.
        </p>
      </div>
    </div>

    <!-- MỐC 2 -->
    <div style="position: relative; margin-bottom: 32px;">
      <!-- Dot indicator -->
      <div style="position: absolute; left: -31px; top: 0; width: 16px; height: 16px; border-radius: 50%; background: #F37021; border: 3px solid #ffffff; box-shadow: 0 0 0 2px #F37021;"></div>
      
      <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 16px 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.04);">
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; margin-bottom: 6px;">
          <span style="display: inline-block; padding: 3px 10px; border-radius: 20px; background: #fff3ed; color: #F37021; font-weight: 700; font-size: 13px;">
            MỐC 2 • NGÀY HỘI CHÀO ĐÓN
          </span>
          <span style="font-weight: 700; color: #b42318; font-size: 14px;">
            08h00 ngày 16/08/2026 (Chủ nhật)
          </span>
        </div>
        <h4 style="font-size: 16px; font-weight: 700; color: #1e293b; margin: 4px 0 8px;">
          Tham gia Ngày hội Chào đón Tân sinh viên Khóa 52K
        </h4>
        <p style="margin: 0; font-size: 14.5px; color: #475569; text-align: justify;">
          Tân sinh viên trực tiếp có mặt tại khuôn viên Trường Đại học Kinh tế - ĐH Đà Nẵng (71 Ngũ Hành Sơn, TP. Đà Nẵng) để hòa mình vào các hoạt động chào đón, giao lưu câu lạc bộ và làm quen bạn bè, thầy cô.
        </p>
      </div>
    </div>

    <!-- MỐC 3 -->
    <div style="position: relative; margin-bottom: 32px;">
      <!-- Dot indicator -->
      <div style="position: absolute; left: -31px; top: 0; width: 16px; height: 16px; border-radius: 50%; background: #00A859; border: 3px solid #ffffff; box-shadow: 0 0 0 2px #00A859;"></div>
      
      <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 16px 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.04);">
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; margin-bottom: 6px;">
          <span style="display: inline-block; padding: 3px 10px; border-radius: 20px; background: #e8f5e9; color: #00A859; font-weight: 700; font-size: 13px;">
            MỐC 3 • CHƯƠNG TRÌNH ĐỊNH HƯỚNG
          </span>
          <span style="font-weight: 700; color: #b42318; font-size: 14px;">
            Từ ngày 17/08/2026 (thứ Hai)
          </span>
        </div>
        <h4 style="font-size: 16px; font-weight: 700; color: #1e293b; margin: 4px 0 8px;">
