    "clubs": [
      {
        "id": "clb-khoa-hoc-phap-ly",
        "name": "CLB Khoa học Pháp lý",
        "category": "Học thuật – Pháp luật",
        "intro": "CLB Khoa học Pháp lý là câu lạc bộ định hướng học thuật dành cho sinh viên Khoa Luật, Trường Đại học Kinh tế – ĐHĐN. CLB tạo môi trường để người trẻ yêu thích ngành Luật học tập, rèn luyện kỹ năng và sáng tạo; tổ chức các ban Kỹ năng, Nhân sự, Truyền thông.",
        "logo": "assets/img/clb/clb-khoa-hoc-phap-ly-logo.jpg"
      }
    ],
    "slogan": "Thượng tôn Pháp luật – Công lý, Tri thức và Trách nhiệm",
    "intro": "Khoa Luật là một trong những đơn vị đào tạo luật kinh tế và luật học uy tín hàng đầu miền Trung. Với đội ngũ giảng viên giàu kinh nghiệm thực tế (nhiều thầy cô là Luật sư, Trọng tài viên thương mại), Khoa chú trọng đào tạo thực hành tranh tụng, kỹ năng đàm phán hợp đồng thương mại quốc tế và giải quyết tranh chấp.",
    "vision": "Trở thành cơ sở đào tạo luật định hướng ứng dụng và kinh doanh đạt chuẩn kiểm định AUN-QA, cung cấp những chuyên gia pháp lý tài ba cho thị trường trong nước và quốc tế.",
    "core_values": "Công lý – Thượng tôn – Trách nhiệm – Trí tuệ",
    "dean_message": "Pháp luật là tấm khiên bảo vệ sự công bằng và là nền tảng cho mọi thương vụ kinh doanh thành công. Đến với Khoa Luật DUE, bạn sẽ được rèn luyện bản lĩnh tranh tụng tại các phiên tòa giả định, tự tin bước vào thế giới pháp đình và giới tư vấn doanh nghiệp.",
    "staff_stats": {
      "total": 32,
