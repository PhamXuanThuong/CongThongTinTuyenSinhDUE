            obj.id, obj.clb.name, obj.ho_ten, obj.ma_sinh_vien, obj.khoa_lop,
            obj.so_dien_thoai, obj.email, obj.ban_ung_tuyen, obj.ly_do_ung_tuyen,
            obj.get_trang_thai_display(), obj.ngay_nop.strftime('%d/%m/%Y %H:%M')
        ])
    return response
