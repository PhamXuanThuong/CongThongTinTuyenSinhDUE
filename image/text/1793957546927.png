  <!-- ================================================
       MODAL 1: HƯỚNG DẪN NHẬP HỌC
       ================================================ -->
  <div
    id="huong-dan-modal-backdrop"
    style="position:fixed;inset:0;z-index:10000;display:none;align-items:center;justify-content:center;padding:8px;background:rgba(15,23,42,0.55);backdrop-filter:blur(4px);"
    aria-modal="true"
    role="dialog"
    aria-labelledby="huong-dan-modal-title"
  >
    <div
      id="huong-dan-modal"
      style="position:relative;width:100%;max-width:1020px;max-height:94vh;height:94vh;background:#fff;border-radius:24px;box-shadow:0 25px 60px rgba(0,0,0,0.18);overflow:hidden;display:flex;flex-direction:column;opacity:0;transform:scale(0.97) translateY(12px);transition:opacity .22s ease,transform .22s ease;"
    >
      <div style="display:flex;align-items:center;justify-content:space-between;padding:14px 20px;border-bottom:1px solid #f1f5f9;background:#fff;flex-shrink:0;">
        <div style="display:flex;align-items:center;gap:12px;">
          <div style="width:36px;height:36px;border-radius:10px;background:#dbeafe;display:flex;align-items:center;justify-content:center;color:#0072BC;flex-shrink:0;">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
          </div>
          <div>
            <h3 id="huong-dan-modal-title" style="margin:0;font-family:'Be Vietnam Pro', sans-serif;font-weight:700;color:#1e293b;font-size:17px;line-height:1.3;">Hướng dẫn nhập học</h3>
            <p style="margin:3px 0 0;font-size:12px;color:#94a3b8;">Tân sinh viên Khóa 52K – Tuyển sinh năm 2026</p>
          </div>
        </div>
        <button
          onclick="closeHuongDanModal()"
          style="width:36px;height:36px;border-radius:50%;background:#f8fafc;border:1px solid #e2e8f0;display:flex;align-items:center;justify-content:center;color:#94a3b8;cursor:pointer;transition:all .15s;flex-shrink:0;"
          onmouseover="this.style.background='#fef2f2';this.style.borderColor='#fca5a5';this.style.color='#ef4444'"
          onmouseout="this.style.background='#f8fafc';this.style.borderColor='#e2e8f0';this.style.color='#94a3b8'"
          aria-label="Đóng"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <div style="flex:1;overflow-y:auto;padding:24px 28px;background:#fff;" class="custom-modal-scroll">
        {% include 'portal/components/enrollment_guide_content.html' %}
      </div>
    </div>
  </div>

  <!-- ================================================
       MODAL 2: LỊCH TRÌNH CỦA TÂN SINH VIÊN
       ================================================ -->
  <div
    id="lich-trinh-modal-backdrop"
    style="position:fixed;inset:0;z-index:10000;display:none;align-items:center;justify-content:center;padding:8px;background:rgba(15,23,42,0.55);backdrop-filter:blur(4px);"
    aria-modal="true"
    role="dialog"
    aria-labelledby="lich-trinh-modal-title"
  >
    <div
      id="lich-trinh-modal"
      style="position:relative;width:100%;max-width:1020px;max-height:94vh;height:94vh;background:#fff;border-radius:24px;box-shadow:0 25px 60px rgba(0,0,0,0.18);overflow:hidden;display:flex;flex-direction:column;opacity:0;transform:scale(0.97) translateY(12px);transition:opacity .22s ease,transform .22s ease;"
    >
      <div style="display:flex;align-items:center;justify-content:space-between;padding:14px 20px;border-bottom:1px solid #f1f5f9;background:#fff;flex-shrink:0;">
        <div style="display:flex;align-items:center;gap:12px;">
          <div style="width:36px;height:36px;border-radius:10px;background:#fef3c7;display:flex;align-items:center;justify-content:center;color:#d97706;flex-shrink:0;">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          </div>
          <div>
            <h3 id="lich-trinh-modal-title" style="margin:0;font-family:'Be Vietnam Pro', sans-serif;font-weight:700;color:#1e293b;font-size:17px;line-height:1.3;">Lịch trình của Tân sinh viên</h3>
            <p style="margin:3px 0 0;font-size:12px;color:#94a3b8;">Thời gian biểu và các mốc sự kiện quan trọng – K52K (2026)</p>
          </div>
        </div>
        <button
          onclick="closeLichTrinhModal()"
          style="width:36px;height:36px;border-radius:50%;background:#f8fafc;border:1px solid #e2e8f0;display:flex;align-items:center;justify-content:center;color:#94a3b8;cursor:pointer;transition:all .15s;flex-shrink:0;"
          onmouseover="this.style.background='#fef2f2';this.style.borderColor='#fca5a5';this.style.color='#ef4444'"
          onmouseout="this.style.background='#f8fafc';this.style.borderColor='#e2e8f0';this.style.color='#94a3b8'"
          aria-label="Đóng"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <div style="flex:1;overflow-y:auto;padding:24px 28px;background:#fff;" class="custom-modal-scroll">
        {% include 'portal/components/freshman_schedule_content.html' %}
      </div>
    </div>
  </div>

  <!-- ================================================
       MODAL 3: DÀNH CHO SINH VIÊN (Chi tiết cẩm nang)
       ================================================ -->
  <div
    id="sinh-vien-modal-backdrop"
    style="position:fixed;inset:0;z-index:10000;display:none;align-items:center;justify-content:center;padding:8px;background:rgba(15,23,42,0.55);backdrop-filter:blur(4px);"
    aria-modal="true"
    role="dialog"
    aria-labelledby="sinh-vien-modal-title"
  >
    <div
      id="sinh-vien-modal"
      style="position:relative;width:100%;max-width:1080px;max-height:94vh;height:94vh;background:#fff;border-radius:24px;box-shadow:0 25px 60px rgba(0,0,0,0.18);overflow:hidden;display:flex;flex-direction:column;opacity:0;transform:scale(0.97) translateY(12px);transition:opacity .22s ease,transform .22s ease;"
    >
      <div style="display:flex;align-items:center;justify-content:space-between;padding:14px 20px;border-bottom:1px solid #f1f5f9;background:#fff;flex-shrink:0;">
        <div style="display:flex;align-items:center;gap:12px;">
          <div style="width:36px;height:36px;border-radius:10px;background:#dbeafe;display:flex;align-items:center;justify-content:center;color:#0072BC;flex-shrink:0;">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
          </div>
          <div>
            <h3 id="sinh-vien-modal-title" style="margin:0;font-family:'Be Vietnam Pro', sans-serif;font-weight:700;color:#1e293b;font-size:17px;line-height:1.3;">Dành cho Sinh viên DUE</h3>
            <p style="margin:3px 0 0;font-size:12px;color:#94a3b8;">Cẩm nang học tập, cơ sở vật chất, phong trào Đoàn - Hội và học bổng</p>
          </div>
        </div>
        <button
          onclick="closeSinhVienModal()"
          style="width:36px;height:36px;border-radius:50%;background:#f8fafc;border:1px solid #e2e8f0;display:flex;align-items:center;justify-content:center;color:#94a3b8;cursor:pointer;transition:all .15s;flex-shrink:0;"
          onmouseover="this.style.background='#fef2f2';this.style.borderColor='#fca5a5';this.style.color='#ef4444'"
          onmouseout="this.style.background='#f8fafc';this.style.borderColor='#e2e8f0';this.style.color='#94a3b8'"
          aria-label="Đóng"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <div style="flex:1;overflow:hidden;background:#fff;">
        {% include 'portal/components/student_life_content.html' %}
      </div>
    </div>
  </div>

  <script>
        /* ---- Dropdown Navbar: GIỚI THIỆU ---- */
    var _gtBtn     = document.getElementById('nav-gioithieu-btn');
    var _gtDrop    = document.getElementById('nav-gioithieu-dropdown');
    var _gtChevron = document.getElementById('nav-gioithieu-chevron');

    function positionGtDropdown() {
      if (!_gtBtn || !_gtDrop) return;
      var rect = _gtBtn.getBoundingClientRect();
      _gtDrop.style.top  = (rect.bottom + 6) + 'px';
      _gtDrop.style.left = rect.left + 'px';
    }

    function toggleGtDropdown(e) {
      if (e) e.stopPropagation();
      if (!_gtDrop) return;
      var isOpen = _gtDrop.style.display === 'block';
      if (isOpen) {
        closeGtDropdown();
      } else {
        closeDropdown();
        closeKhoaDropdown();
        closeDcsvDropdown();
        positionGtDropdown();
        _gtDrop.style.display = 'block';
        if (_gtChevron) _gtChevron.style.transform = 'rotate(180deg)';
        _gtBtn.setAttribute('aria-expanded', 'true');
      }
    }

    function closeGtDropdown() {
      if (!_gtDrop) return;
      _gtDrop.style.display = 'none';
      if (_gtChevron) _gtChevron.style.transform = '';
      if (_gtBtn) _gtBtn.setAttribute('aria-expanded', 'false');
    }

    if (_gtBtn) {
      _gtBtn.addEventListener('click', toggleGtDropdown);
      _gtBtn.addEventListener('mouseenter', function() {
        closeDropdown();
        closeKhoaDropdown();
        closeDcsvDropdown();
        positionGtDropdown();
        _gtDrop.style.display = 'block';
        if (_gtChevron) _gtChevron.style.transform = 'rotate(180deg)';
      });
      _gtBtn.addEventListener('mouseleave', function() {
        setTimeout(function() {
          if (!_gtDrop.matches(':hover') && !_gtBtn.matches(':hover')) closeGtDropdown();
        }, 220);
      });
    }
    if (_gtDrop) {
      _gtDrop.addEventListener('mouseleave', function() {
        setTimeout(function() {
          if (!_gtDrop.matches(':hover') && !_gtBtn.matches(':hover')) closeGtDropdown();
        }, 220);
      });
    }

    /* ---- Login Popover Controller ---- */
    function toggleDueLoginPopover(e) {
      if (e) {
        e.stopPropagation();
        e.preventDefault();
      }
      const popover = document.getElementById('dueLoginPopover');
      if (!popover) return;
      const isHidden = popover.classList.contains('hidden');
      if (isHidden) {
        popover.classList.remove('hidden');
        setTimeout(() => {
          const u = document.getElementById('p_username');
          if (u) u.focus();
        }, 80);
      } else {
        popover.classList.add('hidden');
      }
    }

    function closeDueLoginPopover() {
      const popover = document.getElementById('dueLoginPopover');
      if (popover) popover.classList.add('hidden');
    }

    window.openLoginModal = toggleDueLoginPopover;
    window.closeLoginModal = closeDueLoginPopover;

    function quickFillCreds(u, p) {
      const userInp = document.getElementById('p_username');
      const passInp = document.getElementById('p_password');
      if (userInp && passInp) {
        userInp.value = u;
        passInp.value = p;
      }
    }

    document.addEventListener('click', function(e) {
      const popover = document.getElementById('dueLoginPopover');
      if (!popover || popover.classList.contains('hidden')) return;
      const container = document.getElementById('dueLoginContainer');
      if (container && !container.contains(e.target)) {
        closeDueLoginPopover();
      }
    });

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') closeDueLoginPopover();
    });

    function handleDueLoginSubmit(e) {
      e.preventDefault();
      const u = document.getElementById('p_username').value.trim();
      const p = document.getElementById('p_password').value.trim();
      const alertBox = document.getElementById('popoverAlert');
      const submitBtn = document.getElementById('p_submit_btn');

      if (!u || !p) {
        alertBox.className = "mb-3 p-2 rounded text-xs leading-normal bg-red-50 text-red-700 border border-red-200 block";
        alertBox.textContent = "Vui lòng nhập đầy đủ tên đăng nhập và mật khẩu!";
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = "Đăng nhập";

      let csrfToken = '';
      const cookieMatch = document.cookie.match(/csrftoken=([^;]+)/);
      if (cookieMatch) csrfToken = cookieMatch[1];

      const formData = new FormData();
      formData.append('username', u);
      formData.append('password', p);
      formData.append('is_ajax', '1');

      fetch('/dang-nhap/', {
        method: 'POST',
        headers: {
          'X-Requested-With': 'XMLHttpRequest',
          'X-CSRFToken': csrfToken
        },
        body: formData
      })
      .then(res => res.json().then(data => ({ status: res.status, ok: res.ok, body: data })))
      .then(({ status, ok, body }) => {
        submitBtn.disabled = false;
        submitBtn.textContent = "Đăng nhập";
        if (ok && body.status === 'success') {
          alertBox.className = "mb-3 p-2 rounded text-xs leading-normal bg-green-50 text-green-700 border border-green-200 block";
          alertBox.textContent = body.message || "Đăng nhập thành công!";
          setTimeout(() => {
            if (body.redirect_url) {
              window.location.href = body.redirect_url;
            } else {
              window.location.reload();
            }
          }, 600);
        } else {
          alertBox.className = "mb-3 p-2 rounded text-xs leading-normal bg-red-50 text-red-700 border border-red-200 block";
          alertBox.textContent = body.message || "Tên đăng nhập hoặc mật khẩu không chính xác.";
        }
      })
      .catch(err => {
        submitBtn.disabled = false;
        submitBtn.textContent = "Đăng nhập";
        alertBox.className = "mb-3 p-2 rounded text-xs leading-normal bg-red-50 text-red-700 border border-red-200 block";
        alertBox.textContent = "Đã xảy ra lỗi kết nối. Vui lòng thử lại!";
      });
    }

    /* ---- Dropdown Navbar: THÔNG TIN TUYỂN SINH ---- */
    var _btn     = document.getElementById('nav-ttts-btn');
    var _drop    = document.getElementById('nav-ttts-dropdown');
    var _chevron = document.getElementById('nav-ttts-chevron');

    function positionDropdown() {
      if (!_btn || !_drop) return;
      var rect = _btn.getBoundingClientRect();
      _drop.style.top  = (rect.bottom + 6) + 'px';
      _drop.style.left = rect.left + 'px';
    }

    function toggleDropdown(e) {
      if (e) e.stopPropagation();
      if (!_drop) return;
      var isOpen = _drop.style.display === 'block';
      if (isOpen) {
        closeDropdown();
      } else {
        positionDropdown();
        _drop.style.display = 'block';
        if (_chevron) _chevron.style.transform = 'rotate(180deg)';
        _btn.setAttribute('aria-expanded', 'true');
      }
    }

    function closeDropdown() {
      if (!_drop) return;
      _drop.style.display = 'none';
      if (_chevron) _chevron.style.transform = '';
      if (_btn) _btn.setAttribute('aria-expanded', 'false');
    }

    if (_btn) {
      _btn.addEventListener('click', toggleDropdown);
      _btn.addEventListener('mouseenter', function() {
        closeDcsvDropdown();
        positionDropdown();
        _drop.style.display = 'block';
        if (_chevron) _chevron.style.transform = 'rotate(180deg)';
      });
      _btn.addEventListener('mouseleave', function() {
        setTimeout(function() {
          if (!_drop.matches(':hover') && !_btn.matches(':hover')) closeDropdown();
        }, 220);
      });
    }
    if (_drop) {
      _drop.addEventListener('mouseleave', function() {
        setTimeout(function() {
          if (!_drop.matches(':hover') && !_btn.matches(':hover')) closeDropdown();
        }, 220);
      });
    }

    /* ---- Dropdown Navbar: KHOA ---- */
    var _khoaBtn     = document.getElementById('nav-khoa-btn');
    var _khoaDrop    = document.getElementById('nav-khoa-dropdown');
    var _khoaChevron = document.getElementById('nav-khoa-chevron');

    function positionKhoaDropdown() {
      if (!_khoaBtn || !_khoaDrop) return;
      var rect = _khoaBtn.getBoundingClientRect();
      _khoaDrop.style.top  = (rect.bottom + 6) + 'px';
      var left = rect.left;
      var width = 380;
      if (left + width > window.innerWidth) {
        left = Math.max(10, window.innerWidth - width - 15);
      }
      _khoaDrop.style.left = left + 'px';
    }

    function openKhoaDropdown() {
      closeDropdown();
      closeGtDropdown();
      closeDcsvDropdown();
      if (!_khoaDrop) return;
      positionKhoaDropdown();
      _khoaDrop.style.display = 'block';
      if (_khoaChevron) _khoaChevron.style.transform = 'rotate(180deg)';
      if (_khoaBtn) _khoaBtn.setAttribute('aria-expanded', 'true');
    }

    function closeKhoaDropdown() {
      if (!_khoaDrop) return;
      _khoaDrop.style.display = 'none';
      if (_khoaChevron) _khoaChevron.style.transform = '';
      if (_khoaBtn) _khoaBtn.setAttribute('aria-expanded', 'false');
    }

    function toggleKhoaDropdown(e) {
      if (e) {
        e.preventDefault();
        e.stopPropagation();
      }
      if (!_khoaDrop) return;
      var isOpen = _khoaDrop.style.display === 'block';
      if (isOpen) {
        closeKhoaDropdown();
      } else {
        openKhoaDropdown();
      }
    }

    if (_khoaBtn) {
      _khoaBtn.addEventListener('click', toggleKhoaDropdown);
      _khoaBtn.addEventListener('mouseenter', openKhoaDropdown);
      _khoaBtn.addEventListener('mouseleave', function() {
        setTimeout(function() {
          if (!_khoaDrop.matches(':hover') && !_khoaBtn.matches(':hover')) closeKhoaDropdown();
        }, 220);
      });
    }
    if (_khoaDrop) {
      _khoaDrop.addEventListener('mouseleave', function() {
        setTimeout(function() {
          if (!_khoaDrop.matches(':hover') && !_khoaBtn.matches(':hover')) closeKhoaDropdown();
        }, 220);
      });
    }

    /* ---- Dropdown Navbar: DÀNH CHO SINH VIÊN ---- */
    var _dcsvBtn     = document.getElementById('nav-dcsv-btn');
    var _dcsvDrop    = document.getElementById('nav-dcsv-dropdown');
    var _dcsvChevron = document.getElementById('nav-dcsv-chevron');

    function positionDcsvDropdown() {
      if (!_dcsvBtn || !_dcsvDrop) return;
      var rect = _dcsvBtn.getBoundingClientRect();
      _dcsvDrop.style.top  = (rect.bottom + 6) + 'px';
      var left = rect.left;
      var width = 275;
      if (left + width > window.innerWidth) {
        left = Math.max(10, window.innerWidth - width - 15);
      }
      _dcsvDrop.style.left = left + 'px';
    }

    function openDcsvDropdown() {
      closeDropdown();
      closeGtDropdown();
      closeKhoaDropdown();
      closeKhoaDropdown();
      if (!_dcsvDrop) return;
      positionDcsvDropdown();
      _dcsvDrop.style.display = 'block';
      if (_dcsvChevron) _dcsvChevron.style.transform = 'rotate(180deg)';
      if (_dcsvBtn) _dcsvBtn.setAttribute('aria-expanded', 'true');
    }

    function closeDcsvDropdown() {
      if (!_dcsvDrop) return;
      _dcsvDrop.style.display = 'none';
      if (_dcsvChevron) _dcsvChevron.style.transform = '';
      if (_dcsvBtn) _dcsvBtn.setAttribute('aria-expanded', 'false');
    }

    function toggleDcsvDropdown(e) {
      if (e) {
        e.preventDefault();
        e.stopPropagation();
      }
      if (!_dcsvDrop) return;
      var isOpen = _dcsvDrop.style.display === 'block';
      if (isOpen) {
        closeDcsvDropdown();
      } else {
        openDcsvDropdown();
      }
    }

    if (_dcsvBtn) {
      _dcsvBtn.addEventListener('click', toggleDcsvDropdown);
      _dcsvBtn.addEventListener('mouseenter', openDcsvDropdown);
      _dcsvBtn.addEventListener('mouseleave', function() {
        setTimeout(function() {
          if (!_dcsvDrop.matches(':hover') && !_dcsvBtn.matches(':hover')) closeDcsvDropdown();
        }, 220);
      });
    }
    if (_dcsvDrop) {
      _dcsvDrop.addEventListener('mouseleave', function() {
        setTimeout(function() {
          if (!_dcsvDrop.matches(':hover') && !_dcsvBtn.matches(':hover')) closeDcsvDropdown();
        }, 220);
      });
    }

    document.addEventListener('click', function (e) {
      if (_btn && !_btn.contains(e.target) && _drop && !_drop.contains(e.target)) {
        closeDropdown();
      }
      if (_dcsvBtn && !_dcsvBtn.contains(e.target) && _dcsvDrop && !_dcsvDrop.contains(e.target)) {
        closeDcsvDropdown();
      }
      if (_khoaBtn && !_khoaBtn.contains(e.target) && _khoaDrop && !_khoaDrop.contains(e.target)) {
        closeKhoaDropdown();
      }
    });

    window.addEventListener('resize', function () {
      if (_drop && _drop.style.display === 'block') positionDropdown();
      if (_dcsvDrop && _dcsvDrop.style.display === 'block') positionDcsvDropdown();
      if (_khoaDrop && _khoaDrop.style.display === 'block') positionKhoaDropdown();
    });
    window.addEventListener('scroll', function () {
      if (_drop && _drop.style.display === 'block') positionDropdown();
      if (_dcsvDrop && _dcsvDrop.style.display === 'block') positionDcsvDropdown();
      if (_khoaDrop && _khoaDrop.style.display === 'block') positionKhoaDropdown();
    }, { passive: true });

    /* ---- Modal 1: Hướng dẫn nhập học ---- */
    var _hdBackdrop = document.getElementById('huong-dan-modal-backdrop');
    var _hdModal    = document.getElementById('huong-dan-modal');

    function openHuongDanModal() {
      closeDropdown();
      closeKhoaDropdown();
      closeDcsvDropdown();
      if (!_hdBackdrop || !_hdModal) return;
      _hdBackdrop.style.display = 'flex';
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          _hdModal.style.opacity   = '1';
          _hdModal.style.transform = 'scale(1) translateY(0)';
        });
      });
    }

    function closeHuongDanModal() {
      if (!_hdBackdrop || !_hdModal) return;
      _hdModal.style.opacity   = '0';
      _hdModal.style.transform = 'scale(0.97) translateY(12px)';
      setTimeout(function () {
        _hdBackdrop.style.display = 'none';
        document.body.style.overflow = '';
      }, 220);
    }

    if (_hdBackdrop) {
      _hdBackdrop.addEventListener('click', function (e) {
        if (e.target === _hdBackdrop) closeHuongDanModal();
      });
    }

    /* ---- Modal 2: Lịch trình của Tân sinh viên ---- */
    var _ltBackdrop = document.getElementById('lich-trinh-modal-backdrop');
    var _ltModal    = document.getElementById('lich-trinh-modal');

    function openLichTrinhModal() {
      closeDropdown();
      closeKhoaDropdown();
      closeDcsvDropdown();
      if (!_ltBackdrop || !_ltModal) return;
      _ltBackdrop.style.display = 'flex';
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          _ltModal.style.opacity   = '1';
          _ltModal.style.transform = 'scale(1) translateY(0)';
        });
      });
    }

    function closeLichTrinhModal() {
      if (!_ltBackdrop || !_ltModal) return;
      _ltModal.style.opacity   = '0';
      _ltModal.style.transform = 'scale(0.97) translateY(12px)';
      setTimeout(function () {
        _ltBackdrop.style.display = 'none';
        document.body.style.overflow = '';
      }, 220);
    }

    if (_ltBackdrop) {
      _ltBackdrop.addEventListener('click', function (e) {
        if (e.target === _ltBackdrop) closeLichTrinhModal();
      });
    }

    /* ---- Modal 3: Dành cho sinh viên ---- */
    var _svBackdrop = document.getElementById('sinh-vien-modal-backdrop');
    var _svModal    = document.getElementById('sinh-vien-modal');

    function openSinhVienModal(topicKey) {
      closeDropdown();
      closeKhoaDropdown();
      closeDcsvDropdown();
      if (topicKey) {
        switchSinhVienTab(topicKey);
      }
      if (!_svBackdrop || !_svModal) return;
      _svBackdrop.style.display = 'flex';
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          _svModal.style.opacity   = '1';
          _svModal.style.transform = 'scale(1) translateY(0)';
        });
      });
    }

    function closeSinhVienModal() {
      if (!_svBackdrop || !_svModal) return;
      _svModal.style.opacity   = '0';
      _svModal.style.transform = 'scale(0.97) translateY(12px)';
      setTimeout(function () {
        _svBackdrop.style.display = 'none';
        document.body.style.overflow = '';
      }, 220);
    }

    function switchSinhVienTab(topicKey) {
      if (!topicKey) return;
      var buttons = document.querySelectorAll('.sv-tab-btn');
      buttons.forEach(function(btn) {
        btn.classList.remove('active');
      });
      var activeBtn = document.getElementById('tab-btn-' + topicKey);
      if (activeBtn) {
        activeBtn.classList.add('active');
        if (typeof activeBtn.scrollIntoView === 'function') {
          activeBtn.scrollIntoView({ block: 'nearest', inline: 'nearest' });
        }
      }

      var panes = document.querySelectorAll('.sv-pane');
      panes.forEach(function(pane) {
        pane.classList.add('hidden');
        pane.classList.remove('active');
      });
      var activePane = document.getElementById('sv-pane-' + topicKey);
      if (activePane) {
        activePane.classList.remove('hidden');
        activePane.classList.add('active');
      }
    }

    if (_svBackdrop) {
      _svBackdrop.addEventListener('click', function (e) {
        if (e.target === _svBackdrop) closeSinhVienModal();
      });
    }

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        closeDropdown();
        closeKhoaDropdown();
        closeDcsvDropdown();
        if (_hdBackdrop && _hdBackdrop.style.display === 'flex') closeHuongDanModal();
        if (_ltBackdrop && _ltBackdrop.style.display === 'flex') closeLichTrinhModal();
        if (_svBackdrop && _svBackdrop.style.display === 'flex') closeSinhVienModal();
      }
    });
  </script>

  <!-- ====================================================
       FLOATING AI CHATBOT BUBBLE WIDGET
       ==================================================== -->
  {% block floating_chat %}
  {% include 'partials/chat_widget.html' %}
  {% endblock %}

  {% block extra_js %}{% endblock %}
</body>
</html>



--- FILE: CongthongtintuyensinhDUE/templates/partials/chat_widget.html ---
{# Khung chat AI DUE dạng modal — dùng chung API /api/chat/ và phiên chat với trang /chatbot/ #}
<style>
  #dueChat { --dc-blue:#0072BC; --dc-navy:#003366; --dc-orange:#F37021; --dc-green:#00A859; }
  #dueChat .dc-panel { transform-origin: bottom right; transition: opacity .22s ease, transform .22s cubic-bezier(.2,.9,.3,1.2); }
  #dueChat.dc-closed .dc-panel { opacity:0; transform: translateY(16px) scale(.96); pointer-events:none; }
  #dueChat.dc-closed .dc-backdrop { opacity:0; pointer-events:none; }
  #dueChat .dc-backdrop { transition: opacity .2s ease; }
  @media (max-width: 639px) { #dueChat:not(.dc-closed) #dcLauncher { display: none; } }
  #dueChat .dc-scroll { scrollbar-width: thin; scrollbar-color: rgba(148,163,184,.4) transparent; }
  #dueChat .dc-msg { animation: dcIn .25s ease both; }
  @keyframes dcIn { from { opacity:0; transform: translateY(6px); } to { opacity:1; transform:none; } }
  #dueChat .dc-dot { width:6px; height:6px; border-radius:9999px; background:var(--dc-blue); display:inline-block; animation: dcBounce 1.2s infinite ease-in-out; }
  #dueChat .dc-dot:nth-child(2){ animation-delay:.15s } #dueChat .dc-dot:nth-child(3){ animation-delay:.3s }
  @keyframes dcBounce { 0%,80%,100%{ transform:translateY(0); opacity:.5 } 40%{ transform:translateY(-4px); opacity:1 } }
  #dueChat .dc-bubble a { color: var(--dc-blue); text-decoration: underline; word-break: break-all; }
  #dueChat .dc-bubble ul { list-style: disc; padding-left: 1.1rem; margin: .25rem 0; }
  #dueChat .dc-bubble li { margin: .1rem 0; }
  @media (prefers-reduced-motion: reduce) { #dueChat * { animation: none !important; transition: none !important; } }
</style>

<div id="dueChat" class="dc-closed" aria-live="polite">
  <!-- Nền mờ (chỉ trên điện thoại) -->
  <div class="dc-backdrop fixed inset-0 bg-slate-900/40 backdrop-blur-[2px] z-[60] sm:hidden" data-dc-close></div>

  <!-- Khung chat -->
  <section class="dc-panel fixed z-[61] inset-x-0 bottom-0 top-16 sm:top-auto sm:inset-x-auto sm:right-6 sm:bottom-24 sm:w-[370px] sm:h-[min(500px,calc(100vh-10rem))]
                  flex flex-col bg-white sm:rounded-3xl rounded-t-3xl shadow-2xl shadow-blue-900/25 border border-slate-200/70 overflow-hidden"
           role="dialog" aria-modal="true" aria-labelledby="dcTitle">

    <!-- Header -->
    <header class="relative px-4 py-3.5 text-white bg-gradient-to-br from-[#003366] via-[#0072BC] to-[#0a8fd8]">
      <div class="absolute inset-0 opacity-20 pointer-events-none" style="background: radial-gradient(circle at 90% -20%, #F37021 0, transparent 55%);"></div>
      <div class="relative flex items-center gap-3">
        <div class="relative w-10 h-10 rounded-2xl bg-white/15 ring-1 ring-white/25 flex items-center justify-center">
          <span class="material-symbols-outlined text-[22px]">smart_toy</span>
          <span class="absolute -bottom-0.5 -right-0.5 w-3 h-3 rounded-full bg-[#00A859] ring-2 ring-[#0072BC]"></span>
        </div>
        <div class="flex-1 min-w-0">
          <h2 id="dcTitle" class="font-heading font-bold text-[15px] leading-tight">DUE AI BOT</h2>
        </div>
        <button type="button" data-dc-reset class="w-8 h-8 rounded-xl hover:bg-white/15 flex items-center justify-center" title="Cuộc trò chuyện mới">
          <span class="material-symbols-outlined text-[19px]">refresh</span>
        </button>
        <a href="/chatbot/" class="w-8 h-8 rounded-xl hover:bg-white/15 hidden sm:flex items-center justify-center" title="Mở toàn trang">
          <span class="material-symbols-outlined text-[19px]">open_in_full</span>
        </a>
        <button type="button" data-dc-close class="w-8 h-8 rounded-xl hover:bg-white/15 flex items-center justify-center" title="Đóng">
          <span class="material-symbols-outlined text-[21px]">close</span>
        </button>
      </div>
    </header>

    <!-- Tin nhắn -->
    <div id="dcScroll" class="dc-scroll flex-1 overflow-y-auto px-3.5 py-3 space-y-2.5 bg-gradient-to-b from-slate-50 to-white">
      <div id="dcWelcome" class="dc-msg">
        <div class="rounded-2xl bg-white border border-slate-200 p-3 shadow-sm">
          <p class="text-sm font-bold text-slate-900">Xin chào! 👋</p>
          <p class="text-[12.5px] text-slate-600 mt-0.5 leading-relaxed">Mình là trợ lý tuyển sinh của DUE</p>
        </div>
        <p class="text-[10.5px] font-semibold text-slate-400 uppercase tracking-wider mt-3 mb-1.5 px-1">Gợi ý câu hỏi</p>
        <div class="flex flex-wrap gap-1.5">
          <button type="button" data-dc-ask class="px-3 py-1.5 rounded-full bg-white border border-slate-200 text-[12px] text-slate-700 hover:border-[#0072BC] hover:text-[#0072BC] transition">Năm 2026 có những phương thức xét tuyển nào?</button>
          <button type="button" data-dc-ask class="px-3 py-1.5 rounded-full bg-white border border-slate-200 text-[12px] text-slate-700 hover:border-[#0072BC] hover:text-[#0072BC] transition">Học phí chương trình Tiêu chuẩn bao nhiêu?</button>
          <button type="button" data-dc-ask class="px-3 py-1.5 rounded-full bg-white border border-slate-200 text-[12px] text-slate-700 hover:border-[#0072BC] hover:text-[#0072BC] transition">IELTS 5.5 được xét chương trình nào?</button>
          <button type="button" data-dc-ask class="px-3 py-1.5 rounded-full bg-white border border-slate-200 text-[12px] text-slate-700 hover:border-[#0072BC] hover:text-[#0072BC] transition">Có những học bổng nào cho tân sinh viên?</button>
        </div>
      </div>
      <div id="dcList" class="space-y-3"></div>
    </div>

    <!-- Ô nhập -->
    <form id="dcForm" class="p-3 border-t border-slate-100 bg-white">
      <div class="flex items-end gap-2 rounded-2xl border border-slate-200 bg-slate-50 focus-within:bg-white focus-within:border-[#0072BC] focus-within:ring-4 focus-within:ring-blue-100 transition px-3 py-2">
        <textarea id="dcInput" rows="1" maxlength="2000" placeholder="Nhập câu hỏi của bạn…"
                  class="flex-1 resize-none bg-transparent text-sm text-slate-800 placeholder-slate-400 focus:outline-none py-1.5 max-h-32"></textarea>
        <button id="dcSend" type="submit" class="shrink-0 w-9 h-9 rounded-xl bg-gradient-to-br from-[#F37021] to-[#0072BC] text-white flex items-center justify-center shadow-md shadow-blue-500/30 hover:opacity-95 active:scale-95 transition disabled:opacity-40 disabled:cursor-not-allowed" title="Gửi">
          <span class="material-symbols-outlined text-[19px]">arrow_upward</span>
        </button>
      </div>
      <p class="text-[10.5px] text-slate-400 text-center mt-2">Hotline tuyển sinh <a href="tel:02363836169" class="text-[#0072BC] font-semibold">0236 3836 169</a></p>
    </form>
  </section>

  <!-- Nút mở chat -->
  <div id="dcLauncher" class="fixed bottom-6 right-6 z-[62] flex items-center group">
    <div id="dcHint" class="absolute right-full mr-4 bg-white px-4 py-2.5 rounded-2xl shadow-xl shadow-blue-900/10 border border-slate-100 flex-col items-end w-max pointer-events-none hidden md:flex">
      <span class="text-xs font-semibold text-slate-500 mb-0.5">Bạn cần hỗ trợ tuyển sinh?</span>
      <span class="text-sm font-extrabold text-[#0072BC] tracking-tight flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-[#00A859] animate-pulse"></span>Chat ngay với DUE
      </span>
      <div class="absolute top-1/2 -right-1.5 -translate-y-1/2 border-y-[6px] border-y-transparent border-l-[6px] border-l-white"></div>
    </div>
    <button type="button" id="dcToggle" aria-controls="dcTitle" aria-expanded="false"
            class="relative flex items-center justify-center w-14 h-14 bg-gradient-to-tr from-[#003366] via-[#0072BC] to-[#F37021] text-white rounded-full shadow-lg shadow-blue-500/40 hover:shadow-blue-500/60 hover:scale-105 transition-all"
            title="Chat với AI Tuyển sinh DUE">
      <span id="dcPing" class="absolute inset-0 bg-[#0072BC] rounded-full animate-ping opacity-30 pointer-events-none"></span>
      <span id="dcIconOpen" class="relative flex flex-col items-center">
        <span class="material-symbols-outlined text-[26px]">smart_toy</span>
        <span class="text-[9px] font-extrabold tracking-tighter uppercase -mt-0.5">AI DUE</span>
      </span>
      <span id="dcIconClose" class="relative hidden material-symbols-outlined text-[28px]">close</span>
      <span id="dcBadge" class="absolute -top-1 -right-1 min-w-[20px] h-5 px-1 rounded-full bg-[#F37021] text-[11px] font-bold flex items-center justify-center ring-2 ring-white hidden">1</span>
    </button>
  </div>
</div>

<script>
(function () {
  var root = document.getElementById('dueChat');
  if (!root) return;
  var $ = function (id) { return document.getElementById(id); };
  var list = $('dcList'), scroller = $('dcScroll'), input = $('dcInput'), sendBtn = $('dcSend');
  var history = [], busy = false, pending = 0, pollTimer = null, unread = 0;

  function sGet(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }
  function sSet(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }
  var CID = sGet('due_chat_client_id');
  if (!CID || !/^[A-Za-z0-9_-]{8,64}$/.test(CID)) {
    CID = 'c' + Date.now().toString(36) + Math.random().toString(36).slice(2, 12);
    sSet('due_chat_client_id', CID);
  }
  var seen = {};
  try { seen = JSON.parse(sGet('due_chat_seen') || '{}') || {}; } catch (e) { seen = {}; }

  function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }
  // Markdown rút gọn: **đậm**, gạch đầu dòng, link
  function md(text) {
    var lines = esc(text).split('\n'), out = [], inList = false;
    lines.forEach(function (l) {
      var m = l.match(/^\s*(?:[-*•]|\d+\.)\s+(.*)$/);
      if (m) { if (!inList) { out.push('<ul>'); inList = true; } out.push('<li>' + m[1] + '</li>'); return; }
      if (inList) { out.push('</ul>'); inList = false; }
      out.push(l === '' ? '<div class="h-2"></div>' : '<p>' + l + '</p>');
    });
    if (inList) out.push('</ul>');
    return out.join('')
      .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
      .replace(/(https?:\/\/[^\s<]+)/g, '<a href="$1" target="_blank" rel="noopener">$1</a>');
  }

  function isOpen() { return !root.classList.contains('dc-closed'); }
  function open() {
    root.classList.remove('dc-closed');
    $('dcToggle').setAttribute('aria-expanded', 'true');
    $('dcIconOpen').classList.add('hidden'); $('dcIconClose').classList.remove('hidden');
    $('dcPing').classList.add('hidden'); $('dcHint').classList.add('md:hidden');
    unread = 0; $('dcBadge').classList.add('hidden');
    setTimeout(function () { input.focus(); }, 150);
    if (!history || history.length === 0) {
      scroller.scrollTop = 0;
    } else {
      scrollEnd();
    }
  }
  function close() {
    root.classList.add('dc-closed');
    $('dcToggle').setAttribute('aria-expanded', 'false');
    $('dcIconOpen').classList.remove('hidden'); $('dcIconClose').classList.add('hidden');
    $('dcHint').classList.remove('md:hidden');
  }
  function scrollEnd() { scroller.scrollTop = scroller.scrollHeight; }

  function add(kind, text, sources) {
    $('dcWelcome').classList.add('hidden');
    var wrap = document.createElement('div');
    wrap.className = 'dc-msg flex gap-2 ' + (kind === 'user' ? 'justify-end' : 'justify-start');
    if (kind === 'user') {
      wrap.innerHTML = '<div class="dc-bubble max-w-[82%] rounded-2xl rounded-br-md px-3.5 py-2.5 bg-[#0072BC] text-white text-[13.5px] leading-relaxed shadow-sm">' + md(text) + '</div>';
    } else {
      var cfg = {
        bot:     { av: 'bg-gradient-to-br from-[#0072BC] to-[#003366]', ic: 'smart_toy', box: 'bg-white border-slate-200', label: '' },
        staff:   { av: 'bg-[#00A859]', ic: 'support_agent', box: 'bg-emerald-50 border-emerald-200', label: '<p class="text-[11px] font-bold text-[#00A859] mb-1">Cán bộ tuyển sinh DUE</p>' },
        handoff: { av: 'bg-[#F37021]', ic: 'forward_to_inbox', box: 'bg-orange-50 border-orange-200', label: '<p class="text-[11px] font-bold text-[#F37021] mb-1">Đã chuyển cho cán bộ</p>' },
        error:   { av: 'bg-slate-400', ic: 'error', box: 'bg-slate-50 border-slate-200', label: '' }
      }[kind];
      var src = sources && sources.length
        ? '<div class="mt-2 pt-2 border-t border-slate-100 flex flex-wrap gap-1">' + sources.map(function (s) {
            return '<span class="px-2 py-0.5 rounded-full bg-slate-100 text-[10.5px] text-slate-500">' + esc(s.replace(/^(Website DUE|Tài liệu tuyển sinh): /, '')) + '</span>';
          }).join('') + '</div>' : '';
      wrap.innerHTML = '<div class="shrink-0 w-7 h-7 rounded-xl ' + cfg.av + ' text-white flex items-center justify-center mt-0.5"><span class="material-symbols-outlined text-[16px]">' + cfg.ic + '</span></div>' +
        '<div class="dc-bubble max-w-[85%] rounded-2xl rounded-tl-md px-3.5 py-2.5 border ' + cfg.box + ' text-slate-800 text-[13.5px] leading-relaxed shadow-sm">' + cfg.label + md(text) + src + '</div>';
    }
    list.appendChild(wrap);
    // Câu trả lời dài: cuộn tới đầu câu trả lời thay vì cuối
    if (kind !== 'user' && wrap.offsetHeight > scroller.clientHeight - 40) {
      scroller.scrollTop = wrap.offsetTop - scroller.offsetTop - 12;
    } else {
      scrollEnd();
    }
  }

  function typing(on) {
    var el = $('dcTyping');
    if (on && !el) {
      el = document.createElement('div');
      el.id = 'dcTyping';
      el.className = 'dc-msg flex gap-2';
      el.innerHTML = '<div class="shrink-0 w-7 h-7 rounded-xl bg-gradient-to-br from-[#0072BC] to-[#003366] text-white flex items-center justify-center"><span class="material-symbols-outlined text-[16px]">smart_toy</span></div>' +
        '<div class="rounded-2xl rounded-tl-md px-4 py-3 bg-white border border-slate-200 flex gap-1.5 items-center"><span class="dc-dot"></span><span class="dc-dot"></span><span class="dc-dot"></span></div>';
      list.appendChild(el); scrollEnd();
    } else if (!on && el) { el.remove(); }
  }

  async function send(text) {
    text = (text || '').trim();
    if (!text || busy) return;
    busy = true; sendBtn.disabled = true;
    input.value = ''; autosize();
    add('user', text);
    typing(true);
    try {
      var res = await fetch('/api/chat/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message: text, history: history, client_id: CID })
      });
      var json = await res.json().catch(function () { return {}; });
      typing(false);
      if (res.status === 429) { add('error', 'Bạn đang hỏi hơi nhanh, vui lòng chờ khoảng 1 phút rồi hỏi tiếp nhé.'); return; }
      if (json.status !== 'success') { add('error', json.message || 'Có lỗi xảy ra, bạn thử lại sau nhé.'); return; }
      add(json.handoff ? 'handoff' : 'bot', json.reply, json.sources);
      history.push({ role: 'user', content: text });
      if (!json.handoff) history.push({ role: 'assistant', content: json.reply });
      if (json.handoff) { pending++; schedulePoll(); }
    } catch (e) {
      typing(false);
      add('error', 'Không kết nối được máy chủ, bạn kiểm tra mạng và thử lại nhé.');
    } finally {
      busy = false; sendBtn.disabled = false;
      if (isOpen()) input.focus();
    }
  }

  async function poll() {
    try {
      var res = await fetch('/api/chat/updates/?client_id=' + encodeURIComponent(CID));
      var json = await res.json();
      if (json.status === 'success') {
        pending = 0;
        json.data.forEach(function (q) {
          if (q.trang_thai === 'cho') { pending++; return; }
          if (seen[q.id]) return;
          seen[q.id] = 1;
          add('staff', '**Về câu hỏi:** "' + q.cau_hoi + '"\n\n' + q.tra_loi);
          history.push({ role: 'assistant', content: q.tra_loi });
          if (!isOpen()) { unread++; $('dcBadge').textContent = unread; $('dcBadge').classList.remove('hidden'); }
        });
        sSet('due_chat_seen', JSON.stringify(seen));
      }
    } catch (e) {}
    schedulePoll();
  }
  function schedulePoll() {
    clearTimeout(pollTimer);
    if (pending > 0) pollTimer = setTimeout(poll, 5000);
  }

  function autosize() { input.style.height = 'auto'; input.style.height = Math.min(input.scrollHeight, 128) + 'px'; }

  $('dcToggle').addEventListener('click', function () { isOpen() ? close() : open(); });
  root.querySelectorAll('[data-dc-close]').forEach(function (b) { b.addEventListener('click', close); });
  root.querySelector('[data-dc-reset]').addEventListener('click', function () {
    list.innerHTML = ''; history = []; $('dcWelcome').classList.remove('hidden'); input.focus();
  });
  root.querySelectorAll('[data-dc-ask]').forEach(function (b) { b.addEventListener('click', function () { send(b.textContent); }); });
  $('dcForm').addEventListener('submit', function (e) { e.preventDefault(); send(input.value); });
  input.addEventListener('input', autosize);
  input.addEventListener('keydown', function (e) {
    if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) { e.preventDefault(); send(input.value); }
  });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && isOpen()) close(); });

  // Nhận câu trả lời cán bộ đã gửi trong lúc người dùng rời trang
  poll();
})();
</script>


--- FILE: CongthongtintuyensinhDUE/templates/portal/clubs.html ---
{% extends 'layouts/base.html' %}

{% block title %}Hệ thống Câu Lạc Bộ – Đội – Nhóm | DUE - Trường Đại học Kinh tế, ĐH Đà Nẵng{% endblock %}

{% block nav_sinhvien %}text-secondary-container font-headline-sm border-b-2 border-secondary-container uppercase whitespace-nowrap font-bold{% endblock %}

{% block extra_head %}
<style>
  .clb-card {
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s ease;
  }
  .clb-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 36px -8px rgba(0, 51, 102, 0.14), 0 4px 12px -2px rgba(0, 0, 0, 0.06);
  }
  .chip-btn {
    transition: all 0.18s ease;
  }
  .chip-btn.active {
    background-color: #003366 !important;
    color: #ffffff !important;
    border-color: #003366 !important;
    box-shadow: 0 4px 12px rgba(0, 51, 102, 0.25);
  }
  .custom-modal-scroll::-webkit-scrollbar {
    width: 6px;
  }
  .custom-modal-scroll::-webkit-scrollbar-thumb {
    background-color: #cbd5e1;
    border-radius: 9999px;
  }
  .custom-modal-scroll::-webkit-scrollbar-thumb:hover {
    background-color: #94a3b8;
  }
</style>
{% endblock %}

{% block content %}
<main class="w-full pt-32 sm:pt-36 pb-6 bg-surface min-h-[calc(100vh-28rem)] flex-1">
  <div class="max-w-7xl mx-auto px-6 lg:px-12 pt-8 pb-4">

    <!-- BREADCRUMB -->
    <nav class="flex items-center gap-2 text-xs sm:text-sm text-on-surface-variant mb-6 font-medium" aria-label="Breadcrumb">
      <a href="/" class="hover:text-primary-container transition-colors">Trang chủ</a>
      <span class="material-symbols-outlined text-[14px]">chevron_right</span>
      <a href="/sinh-vien/" class="hover:text-primary-container transition-colors">Dành cho sinh viên</a>
      <span class="material-symbols-outlined text-[14px]">chevron_right</span>
      <span class="text-secondary-container font-semibold">Câu lạc bộ – Đội – Nhóm</span>
    </nav>

    <!-- HERO BANNER -->
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-[#00274d] via-[#003366] to-[#004f8c] text-white p-6 sm:p-10 mb-10 shadow-xl">
      <div class="absolute -right-20 -top-20 w-80 h-80 rounded-full bg-white/10 blur-3xl pointer-events-none"></div>
      <div class="absolute right-60 -bottom-32 w-72 h-72 rounded-full bg-orange-500/15 blur-2xl pointer-events-none"></div>

      <div class="relative z-10 max-w-3xl">
        <h1 class="text-2xl sm:text-4xl font-extrabold font-headline-lg tracking-tight mb-3">
          Hệ Thống Câu Lạc Bộ – Đội – Nhóm DUE
        </h1>
        <p class="text-blue-100/90 text-sm sm:text-base leading-relaxed mb-6 max-w-2xl">
          Nơi kết nối đam mê, rèn luyện kỹ năng thực chiến, tự tin khẳng định bản lĩnh và lưu giữ những thanh xuân rực rỡ nhất tại Trường Đại học Kinh tế – Đại học Đà Nẵng.
        </p>

        <!-- 3 Thống kê nhanh -->
        <div class="grid grid-cols-3 gap-3 sm:gap-4 max-w-xl">
          <div class="bg-white/10 backdrop-blur-md rounded-2xl p-3 sm:p-4 border border-white/15">
            <div class="text-xl sm:text-3xl font-extrabold text-[#fd761a]">{{ clubs_count }}</div>
            <div class="text-[11px] sm:text-xs text-blue-100 font-medium mt-0.5">CLB – Đội – Nhóm</div>
          </div>
          <div class="bg-white/10 backdrop-blur-md rounded-2xl p-3 sm:p-4 border border-white/15">
            <div class="text-xl sm:text-3xl font-extrabold text-white">6</div>
            <div class="text-[11px] sm:text-xs text-blue-100 font-medium mt-0.5">Lĩnh vực hoạt động</div>
          </div>
          <div class="bg-white/10 backdrop-blur-md rounded-2xl p-3 sm:p-4 border border-white/15">
            <div class="text-xl sm:text-3xl font-extrabold text-[#7dd3fc]">54K+</div>
            <div class="text-[11px] sm:text-xs text-blue-100 font-medium mt-0.5">Lượt theo dõi Fanpage</div>
          </div>
        </div>
      </div>
    </div>

    <!-- CONTROL BAR: TÌM KIẾM và BỘ LỌC CẤP -->
    <div class="bg-white rounded-2xl border border-slate-200 p-4 sm:p-5 mb-6 shadow-sm flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-4">
      <!-- Search Input -->
      <div class="relative flex-1">
        <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-[20px]">search</span>
        <input
          id="clbSearchInput"
          type="search"
          placeholder="Tìm tên CLB, lĩnh vực, chuyên môn, kỹ năng..."
          class="w-full pl-11 pr-4 py-2.5 rounded-full border border-slate-200 bg-slate-50 focus:bg-white text-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-[#0072BC] focus:border-[#0072BC] transition-all"
        >
      </div>

      <!-- Level Filter Dropdown -->
      <div class="flex items-center gap-2">
        <label for="clbLevelSelect" class="text-xs font-bold text-slate-500 whitespace-nowrap uppercase tracking-wider">Cấp quản lý:</label>
        <select
          id="clbLevelSelect"
          class="px-4 py-2.5 rounded-full border border-slate-200 bg-slate-50 text-slate-700 text-xs sm:text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-[#0072BC] transition-all cursor-pointer"
        >
          <option value="all">Tất cả cấp (Trường và khoa)</option>
          <option value="truong">Cấp trường (Đoàn – Hội)</option>
          <option value="khoa">Cấp khoa chuyên ngành</option>
        </select>
      </div>
    </div>

    <!-- FILTER CHIPS: LĨNH VỰC HOẠT ĐỘNG -->
    <div class="flex items-center gap-2 overflow-x-auto pb-2 mb-6 no-scrollbar" id="categoryChips">
      <button type="button" data-group="all" class="chip-btn active shrink-0 inline-flex items-center gap-1.5 px-4 py-2 rounded-full border border-slate-200 bg-white text-slate-700 text-xs sm:text-sm font-semibold hover:border-[#003366]">
        <span class="material-symbols-outlined text-[18px]">apps</span>
        <span>Tất cả</span>
      </button>
      <button type="button" data-group="hoc-thuat" class="chip-btn shrink-0 inline-flex items-center gap-1.5 px-4 py-2 rounded-full border border-slate-200 bg-white text-slate-700 text-xs sm:text-sm font-semibold hover:border-[#003366]">
        <span class="material-symbols-outlined text-[18px] text-blue-600">menu_book</span>
        <span>Học thuật và chuyên ngành</span>
      </button>
      <button type="button" data-group="ky-nang" class="chip-btn shrink-0 inline-flex items-center gap-1.5 px-4 py-2 rounded-full border border-slate-200 bg-white text-slate-700 text-xs sm:text-sm font-semibold hover:border-[#003366]">
        <span class="material-symbols-outlined text-[18px] text-amber-500">rocket_launch</span>
        <span>Kỹ năng và khởi nghiệp</span>
      </button>
      <button type="button" data-group="ngoai-ngu" class="chip-btn shrink-0 inline-flex items-center gap-1.5 px-4 py-2 rounded-full border border-slate-200 bg-white text-slate-700 text-xs sm:text-sm font-semibold hover:border-[#003366]">
        <span class="material-symbols-outlined text-[18px] text-emerald-600">translate</span>
        <span>Ngoại ngữ và tiếng Anh</span>
      </button>
      <button type="button" data-group="nghe-thuat" class="chip-btn shrink-0 inline-flex items-center gap-1.5 px-4 py-2 rounded-full border border-slate-200 bg-white text-slate-700 text-xs sm:text-sm font-semibold hover:border-[#003366]">
        <span class="material-symbols-outlined text-[18px] text-pink-500">music_note</span>
        <span>Văn nghệ và nghệ thuật</span>
      </button>
      <button type="button" data-group="the-thao" class="chip-btn shrink-0 inline-flex items-center gap-1.5 px-4 py-2 rounded-full border border-slate-200 bg-white text-slate-700 text-xs sm:text-sm font-semibold hover:border-[#003366]">
        <span class="material-symbols-outlined text-[18px] text-indigo-600">sports_martial_arts</span>
        <span>Thể dục và thể thao</span>
      </button>
      <button type="button" data-group="cong-dong" class="chip-btn shrink-0 inline-flex items-center gap-1.5 px-4 py-2 rounded-full border border-slate-200 bg-white text-slate-700 text-xs sm:text-sm font-semibold hover:border-[#003366]">
        <span class="material-symbols-outlined text-[18px] text-teal-600">campaign</span>
        <span>Truyền thông và cộng đồng</span>
      </button>
    </div>

    <!-- KẾT QUẢ ĐẾM -->
    <div class="flex items-center justify-between mb-5 px-1">
      <div id="clbResultCount" class="text-xs sm:text-sm font-bold text-slate-600">
        Hiển thị <span class="text-[#0072BC] font-extrabold" id="shownCount">{{ clubs_count }}</span> / {{ clubs_count }} câu lạc bộ, đội, nhóm
      </div>
      <div class="text-xs text-slate-400 hidden sm:block">
        Bấm "Xem chi tiết" để xem hồ sơ và liên hệ từng CLB
      </div>
    </div>

    <!-- GRID DANH SÁCH CLB -->
    <div id="clbGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
      <!-- Sẽ được Render động bằng Javascript từ dữ liệu clb.json -->
    </div>

    <!-- KHÔNG TÌM THẤY KẾT QUẢ EMPTY STATE -->
    <div id="clbEmptyState" class="hidden text-center py-16 bg-white rounded-3xl border border-slate-200 shadow-sm mb-16">
      <span class="material-symbols-outlined text-slate-300 text-[56px] mb-3">search_off</span>
      <h3 class="text-lg font-bold text-slate-700 mb-1">Không tìm thấy câu lạc bộ phù hợp</h3>
      <p class="text-sm text-slate-500 max-w-md mx-auto mb-4">Vui lòng thử tìm với từ khóa khác hoặc chuyển sang danh mục "Tất cả".</p>
      <button onclick="resetFilters()" class="px-5 py-2 rounded-full bg-[#0072BC] text-white text-xs font-bold hover:bg-[#005a96] transition-colors">
        Xem tất cả câu lạc bộ
      </button>
    </div>

    <!-- HOẠT ĐỘNG THƯỜNG NIÊN CỦA SINH VIÊN DUE -->
    <div class="rounded-3xl bg-gradient-to-br from-[#003366] to-[#001e40] text-white p-6 sm:p-10 shadow-xl relative overflow-hidden">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/10 text-orange-200 text-xs font-bold uppercase tracking-wider mb-3">
        <span class="material-symbols-outlined text-[16px] text-orange-400">celebration</span>
        Không chỉ có CLB
      </div>
      <h2 class="text-xl sm:text-3xl font-bold font-headline-lg mb-2">Các Hoạt Động và sự Kiện Thường Niên Của DUE</h2>
      <p class="text-blue-100 text-xs sm:text-sm max-w-2xl mb-8">Bên cạnh sinh hoạt CLB, sinh viên DUE còn được hòa mình vào chuỗi phong trào quy mô lớn do Đoàn trường và Hội Sinh viên tổ chức.</p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <div class="flex items-start gap-3.5 p-4 rounded-2xl bg-white/10 backdrop-blur-md border border-white/10 hover:bg-white/15 transition-colors">
          <span class="shrink-0 w-11 h-11 rounded-xl bg-gradient-to-tr from-orange-500 to-amber-400 text-white flex items-center justify-center shadow-md">
            <span class="material-symbols-outlined text-[24px]">volunteer_activism</span>
          </span>
          <div>
            <h4 class="font-bold text-sm text-white">Chiến dịch Tình nguyện Đông</h4>
            <p class="text-xs text-blue-100/80 mt-1 leading-relaxed">Mang hơi ấm, áo ấm và công trình thanh niên đến với bà con đồng bào vùng sâu vùng xa.</p>
          </div>
        </div>

        <div class="flex items-start gap-3.5 p-4 rounded-2xl bg-white/10 backdrop-blur-md border border-white/10 hover:bg-white/15 transition-colors">
          <span class="shrink-0 w-11 h-11 rounded-xl bg-gradient-to-tr from-emerald-500 to-teal-400 text-white flex items-center justify-center shadow-md">
            <span class="material-symbols-outlined text-[24px]">wb_sunny</span>
          </span>
          <div>
            <h4 class="font-bold text-sm text-white">Chiến dịch Mùa Hè Xanh</h4>
            <p class="text-xs text-blue-100/80 mt-1 leading-relaxed">Mặt trận tình nguyện hè rực lửa, xây dựng nông thôn mới và chuyển giao văn hóa kỹ năng.</p>
          </div>
        </div>

        <div class="flex items-start gap-3.5 p-4 rounded-2xl bg-white/10 backdrop-blur-md border border-white/10 hover:bg-white/15 transition-colors">
          <span class="shrink-0 w-11 h-11 rounded-xl bg-gradient-to-tr from-pink-500 to-rose-400 text-white flex items-center justify-center shadow-md">
            <span class="material-symbols-outlined text-[24px]">nightlife</span>
          </span>
          <div>
            <h4 class="font-bold text-sm text-white">Đêm Khiêu vũ Lovely Night</h4>
            <p class="text-xs text-blue-100/80 mt-1 leading-relaxed">Dạ hội khiêu vũ thường niên lãng mạn, sang trọng và gắn kết các thế hệ sinh viên DUE.</p>
          </div>
        </div>

        <div class="flex items-start gap-3.5 p-4 rounded-2xl bg-white/10 backdrop-blur-md border border-white/10 hover:bg-white/15 transition-colors">
          <span class="shrink-0 w-11 h-11 rounded-xl bg-gradient-to-tr from-purple-500 to-indigo-400 text-white flex items-center justify-center shadow-md">
            <span class="material-symbols-outlined text-[24px]">military_tech</span>
          </span>
          <div>
            <h4 class="font-bold text-sm text-white">Cuộc thi Thủ lĩnh Sinh viên</h4>
            <p class="text-xs text-blue-100/80 mt-1 leading-relaxed">Sân chơi rèn luyện tài năng lãnh đạo, tư duy phản biện và khả năng xử lý tình huống thực tế.</p>
          </div>
        </div>

        <div class="flex items-start gap-3.5 p-4 rounded-2xl bg-white/10 backdrop-blur-md border border-white/10 hover:bg-white/15 transition-colors">
          <span class="shrink-0 w-11 h-11 rounded-xl bg-gradient-to-tr from-amber-500 to-yellow-400 text-white flex items-center justify-center shadow-md">
            <span class="material-symbols-outlined text-[24px]">star</span>
          </span>
          <div>
            <h4 class="font-bold text-sm text-white">Sinh viên Tài năng – Thanh lịch</h4>
            <p class="text-xs text-blue-100/80 mt-1 leading-relaxed">Tôn vinh vẻ đẹp trí tuệ, duyên dáng và phong thái tự tin của nam nữ sinh viên Kinh tế.</p>
          </div>
        </div>

        <div class="flex items-start gap-3.5 p-4 rounded-2xl bg-white/10 backdrop-blur-md border border-white/10 hover:bg-white/15 transition-colors">
          <span class="shrink-0 w-11 h-11 rounded-xl bg-gradient-to-tr from-blue-500 to-cyan-400 text-white flex items-center justify-center shadow-md">
            <span class="material-symbols-outlined text-[24px]">sports_soccer</span>
          </span>
          <div>
            <h4 class="font-bold text-sm text-white">Hội thao Sinh viên DUE</h4>
            <p class="text-xs text-blue-100/80 mt-1 leading-relaxed">Giải thi đấu bóng đá, bóng rổ, cầu lông, bóng chuyền, cờ vua giữa các Khoa và CLB.</p>
          </div>
        </div>
      </div>
    </div>

  </div>
</main>
{% endblock %}

{% block extra_js %}
<script>
  // Dữ liệu danh sách CLB từ Django backend
  const CLUBS_DATA = JSON.parse('{{ clubs_json|safe }}');

  // Nhóm phân loại
  const GROUPS = [
    { key: "hoc-thuat", label: "Học thuật & Chuyên ngành", ic: "menu_book", color: "blue", test: (c) => /^Học thuật/i.test(c.category || "") },
    { key: "ky-nang", label: "Kỹ năng & Khởi nghiệp", ic: "rocket_launch", color: "amber", test: (c) => /Kỹ năng|Kinh doanh|Thương mại/i.test(c.category || "") },
    { key: "ngoai-ngu", label: "Ngoại ngữ & Tiếng Anh", ic: "translate", color: "emerald", test: (c) => /Ngoại ngữ/i.test(c.category || "") },
    { key: "nghe-thuat", label: "Văn nghệ & Nghệ thuật", ic: "music_note", color: "pink", test: (c) => /Âm nhạc|Văn nghệ/i.test(c.category || "") },
    { key: "the-thao", label: "Thể dục & Thể thao", ic: "sports_martial_arts", color: "indigo", test: (c) => /Thể thao/i.test(c.category || "") },
    { key: "cong-dong", label: "Truyền thông & Cộng đồng", ic: "campaign", color: "teal", test: (c) => /Truyền thông|Môi trường|xã hội/i.test(c.category || "") },
    { key: "khac", label: "Đa lĩnh vực", ic: "interests", color: "slate", test: () => true }
  ];

  function getGroup(club) {
    return GROUPS.find(g => g.test(club)) || GROUPS[GROUPS.length - 1];
  }

  const state = {
    q: "",
    group: "all",
    level: "all"
  };

  function removeDiacritics(str) {
    return String(str || "").toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/đ/g, "d");
  }

  function renderClubs() {
    const q = removeDiacritics(state.q);
    const filtered = CLUBS_DATA.filter(c => {
      const g = getGroup(c);
      const matchGroup = (state.group === "all" || g.key === state.group);
      const isTruong = !c.faculty_id;
      const matchLevel = (state.level === "all" || (state.level === "truong" && isTruong) || (state.level === "khoa" && !isTruong));
      const searchTarget = [c.name, c.category, c.description, c.slogan, c.faculty_name, c.intro].join(" ");
      const matchSearch = (!q || removeDiacritics(searchTarget).includes(q));
      return matchGroup && matchLevel && matchSearch;
    });

    // Update count
    document.getElementById("shownCount").textContent = filtered.length;
    const grid = document.getElementById("clbGrid");
    const empty = document.getElementById("clbEmptyState");

    if (filtered.length === 0) {
      grid.innerHTML = "";
      empty.classList.remove("hidden");
      return;
    }

    empty.classList.add("hidden");

    grid.innerHTML = filtered.map(c => {
      const g = getGroup(c);
      const isTruong = !c.faculty_id;
      const levelLabel = isTruong ? "Cấp trường (Đoàn – Hội)" : (c.faculty_name || "Cấp khoa");

      // Badge color
      let badgeBg = "bg-blue-50 text-blue-700 border-blue-200";
      if (g.color === "amber") badgeBg = "bg-amber-50 text-amber-700 border-amber-200";
      if (g.color === "emerald") badgeBg = "bg-emerald-50 text-emerald-700 border-emerald-200";
      if (g.color === "pink") badgeBg = "bg-pink-50 text-pink-700 border-pink-200";
      if (g.color === "indigo") badgeBg = "bg-indigo-50 text-indigo-700 border-indigo-200";
      if (g.color === "teal") badgeBg = "bg-teal-50 text-teal-700 border-teal-200";

      const coverHtml = c.cover_url
        ? `<div class="aspect-[21/9] w-full bg-slate-100 overflow-hidden relative">
             <img src="${c.cover_url}" alt="${c.name}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy">
             <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent"></div>
           </div>`
        : `<div class="aspect-[21/9] w-full bg-gradient-to-r from-[#003366] to-[#0072BC] relative overflow-hidden flex items-center justify-center">
             <div class="absolute -right-8 -top-8 w-32 h-32 rounded-full bg-white/10 blur-xl"></div>
             <span class="material-symbols-outlined text-white/30 text-[48px]">${g.ic}</span>
           </div>`;

      const logoHtml = c.logo_url
        ? `<img src="${c.logo_url}" alt="Logo ${c.name}" class="w-14 h-14 rounded-2xl object-cover ring-4 ring-white shadow-md bg-white shrink-0 -mt-7 ml-5 z-10" loading="lazy">`
        : `<div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-[#0072BC] to-[#003366] text-white flex items-center justify-center font-black text-xl ring-4 ring-white shadow-md shrink-0 -mt-7 ml-5 z-10">
             ${c.name.charAt(0)}
           </div>`;

      return `
        <a href="/clb/${c.id}/" class="clb-card group flex flex-col bg-white rounded-3xl border border-slate-200/90 overflow-hidden shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 block text-inherit no-underline cursor-pointer">
          <!-- Cover -->
          ${coverHtml}

          <!-- Logo & Badges -->
          <div class="flex items-start justify-between pr-4">
            ${logoHtml}
            <div class="pt-2 flex flex-wrap items-center justify-end gap-1.5">
              <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold border ${badgeBg}">${g.label}</span>
              ${c.founded ? `<span class="px-2 py-0.5 rounded-full text-[11px] font-medium bg-slate-100 text-slate-600">Từ ${c.founded.substring(0, 4)}</span>` : ""}
            </div>
          </div>

          <!-- Body -->
          <div class="p-5 flex flex-col flex-1">
            <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wide mb-1 flex items-center gap-1">
              <span class="material-symbols-outlined text-[14px] ${isTruong ? 'text-orange-500' : 'text-blue-600'}">
                ${isTruong ? 'flag' : 'school'}
              </span>
              <span>${levelLabel}</span>
            </div>

            <h3 class="font-bold text-slate-900 text-lg leading-snug group-hover:text-[#0072BC] transition-colors mb-2">
              ${c.name}
            </h3>

            ${c.slogan ? `<p class="text-xs font-semibold text-[#0072BC] italic mb-2 line-clamp-1">“${c.slogan}”</p>` : ""}

            <p class="text-slate-600 text-xs sm:text-sm line-clamp-3 leading-relaxed mb-4">
              ${c.intro || c.description || "Câu lạc bộ đang hoạt động sôi nổi tại Trường Đại học Kinh tế - ĐH Đà Nẵng."}
            </p>

            ${c.recruitment ? `
              <div class="mt-auto mb-4 px-3 py-1.5 rounded-xl bg-orange-50 border border-orange-200/70 flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-orange-500 animate-ping"></span>
                <span class="text-[11px] font-bold text-orange-700 truncate">Tuyển TV: ${c.recruitment}</span>
              </div>
            ` : `<div class="mt-auto"></div>`}

            <!-- Footer Card -->
            <div class="pt-3 border-t border-slate-100 flex items-center justify-between">
              <span class="text-xs font-semibold text-slate-500 flex items-center gap-1">
                ${c.followers ? `<span class="material-symbols-outlined text-[16px] text-slate-400">group</span> ${c.followers} theo dõi` : ""}
              </span>

              <span
                class="inline-flex items-center gap-1 px-4 py-1.5 rounded-full bg-[#0072BC] group-hover:bg-[#005a96] text-white text-xs font-bold transition-all shadow-sm group-hover:shadow"
              >
                <span>Xem chi tiết</span>
                <span class="material-symbols-outlined text-[15px] group-hover:translate-x-0.5 transition-transform">arrow_forward</span>
              </span>
            </div>
          </div>
        </a>
      `;
    }).join("");
  }

  function resetFilters() {
    state.q = "";
    state.group = "all";
    state.level = "all";
    document.getElementById("clbSearchInput").value = "";
    document.getElementById("clbLevelSelect").value = "all";
    document.querySelectorAll(".chip-btn").forEach(b => {
      b.classList.toggle("active", b.dataset.group === "all");
    });
    renderClubs();
  }

  // Lắng nghe sự kiện tìm kiếm & lọc
  document.getElementById("clbSearchInput").addEventListener("input", function(e) {
    state.q = e.target.value.trim();
    renderClubs();
  });

  document.getElementById("clbLevelSelect").addEventListener("change", function(e) {
    state.level = e.target.value;
    renderClubs();
  });

  document.querySelectorAll(".chip-btn").forEach(btn => {
    btn.addEventListener("click", function() {
      document.querySelectorAll(".chip-btn").forEach(b => b.classList.remove("active"));
      this.classList.add("active");
      state.group = this.dataset.group;
      renderClubs();
    });
  });

  // Điều hướng xem trang chi tiết đầy đủ thông tin CLB
  function openClubDetail(clubId) {
    if (!clubId) return;
    window.location.href = `/clb/${clubId}/`;
  }

  // Khởi tạo ban đầu
  renderClubs();
</script>
{% endblock %}



--- FILE: CongthongtintuyensinhDUE/templates/portal/club_detail.html ---
{% extends 'layouts/base.html' %}

{% block title %}{{ club.name }} - Câu lạc bộ sinh viên DUE | Trường Đại học Kinh tế - ĐH Đà Nẵng{% endblock %}

{% block nav_sinhvien %}text-secondary-container font-headline-sm border-b-2 border-secondary-container{% endblock %}

{% block content %}
<main class="w-full pt-32 sm:pt-36 pb-6 bg-surface min-h-[calc(100vh-28rem)] flex-1">

  <!-- Breadcrumb -->
  <div class="max-w-7xl mx-auto px-6 lg:px-12 pt-8 pb-4">
    <nav class="flex items-center gap-2 text-xs sm:text-sm text-on-surface-variant mb-6 font-medium">
      <a href="/" class="hover:text-primary-container transition-colors">Trang chủ</a>
      <span class="material-symbols-outlined text-[14px]">chevron_right</span>
      <a href="/sinh-vien/" class="hover:text-primary-container transition-colors">Dành cho sinh viên</a>
      <span class="material-symbols-outlined text-[14px]">chevron_right</span>
      <a href="/clb/" class="hover:text-primary-container transition-colors">Câu lạc bộ</a>
      <span class="material-symbols-outlined text-[14px]">chevron_right</span>
      <span class="text-secondary-container font-semibold truncate max-w-[200px] sm:max-w-none">{{ club.name }}</span>
    </nav>
  </div>

  <!-- Hero Header Section -->
  <section class="max-w-7xl mx-auto px-6 lg:px-12 mb-10">
    <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
      <!-- Cover Banner -->
      <div class="relative w-full h-56 sm:h-72 md:h-84 lg:h-96 bg-slate-900 overflow-hidden">
        {% if club.cover_url %}
          <img
            src="{{ club.cover_url }}"
            alt="Cover {{ club.name }}"
            class="w-full h-full object-cover object-center filter brightness-[0.88]"
          />
        {% else %}
          <div class="w-full h-full bg-gradient-to-r from-[#002855] via-[#003366] to-[#0072BC] flex items-center justify-center">
            <span class="material-symbols-outlined text-white/20 text-[120px]">groups</span>
          </div>
        {% endif %}
        <!-- Gradient overlay -->
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-900/30 to-transparent"></div>

        <!-- Back to list badge (top left) -->
        <div class="absolute top-5 left-5 z-10">
          <a
            href="/clb/"
            class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-black/40 hover:bg-black/60 text-white text-xs font-semibold backdrop-blur-md border border-white/20 transition-all shadow-sm"
          >
            <span class="material-symbols-outlined text-[16px]">arrow_back</span>
            <span>Tất cả CLB</span>
          </a>
        </div>

        <!-- Badge top right (Level) -->
        <div class="absolute top-5 right-5 z-10 flex items-center gap-2">
          <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-[#fd761a]/90 text-white text-xs font-bold shadow-md backdrop-blur-sm">
            <span class="material-symbols-outlined text-[14px]">verified</span>
            <span>{{ club.level }}</span>
          </span>
          <span class="inline-flex items-center px-3 py-1 rounded-full bg-white/90 text-[#003366] text-xs font-bold shadow-md backdrop-blur-sm">
            {{ club.category }}
          </span>
        </div>
      </div>

      <!-- Header Info và CTA Bar -->
      <div class="px-6 sm:px-10 pb-8 pt-4 relative">
        <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6 relative">
          <!-- Logo + Titles -->
          <div class="flex flex-col sm:flex-row items-start sm:items-center gap-5 w-full lg:w-auto">
            <!-- Club Logo (Elevated cleanly into cover banner) -->
            <div class="relative shrink-0 -mt-16 sm:-mt-24 z-20">
              {% if club.logo_url %}
                <img
                  src="{{ club.logo_url }}"
                  alt="Logo {{ club.name }}"
                  class="w-28 h-28 sm:w-36 sm:h-36 rounded-3xl object-cover ring-4 ring-white shadow-xl bg-white"
                />
              {% else %}
                <div class="w-28 h-28 sm:w-36 sm:h-36 rounded-3xl bg-gradient-to-br from-[#0072BC] to-[#003366] text-white flex items-center justify-center font-black text-4xl ring-4 ring-white shadow-xl">
                  {{ club.name|slice:":1" }}
                </div>
              {% endif %}
              <div class="absolute -bottom-2 -right-2 w-8 h-8 rounded-full bg-[#00A859] border-2 border-white flex items-center justify-center text-white shadow" title="Đang hoạt động sôi nổi">
                <span class="material-symbols-outlined text-[16px]">check</span>
              </div>
            </div>

            <!-- Title và slogan -->
            <div class="flex flex-col gap-1.5 pt-2">
              <div class="flex flex-wrap items-center gap-2">
                <span class="text-xs font-bold text-[#0072BC] uppercase tracking-wider flex items-center gap-1">
                  <span class="material-symbols-outlined text-[15px]">apartment</span>
                  <span>{{ club.faculty_name }}</span>
                </span>
                {% if club.founded %}
                  <span class="text-slate-300">•</span>
                  <span class="text-xs font-medium text-slate-500">Thành lập: {{ club.founded }}</span>
                {% endif %}
              </div>

              <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[#003366] tracking-tight font-display-hero">
                {{ club.name }}
              </h1>

              {% if club.slogan %}
                <p class="text-sm sm:text-base font-semibold text-[#fd761a] italic flex items-center gap-1.5">
                  <span class="material-symbols-outlined text-[18px]">format_quote</span>
                  <span>“{{ club.slogan }}”</span>
                </p>
              {% endif %}
            </div>
          </div>

          <!-- CTAs -->
          <div class="flex flex-wrap items-center gap-3 w-full lg:w-auto shrink-0">
            {% if club.contact and club.contact.facebook %}
              <a
                href="{{ club.contact.facebook }}"
                target="_blank"
                rel="noopener noreferrer"
                class="flex-1 lg:flex-initial inline-flex items-center justify-center gap-2 px-5 py-3 rounded-2xl bg-[#1877F2] hover:bg-[#166fe5] text-white text-sm font-bold shadow-md hover:shadow-lg transition-all"
              >
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                <span>Fanpage CLB</span>
                <span class="material-symbols-outlined text-[16px]">open_in_new</span>
              </a>
            {% endif %}

            <a
              href="#ung-tuyen"
              class="flex-1 lg:flex-initial inline-flex items-center justify-center gap-2 px-6 py-3 rounded-2xl bg-[#fd761a] hover:bg-[#e0610f] text-white text-sm font-bold shadow-md hover:shadow-lg transition-all"
            >
              <span class="material-symbols-outlined text-[18px]">how_to_reg</span>
              <span>Đăng ký tham gia</span>
            </a>
          </div>
        </div>

        <!-- Quick Stats Bar -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-8 pt-6 border-t border-slate-100">
          <div class="p-3.5 rounded-2xl bg-[#f0f4f9]/80 border border-slate-100 flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-[#0072BC]/10 text-[#0072BC] flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-[20px]">groups</span>
            </div>
            <div>
              <p class="text-[11px] font-semibold text-slate-500 uppercase tracking-wide">Người theo dõi</p>
              <p class="text-base sm:text-lg font-bold text-[#003366]">{{ club.followers|default:"10K+" }}</p>
            </div>
          </div>

          <div class="p-3.5 rounded-2xl bg-[#f0f4f9]/80 border border-slate-100 flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-orange-500/10 text-orange-600 flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-[20px]">account_tree</span>
            </div>
            <div>
              <p class="text-[11px] font-semibold text-slate-500 uppercase tracking-wide">Ban chức năng</p>
              <p class="text-base sm:text-lg font-bold text-[#003366]">{{ club.departments|length|default:"4" }} Ban trực thuộc</p>
            </div>
          </div>

          <div class="p-3.5 rounded-2xl bg-[#f0f4f9]/80 border border-slate-100 flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-green-500/10 text-green-600 flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-[20px]">event_available</span>
            </div>
            <div>
              <p class="text-[11px] font-semibold text-slate-500 uppercase tracking-wide">Tuyển thành viên</p>
              <p class="text-xs sm:text-sm font-bold text-[#00A859] truncate">{{ club.recruitment|default:"Tháng 8 - 10" }}</p>
            </div>
          </div>

          <div class="p-3.5 rounded-2xl bg-[#f0f4f9]/80 border border-slate-100 flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-purple-500/10 text-purple-600 flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-[20px]">military_tech</span>
            </div>
            <div>
              <p class="text-[11px] font-semibold text-slate-500 uppercase tracking-wide">Cấp quản lý</p>
              <p class="text-xs sm:text-sm font-bold text-[#003366] truncate">{{ club.level }}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Sticky In-Page Navigation Bar -->
  <div class="sticky top-20 z-30 max-w-7xl mx-auto px-6 lg:px-12 mb-8">
    <div class="bg-white/95 backdrop-blur-md rounded-2xl border border-slate-200/90 shadow-sm p-1.5 flex items-center gap-1 overflow-x-auto">
      <a href="#tong-quan" class="px-4 py-2 rounded-xl text-xs sm:text-sm font-bold text-slate-700 hover:text-[#0072BC] hover:bg-slate-100 whitespace-nowrap transition-colors flex items-center gap-1.5">
        <span class="material-symbols-outlined text-[16px]">info</span>
        <span>Tổng quan</span>
      </a>
      <a href="#co-cau" class="px-4 py-2 rounded-xl text-xs sm:text-sm font-bold text-slate-700 hover:text-[#0072BC] hover:bg-slate-100 whitespace-nowrap transition-colors flex items-center gap-1.5">
        <span class="material-symbols-outlined text-[16px]">account_tree</span>
        <span>Cơ cấu Ban</span>
      </a>
      <a href="#hoat-dong" class="px-4 py-2 rounded-xl text-xs sm:text-sm font-bold text-slate-700 hover:text-[#0072BC] hover:bg-slate-100 whitespace-nowrap transition-colors flex items-center gap-1.5">
        <span class="material-symbols-outlined text-[16px]">star</span>
        <span>Hoạt động và sự kiện</span>
      </a>
      <a href="#hinh-anh" class="px-4 py-2 rounded-xl text-xs sm:text-sm font-bold text-slate-700 hover:text-[#0072BC] hover:bg-slate-100 whitespace-nowrap transition-colors flex items-center gap-1.5">
        <span class="material-symbols-outlined text-[16px]">photo_library</span>
        <span>Hình ảnh thực tế</span>
      </a>
      <a href="#thanh-tich" class="px-4 py-2 rounded-xl text-xs sm:text-sm font-bold text-slate-700 hover:text-[#0072BC] hover:bg-slate-100 whitespace-nowrap transition-colors flex items-center gap-1.5">
        <span class="material-symbols-outlined text-[16px]">military_tech</span>
        <span>Thành tích</span>
      </a>
      <a href="#ung-tuyen" class="px-4 py-2 rounded-xl text-xs sm:text-sm font-bold text-white bg-[#0072BC] hover:bg-[#005a96] whitespace-nowrap transition-colors flex items-center gap-1.5 shadow-sm">
        <span class="material-symbols-outlined text-[16px]">how_to_reg</span>
        <span>Tuyển thành viên</span>
      </a>
      <a href="#lien-he" class="px-4 py-2 rounded-xl text-xs sm:text-sm font-bold text-slate-700 hover:text-[#0072BC] hover:bg-slate-100 whitespace-nowrap transition-colors flex items-center gap-1.5">
        <span class="material-symbols-outlined text-[16px]">contact_phone</span>
        <span>Liên hệ</span>
      </a>
    </div>
  </div>

  <!-- Main Content Grid -->
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

      <!-- ================= LEFT COLUMN (8 cols) ================= -->
      <div class="lg:col-span-8 flex flex-col gap-8">

        <!-- 1. TỔNG QUAN và SỨ MỆNH -->
        <section id="tong-quan" class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/90 shadow-sm scroll-mt-36">
          <div class="flex items-center gap-3 mb-5 pb-4 border-b border-slate-100">
            <div class="w-10 h-10 rounded-2xl bg-[#0072BC]/10 text-[#0072BC] flex items-center justify-center">
              <span class="material-symbols-outlined text-[22px]">info</span>
            </div>
            <div>
              <h2 class="text-xl font-bold text-[#003366]">Giới thiệu và sứ mệnh phát triển</h2>
              <p class="text-xs text-slate-400">Lịch sử, tôn chỉ và định hướng hoạt động</p>
            </div>
          </div>

          <!-- Highlight Intro Quote -->
          {% if club.intro %}
            <div class="p-5 rounded-2xl bg-gradient-to-r from-blue-50/70 to-indigo-50/70 border border-blue-200/60 mb-6 relative">
              <span class="material-symbols-outlined text-blue-300 text-[36px] absolute top-3 right-4 select-none">format_quote</span>
              <p class="text-sm sm:text-base font-medium text-blue-900 leading-relaxed pr-8">
                {{ club.intro }}
              </p>
            </div>
          {% endif %}

          <!-- Full Description -->
          <div class="prose prose-slate max-w-none text-sm sm:text-base text-slate-700 leading-relaxed mb-6">
            <p>{{ club.description }}</p>
          </div>

          <!-- Mission và vision Cards -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
            {% if club.mission %}
              <div class="p-5 rounded-2xl bg-[#f8fafc] border border-slate-200/80 hover:border-blue-300 transition-all">
                <div class="flex items-center gap-2 mb-2 text-[#0072BC] font-bold text-sm">
                  <span class="material-symbols-outlined text-[20px]">flag</span>
                  <span>Sứ mệnh (Mission)</span>
                </div>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                  {{ club.mission }}
                </p>
              </div>
            {% endif %}

            {% if club.vision %}
              <div class="p-5 rounded-2xl bg-[#f8fafc] border border-slate-200/80 hover:border-orange-300 transition-all">
                <div class="flex items-center gap-2 mb-2 text-[#fd761a] font-bold text-sm">
                  <span class="material-symbols-outlined text-[20px]">visibility</span>
                  <span>Tầm nhìn (Vision)</span>
                </div>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                  {{ club.vision }}
                </p>
              </div>
            {% endif %}
          </div>
        </section>

        <!-- 2. CƠ CẤU CÁC BAN CHỨC NĂNG -->
        <section id="co-cau" class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/90 shadow-sm scroll-mt-36">
          <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100">
            <div class="w-10 h-10 rounded-2xl bg-[#fd761a]/10 text-[#fd761a] flex items-center justify-center">
              <span class="material-symbols-outlined text-[22px]">account_tree</span>
            </div>
            <div>
              <h2 class="text-xl font-bold text-[#003366]">Cơ cấu tổ chức và các Ban chuyên môn</h2>
              <p class="text-xs text-slate-400">Khám phá vị trí phù hợp với thế mạnh của bạn</p>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {% if club.departments %}
              {% for d in club.departments %}
                <div class="p-5 rounded-2xl bg-white border border-slate-200/90 hover:border-[#0072BC] hover:shadow-md transition-all flex flex-col justify-between group">
                  <div>
                    <div class="flex items-center gap-3 mb-3">
                      <div class="w-9 h-9 rounded-xl bg-blue-50 text-[#0072BC] group-hover:bg-[#0072BC] group-hover:text-white transition-colors flex items-center justify-center font-bold text-sm">
                        {{ forloop.counter }}
                      </div>
                      <h3 class="font-bold text-slate-900 text-sm sm:text-base group-hover:text-[#0072BC] transition-colors">
                        {{ d.name }}
                      </h3>
                    </div>
                    <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                      {{ d.desc }}
                    </p>
                  </div>
                  <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-[11px] font-semibold text-slate-400">
                    <span>Tuyển Gen mới hằng năm</span>
                    <span class="material-symbols-outlined text-[16px] text-slate-300 group-hover:text-[#0072BC] transition-colors">arrow_forward</span>
                  </div>
                </div>
              {% endfor %}
            {% else %}
              <div class="col-span-2 text-center py-8 text-slate-400 text-sm">
                Đang cập nhật danh sách các ban chuyên môn của CLB.
              </div>
            {% endif %}
          </div>
        </section>

        <!-- 3. HOẠT ĐỘNG và SỰ KIỆN NỔI BẬT -->
        <section id="hoat-dong" class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/90 shadow-sm scroll-mt-36">
          <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100">
            <div class="w-10 h-10 rounded-2xl bg-green-500/10 text-[#00A859] flex items-center justify-center">
              <span class="material-symbols-outlined text-[22px]">star</span>
            </div>
            <div>
              <h2 class="text-xl font-bold text-[#003366]">Hoạt động và dấu ấn tiêu biểu</h2>
              <p class="text-xs text-slate-400">Các cuộc thi, hội thảo và chương trình thường niên</p>
            </div>
          </div>

          <!-- Major Highlights -->
          <div class="mb-6">
            <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3 flex items-center gap-1.5">
              <span class="material-symbols-outlined text-[16px] text-amber-500">campaign</span>
              <span>Chương trình mũi nhọn / Sự kiện lớn</span>
            </h3>
            <div class="space-y-3">
              {% if club.highlights %}
                {% for hl in club.highlights %}
                  <div class="p-4 rounded-2xl bg-[#f8fafc] border border-slate-200/80 flex items-start gap-3.5 hover:bg-white hover:border-blue-200 transition-all">
                    <div class="w-8 h-8 rounded-xl bg-amber-500/10 text-amber-600 flex items-center justify-center shrink-0 mt-0.5">
                      <span class="material-symbols-outlined text-[18px]">workspace_premium</span>
                    </div>
                    <div class="flex-1 text-xs sm:text-sm font-semibold text-slate-800 leading-relaxed">
                      {{ hl }}
                    </div>
                  </div>
                {% endfor %}
              {% endif %}
            </div>
          </div>

          <!-- Recent activities -->
          {% if club.recent_activities %}
            <div class="pt-2">
              <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3 flex items-center gap-1.5">
                <span class="material-symbols-outlined text-[16px] text-[#0072BC]">history_edu</span>
                <span>Hoạt động gần đây</span>
              </h3>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                {% for act in club.recent_activities %}
                  <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200/70 text-xs text-slate-700 flex items-center gap-2.5">
                    <span class="w-2 h-2 rounded-full bg-[#0072BC] shrink-0"></span>
                    <span class="font-medium">{{ act }}</span>
                  </div>
                {% endfor %}
              </div>
            </div>
          {% endif %}
        </section>

        <!-- 4. THƯ VIỆN HÌNH ẢNH THỰC TẾ -->
        <section id="hinh-anh" class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/90 shadow-sm scroll-mt-36">
          <div class="flex items-center justify-between mb-6 pb-4 border-b border-slate-100">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-2xl bg-purple-500/10 text-purple-600 flex items-center justify-center">
                <span class="material-symbols-outlined text-[22px]">photo_library</span>
              </div>
              <div>
                <h2 class="text-xl font-bold text-[#003366]">Thư viện khoảnh khắc hoạt động</h2>
                <p class="text-xs text-slate-400">Hình ảnh các chương trình, workshop và sinh hoạt của CLB</p>
              </div>
            </div>
            <span class="text-xs font-bold px-3 py-1 rounded-full bg-purple-50 text-purple-700 border border-purple-200/60">
              {{ club.gallery|length|default:"4" }} hình ảnh
            </span>
          </div>

          <!-- Photo Gallery Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {% if club.gallery %}
              {% for g in club.gallery %}
                <div class="group relative rounded-2xl overflow-hidden bg-slate-100 border border-slate-200 aspect-[16/10] shadow-sm">
                  <img
                    src="{{ g.url }}"
                    alt="{{ g.caption|default:club.name }}"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-90 sm:opacity-0 sm:group-hover:opacity-100 transition-opacity flex flex-col justify-end p-4">
                    <p class="text-white text-xs sm:text-sm font-semibold leading-snug drop-shadow-sm">
                      {{ g.caption }}
                    </p>
                    <span class="text-[11px] text-white/70 mt-1 flex items-center gap-1">
                      <span class="material-symbols-outlined text-[13px]">photo_camera</span>
                      <span>Hoạt động CLB</span>
                    </span>
                  </div>
                </div>
              {% endfor %}
            {% else %}
              <div class="col-span-2 text-center py-10 text-slate-400 text-sm">
                Đang cập nhật hình ảnh hoạt động của CLB.
              </div>
            {% endif %}
          </div>
        </section>

        <!-- 5. THÀNH TÍCH ĐẠT ĐƯỢC -->
        {% if club.achievements %}
          <section id="thanh-tich" class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/90 shadow-sm scroll-mt-36">
            <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100">
              <div class="w-10 h-10 rounded-2xl bg-amber-500/10 text-amber-600 flex items-center justify-center">
                <span class="material-symbols-outlined text-[22px]">military_tech</span>
              </div>
              <div>
                <h2 class="text-xl font-bold text-[#003366]">Thành tích và bằng khen</h2>
                <p class="text-xs text-slate-400">Những dấu ấn và giải thưởng được ghi nhận</p>
              </div>
            </div>

            <div class="space-y-3">
              {% for ach in club.achievements %}
                <div class="p-4 rounded-2xl bg-amber-50/50 border border-amber-200/60 flex items-start gap-3.5">
                  <div class="w-8 h-8 rounded-xl bg-amber-500 text-white flex items-center justify-center shrink-0 shadow-sm">
                    <span class="material-symbols-outlined text-[18px]">trophy</span>
                  </div>
                  <p class="text-xs sm:text-sm font-semibold text-amber-950 leading-relaxed pt-1">
                    {{ ach }}
                  </p>
                </div>
              {% endfor %}
            </div>
          </section>
        {% endif %}

        <!-- 6. QUY TRÌNH ỨNG TUYỂN GEN MỚI và QUYỀN LỢI -->
        <section id="ung-tuyen" class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/90 shadow-sm scroll-mt-36">
          <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100">
            <div class="w-10 h-10 rounded-2xl bg-[#fd761a]/10 text-[#fd761a] flex items-center justify-center">
              <span class="material-symbols-outlined text-[22px]">how_to_reg</span>
            </div>
            <div>
              <h2 class="text-xl font-bold text-[#003366]">Tuyển thành viên Gen mới</h2>
              <p class="text-xs text-slate-400">Quy trình ứng tuyển và quyền lợi dành cho thành viên</p>
            </div>
          </div>

          <!-- Recruitment Alert Card -->
          <div class="p-5 rounded-2xl bg-gradient-to-r from-orange-50 to-amber-50 border border-orange-200/80 mb-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div class="flex items-center gap-3">
              <span class="w-3 h-3 rounded-full bg-orange-500 animate-ping"></span>
              <div>
                <p class="text-xs font-bold text-orange-800 uppercase tracking-wide">Thời gian tuyển quân</p>
                <p class="text-sm sm:text-base font-extrabold text-orange-950">{{ club.recruitment|default:"Mở đơn định kỳ tháng 8 - tháng 10" }}</p>
              </div>
            </div>
            {% if club.contact and club.contact.facebook %}
              <a
                href="{{ club.contact.facebook }}"
                target="_blank"
                rel="noopener noreferrer"
                class="px-5 py-2.5 rounded-xl bg-[#fd761a] hover:bg-[#e0610f] text-white text-xs font-bold shadow transition-all whitespace-nowrap"
              >
                Nhận thông báo mở đơn
              </a>
            {% endif %}
          </div>

          <!-- 4-step recruitment funnel -->
          {% if club.recruitment_steps %}
            <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-4">Các vòng ứng tuyển</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 mb-8">
              {% for step in club.recruitment_steps %}
                <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/80 flex flex-col justify-between">
                  <div>
                    <span class="inline-block px-2.5 py-0.5 rounded-full text-[11px] font-black bg-[#0072BC] text-white mb-2">
                      {{ step.step }}
                    </span>
                    <h4 class="font-bold text-slate-900 text-xs sm:text-sm mb-1.5">{{ step.title }}</h4>
                    <p class="text-[12px] text-slate-600 leading-relaxed">{{ step.desc }}</p>
                  </div>
                </div>
              {% endfor %}
            </div>
          {% endif %}

          <!-- Member Benefits -->
          {% if club.benefits %}
            <div class="pt-2">
              <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3 flex items-center gap-1.5">
                <span class="material-symbols-outlined text-[16px] text-green-600">redeem</span>
                <span>Quyền lợi khi trở thành thành viên chính thức</span>
              </h3>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                {% for b in club.benefits %}
                  <div class="p-3.5 rounded-xl bg-green-50/60 border border-green-200/70 text-xs sm:text-sm text-green-950 flex items-start gap-2.5">
                    <span class="material-symbols-outlined text-[18px] text-green-600 shrink-0 mt-0.5">check_circle</span>
                    <span class="font-medium leading-relaxed">{{ b }}</span>
                  </div>
                {% endfor %}
              </div>
            </div>
          {% endif %}

          <!-- FORM ỨNG TUYỂN THÀNH VIÊN TRỰC TUYẾN -->
          <div class="mt-8 pt-6 border-t border-slate-100">
            <div class="p-6 rounded-3xl bg-gradient-to-br from-slate-50 to-orange-50/40 border border-orange-100 shadow-sm">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 rounded-2xl bg-[#fd761a] text-white flex items-center justify-center font-bold shadow-sm">
                  <span class="material-symbols-outlined text-[22px]">edit_document</span>
                </div>
                <div>
                  <h3 class="text-base sm:text-lg font-bold text-[#003366]">Đơn Đăng Ký Ứng Tuyển Online</h3>
                  <p class="text-xs text-slate-500">Điền thông tin ứng tuyển vào {{ club.name }} - Gen mới 2026</p>
                </div>
              </div>

              <form id="clb-apply-form" onsubmit="handleClbApplySubmit(event)" class="space-y-4">
                <input type="hidden" id="clb_slug" value="{{ club.id }}">

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Họ và tên <span class="text-red-500">*</span></label>
                    <input type="text" id="clb_ho_ten" required placeholder="Ví dụ: Nguyễn Văn A" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs sm:text-sm focus:border-[#fd761a] focus:ring-1 focus:ring-[#fd761a] outline-none bg-white">
                  </div>
                  <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Số điện thoại <span class="text-red-500">*</span></label>
                    <input type="tel" id="clb_sdt" required placeholder="0905 xxx xxx" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs sm:text-sm focus:border-[#fd761a] focus:ring-1 focus:ring-[#fd761a] outline-none bg-white">
                  </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Email <span class="text-red-500">*</span></label>
                    <input type="email" id="clb_email" required placeholder="email@gmail.com" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs sm:text-sm focus:border-[#fd761a] focus:ring-1 focus:ring-[#fd761a] outline-none bg-white">
                  </div>
                  <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Mã sinh viên / Khóa - Lớp (hoặc Trường THPT)</label>
                    <input type="text" id="clb_khoa_lop" placeholder="VD: 51K15.2 hoặc THPT Phan Châu Trinh" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs sm:text-sm focus:border-[#fd761a] focus:ring-1 focus:ring-[#fd761a] outline-none bg-white">
                  </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Ban nguyện vọng ứng tuyển</label>
                    <select id="clb_ban" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs sm:text-sm bg-white focus:border-[#fd761a] focus:ring-1 focus:ring-[#fd761a] outline-none">
                      <option value="Thành viên chung">-- Chọn ban chuyên môn --</option>
                      {% for dept in club.departments %}
                        <option value="{{ dept.name }}">{{ dept.name }}</option>
                      {% endfor %}
                    </select>
                  </div>
                  <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Link Facebook cá nhân</label>
                    <input type="url" id="clb_fb" placeholder="https://facebook.com/..." class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs sm:text-sm focus:border-[#fd761a] focus:ring-1 focus:ring-[#fd761a] outline-none bg-white">
                  </div>
                </div>

                <div>
                  <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Sở trường / Năng khiếu nổi bật</label>
                  <input type="text" id="clb_so_truong" placeholder="VD: Thiết kế Canva/Photoshop, MC dẫn chương trình, Hậu cần, Nhảy, Đàn guitar..." class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs sm:text-sm focus:border-[#fd761a] focus:ring-1 focus:ring-[#fd761a] outline-none bg-white">
                </div>

                <div>
                  <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Lý do bạn muốn tham gia {{ club.name }}? <span class="text-red-500">*</span></label>
                  <textarea id="clb_ly_do" rows="3" required placeholder="Chia sẻ đôi nét về mục tiêu và mong muốn gắn bó cùng CLB..." class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs sm:text-sm focus:border-[#fd761a] focus:ring-1 focus:ring-[#fd761a] outline-none bg-white"></textarea>
                </div>

                <div id="clb-apply-msg" class="hidden p-3.5 rounded-xl text-xs sm:text-sm font-semibold"></div>

                <div class="flex items-center justify-end gap-3 pt-2">
                  <button type="submit" id="clb-apply-btn" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-2xl bg-[#fd761a] hover:bg-[#e0610f] text-white text-xs sm:text-sm font-bold shadow-md hover:shadow-lg transition-all">
                    <span class="material-symbols-outlined text-[18px]">send</span>
                    <span>Gửi Đơn Ứng Tuyển</span>
                  </button>
                </div>
              </form>
            </div>
          </div>
        </section>

      </div>

      <!-- ================= RIGHT COLUMN / SIDEBAR (4 cols) ================= -->
      <aside class="lg:col-span-4 flex flex-col gap-6 lg:sticky lg:top-36">

        <!-- Widget 1: Thông tin liên hệ nhanh -->
        <div id="lien-he" class="bg-white rounded-3xl p-6 border border-slate-200/90 shadow-sm scroll-mt-36">
          <h3 class="text-base font-bold text-[#003366] pb-3 mb-4 border-b border-slate-100 flex items-center gap-2">
            <span class="material-symbols-outlined text-[20px] text-[#0072BC]">contact_page</span>
            <span>Kênh liên hệ chính thức</span>
          </h3>

          <div class="space-y-3.5 text-xs sm:text-sm">
            {% if club.contact and club.contact.facebook %}
              <a
                href="{{ club.contact.facebook }}"
                target="_blank"
                rel="noopener noreferrer"
                class="p-3 rounded-2xl bg-blue-50/70 hover:bg-blue-100 border border-blue-200/60 text-[#1877F2] font-bold flex items-center justify-between transition-colors"
              >
                <div class="flex items-center gap-2.5 truncate">
                  <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                  <span class="truncate">Fanpage CLB</span>
                </div>
                <span class="material-symbols-outlined text-[16px]">open_in_new</span>
              </a>
            {% endif %}

            {% if club.contact and club.contact.email %}
              <div class="flex items-start gap-2.5 text-slate-600">
                <span class="material-symbols-outlined text-[18px] text-[#0072BC] shrink-0 mt-0.5">mail</span>
                <div>
                  <span class="text-[11px] text-slate-400 block font-semibold uppercase">Email</span>
                  <a href="mailto:{{ club.contact.email }}" class="text-[#0072BC] hover:underline font-semibold break-all">{{ club.contact.email }}</a>
                </div>
              </div>
            {% endif %}

            {% if club.contact and club.contact.phone %}
              <div class="flex items-start gap-2.5 text-slate-600">
                <span class="material-symbols-outlined text-[18px] text-[#0072BC] shrink-0 mt-0.5">call</span>
                <div>
                  <span class="text-[11px] text-slate-400 block font-semibold uppercase">Hotline / Ban liên lạc</span>
                  <span class="font-semibold text-slate-800">{{ club.contact.phone }}</span>
                </div>
              </div>
            {% endif %}

            <div class="flex items-start gap-2.5 text-slate-600">
              <span class="material-symbols-outlined text-[18px] text-[#0072BC] shrink-0 mt-0.5">location_on</span>
              <div>
                <span class="text-[11px] text-slate-400 block font-semibold uppercase">Trụ sở / Văn phòng</span>
                <span class="font-medium text-slate-700">{{ club.contact.address|default:"71 Ngũ Hành Sơn, Q. Ngũ Hành Sơn, TP. Đà Nẵng (Văn phòng Đoàn - Hội DUE)" }}</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Widget 2: Ban Điều Hành và cố Vấn -->
        <div class="bg-white rounded-3xl p-6 border border-slate-200/90 shadow-sm">
          <h3 class="text-base font-bold text-[#003366] pb-3 mb-4 border-b border-slate-100 flex items-center gap-2">
            <span class="material-symbols-outlined text-[20px] text-[#fd761a]">badge</span>
            <span>Ban Điều Hành và cố Vấn</span>
          </h3>

          <div class="space-y-4 text-xs sm:text-sm">
            {% if club.leaders %}
              <div>
                <span class="text-[11px] text-slate-400 block font-semibold uppercase mb-1">Ban Chủ nhiệm nhiệm kỳ</span>
                <p class="font-bold text-slate-800 leading-snug">{{ club.leaders }}</p>
              </div>
            {% endif %}

            {% if club.advisors %}
              <div class="pt-3 border-t border-slate-100">
                <span class="text-[11px] text-slate-400 block font-semibold uppercase mb-1">Cố vấn chuyên môn</span>
                <p class="font-medium text-slate-700 leading-snug">{{ club.advisors }}</p>
              </div>
            {% endif %}
          </div>
        </div>

        <!-- Widget 3: Các câu lạc bộ liên quan -->
        {% if related_clubs %}
          <div class="bg-white rounded-3xl p-6 border border-slate-200/90 shadow-sm">
            <h3 class="text-base font-bold text-[#003366] pb-3 mb-4 border-b border-slate-100 flex items-center justify-between">
              <span class="flex items-center gap-2">
                <span class="material-symbols-outlined text-[20px] text-[#0072BC]">diversity_3</span>
                <span>CLB cùng nhóm lĩnh vực</span>
              </span>
              <a href="/clb/" class="text-xs font-bold text-[#0072BC] hover:underline">Xem tất cả</a>
            </h3>

            <div class="space-y-3">
              {% for rc in related_clubs %}
                <a
                  href="/clb/{{ rc.id }}/"
                  class="p-3 rounded-2xl bg-slate-50 hover:bg-blue-50/60 border border-slate-200/70 hover:border-blue-200 transition-all flex items-center gap-3 group"
                >
                  {% if rc.logo_url %}
                    <img src="{{ rc.logo_url }}" alt="Logo {{ rc.name }}" class="w-11 h-11 rounded-xl object-cover shrink-0 bg-white shadow-xs">
                  {% else %}
                    <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-[#0072BC] to-[#003366] text-white flex items-center justify-center font-bold text-base shrink-0">
                      {{ rc.name|slice:":1" }}
                    </div>
                  {% endif %}
                  <div class="flex-1 min-w-0">
                    <p class="text-xs font-bold text-slate-900 group-hover:text-[#0072BC] transition-colors truncate">
                      {{ rc.name }}
                    </p>
                    <p class="text-[11px] text-slate-500 truncate">{{ rc.category }} • {{ rc.level }}</p>
                  </div>
                  <span class="material-symbols-outlined text-slate-300 group-hover:text-[#0072BC] text-[18px] transition-colors">chevron_right</span>
                </a>
              {% endfor %}
            </div>
          </div>
        {% endif %}

        <!-- Widget 4: Nút quay lại -->
        <div>
          <a
            href="/clb/"
            class="w-full inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-2xl bg-white hover:bg-slate-50 border border-slate-300 text-slate-700 text-sm font-bold shadow-xs hover:shadow transition-all"
          >
            <span class="material-symbols-outlined text-[18px]">arrow_back</span>
            <span>Khám phá các CLB khác</span>
          </a>
        </div>

      </aside>

    </div>
  </div>

</main>
<script>
function handleClbApplySubmit(e) {
  e.preventDefault();
  var btn = document.getElementById('clb-apply-btn');
  var msg = document.getElementById('clb-apply-msg');
  var slug = document.getElementById('clb_slug').value;
  var hoTen = document.getElementById('clb_ho_ten').value.trim();
  var sdt = document.getElementById('clb_sdt').value.trim();
  var email = document.getElementById('clb_email').value.trim();
  var khoaLop = document.getElementById('clb_khoa_lop').value.trim();
  var ban = document.getElementById('clb_ban').value;
  var fb = document.getElementById('clb_fb').value.trim();
  var soTruong = document.getElementById('clb_so_truong').value.trim();
  var lyDo = document.getElementById('clb_ly_do').value.trim();

  btn.disabled = true;
  btn.innerHTML = '<span>Đang gửi đơn...</span>';

  fetch('/api/clb/dang-ky/', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'X-Requested-With': 'XMLHttpRequest'
    },
    body: JSON.stringify({
      clb_slug: slug,
      ho_ten: hoTen,
      so_dien_thoai: sdt,
      email: email,
      khoa_lop: khoaLop,
      ban_ung_tuyen: ban,
      facebook_link: fb,
      kinh_nghiem: soTruong,
      ly_do_ung_tuyen: lyDo
    })
  })
  .then(function(res) { return res.json(); })
  .then(function(data) {
    btn.disabled = false;
    btn.innerHTML = '<span class="material-symbols-outlined text-[18px]">send</span><span>Gửi Đơn Ứng Tuyển</span>';
    msg.className = 'p-3.5 rounded-xl text-xs sm:text-sm font-semibold border';
    if (data.status === 'success') {
      msg.classList.add('bg-emerald-50', 'text-emerald-800', 'border-emerald-200');
      msg.textContent = data.message;
      document.getElementById('clb-apply-form').reset();
    } else {
      msg.classList.add('bg-red-50', 'text-red-700', 'border-red-200');
      msg.textContent = data.message || 'Đã có lỗi xảy ra. Vui lòng thử lại!';
    }
  })
  .catch(function(err) {
    btn.disabled = false;
    btn.innerHTML = '<span class="material-symbols-outlined text-[18px]">send</span><span>Gửi Đơn Ứng Tuyển</span>';
    msg.className = 'p-3.5 rounded-xl text-xs sm:text-sm font-semibold border bg-red-50 text-red-700 border-red-200';
    msg.textContent = 'Lỗi kết nối máy chủ. Vui lòng kiểm tra lại!';
  });
}
</script>
{% endblock %}



--- FILE: CongthongtintuyensinhDUE/templates/portal/components/enrollment_guide_content.html ---
