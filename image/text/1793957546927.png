              <a href="/khoa/" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-primary-container hover:bg-primary text-white text-sm font-semibold transition-all shadow-md shrink-0">
                <span>Xem tất cả 9 Khoa và phòng ban</span>
                <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
              </a>
            </div>

            <!-- Grid 6 Khoa nổi bật trên trang chủ (Dẫn thẳng sang trang chi tiết) -->
            <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
              <a href="/khoa/tcnh/" class="p-4 rounded-2xl border border-slate-200/70 bg-white hover:border-blue-400 hover:shadow-md transition-all flex items-center justify-between gap-3 group">
                <div class="flex items-center gap-3 min-w-0">
                  <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0 text-blue-600 bg-blue-50 border border-blue-100 group-hover:bg-blue-600 group-hover:text-white transition-colors">
                    <span class="material-symbols-outlined text-[20px]">account_balance</span>
                  </div>
                  <div class="min-w-0">
                    <span class="font-bold text-slate-800 text-sm group-hover:text-blue-900 truncate block">Khoa Tài chính - Ngân hàng</span>
                    <span class="text-[11px] text-slate-500 block truncate">Tài chính, Ngân hàng, Fintech</span>
                  </div>
                </div>
                <span class="material-symbols-outlined text-slate-400 group-hover:text-blue-600 text-[18px] transition-colors shrink-0">chevron_right</span>
              </a>

              <a href="/khoa/dlkdqt/" class="p-4 rounded-2xl border border-slate-200/70 bg-white hover:border-emerald-400 hover:shadow-md transition-all flex items-center justify-between gap-3 group">
                <div class="flex items-center gap-3 min-w-0">
                  <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0 text-emerald-600 bg-emerald-50 border border-emerald-100 group-hover:bg-emerald-600 group-hover:text-white transition-colors">
                    <span class="material-symbols-outlined text-[20px]">travel_explore</span>
                  </div>
                  <div class="min-w-0">
                    <span class="font-bold text-slate-800 text-sm group-hover:text-emerald-900 truncate block">Khoa Du lịch và KD Quốc tế</span>
                    <span class="text-[11px] text-slate-500 block truncate">Kinh doanh quốc tế, Du lịch, Khách sạn</span>
                  </div>
                </div>
                <span class="material-symbols-outlined text-slate-400 group-hover:text-emerald-600 text-[18px] transition-colors shrink-0">chevron_right</span>
              </a>

              <a href="/khoa/tmdt_mkt_cns/" class="p-4 rounded-2xl border border-slate-200/70 bg-white hover:border-orange-400 hover:shadow-md transition-all flex items-center justify-between gap-3 group">
                <div class="flex items-center gap-3 min-w-0">
                  <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0 text-orange-600 bg-orange-50 border border-orange-100 group-hover:bg-orange-600 group-hover:text-white transition-colors">
                    <span class="material-symbols-outlined text-[20px]">hub</span>
                  </div>
                  <div class="min-w-0">
                    <span class="font-bold text-slate-800 text-sm group-hover:text-orange-900 truncate block">Khoa TMĐT - Marketing và CNS</span>
                    <span class="text-[11px] text-slate-500 block truncate">Marketing số, TMĐT, Kinh tế số</span>
                  </div>
                </div>
                <span class="material-symbols-outlined text-slate-400 group-hover:text-orange-600 text-[18px] transition-colors shrink-0">chevron_right</span>
              </a>

              <a href="/khoa/qtkd/" class="p-4 rounded-2xl border border-slate-200/70 bg-white hover:border-amber-400 hover:shadow-md transition-all flex items-center justify-between gap-3 group">
                <div class="flex items-center gap-3 min-w-0">
                  <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0 text-amber-600 bg-amber-50 border border-amber-100 group-hover:bg-amber-600 group-hover:text-white transition-colors">
                    <span class="material-symbols-outlined text-[20px]">corporate_fare</span>
                  </div>
                  <div class="min-w-0">
                    <span class="font-bold text-slate-800 text-sm group-hover:text-amber-900 truncate block">Khoa Quản trị kinh doanh</span>
                    <span class="text-[11px] text-slate-500 block truncate">Quản trị doanh nghiệp, Nhân lực, Chuỗi cung ứng</span>
                  </div>
                </div>
                <span class="material-symbols-outlined text-slate-400 group-hover:text-amber-600 text-[18px] transition-colors shrink-0">chevron_right</span>
              </a>

              <a href="/khoa/ketoan/" class="p-4 rounded-2xl border border-slate-200/70 bg-white hover:border-teal-400 hover:shadow-md transition-all flex items-center justify-between gap-3 group">
                <div class="flex items-center gap-3 min-w-0">
                  <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0 text-teal-600 bg-teal-50 border border-teal-100 group-hover:bg-teal-600 group-hover:text-white transition-colors">
                    <span class="material-symbols-outlined text-[20px]">calculate</span>
                  </div>
                  <div class="min-w-0">
                    <span class="font-bold text-slate-800 text-sm group-hover:text-teal-900 truncate block">Khoa Kế toán</span>
                    <span class="text-[11px] text-slate-500 block truncate">Kế toán doanh nghiệp, Kiểm toán ACCA</span>
                  </div>
                </div>
                <span class="material-symbols-outlined text-slate-400 group-hover:text-teal-600 text-[18px] transition-colors shrink-0">chevron_right</span>
              </a>

              <a href="/khoa/vdtqt/" class="p-4 rounded-2xl border border-slate-200/70 bg-white hover:border-cyan-400 hover:shadow-md transition-all flex items-center justify-between gap-3 group">
                <div class="flex items-center gap-3 min-w-0">
                  <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0 text-cyan-600 bg-cyan-50 border border-cyan-100 group-hover:bg-cyan-600 group-hover:text-white transition-colors">
                    <span class="material-symbols-outlined text-[20px]">public</span>
                  </div>
                  <div class="min-w-0">
                    <span class="font-bold text-slate-800 text-sm group-hover:text-cyan-900 truncate block">Viện Đào tạo Quốc tế</span>
                    <span class="text-[11px] text-slate-500 block truncate">Liên kết Anh, Mỹ, Úc; Cử nhân quốc tế</span>
                  </div>
                </div>
                <span class="material-symbols-outlined text-slate-400 group-hover:text-cyan-600 text-[18px] transition-colors shrink-0">chevron_right</span>
              </a>
            </div>
          </div>
        </section>

        <section id="tin-tuc" class="max-w-7xl mx-auto px-6 lg:px-12 py-16">
          <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10">
            <div>
              <span class="font-label-md text-label-md text-secondary-container uppercase tracking-wider block mb-2">Thông tin mới nhất</span>
              <h2 class="font-headline-lg text-headline-lg text-on-surface tracking-tight">Bản tin tuyển sinh và sự kiện</h2>
            </div>
            <a class="inline-flex items-center gap-2 font-label-lg text-label-lg text-primary-container hover:text-secondary-container transition-colors" href="#">
              <span>Xem tất cả tin tức</span>
              <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
            </a>
          </div>
          <!-- Articles Grid (Dynamic from Database) -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {% for item in tin_tuc_list %}
            <article class="group flex flex-col bg-surface-container-lowest rounded-3xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300">
              <div class="aspect-video w-full overflow-hidden bg-surface-container">
                <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" 
                     src="{{ item.hinh_anh }}" 
                     alt="{{ item.tieu_de }}">
              </div>
              <div class="p-6 flex flex-col flex-1 justify-between">
                <div>
                  <div class="flex items-center justify-between mb-3">
                    <span class="px-2.5 py-1 rounded-full bg-secondary-fixed text-on-secondary-fixed-variant font-label-sm text-label-sm font-semibold">
                      {{ item.get_the_loai_display }}
                    </span>
                    <span class="font-body-sm text-body-sm text-outline">{{ item.ngay_dang|date:"d/m/Y" }}</span>
                  </div>
                  <h3 class="font-headline-sm text-headline-sm text-on-surface group-hover:text-primary-container transition-colors mb-2 leading-snug line-clamp-2">
                    {{ item.tieu_de }}
                  </h3>
                  <p class="font-body-sm text-body-sm text-on-surface-variant line-clamp-2 mb-4 leading-relaxed">
                    {{ item.tom_tat }}
                  </p>
                </div>
                <a class="font-label-md text-label-md text-primary-container group-hover:text-secondary-container flex items-center gap-1.5 transition-colors" href="#">
                  <span>Đọc toàn văn</span>
                  <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
                </a>
              </div>
            </article>
            {% empty %}
            <p class="text-on-surface-variant col-span-3 text-center py-8">Hiện chưa có tin tức tuyển sinh mới.</p>
            {% endfor %}
          </div>
        </section>

      </div>
    </div>
  
        <!-- SECTION: TƯ VẤN và AI CHATBOT (TÍNH NĂNG MỚI TỪ MAIN) -->
        <section class="max-w-7xl mx-auto px-6 lg:px-12 py-10">
          <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-[#003366] via-[#0056b3] to-[#0072BC] text-white p-8 sm:p-12 shadow-xl">
            <div class="absolute -right-10 -bottom-10 w-72 h-72 rounded-full bg-white/10 blur-2xl pointer-events-none"></div>
            <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
              <div class="lg:col-span-8 space-y-4">
                <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight">Băn khoăn chọn ngành? Hãy để DUE đồng hành cùng bạn!</h2>
                <p class="text-white/85 text-sm sm:text-base leading-relaxed max-w-2xl">
                  Khám phá công cụ <strong>Tư vấn chọn ngành thông minh</strong> dựa trên sở thích, năng lực học tập và xu hướng thị trường lao động 2026, hoặc kết nối ngay với <strong>AI Tuyển sinh DUE</strong> để được giải đáp tức thì về học phí, điểm chuẩn và quy chế xét tuyển.
                </p>
              </div>
              <div class="lg:col-span-4 flex flex-col sm:flex-row lg:flex-col gap-3 justify-center">
                <a href="{% url 'admissions:career_advisory' %}" class="inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-full bg-[#f37021] hover:bg-[#e0610f] text-white font-bold text-sm shadow-lg hover:shadow-orange-500/30 transition-all">
                  <span class="material-symbols-outlined text-[20px]">psychology</span>
                  <span>Tư vấn chọn ngành</span>
                </a>
                <a href="/chatbot/" class="inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-full bg-white hover:bg-slate-100 text-[#003366] font-bold text-sm shadow-md transition-all">
                  <span class="material-symbols-outlined text-[20px] text-[#0072BC]">smart_toy</span>
                  <span>Chat ngay với AI DUE</span>
                </a>
              </div>
            </div>
          </div>
        </section>

  </main>
{% endblock %}


--- FILE: CongthongtintuyensinhDUE/templates/admissions/mission_vision.html ---
{% extends 'layouts/base.html' %}
{% load static %}

{% block title %}Sứ Mệnh và tầm nhìn - Trường Đại học Kinh tế, ĐH Đà Nẵng (DUE){% endblock %}

{% block content %}
<!-- Main Content -->
  <main class="w-full pt-32 sm:pt-36 pb-6 bg-surface min-h-[calc(100vh-28rem)] flex-1">
    <!-- Top Ambient Background Glows -->
    <div class="relative w-full overflow-hidden pb-4">
      <div class="absolute -top-40 right-1/4 w-[500px] h-[500px] rounded-full bg-secondary-container/10 blur-[130px] pointer-events-none"></div>
      <div class="absolute top-20 -left-20 w-[420px] h-[420px] rounded-full bg-primary-container/5 blur-[120px] pointer-events-none"></div>

      <!-- Banner Header Section (Căn giữa) -->
      <section class="max-w-7xl mx-auto px-6 lg:px-12 pt-8 pb-12">
        <!-- Breadcrumb -->
        <nav class="flex items-center gap-2 text-xs sm:text-sm text-on-surface-variant mb-6 font-medium">
          <a href="/" class="hover:text-primary-container transition-colors">Trang chủ</a>
          <span class="material-symbols-outlined text-[14px]">chevron_right</span>
          <span>Giới thiệu</span>
          <span class="material-symbols-outlined text-[14px]">chevron_right</span>
          <span class="text-secondary-container font-semibold">Sứ mệnh, tầm nhìn</span>
        </nav>

        <div class="border-b border-outline-variant/30 pb-8 text-center flex flex-col items-center">
          <h1 class="font-display-hero text-3xl sm:text-4xl lg:text-5xl font-bold text-on-surface tracking-tight">
            Sứ mệnh, tầm nhìn và giá trị cốt lõi
          </h1>
          <p class="text-on-surface-variant text-base sm:text-lg max-w-2xl mt-3 leading-relaxed mx-auto">
            Kim chỉ nam định hướng mọi hoạt động đào tạo, nghiên cứu khoa học và kiến tạo giá trị cho cộng đồng của Trường Đại học Kinh tế – Đại học Đà Nẵng.
          </p>
        </div>
      </section>

      <!-- Section: Sứ mệnh và tầm nhìn Cards -->
      <section class="max-w-7xl mx-auto px-6 lg:px-12 py-6">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-stretch">
          
          <!-- Card Sứ mệnh -->
          <div class="rounded-3xl p-8 sm:p-10 bg-gradient-to-br from-primary-container to-primary text-white shadow-xl relative overflow-hidden flex flex-col justify-between group hover:shadow-2xl transition-all">
            <div class="absolute -right-10 -bottom-10 w-52 h-52 rounded-full bg-secondary-container/20 blur-3xl pointer-events-none"></div>
            <div class="relative z-10">
              <div class="w-14 h-14 rounded-2xl bg-white/10 backdrop-blur-md flex items-center justify-center mb-6 border border-white/20">
                <span class="material-symbols-outlined text-[30px] text-secondary-fixed">flag</span>
              </div>
              <h2 class="text-2xl sm:text-3xl font-bold font-headline-sm mb-5 leading-snug">Sứ mệnh của DUE</h2>
              <blockquote class="text-white/90 text-base sm:text-lg leading-relaxed border-l-4 border-secondary-container pl-4 my-2 italic">
                "Chúng tôi kiến tạo môi trường học thuật tiên tiến và nhân văn; thúc đẩy, khám phá, ứng dụng và chuyển giao tri thức gắn với biến đổi số, đổi mới sáng tạo và phát triển bền vững; nâng cao năng lực học tập suốt đời; nuôi dưỡng và phát triển tài năng phục vụ sự phát triển của cộng đồng."
              </blockquote>
            </div>
            <div class="relative z-10 pt-6 mt-6 border-t border-white/10 text-xs text-white/60 flex items-center justify-between">
              <span>Công bố chính thức tại due.udn.vn</span>
              <span class="font-bold text-white/80">Trường Đại học Kinh tế</span>
            </div>
          </div>

          <!-- Card Tầm nhìn -->
          <div class="rounded-3xl p-8 sm:p-10 bg-surface-container-lowest border border-outline-variant/40 shadow-xl flex flex-col justify-between group hover:shadow-2xl transition-all">
            <div>
              <div class="w-14 h-14 rounded-2xl bg-secondary-fixed text-secondary-container flex items-center justify-center mb-6">
                <span class="material-symbols-outlined text-[30px]">visibility</span>
              </div>
              <h2 class="text-2xl sm:text-3xl font-bold font-headline-sm text-on-surface mb-5 leading-snug">Tầm nhìn chiến lược</h2>
              <blockquote class="text-on-surface-variant text-base sm:text-lg leading-relaxed border-l-4 border-secondary-container pl-4 my-2 italic font-medium">
                "Khát vọng của chúng tôi là trở thành trường đại học hàng đầu Việt Nam, đóng góp vào sự thịnh vượng của cộng đồng ASEAN và tri thức nhân loại."
              </blockquote>
              <p class="text-sm text-on-surface-variant/80 mt-4 leading-relaxed">
                Nhà trường hướng đến xây dựng hệ sinh thái đại học thông minh, tiên phong kiểm định quốc tế AUN-QA và mở rộng liên kết với các trường đại học danh tiếng trên toàn cầu.
              </p>
            </div>

            <div class="pt-6 mt-6 border-t border-outline-variant/30 flex items-center justify-between text-xs text-outline">
              <span>Định hướng vươn tầm ASEAN</span>
              <span class="font-bold text-primary-container">Since 1975</span>
            </div>
          </div>

        </div>
      </section>

      <!-- Section: 5 Giá trị cốt lõi chi tiết -->
      <section class="max-w-7xl mx-auto px-6 lg:px-12 py-12">
        <div class="text-center max-w-3xl mx-auto mb-12">
          <span class="text-xs uppercase tracking-wider font-bold text-secondary-container block mb-2">Văn hóa tổ chức</span>
          <h2 class="font-headline-lg text-2xl sm:text-3xl lg:text-4xl font-bold text-on-surface tracking-tight">Hệ thống 5 giá trị cốt lõi</h2>
          <p class="text-on-surface-variant text-sm sm:text-base mt-2">Nền tảng chuẩn mực định hình tư duy, hành động và phong cách của cán bộ, giảng viên và sinh viên DUE</p>
        </div>

        <!-- Hàng trên: 3 thẻ (Chính trực - Xanh ngọc, Hợp tác - Cam đào, Tôn trọng - Xanh lục) -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-6">
          
          <!-- Giá trị 1: Chính trực (Xanh ngọc / Emerald Cyan) -->
          <div class="relative overflow-hidden rounded-3xl p-7 bg-[#f2faf7] border border-[#d2efe5] shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between group">
            <div class="absolute -top-10 -right-10 w-32 h-32 rounded-full bg-[#00a884]/10 blur-2xl pointer-events-none"></div>
            <div class="relative z-10">
              <div class="w-14 h-14 rounded-2xl bg-[#00a884] text-white flex items-center justify-center mb-5 shadow-md shadow-[#00a884]/20 group-hover:scale-105 transition-transform">
                <span class="material-symbols-outlined text-[28px]">verified_user</span>
              </div>
              <h3 class="text-xl font-bold text-slate-800 mb-3 group-hover:text-[#008f6f] transition-colors">1. Chính trực</h3>
              <p class="text-sm text-slate-600 leading-relaxed mb-4">
                Tôn trọng sự thật, đề cao tính minh bạch, sự liêm chính trong học thuật, nghiên cứu khoa học cũng như mọi hoạt động quản trị của Nhà trường.
              </p>
              <ul class="space-y-1.5 text-xs text-slate-500 pt-1">
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#00a884]"></span>
                  <span>Trung thực và khách quan</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#00a884]"></span>
                  <span>Minh bạch trong mọi quy trình</span>
                </li>
              </ul>
            </div>
            <div class="relative z-10 pt-4 mt-5 border-t border-[#d2efe5] text-xs font-bold text-[#008f6f] uppercase tracking-wider">
              Liêm chính học thuật
            </div>
          </div>

          <!-- Giá trị 2: Hợp tác (Cam đào / Warm Orange) -->
          <div class="relative overflow-hidden rounded-3xl p-7 bg-[#fff6f0] border border-[#ffdecb] shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between group">
            <div class="absolute -top-10 -right-10 w-32 h-32 rounded-full bg-[#ea580c]/10 blur-2xl pointer-events-none"></div>
            <div class="relative z-10">
              <div class="w-14 h-14 rounded-2xl bg-[#ea580c] text-white flex items-center justify-center mb-5 shadow-md shadow-[#ea580c]/20 group-hover:scale-105 transition-transform">
                <span class="material-symbols-outlined text-[28px]">groups</span>
              </div>
              <h3 class="text-xl font-bold text-slate-800 mb-3 group-hover:text-[#c2410c] transition-colors">2. Hợp tác</h3>
              <p class="text-sm text-slate-600 leading-relaxed mb-4">
                Đề cao tinh thần làm việc nhóm, chia sẻ tri thức, đồng lòng hỗ trợ lẫn nhau giữa thầy và trò, kết nối chặt chẽ cùng doanh nghiệp và cộng đồng xã hội.
              </p>
              <ul class="space-y-1.5 text-xs text-slate-500 pt-1">
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#ea580c]"></span>
                  <span>Gắn kết thầy trò và đồng nghiệp</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#ea580c]"></span>
                  <span>Đồng hành cùng doanh nghiệp</span>
                </li>
              </ul>
            </div>
            <div class="relative z-10 pt-4 mt-5 border-t border-[#ffdecb] text-xs font-bold text-[#c2410c] uppercase tracking-wider">
              Đoàn kết và đồng hành
            </div>
          </div>

          <!-- Giá trị 3: Tôn trọng (Xanh lá cây / Fresh Green) -->
          <div class="relative overflow-hidden rounded-3xl p-7 bg-[#f3f9f2] border border-[#d8ecd6] shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between group">
            <div class="absolute -top-10 -right-10 w-32 h-32 rounded-full bg-[#16a34a]/10 blur-2xl pointer-events-none"></div>
            <div class="relative z-10">
              <div class="w-14 h-14 rounded-2xl bg-[#16a34a] text-white flex items-center justify-center mb-5 shadow-md shadow-[#16a34a]/20 group-hover:scale-105 transition-transform">
                <span class="material-symbols-outlined text-[28px]">diversity_1</span>
              </div>
              <h3 class="text-xl font-bold text-slate-800 mb-3 group-hover:text-[#15803d] transition-colors">3. Tôn trọng</h3>
              <p class="text-sm text-slate-600 leading-relaxed mb-4">
                Tôn trọng phẩm giá, năng lực cá nhân, lắng nghe đa chiều, chấp nhận sự khác biệt và gìn giữ, bảo vệ môi trường tự nhiên bền vững.
              </p>
              <ul class="space-y-1.5 text-xs text-slate-500 pt-1">
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#16a34a]"></span>
                  <span>Lắng nghe và chấp nhận khác biệt</span>
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#16a34a]"></span>
                  <span>Bảo vệ môi trường tự nhiên</span>
                </li>
              </ul>
            </div>
            <div class="relative z-10 pt-4 mt-5 border-t border-[#d8ecd6] text-xs font-bold text-[#15803d] uppercase tracking-wider">
              Bình đẳng và nhân văn
            </div>
          </div>
        </div>

        <!-- Hàng dưới: 2 thẻ (Cảm thông - Xanh dương và Sáng tạo - Vàng hổ phách) CĂN GIỮA TRANG -->
        <div class="flex justify-center">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 w-full lg:max-w-[calc(66.666667%+0.5rem)]">
            
            <!-- Giá trị 4: Cảm thông (Xanh dương / Deep Sky Blue) -->
            <div class="relative overflow-hidden rounded-3xl p-7 bg-[#f0f6ff] border border-[#cfe2ff] shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between group">
              <div class="absolute -top-10 -right-10 w-32 h-32 rounded-full bg-[#0284c7]/10 blur-2xl pointer-events-none"></div>
              <div class="relative z-10">
                <div class="w-14 h-14 rounded-2xl bg-[#0284c7] text-white flex items-center justify-center mb-5 shadow-md shadow-[#0284c7]/20 group-hover:scale-105 transition-transform">
                  <span class="material-symbols-outlined text-[28px]">volunteer_activism</span>
                </div>
                <h3 class="text-xl font-bold text-slate-800 mb-3 group-hover:text-[#0369a1] transition-colors">4. Cảm thông</h3>
                <p class="text-sm text-slate-600 leading-relaxed mb-4">
                  Thúc đẩy tinh thần sẻ chia, thấu cảm, tinh thần thiện nguyện và trách nhiệm xã hội sâu sắc đối với cộng đồng và người học có hoàn cảnh khó khăn.
                </p>
                <ul class="space-y-1.5 text-xs text-slate-500 pt-1">
                  <li class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#0284c7]"></span>
                    <span>Thấu hiểu và chia sẻ yêu thương</span>
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#0284c7]"></span>
                    <span>Trách nhiệm cao với cộng đồng</span>
                  </li>
                </ul>
              </div>
              <div class="relative z-10 pt-4 mt-5 border-t border-[#cfe2ff] text-xs font-bold text-[#0369a1] uppercase tracking-wider">
                Sẻ chia và trách nhiệm
              </div>
            </div>

            <!-- Giá trị 5: Sáng tạo (Vàng hổ phách / Warm Amber Gold) -->
            <div class="relative overflow-hidden rounded-3xl p-7 bg-[#fef9ee] border border-[#fbe5b5] shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between group">
              <div class="absolute -top-10 -right-10 w-32 h-32 rounded-full bg-[#d97706]/10 blur-2xl pointer-events-none"></div>
              <div class="relative z-10">
                <div class="w-14 h-14 rounded-2xl bg-[#d97706] text-white flex items-center justify-center mb-5 shadow-md shadow-[#d97706]/20 group-hover:scale-105 transition-transform">
                  <span class="material-symbols-outlined text-[28px]">lightbulb</span>
                </div>
                <h3 class="text-xl font-bold text-slate-800 mb-3 group-hover:text-[#b45309] transition-colors">5. Sáng tạo</h3>
                <p class="text-sm text-slate-600 leading-relaxed mb-4">
                  Không ngừng đổi mới, khuyến khích tư duy phản biện, đam mê nghiên cứu khám phá tri thức mới, chủ động ứng dụng công nghệ số và thích ứng nhanh chóng với kỷ nguyên 4.0.
                </p>
                <ul class="space-y-1.5 text-xs text-slate-500 pt-1">
                  <li class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#d97706]"></span>
                    <span>Đổi mới tư duy và phản biện</span>
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#d97706]"></span>
                    <span>Tiên phong ứng dụng công nghệ số</span>
                  </li>
                </ul>
              </div>
              <div class="relative z-10 pt-4 mt-5 border-t border-[#fbe5b5] text-xs font-bold text-[#b45309] uppercase tracking-wider">
                Đột phá và tiên phong
              </div>
            </div>

          </div>
        </div>
      </section>

    </div>
  </main>

  <!-- Footer -->
{% endblock %}


--- FILE: CongthongtintuyensinhDUE/templates/admissions/officer_qa.html ---
{% extends 'layouts/base.html' %}

{% block title %}Trả lời câu hỏi Chatbot - Cán bộ tuyển sinh DUE{% endblock %}

{% block content %}
<main class="w-full pt-32 sm:pt-36 pb-6 bg-surface min-h-[calc(100vh-28rem)] flex-1">
  <div class="max-w-5xl w-full mx-auto px-4 sm:px-6 lg:px-12 py-6">

    <div class="flex flex-wrap items-center justify-between gap-3 mb-5">
      <div>
        <h1 class="font-heading text-xl sm:text-2xl font-bold text-slate-900">Câu hỏi Chatbot chuyển tới cán bộ</h1>
        <p class="text-xs text-slate-500 mt-1">Những câu hỏi không có trong tài liệu sẽ hiện ở đây. Câu trả lời của bạn sẽ hiện ngay trong khung chat của người hỏi.</p>
      </div>
      <div class="flex gap-2 text-xs font-bold">
        <button id="tab-cho" onclick="switchTab('cho')" class="px-3 py-2 rounded-lg bg-[#0072BC] text-white">Đang chờ <span id="count-cho"></span></button>
        <button id="tab-da_tra_loi" onclick="switchTab('da_tra_loi')" class="px-3 py-2 rounded-lg bg-slate-100 text-slate-700">Đã trả lời</button>
      </div>
    </div>

    <div id="list" class="space-y-4"></div>
  </div>
</main>
{% endblock %}

{% block extra_js %}
<script>
  var CSRF_TOKEN = '{{ csrf_token }}';
  var currentTab = 'cho';

  function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
    });
  }

  function switchTab(tab) {
    currentTab = tab;
    ['cho', 'da_tra_loi'].forEach(function (t) {
      document.getElementById('tab-' + t).className = 'px-3 py-2 rounded-lg ' +
        (t === tab ? 'bg-[#0072BC] text-white' : 'bg-slate-100 text-slate-700');
    });
    load();
  }

  async function load() {
    var list = document.getElementById('list');
    try {
      var res = await fetch('/api/can-bo/cau-hoi/?trang_thai=' + currentTab);
      var json = await res.json();
      if (json.status !== 'success') { list.innerHTML = '<p class="text-sm text-red-600">' + esc(json.message) + '</p>'; return; }
      document.getElementById('count-cho').textContent = json.pending_count ? '(' + json.pending_count + ')' : '';
      if (!json.data.length) {
        list.innerHTML = '<div class="p-8 text-center text-sm text-slate-500 bg-white rounded-2xl border border-slate-200">' +
          (currentTab === 'cho' ? 'Không có câu hỏi nào đang chờ.' : 'Chưa có câu hỏi nào được trả lời.') + '</div>';
        return;
      }
      // Không vẽ lại khi cán bộ đang gõ dở
      if (currentTab === 'cho' && document.activeElement && document.activeElement.tagName === 'TEXTAREA') return;
      list.innerHTML = json.data.map(render).join('');
    } catch (e) {
      list.innerHTML = '<p class="text-sm text-red-600">Không tải được danh sách.</p>';
    }
  }

  function render(q) {
    var ctx = q.ngu_canh ? '<details class="mt-2 text-xs text-slate-500"><summary class="cursor-pointer">Xem hội thoại trước đó</summary>' +
      '<pre class="whitespace-pre-wrap font-sans mt-1 p-2 bg-slate-50 rounded">' + esc(q.ngu_canh) + '</pre></details>' : '';
    var head = '<div class="flex justify-between gap-2 text-[11px] text-slate-400 mb-1"><span>#' + q.id + ' • Hỏi lúc ' + esc(q.ngay_tao) + '</span>' +
      (q.da_them_kien_thuc ? '<span class="text-[#00A859] font-bold">Đã thêm vào kho kiến thức</span>' : '') + '</div>';
    var body;
    if (q.trang_thai === 'cho') {
      body = '<textarea id="ans-' + q.id + '" rows="3" class="w-full mt-3 p-3 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#0072BC]" placeholder="Nhập câu trả lời cho thí sinh..."></textarea>' +
        '<div class="flex flex-wrap items-center justify-between gap-2 mt-2">' +
        '<label class="text-xs text-slate-600 flex items-center gap-1.5"><input type="checkbox" id="kb-' + q.id + '" checked> Thêm vào kho kiến thức để Chatbot tự trả lời lần sau</label>' +
        '<button onclick="answer(' + q.id + ')" id="btn-' + q.id + '" class="px-4 py-2 rounded-lg bg-[#00A859] text-white text-xs font-bold">Gửi câu trả lời</button></div>';
    } else {
      body = '<div class="mt-3 p-3 rounded-xl bg-emerald-50 border border-emerald-100 text-sm text-slate-800 whitespace-pre-wrap">' + esc(q.tra_loi) + '</div>' +
        '<p class="text-[11px] text-slate-400 mt-1">' + esc(q.can_bo) + ' • ' + esc(q.ngay_tra_loi) + '</p>';
    }
    return '<div class="p-4 sm:p-5 bg-white rounded-2xl border border-slate-200 shadow-sm">' + head +
      '<p class="text-sm font-semibold text-slate-900 whitespace-pre-wrap">' + esc(q.cau_hoi) + '</p>' + ctx + body + '</div>';
  }

  async function answer(id) {
    var text = document.getElementById('ans-' + id).value.trim();
    if (!text) { document.getElementById('ans-' + id).focus(); return; }
    var btn = document.getElementById('btn-' + id);
    btn.disabled = true; btn.textContent = 'Đang gửi...';
    try {
      var res = await fetch('/api/can-bo/cau-hoi/' + id + '/tra-loi/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRFToken': CSRF_TOKEN },
        body: JSON.stringify({ tra_loi: text, them_kien_thuc: document.getElementById('kb-' + id).checked })
      });
      var json = await res.json();
      if (json.status !== 'success') throw new Error(json.message);
      document.activeElement && document.activeElement.blur();
      load();
    } catch (e) {
      btn.disabled = false; btn.textContent = 'Gửi câu trả lời';
      console.warn(e);
      btn.insertAdjacentHTML('beforebegin', '<span class="text-xs text-red-600">Gửi thất bại: ' + esc(e.message) + '</span>');
    }
  }

  load();
  setInterval(function () { if (currentTab === 'cho') load(); }, 10000);
</script>
{% endblock %}


--- FILE: CongthongtintuyensinhDUE/templates/admissions/training_programs.html ---
{% extends 'layouts/base.html' %}
{% load static %}

{% block title %}Loại Hình Đào Tạo 2026 - Trường Đại học Kinh tế, ĐH Đà Nẵng (DUE){% endblock %}

{% block extra_head %}
<style>
.filter-btn.active {
  background-color: #003366;
  color: #ffffff;
  border-color: #003366;
  box-shadow: 0 4px 14px 0 rgba(0, 51, 102, 0.25);
}

.tab-btn.active {
  background-color: #003366 !important;
  color: #ffffff !important;
  border-color: #003366 !important;
  box-shadow: 0 4px 14px 0 rgba(0, 51, 102, 0.25);
}
.tab-btn.active .tab-badge {
  background-color: #fd761a !important;
  color: #ffffff !important;
}
.tab-content {
  display: none;
}
.tab-content.active {
  display: block;
  animation: fadeIn 0.3s ease-in-out;
}
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(6px); }
  to { opacity: 1; transform: translateY(0); }
}
</style>
{% endblock %}

{% block content %}
<!-- Main Content (pt-36 sm:pt-40 tạo khoảng cách thông thoáng hoàn toàn dưới fixed header) -->
  <main class="w-full pt-32 sm:pt-36 pb-6 bg-surface min-h-[calc(100vh-28rem)] flex-1">
    <!-- Top Glows -->
    <div class="relative w-full overflow-hidden">
      <div class="absolute -top-40 right-1/4 w-[550px] h-[550px] rounded-full bg-secondary-container/10 blur-[130px] pointer-events-none"></div>
      <div class="absolute top-20 -left-20 w-[450px] h-[450px] rounded-full bg-primary-container/10 blur-[120px] pointer-events-none"></div>

      <!-- BREADCRUMB -->
      <div class="max-w-7xl mx-auto px-6 lg:px-12 pt-8 pb-4">
        <nav class="flex items-center gap-2 text-xs sm:text-sm text-on-surface-variant mb-6 font-medium">
        <a class="hover:text-primary-container transition-colors" href="/">Trang chủ</a>
        <span class="material-symbols-outlined text-xs">chevron_right</span>
        <span class="text-on-surface-variant">Thông tin tuyển sinh</span>
        <span class="material-symbols-outlined text-xs">chevron_right</span>
        <span class="text-secondary-container font-semibold">Loại hình đào tạo</span>
      </nav>
    </div>

    <!-- HERO BANNER -->
    <section class="max-w-7xl mx-auto px-6 lg:px-12 mb-8">
      <div class="bg-gradient-to-br from-[#002244] via-[#003366] to-[#0a4b8a] rounded-3xl p-8 sm:p-12 text-white relative overflow-hidden shadow-xl border border-blue-900/40">
        <div class="absolute -right-16 -bottom-16 w-80 h-80 rounded-full bg-blue-500/10 blur-3xl pointer-events-none"></div>
        <div class="relative z-10 max-w-4xl">
          <h1 class="text-2xl sm:text-4xl font-headline-lg font-bold mb-4 tracking-tight leading-tight">
            Các Loại Hình Đào Tạo Tại DUE
          </h1>
          <p class="text-slate-200 text-sm sm:text-base leading-relaxed max-w-3xl mb-8">
            Trường Đại học Kinh tế – Đại học Đà Nẵng triển khai 3 loại hình đào tạo chính quy hiện đại, đón đầu xu thế kinh tế số và hội nhập quốc tế: <span class="font-semibold text-white">Toàn phần tiếng Anh</span> (chuẩn toàn cầu, học bổng tài năng Elite), <span class="font-semibold text-white">Bán phần tiếng Anh</span> (song ngữ tích hợp chứng chỉ ACCA, ICAEW) và <span class="font-semibold text-white">Tiêu chuẩn</span> (chuẩn kiểm định AUN-QA).
          </p>

          <!-- 3 Quick Metrics Cards -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            
            <div class="bg-white/10 backdrop-blur-md rounded-2xl p-4 border border-white/15 flex items-center gap-3">
              <div class="w-11 h-11 rounded-xl bg-secondary-container text-white flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-xl">translate</span>
              </div>
              <div>
                <div class="text-xs uppercase font-bold text-slate-300">Toàn phần tiếng Anh</div>
                <div class="text-lg font-bold text-white">4 Chương trình <span class="text-xs font-normal text-orange-200">(360 CT)</span></div>
                <div class="text-[11px] text-slate-300">Giảng dạy 100% bằng tiếng Anh</div>
              </div>
            </div>

            <div class="bg-white/10 backdrop-blur-md rounded-2xl p-4 border border-white/15 flex items-center gap-3">
              <div class="w-11 h-11 rounded-xl bg-blue-500 text-white flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-xl">workspace_premium</span>
              </div>
              <div>
                <div class="text-xs uppercase font-bold text-slate-300">Bán phần tiếng Anh</div>
                <div class="text-lg font-bold text-white">13 Chương trình <span class="text-xs font-normal text-blue-200">(1.240 CT)</span></div>
                <div class="text-[11px] text-slate-300">Tích hợp ACCA, ICAEW và AI</div>
              </div>
            </div>

            <div class="bg-white/10 backdrop-blur-md rounded-2xl p-4 border border-white/15 flex items-center gap-3">
              <div class="w-11 h-11 rounded-xl bg-emerald-500 text-white flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-xl">verified</span>
              </div>
              <div>
                <div class="text-xs uppercase font-bold text-slate-300">Tiêu chuẩn</div>
                <div class="text-lg font-bold text-white">19 Chương trình <span class="text-xs font-normal text-emerald-200">(1.985 CT)</span></div>
                <div class="text-[11px] text-slate-300">Chuẩn kiểm định quốc tế AUN-QA</div>
              </div>
            </div>

          </div>
        </div>
      </div>
    </section>

    <!-- TABS NAVIGATION SECTION -->
    <section class="max-w-7xl mx-auto px-6 lg:px-12 mb-6">
      
      <!-- Hộp chuyển đổi Tab và ô tìm kiếm -->
      <div class="bg-surface-container-lowest rounded-3xl p-5 sm:p-6 shadow-sm border border-outline-variant/40 space-y-4">
        
        <!-- Hàng 1: Ô tìm kiếm lên trên -->
        <div class="relative w-full">
          <input id="programSearch" onkeyup="searchPrograms()" class="w-full pl-11 pr-4 py-3 bg-slate-50 text-on-surface rounded-2xl text-xs sm:text-sm border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary focus:bg-white transition-all shadow-inner" placeholder="Tìm kiếm nhanh tên ngành, chuyên ngành, mã xét tuyển..." type="text">
          <span class="material-symbols-outlined absolute left-3.5 top-3 text-slate-400 text-[20px]">search</span>
        </div>

        <!-- Hàng 2: 3 option nằm cùng hàng -->
        <div class="flex flex-wrap items-center gap-3 pt-1" id="loaiHinhTabs">
          <button onclick="switchTab('toan-phan')" id="tab-toan-phan" class="tab-btn active flex items-center gap-2 px-5 py-3 rounded-2xl text-xs sm:text-sm font-bold border border-slate-200 transition-all cursor-pointer whitespace-nowrap">
            <span class="material-symbols-outlined text-base">public</span>
            <span>Toàn phần tiếng Anh</span>
            <span class="tab-badge px-2 py-0.5 rounded-full text-[11px] font-bold bg-slate-200 text-slate-700">4 ngành</span>
          </button>

          <button onclick="switchTab('ban-phan')" id="tab-ban-phan" class="tab-btn flex items-center gap-2 px-5 py-3 rounded-2xl text-xs sm:text-sm font-bold border border-slate-200 text-slate-700 hover:bg-slate-50 transition-all cursor-pointer whitespace-nowrap">
            <span class="material-symbols-outlined text-base">language</span>
            <span>Bán phần tiếng Anh</span>
            <span class="tab-badge px-2 py-0.5 rounded-full text-[11px] font-bold bg-slate-200 text-slate-700">13 ngành</span>
          </button>

          <button onclick="switchTab('tieu-chuan')" id="tab-tieu-chuan" class="tab-btn flex items-center gap-2 px-5 py-3 rounded-2xl text-xs sm:text-sm font-bold border border-slate-200 text-slate-700 hover:bg-slate-50 transition-all cursor-pointer whitespace-nowrap">
            <span class="material-symbols-outlined text-base">verified</span>
            <span>Tiêu chuẩn</span>
            <span class="tab-badge px-2 py-0.5 rounded-full text-[11px] font-bold bg-slate-200 text-slate-700">19 ngành</span>
          </button>
        </div>

      </div>

    </section>

    <!-- CONTENT TABS -->
    <div class="max-w-7xl mx-auto px-6 lg:px-12">

      <!-- ==================== TAB 1: TOÀN PHẦN TIẾNG ANH ==================== -->
      <section id="content-toan-phan" class="tab-content active space-y-8">
        
        <!-- Giới thiệu Toàn phần tiếng Anh -->
        <div class="bg-gradient-to-r from-orange-50/80 via-white to-amber-50/50 rounded-3xl p-6 sm:p-8 border border-orange-200/60 shadow-sm">
          <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
            <div class="max-w-4xl">
              <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-orange-100 text-orange-800 text-xs font-bold uppercase tracking-wider mb-2">
                <span class="material-symbols-outlined text-sm">stars</span>
                Chương Trình Cử Nhân Chuẩn Toàn Cầu
              </div>
              <h2 class="text-xl sm:text-2xl font-headline-md font-bold text-slate-900 mb-2">
                Loại Hình Đào Tạo: Toàn Phần Tiếng Anh
              </h2>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-4">
                Chương trình Toàn phần tiếng Anh được thiết kế theo chuẩn các trường đại học hàng đầu thế giới. Toàn bộ các môn chuyên ngành và nghiệp vụ kinh doanh được giảng dạy 100% bằng tiếng Anh. Sinh viên có cơ hội học tập cùng giảng viên quốc tế, chuyên gia đa quốc gia và tham gia các kỳ trao đổi tín chỉ ở nước ngoài.
              </p>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
                <div class="flex items-center gap-2 p-2.5 rounded-xl bg-white border border-orange-100 shadow-sm">
                  <span class="material-symbols-outlined text-orange-600">record_voice_over</span>
                  <span><strong>100%</strong> Giảng dạy tiếng Anh</span>
                </div>
                <div class="flex items-center gap-2 p-2.5 rounded-xl bg-white border border-orange-100 shadow-sm">
                  <span class="material-symbols-outlined text-orange-600">how_to_reg</span>
                  <span><strong>Phương thức:</strong> PT 1 và PT 2</span>
                </div>
                <div class="flex items-center gap-2 p-2.5 rounded-xl bg-white border border-orange-100 shadow-sm">
                  <span class="material-symbols-outlined text-orange-600">workspace_premium</span>
                  <span><strong>IELTS 5.5+</strong> hoặc tương đương</span>
                </div>
              </div>
            </div>
          </div>
