            <!-- PT3 -->
            <a href="/phuong-thuc-xet-tuyen/#pt3" class="group relative bg-surface-container-lowest rounded-3xl p-6 shadow-sm hover:shadow-xl transition-all duration-300 border border-orange-200/70 flex flex-col justify-between hover:-translate-y-1 cursor-pointer block text-left">
              <div class="absolute top-0 left-0 right-0 h-2 bg-orange-500 rounded-t-3xl"></div>
