              </tr>
              <tr class="hover:bg-slate-50/70">
                <td class="py-3.5 px-5 font-bold text-slate-800 bg-slate-50/60">Chứng chỉ và giá trị gia tăng</td>
                <td class="py-3.5 px-5 text-slate-700">Học bổng Elite, thực tập tập đoàn đa quốc gia, trao đổi quốc tế</td>
                <td class="py-3.5 px-5 text-slate-700">Tích hợp tín chỉ nghề nghiệp ICAEW, ACCA, AI trong kinh doanh</td>
                <td class="py-3.5 px-5 text-slate-700">Đạt chuẩn AUN-QA, chuyên môn thực tiễn vững vàng, mạng lưới cựu SV mạnh</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

    </div>
    </div>
  </main>

  <!-- JAVASCRIPT ĐIỀU KHIỂN TABS và TÌM KIẾM -->
  <script>
    let activeTabId = 'toan-phan';

    function switchTab(tabId) {
      activeTabId = tabId;

      // Cập nhật nút tab
      document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.classList.remove('active');
        btn.classList.add('text-slate-700');
      });
      const targetBtn = document.getElementById('tab-' + tabId);
      if (targetBtn) {
        targetBtn.classList.add('active');
        targetBtn.classList.remove('text-slate-700');
      }

      // Cập nhật nội dung tab
      document.querySelectorAll('.tab-content').forEach(content => {
        content.classList.remove('active');
      });
      const targetContent = document.getElementById('content-' + tabId);
      if (targetContent) {
        targetContent.classList.add('active');
      }

      // Tự động cuộn nhẹ tới phần nội dung
      window.location.hash = tabId;
      searchPrograms();
    }

    function searchPrograms() {
      const query = document.getElementById('programSearch').value.toLowerCase().trim();
      const currentSection = document.getElementById('content-' + activeTabId);
      if (!currentSection) return;

      const rows = currentSection.querySelectorAll('.program-row');
      rows.forEach(row => {
        const text = row.textContent.toLowerCase();
        if (query === '' || text.includes(query)) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    }

    // Khởi tạo tab từ URL hash nếu có
    window.addEventListener('DOMContentLoaded', () => {
      const hash = window.location.hash.replace('#', '');
      if (hash && ['toan-phan', 'ban-phan', 'tieu-chuan'].includes(hash)) {
        switchTab(hash);
      }
    });

    // Kết nối ô tìm kiếm trên navbar nếu có
    const navSearch = document.getElementById('quickSearchNav');
    if (navSearch) {
      navSearch.addEventListener('keyup', function() {
        const localSearch = document.getElementById('programSearch');
        if (localSearch) {
          localSearch.value = this.value;
          searchPrograms();
        }
      });
    }
  </script>


  <!-- Footer (100% giống các trang khác) -->
{% endblock %}


--- FILE: CongthongtintuyensinhDUE/templates/admissions/tuition_fees.html ---
{% extends 'layouts/base.html' %}

{% block title %}Thông Tin Học Phí Năm 2026 - Trường Đại học Kinh tế, ĐH Đà Nẵng (DUE){% endblock %}

{% block nav_hocphi %}text-secondary-container font-headline-sm border-b-2 border-secondary-container uppercase whitespace-nowrap font-bold{% endblock %}

{% block extra_head %}
<style>
  @keyframes pulseSoft {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); }
  }
  .pulse-animation {
    animation: pulseSoft 2.5s infinite ease-in-out;
  }
</style>
{% endblock %}

{% block content %}
<main class="w-full pt-32 sm:pt-36 pb-6 bg-surface min-h-[calc(100vh-28rem)] flex-1">
    <div class="max-w-7xl mx-auto px-6 lg:px-12 pt-8 pb-4">

      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-2 text-xs sm:text-sm text-on-surface-variant mb-6 font-medium">
        <a href="/" class="hover:text-primary-container transition-colors">Trang chủ</a>
        <span class="material-symbols-outlined text-[14px]">chevron_right</span>
        <span class="text-secondary-container font-semibold">Học phí tuyển sinh 2026</span>
      </nav>

      <!-- Banner Tiêu đề và giới thiệu ngắn -->
      <div class="relative bg-gradient-to-br from-primary-container via-[#004080] to-[#00274d] rounded-3xl p-8 sm:p-12 text-white shadow-xl overflow-hidden mb-12">
        <div class="absolute -right-20 -bottom-20 w-80 h-80 rounded-full bg-sky-400/10 blur-3xl pointer-events-none"></div>
        <div class="absolute right-10 top-10 w-48 h-48 rounded-full bg-orange-400/10 blur-2xl pointer-events-none"></div>

        <div class="relative z-10 max-w-3xl">
          <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight mb-4 leading-tight">
            Chính Sách và khung Học Phí Đại Học Chính Quy Khóa 2026
          </h1>
          <p class="text-sky-100/90 text-sm sm:text-base leading-relaxed">
            Trường Đại học Kinh tế - Đại học Đà Nẵng áp dụng chính sách học phí ổn định, lộ trình tăng hợp lý theo đúng quy định của Chính phủ, đi kèm quỹ học bổng và hỗ trợ tài chính toàn diện dành cho sinh viên.
          </p>
        </div>
      </div>

      <!-- KHỐI CHÍNH: BẢNG HỌC PHÍ NĂM 2026 (THEO THIẾT KẾ YÊU CẦU) -->
      <section class="bg-white rounded-3xl shadow-sm border border-slate-200/80 p-6 sm:p-10 mb-12">
        
        <!-- Header tiêu đề mục và Đơn vị tính -->
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 mb-4 pb-2">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-2xl bg-sky-50 text-[#0096c7] flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-[24px]">account_balance_wallet</span>
            </div>
            <div>
              <h2 class="text-xl sm:text-2xl font-black text-[#003366] tracking-wide uppercase">
                HỌC PHÍ NĂM 2026
              </h2>
              <p class="text-xs text-slate-500">Mức học phí áp dụng cho sinh viên nhập học năm 2026</p>
            </div>
          </div>
          <div class="text-right">
            <span class="italic font-semibold text-sky-700 text-sm sm:text-base tracking-wide">ĐVT: Triệu đồng</span>
          </div>
        </div>

        <!-- BẢNG HỌC PHÍ ĐƯỢC BO VIỀN CONG XANH NGỌC ĐẶC TRƯNG -->
        <div class="overflow-x-auto pb-2">
          <div class="min-w-[680px] rounded-[24px] border-[3px] border-[#38bdf8] overflow-hidden shadow-md shadow-sky-500/10">
            <table class="w-full text-center border-collapse">
              <!-- Hàng Tiêu đề (Header) -->
              <thead>
                <tr class="bg-[#0093c7] text-white text-sm sm:text-base">
                  <th class="py-4 px-6 font-bold text-left w-1/3 border-r border-[#38bdf8]/60">
                    Nhóm
                  </th>
                  <th class="py-4 px-4 font-bold border-r border-[#38bdf8]/60">
                    Năm học<br><span class="font-semibold text-xs sm:text-sm text-sky-100">2026 - 2027</span>
                  </th>
                  <th class="py-4 px-4 font-bold border-r border-[#38bdf8]/60">
                    Năm học<br><span class="font-semibold text-xs sm:text-sm text-sky-100">2027 - 2028</span>
                  </th>
                  <th class="py-4 px-4 font-bold border-r border-[#38bdf8]/60">
                    Năm học<br><span class="font-semibold text-xs sm:text-sm text-sky-100">2028 - 2029</span>
                  </th>
                  <th class="py-4 px-4 font-bold">
                    Năm học<br><span class="font-semibold text-xs sm:text-sm text-sky-100">2029 - 2030</span>
                  </th>
                </tr>
              </thead>
              <!-- Dữ liệu các dòng học phí -->
              <tbody class="text-sm sm:text-base font-bold text-[#003366] bg-[#ebf8fe] divide-y divide-[#7dd3fc]">
                {% for item in tuition_list %}
                <tr class="hover:bg-[#d8f2fd] transition-colors">
                  <td class="py-4 px-6 text-left font-bold text-slate-800 border-r border-[#7dd3fc]">
                    {{ item.nhom|linebreaksbr }}
                  </td>
                  <td class="py-4 px-4 border-r border-[#7dd3fc] text-[#003366] font-extrabold">{{ item.nam_hoc_1|floatformat:2 }}</td>
                  <td class="py-4 px-4 border-r border-[#7dd3fc] text-[#003366] font-extrabold">{{ item.nam_hoc_2|floatformat:2 }}</td>
                  <td class="py-4 px-4 border-r border-[#7dd3fc] text-[#003366] font-extrabold">{{ item.nam_hoc_3|floatformat:2 }}</td>
                  <td class="py-4 px-4 text-[#003366] font-extrabold">{{ item.nam_hoc_4|floatformat:2 }}</td>
                </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Phần Ghi chú chi tiết theo hình ảnh -->
        <div class="mt-6 space-y-2 text-slate-700 text-sm sm:text-base leading-relaxed pl-2">
          <p class="italic font-bold text-slate-900">Ghi chú:</p>
          <ul class="space-y-1.5 pl-1">
            <li class="flex items-start gap-2">
              <span class="text-slate-500 font-bold">-</span>
              <span>Thông tin học phí các năm học có thể thay đổi tuân thủ theo quy định của Nhà nước.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-slate-500 font-bold">-</span>
              <span>Mức thu học phí được xác định dựa trên số tín chỉ học thực tế của sinh viên trong mỗi học kỳ và đơn giá tín chỉ theo thông báo về mức thu học phí của Nhà trường.</span>
            </li>
          </ul>
        </div>

      </section>

      <!-- TIỆN ÍCH TÍNH NHANH HỌC PHÍ DỰ KIẾN (TUITION CALCULATOR) -->
      <section class="bg-gradient-to-r from-sky-50 to-blue-50/60 rounded-3xl border border-sky-200/70 p-6 sm:p-10 mb-12 shadow-sm">
        <div class="max-w-4xl mx-auto">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-10 h-10 rounded-2xl bg-secondary-container text-white flex items-center justify-center font-bold shadow-sm">
              <span class="material-symbols-outlined text-[22px]">calculate</span>
            </div>
            <div>
              <h3 class="text-xl font-bold text-slate-900">Công cụ ước tính học phí theo nhu cầu</h3>
              <p class="text-xs text-slate-500">Chọn chương trình và năm học để xem học phí tương ứng mỗi kỳ và cả năm</p>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Chương trình đào tạo</label>
              <select id="calcProgram" class="w-full px-4 py-2.5 bg-white border border-slate-300 rounded-xl text-sm font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-sky-500 transition-all">
                {% for item in tuition_list %}
                <option value="{{ item.slug }}">{{ item.nhom }}</option>
                {% endfor %}
              </select>
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Năm học dự kiến</label>
              <select id="calcYear" class="w-full px-4 py-2.5 bg-white border border-slate-300 rounded-xl text-sm font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-sky-500 transition-all">
                <option value="0">Năm 1 (2026 - 2027)</option>
                <option value="1">Năm 2 (2027 - 2028)</option>
                <option value="2">Năm 3 (2028 - 2029)</option>
                <option value="3">Năm 4 (2029 - 2030)</option>
              </select>
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Hình thức ước tính</label>
              <div class="flex items-center gap-2 h-[42px] px-4 py-2 bg-white border border-slate-300 rounded-xl text-xs text-slate-600">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                <span>2 Học kỳ chính / năm học</span>
              </div>
            </div>
          </div>

          <!-- Kết quả tính toán -->
          <div class="p-6 rounded-2xl bg-white border border-sky-200 shadow-sm flex flex-col md:flex-row items-center justify-between gap-6">
            <div class="space-y-1 text-center md:text-left">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Học phí dự kiến cả năm</span>
              <div class="flex items-baseline gap-2 justify-center md:justify-start">
                <span id="calcTotalYear" class="text-3xl sm:text-4xl font-black text-secondary-container">29.500.000</span>
                <span class="text-sm font-bold text-slate-600">VNĐ / năm</span>
              </div>
              <p class="text-xs text-slate-500">
                Tương đương khoảng <strong id="calcPerTerm" class="text-slate-800">14.750.000 VNĐ</strong> / học kỳ chính
              </p>
            </div>

            <div class="flex flex-col sm:flex-row items-center gap-3 w-full md:w-auto">
              <a href="https://m.me/FaceDue" target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto px-6 py-3 rounded-full bg-gradient-to-r from-blue-600 to-[#1877F2] text-white font-bold text-xs sm:text-sm shadow-md hover:shadow-lg hover:scale-105 transition-all flex items-center justify-center gap-2">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2C6.477 2 2 6.145 2 11.258c0 2.914 1.455 5.517 3.735 7.21V22l3.39-1.86c.91.252 1.88.388 2.875.388 5.523 0 10-4.145 10-9.258C22 6.145 17.523 2 12 2zm1.066 12.443l-2.573-2.744-5.021 2.744 5.524-5.86 2.64 2.744 4.954-2.744-5.524 5.86z"></path></svg>
                <span>Tư vấn chi tiết học phí</span>
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- 3 CỘT: CHÍNH SÁCH HỌC BỔNG - MIỄN GIẢM - PHƯƠNG THỨC NỘP -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
        
        <!-- Cột 1: Học bổng Tuyển sinh và khuyến khích -->
        <div class="bg-white rounded-3xl p-6 border border-slate-200/80 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center mb-4">
              <span class="material-symbols-outlined text-[28px]">military_tech</span>
            </div>
            <h3 class="font-bold text-slate-900 text-lg mb-2">Học bổng và tài trợ</h3>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed mb-4">
              Nhà trường dành hàng chục tỷ đồng mỗi năm cho quỹ học bổng:
            </p>
            <ul class="text-xs text-slate-600 space-y-2">
              <li class="flex items-start gap-2">
                <span class="text-amber-500 font-bold">✓</span>
                <span><strong>Học bổng Thủ khoa, Á khoa:</strong> Miễn 100% học phí năm học đầu tiên.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-amber-500 font-bold">✓</span>
                <span><strong>Học bổng Khuyến khích học tập:</strong> Xét mỗi kỳ (Xuất sắc, Giỏi, Khá).</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-amber-500 font-bold">✓</span>
                <span><strong>Học bổng Doanh nghiệp và cựu sinh viên:</strong> Trao tặng hàng trăm suất hàng năm.</span>
              </li>
            </ul>
          </div>
          <div class="mt-6 pt-4 border-t border-slate-100">
            <span class="text-[11px] text-amber-700 font-semibold bg-amber-50 px-3 py-1 rounded-full">Tổng quỹ > 25 tỷ VNĐ/năm</span>
          </div>
        </div>

        <!-- Cột 2: Miễn giảm và hỗ trợ vay vốn -->
        <div class="bg-white rounded-3xl p-6 border border-slate-200/80 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center mb-4">
              <span class="material-symbols-outlined text-[28px]">volunteer_activism</span>
            </div>
            <h3 class="font-bold text-slate-900 text-lg mb-2">Chính sách Miễn giảm và vay vốn</h3>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed mb-4">
              Hỗ trợ tối đa cho sinh viên có hoàn cảnh khó khăn:
            </p>
            <ul class="text-xs text-slate-600 space-y-2">
              <li class="flex items-start gap-2">
                <span class="text-emerald-500 font-bold">✓</span>
                <span><strong>Miễn/giảm học phí theo Nghị định:</strong> Hộ nghèo, con thương binh, dân tộc thiểu số...</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-emerald-500 font-bold">✓</span>
                <span><strong>Trợ cấp xã hội:</strong> Chi trả định kỳ theo học kỳ.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-emerald-500 font-bold">✓</span>
                <span><strong>Vay vốn tín dụng sinh viên:</strong> Lãi suất ưu đãi qua Ngân hàng CSXH (VBSP).</span>
              </li>
            </ul>
          </div>
          <div class="mt-6 pt-4 border-t border-slate-100">
            <span class="text-[11px] text-emerald-700 font-semibold bg-emerald-50 px-3 py-1 rounded-full">Đầy đủ chế độ Nhà nước</span>
          </div>
        </div>

        <!-- Cột 3: Phương thức thanh toán tiện lợi -->
        <div class="bg-white rounded-3xl p-6 border border-slate-200/80 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center mb-4">
              <span class="material-symbols-outlined text-[28px]">credit_card</span>
            </div>
            <h3 class="font-bold text-slate-900 text-lg mb-2">Phương thức Nộp học phí</h3>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed mb-4">
              Đa dạng kênh thanh toán trực tuyến, an toàn và nhanh chóng:
            </p>
            <ul class="text-xs text-slate-600 space-y-2">
              <li class="flex items-start gap-2">
                <span class="text-blue-500 font-bold">✓</span>
                <span><strong>Cổng E-Payment DUE:</strong> Thanh toán trực tiếp qua mã QR VietQR, VNPAY, Thẻ ATM/Visa.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-blue-500 font-bold">✓</span>
                <span><strong>Ngân hàng liên kết:</strong> Nộp qua ứng dụng Agribank, VietinBank, BIDV, Vietcombank.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-blue-500 font-bold">✓</span>
                <span><strong>Hóa đơn điện tử:</strong> Tự động xuất hóa đơn gửi về email sinh viên sau khi thanh toán.</span>
              </li>
            </ul>
          </div>
          <div class="mt-6 pt-4 border-t border-slate-100">
            <span class="text-[11px] text-blue-700 font-semibold bg-blue-50 px-3 py-1 rounded-full">100% Trực tuyến không dùng tiền mặt</span>
          </div>
        </div>

      </div>

      <!-- CÂU HỎI THƯỜNG GẶP (FAQ) -->
      <section class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200/80 shadow-sm">
        <div class="max-w-3xl mx-auto">
          <div class="text-center mb-8">
            <span class="text-xs font-bold uppercase tracking-wider text-secondary-container bg-orange-50 px-3 py-1 rounded-full">Hỏi đáp</span>
            <h3 class="text-xl sm:text-2xl font-bold text-slate-900 mt-2">Câu hỏi thường gặp về Học phí</h3>
          </div>

          <div class="space-y-4">
            {% for faq in faq_list %}
            <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/70">
              <h4 class="font-bold text-slate-800 text-sm sm:text-base flex items-center justify-between">
                <span>{{ faq.question }}</span>
                <span class="material-symbols-outlined text-slate-400 text-[20px]">help_outline</span>
              </h4>
              <p class="text-xs sm:text-sm text-slate-600 mt-2 leading-relaxed">
                {{ faq.answer|safe }}
              </p>
            </div>
            {% endfor %}
          </div>

          <!-- CTA hỗ trợ trực tiếp -->
          <div class="mt-8 pt-6 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
            <div>
              <p class="font-bold text-slate-800 text-sm">Bạn cần giải đáp thêm về học phí từng ngành cụ thể?</p>
              <p class="text-xs text-slate-500">Đội ngũ Ban tư vấn tuyển sinh DUE sẵn sàng hỗ trợ bạn 24/7</p>
            </div>
            <a href="https://m.me/FaceDue" target="_blank" rel="noopener noreferrer" class="px-5 py-2.5 rounded-full bg-[#1877F2] hover:bg-blue-700 text-white font-semibold text-xs transition-all shadow-md flex items-center gap-2 shrink-0">
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2C6.477 2 2 6.145 2 11.258c0 2.914 1.455 5.517 3.735 7.21V22l3.39-1.86c.91.252 1.88.388 2.875.388 5.523 0 10-4.145 10-9.258C22 6.145 17.523 2 12 2zm1.066 12.443l-2.573-2.744-5.021 2.744 5.524-5.86 2.64 2.744 4.954-2.744-5.524 5.86z"></path></svg>
              <span>Nhắn tin tư vấn ngay</span>
            </a>
          </div>

        </div>
      </section>

    </div>
  </main>


  <!-- FLOATING QUICK CHAT WIDGET -->
  <div class="fixed bottom-6 right-6 z-40 flex flex-col items-end gap-3">
    <a href="https://m.me/FaceDue" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-3 bg-white pl-4 pr-3 py-2.5 rounded-full shadow-2xl border border-blue-100 hover:border-blue-400 hover:shadow-blue-500/20 transition-all duration-300 hover:-translate-y-1">
      <div class="flex flex-col text-right">
        <span class="text-xs font-bold text-slate-800 group-hover:text-blue-600 transition-colors">Tư vấn Học phí DUE</span>
        <span class="text-[11px] text-slate-500">Hỗ trợ trực tuyến 24/7</span>
      </div>
      <div class="w-11 h-11 rounded-full bg-gradient-to-tr from-blue-600 via-indigo-500 to-sky-400 text-white flex items-center justify-center shadow-md group-hover:scale-110 transition-transform pulse-animation">
        <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"><path d="M12 2C6.477 2 2 6.145 2 11.258c0 2.914 1.455 5.517 3.735 7.21V22l3.39-1.86c.91.252 1.88.388 2.875.388 5.523 0 10-4.145 10-9.258C22 6.145 17.523 2 12 2zm1.066 12.443l-2.573-2.744-5.021 2.744 5.524-5.86 2.64 2.744 4.954-2.744-5.524 5.86z"></path></svg>
      </div>
    </a>
  </div>

  
{% endblock %}

{% block extra_js %}


  <!-- SCRIPT TÍNH TOÁN HỌC PHÍ DỰ KIẾN TỰ ĐỘNG -->
  <script>
    const tuitionData = JSON.parse('{{ tuition_rates_json|escapejs }}');

    const calcProgram = document.getElementById('calcProgram');
    const calcYear = document.getElementById('calcYear');
    const calcTotalYear = document.getElementById('calcTotalYear');
    const calcPerTerm = document.getElementById('calcPerTerm');

    function updateTuitionCalc() {
      const prog = calcProgram.value;
      const yearIdx = parseInt(calcYear.value, 10);
      const rates = tuitionData[prog];
      if (rates && rates[yearIdx] !== undefined) {
        const valMil = rates[yearIdx];
        const totalVnd = Math.round(valMil * 1000000);
        const perTermVnd = Math.round(totalVnd / 2);

        calcTotalYear.textContent = totalVnd.toLocaleString('vi-VN');
        calcPerTerm.textContent = perTermVnd.toLocaleString('vi-VN') + ' VNĐ';
      }
    }

    calcProgram.addEventListener('change', updateTuitionCalc);
    calcYear.addEventListener('change', updateTuitionCalc);
    updateTuitionCalc();
  </script>


{% endblock %}


--- FILE: CongthongtintuyensinhDUE/templates/auth/login.html ---
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">
  <title>Đăng nhập | Cổng thông tin Tuyển sinh DUE 2026</title>
  <link rel="icon" type="image/png" href="https://due.udn.vn/Portals/0/favicon.ico">

  <!-- Google Fonts và material Symbols -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,600&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet">

  <script src="https://cdn.tailwindcss.com"></script>
  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "primary": "#003366",
            "primary-container": "#00274e",
            "secondary": "#9d4300",
            "secondary-container": "#fd761a",
            "secondary-fixed": "#ffdbca",
            "surface": "#faf8ff",
            "surface-container": "#eaedff",
            "surface-container-high": "#e2e7ff",
            "surface-container-low": "#f2f3ff",
            "surface-container-lowest": "#ffffff",
            "on-surface": "#131b2e",
            "on-surface-variant": "#43474f",
          },
          fontFamily: {
            "body-md": ["Be Vietnam Pro", "sans-serif"],
            "display-hero": ["Space Grotesk", "sans-serif"]
          }
        }
      }
    };
  </script>
</head>
<body class="bg-gradient-to-br from-[#f0f4f9] via-[#f7f9fc] to-[#e8eef6] min-h-screen flex items-center justify-center p-4 sm:p-6 lg:p-8 font-body-md text-on-surface antialiased">

  <!-- Main Card Container -->
  <div class="w-full max-w-5xl bg-surface-container-lowest rounded-3xl sm:rounded-[32px] shadow-2xl border border-slate-200/80 overflow-hidden grid grid-cols-1 lg:grid-cols-12 min-h-[620px]">
    
    <!-- LEFT PANEL: Visuals và university Highlights (Hidden on small mobile, visible on lg) -->
    <div class="lg:col-span-5 relative hidden lg:flex flex-col justify-between p-8 text-white overflow-hidden bg-primary-container">
      <!-- Background Image with Overlay -->
      <img class="absolute inset-0 w-full h-full object-cover object-center opacity-30 mix-blend-overlay" 
           src="https://lh3.googleusercontent.com/aida-public/AB6AXuDC_9_nZEiYQFTEVi4j1Euk7pjYY2R0FZf4RCSacCOK1jsCxMjMRKgLJSHksCx_bsVYGN9_2EmKgCLEy8oIO2xTm4CbdovXLs3-faqfHwoNkZq6J9hQYlLUiEpyPc_-bYb1q5gqZlOwgLyVIBemZ8G2dHrKGXtcKm2YjQwK9c763aT83ikT3OW3j902xrE24mslmXbnLMmA7obCVuBSIuak8iamrNz_fztfwqmz0LhL" 
           alt="Khuôn viên DUE">
      <div class="absolute inset-0 bg-gradient-to-t from-primary-container via-primary-container/80 to-primary/80"></div>
      
      <!-- Top: Back Button và badge -->
      <div class="relative z-10 flex items-center justify-between">
        <a href="{% url 'admissions:home' %}" class="inline-flex items-center gap-1.5 text-xs font-bold text-white/90 hover:text-white bg-white/10 hover:bg-white/20 backdrop-blur-md px-3.5 py-1.5 rounded-full transition-all">
          <span class="material-symbols-outlined text-[16px]">arrow_back</span>
          <span>Về trang chủ</span>
        </a>
        <span class="text-[11px] font-extrabold uppercase tracking-wider bg-secondary-container text-white px-3 py-1 rounded-full shadow-sm">
          Mã: DDQ
        </span>
      </div>

      <!-- Center: University Info và value Props -->
      <div class="relative z-10 my-8">
        <img alt="DUE Logo" class="h-16 w-auto object-contain mb-6 drop-shadow-md brightness-0 invert" 
             src="https://lh3.googleusercontent.com/aida-public/AB6AXuC0SZKiA3qgvDQxaYkxsR3w1ej_sMxTuegQNml68FZ966VgfiyacVxxCVBp1S46Q8ZfFcj89zJFmRbki2mFVxwDK3mA_1FmeZlpvSq9GsILj2z2HzeolTI-1aztUgTZFmj50c5hiIbGUH4ETZRF2d42e6mKwe70Fwob0_OrZ8Y8qXAT69PRCagSk7LI9OJze_odv3CZfAw5_B28JRczw9Dj1w2HYnD-Z0VxQ9a8E-IZYEvv1QN0wLCekQ">
        
        <h2 class="text-xl sm:text-2xl font-bold font-display-hero leading-snug mb-3">
          Khởi đầu <span class="text-secondary-container">Tương lai Vững vàng</span> cùng DUE
        </h2>
        <p class="text-xs sm:text-sm text-slate-200 leading-relaxed mb-6">
          Trường Đại học Kinh tế – Đại học Đà Nẵng chào đón tân sinh viên khóa 50K với môi trường đào tạo quốc tế AUN-QA, giảng viên tận tâm và cơ hội việc làm 98.5%.
        </p>

        <!-- Feature List -->
        <div class="space-y-3 text-xs sm:text-sm text-slate-200">
          <div class="flex items-center gap-2.5">
            <span class="material-symbols-outlined text-secondary-container text-[18px]">verified</span>
            <span>Tra cứu hồ sơ và kết quả xét tuyển sớm</span>
          </div>
          <div class="flex items-center gap-2.5">
            <span class="material-symbols-outlined text-secondary-container text-[18px]">verified</span>
            <span>Cập nhật và bổ sung minh chứng chứng chỉ IELTS</span>
          </div>
          <div class="flex items-center gap-2.5">
            <span class="material-symbols-outlined text-secondary-container text-[18px]">verified</span>
            <span>Kênh hỗ trợ giải đáp 24/7 từ Ban tư vấn DUE</span>
          </div>
        </div>
      </div>

      <!-- Bottom: Hotline -->
      <div class="relative z-10 pt-4 border-t border-white/10 flex items-center justify-between text-xs text-slate-300">
        <span>Hotline: 0236 3836 169</span>
        <span>due.udn.vn</span>
      </div>
    </div>

    <!-- RIGHT PANEL: Login Form -->
    <div class="lg:col-span-7 p-6 sm:p-10 lg:p-12 flex flex-col justify-between">
      
      <!-- Mobile Top Bar: Logo và back Link (Visible only on mobile/tablet) -->
      <div class="flex lg:hidden items-center justify-between mb-6 pb-4 border-b border-slate-100">
        <a href="{% url 'admissions:home' %}" class="flex items-center gap-1 text-xs font-bold text-slate-600 hover:text-primary">
          <span class="material-symbols-outlined text-[18px]">arrow_back</span>
          <span>Trang chủ</span>
        </a>
        <img alt="DUE Logo" class="h-10 w-auto object-contain" 
             src="https://lh3.googleusercontent.com/aida-public/AB6AXuC0SZKiA3qgvDQxaYkxsR3w1ej_sMxTuegQNml68FZ966VgfiyacVxxCVBp1S46Q8ZfFcj89zJFmRbki2mFVxwDK3mA_1FmeZlpvSq9GsILj2z2HzeolTI-1aztUgTZFmj50c5hiIbGUH4ETZRF2d42e6mKwe70Fwob0_OrZ8Y8qXAT69PRCagSk7LI9OJze_odv3CZfAw5_B28JRczw9Dj1w2HYnD-Z0VxQ9a8E-IZYEvv1QN0wLCekQ">
      </div>

      <!-- Form Content -->
      <div>
        <!-- Heading -->
        <div class="mb-6">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-orange-100 text-secondary-container text-xs font-bold mb-2">
            <span class="w-2 h-2 rounded-full bg-secondary-container animate-pulse"></span>
            Hệ thống Tuyển sinh 2026
          </div>
          <h1 class="text-2xl sm:text-3xl font-bold font-display-hero text-on-surface">
            Đăng nhập tài khoản
          </h1>
          <p class="text-xs sm:text-sm text-on-surface-variant mt-1">
            Vui lòng nhập thông tin đăng nhập để tiếp tục tra cứu và quản trị hồ sơ.
          </p>
        </div>

        <!-- Role Switcher Tabs (Thí sinh / Cán bộ) -->
        <div class="flex p-1 bg-slate-100 rounded-2xl mb-6">
          <button type="button" onclick="switchRole('thisinh')" id="tab-thisinh" class="flex-1 py-2 text-xs sm:text-sm font-bold rounded-xl transition-all shadow-sm bg-white text-primary-container">
            Thí sinh / Phụ huynh
          </button>
          <button type="button" onclick="switchRole('admin')" id="tab-admin" class="flex-1 py-2 text-xs sm:text-sm font-bold rounded-xl transition-all text-slate-500 hover:text-slate-800">
            Cán bộ / Quản trị
          </button>
        </div>

        <!-- Error Alert (If login failed) -->
        {% if error_message %}
        <div class="mb-4 p-3.5 rounded-2xl bg-red-50 border border-red-200 text-xs sm:text-sm text-red-700 flex items-center gap-2.5">
          <span class="material-symbols-outlined text-[20px] shrink-0 text-red-600">error</span>
          <span>{{ error_message }}</span>
        </div>
        {% endif %}

        <!-- Django Flash Messages -->
        {% if messages %}
        <div class="mb-4 space-y-2">
          {% for msg in messages %}
          <div class="p-3.5 rounded-2xl text-xs sm:text-sm {% if msg.tags == 'success' %}bg-emerald-50 text-emerald-800 border border-emerald-200{% else %}bg-blue-50 text-blue-800 border border-blue-200{% endif %} flex items-center gap-2">
            <span class="material-symbols-outlined text-[18px]">info</span>
            <span>{{ msg }}</span>
          </div>
          {% endfor %}
        </div>
        {% endif %}

        <!-- Login Form -->
        <form method="POST" action="{% url 'admissions:login' %}" class="space-y-4">
          {% csrf_token %}
          
          <!-- Username / Email / CCCD -->
          <div>
            <label for="username" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1.5">
              Tên đăng nhập / Email / CCCD
            </label>
            <div class="relative">
              <span class="material-symbols-outlined absolute left-3.5 top-3 text-slate-400 text-[20px]">person</span>
              <input id="username" name="username" type="text" required 
                     class="w-full pl-11 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-2xl text-sm text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-secondary-container focus:border-transparent transition-all" 
                     placeholder="VD: thisinh2026, canbo hoặc admin">
            </div>
          </div>

          <!-- Password -->
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label for="password" class="text-xs font-bold uppercase tracking-wider text-slate-700">
                Mật khẩu
              </label>
              <a href="#" class="text-xs font-semibold text-secondary-container hover:underline">
                Quên mật khẩu?
              </a>
            </div>
            <div class="relative">
              <span class="material-symbols-outlined absolute left-3.5 top-3 text-slate-400 text-[20px]">lock</span>
              <input id="password" name="password" type="password" required 
                     class="w-full pl-11 pr-12 py-3 bg-slate-50 border border-slate-200 rounded-2xl text-sm text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-secondary-container focus:border-transparent transition-all" 
                     placeholder="Nhập mật khẩu của bạn">
              <button type="button" onclick="togglePasswordVisibility()" class="absolute right-3.5 top-3 text-slate-400 hover:text-slate-700 transition-colors cursor-pointer" aria-label="Hiện mật khẩu">
                <span id="eyeIcon" class="material-symbols-outlined text-[20px]">visibility</span>
              </button>
            </div>
          </div>

          <!-- Remember Me Checkbox -->
          <div class="flex items-center justify-between pt-1">
            <label class="flex items-center gap-2 cursor-pointer text-xs sm:text-sm text-slate-600">
              <input type="checkbox" name="remember_me" class="w-4 h-4 rounded text-secondary-container focus:ring-secondary-container border-slate-300">
              <span>Ghi nhớ đăng nhập trên thiết bị này</span>
            </label>
          </div>

          <!-- Submit Button -->
          <div class="pt-2">
            <button type="submit" class="w-full py-3.5 px-6 rounded-2xl bg-secondary-container hover:bg-[#e06310] text-white font-bold text-sm sm:text-base shadow-lg shadow-orange-500/25 hover:shadow-xl transition-all duration-200 flex items-center justify-center gap-2 cursor-pointer">
              <span>Đăng nhập hệ thống</span>
              <span class="material-symbols-outlined text-[20px]">login</span>
            </button>
          </div>
        </form>

        <!-- Quick Demo Accounts (Click to test effortlessly) -->
        <div class="mt-6 p-3.5 rounded-2xl bg-slate-50 border border-slate-200 text-xs text-slate-600">
          <p class="font-bold text-slate-700 mb-1.5 flex items-center gap-1.5">
            <span class="material-symbols-outlined text-[16px] text-secondary-container">key</span>
            <span>Tài khoản kiểm thử nhanh (Click để tự động điền):</span>
          </p>
          <div class="flex flex-wrap gap-2">
            <button type="button" onclick="fillCredentials('thisinh2026', 'thisinh123')" class="px-2.5 py-1 rounded-lg bg-white border border-slate-200 hover:border-secondary-container text-slate-700 hover:text-secondary-container font-semibold transition-colors cursor-pointer">
              Thí sinh: <span class="font-mono text-primary font-bold">thisinh2026</span>
            </button>
            <button type="button" onclick="fillCredentials('canbo', 'canbo123')" class="px-2.5 py-1 rounded-lg bg-white border border-slate-200 hover:border-secondary-container text-slate-700 hover:text-secondary-container font-semibold transition-colors cursor-pointer">
              Cán bộ: <span class="font-mono text-primary font-bold">canbo</span>
            </button>
            <button type="button" onclick="fillCredentials('admin', 'admin123')" class="px-2.5 py-1 rounded-lg bg-white border border-slate-200 hover:border-secondary-container text-slate-700 hover:text-secondary-container font-semibold transition-colors cursor-pointer">
              Quản trị: <span class="font-mono text-primary font-bold">admin</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Footer Info -->
      <div class="mt-8 pt-4 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between text-[11px] sm:text-xs text-slate-500 gap-2 text-center sm:text-left">
        <span>© 2026 Trường Đại học Kinh tế – Đại học Đà Nẵng</span>
        <span>Hỗ trợ kỹ thuật: <strong>0236 3836 169</strong></span>
      </div>

    </div>
  </div>

  <!-- Scripts -->
  <script>
    function togglePasswordVisibility() {
      const pwd = document.getElementById('password');
      const icon = document.getElementById('eyeIcon');
      if (pwd.type === 'password') {
        pwd.type = 'text';
        icon.textContent = 'visibility_off';
      } else {
        pwd.type = 'password';
        icon.textContent = 'visibility';
      }
    }

    function fillCredentials(u, p) {
      document.getElementById('username').value = u;
      document.getElementById('password').value = p;
      if (u === 'admin' || u === 'canbo') {
        switchRole('admin');
      } else {
        switchRole('thisinh');
      }
    }

    function switchRole(role) {
      const tabThisinh = document.getElementById('tab-thisinh');
      const tabAdmin = document.getElementById('tab-admin');
      if (role === 'admin') {
        tabAdmin.className = "flex-1 py-2 text-xs sm:text-sm font-bold rounded-xl transition-all shadow-sm bg-white text-primary-container";
        tabThisinh.className = "flex-1 py-2 text-xs sm:text-sm font-bold rounded-xl transition-all text-slate-500 hover:text-slate-800";
      } else {
        tabThisinh.className = "flex-1 py-2 text-xs sm:text-sm font-bold rounded-xl transition-all shadow-sm bg-white text-primary-container";
        tabAdmin.className = "flex-1 py-2 text-xs sm:text-sm font-bold rounded-xl transition-all text-slate-500 hover:text-slate-800";
      }
    }
  </script>
</body>
</html>


--- FILE: CongthongtintuyensinhDUE/templates/layouts/base.html ---
{% load static %}
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">
  <meta content="web_standard" name="shell-type">
  <title>{% block title %}Cổng thông tin tuyển sinh - Trường Đại học Kinh tế, ĐH Đà Nẵng (DUE){% endblock %}</title>
  <link rel="icon" type="image/x-icon" href="{% static 'images/logo_due.ico' %}">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet">
  <link href="https://fonts.googleapis.com" rel="preconnect">
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect">
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,600&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">

  <style>
    @layer base {
      html, body {
        margin: 0;
        padding: 0;
        scroll-behavior: smooth;
        font-family: 'Be Vietnam Pro', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      }
      body {
        overscroll-behavior: none;
      }
      h1, h2, h3, h4, .font-heading {
        font-family: 'Space Grotesk', sans-serif;
      }
      main > :first-child {
        margin-top: 0 !important;
      }
      main > :last-child {
        margin-bottom: 0 !important;
      }
    }
    .material-symbols-outlined {
      font-family: 'Material Symbols Outlined' !important;
      font-weight: normal;
      font-style: normal;
      line-height: 1;
      display: inline-block;
      white-space: nowrap;
      word-wrap: normal;
      direction: ltr;
      -webkit-font-feature-settings: 'liga';
      -webkit-font-smoothing: antialiased;
    }
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #f1f5f9;
    }
    ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }

    /* Style cho Dropdown DÀNH CHO SINH VIÊN chuẩn theo ảnh mẫu */
    .dcsv-dropdown-panel {
      position: fixed;
      display: none;
      z-index: 9999;
      width: 275px;
      background-color: #dbe6f3;
      border: 1px solid #7c9ec7;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.16);
      padding: 0;
      border-radius: 0;
      font-family: 'Be Vietnam Pro', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
    .dcsv-item {
      display: flex;
      align-items: center;
      padding: 8px 14px;
      background-color: #dbe6f3;
      color: #0b4d8c;
      text-decoration: none;
      font-size: 13.5px;
      font-weight: 700;
      border-bottom: 1px solid #adc7e7;
      transition: background-color .15s ease, color .15s ease, padding-left .15s ease;
      line-height: 1.35;
      cursor: pointer;
      box-sizing: border-box;
      user-select: none;
    }
    .dcsv-item:hover {
      background-color: #c7dcf2;
      color: #003366;
      padding-left: 17px;
    }
    .dcsv-item:last-child {
      border-bottom: none;
    }
    .dcsv-bullet {
      font-size: 11px;
      margin-right: 8px;
      color: #1e293b;
      flex-shrink: 0;
      line-height: 1;
      font-weight: 900;
    }
    .dcsv-text {
      flex: 1;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
        /* Nút chấm tròn (Bullet dot) dùng chung cho tất cả Dropdown menu: Bình thường xám, rơ chuột vào cam */
    .due-nav-bullet {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background-color: #94a3b8; /* Bình thường màu xám */
      display: inline-block;
      flex-shrink: 0;
      transition: background-color 0.2s ease, transform 0.2s ease;
    }
    .due-dropdown-link:hover .due-nav-bullet,
    .nav-khoa-item:hover .due-nav-bullet,
    .dcsv-item:hover .due-nav-bullet,
    a:hover > .due-nav-bullet,
    button:hover > .due-nav-bullet {
      background-color: #fd761a !important; /* Khi rơ chuột vào là màu cam */
      transform: scale(1.25);
    }

    /* Style cho Dropdown KHOA */
    .nav-khoa-panel {
      position: fixed;
      display: none;
      z-index: 9999;
      width: 380px;
      max-height: 85vh;
      overflow-y: auto;
      background-color: #ffffff;
      border: 1px solid #cbd5e1;
      border-radius: 16px;
      box-shadow: 0 16px 40px rgba(0, 30, 64, 0.16);
      padding: 8px;
      font-family: 'Be Vietnam Pro', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
    .nav-khoa-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 8px 10px;
      border-radius: 10px;
      text-decoration: none;
      transition: background-color .15s ease, transform .15s ease;
    }
    .nav-khoa-item:hover {
      background-color: #f1f5f9;
    }
    .nav-khoa-icon {
      width: 34px;
      height: 34px;
      border-radius: 9px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .nav-khoa-text {
      flex: 1;
      min-width: 0;
      display: flex;
      flex-direction: column;
    }
    .nav-khoa-name {
      font-size: 13.5px;
      font-weight: 700;
      color: #1e293b;
      line-height: 1.25;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .nav-khoa-item:hover .nav-khoa-name {
      color: #003366;
    }
    .nav-khoa-sub {
      font-size: 11px;
      color: #64748b;
      line-height: 1.2;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      margin-top: 2px;
    }
  </style>

  <script src="https://cdn.tailwindcss.com"></script>
  <script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "error": "#ba1a1a",
            "tertiary-container": "#003655",
            "inverse-primary": "#a7c8ff",
            "on-primary-fixed-variant": "#1f477b",
            "secondary": "#9d4300",
            "surface-container-high": "#e2e7ff",
            "on-tertiary-fixed-variant": "#004b73",
            "on-tertiary-container": "#40a2e7",
            "primary-container": "#003366",
            "background": "#faf8ff",
            "on-secondary": "#ffffff",
            "on-secondary-container": "#5c2400",
            "on-primary": "#ffffff",
            "tertiary-fixed-dim": "#93ccff",
            "secondary-fixed": "#ffdbca",
            "primary-fixed": "#d5e3ff",
            "surface-container": "#eaedff",
            "on-secondary-fixed-variant": "#783200",
            "on-surface-variant": "#43474f",
            "inverse-on-surface": "#eef0ff",
            "on-tertiary-fixed": "#001d31",
            "surface-dim": "#d2d9f4",
            "primary-fixed-dim": "#a7c8ff",
            "outline-variant": "#c3c6d1",
            "surface-bright": "#faf8ff",
            "surface-variant": "#dae2fd",
            "secondary-fixed-dim": "#ffb690",
            "surface-container-highest": "#dae2fd",
            "on-error": "#ffffff",
            "inverse-surface": "#283044",
            "on-background": "#131b2e",
            "secondary-container": "#fd761a",
            "on-primary-fixed": "#001b3c",
            "on-surface": "#131b2e",
            "surface-tint": "#3a5f94",
            "surface": "#faf8ff",
            "on-secondary-fixed": "#341100",
            "on-error-container": "#93000a",
            "outline": "#737780",
            "surface-container-low": "#f2f3ff",
            "primary": "#001e40",
            "surface-container-lowest": "#ffffff",
            "on-primary-container": "#799dd6",
            "tertiary-fixed": "#cce5ff",
            "error-container": "#ffdad6",
            "on-tertiary": "#ffffff",
            "tertiary": "#002035"
          },
          borderRadius: {
            "DEFAULT": "0.25rem",
            "lg": "0.5rem",
            "xl": "0.75rem",
            "full": "9999px"
          },
          spacing: {
            "gutter-mobile": "1rem",
            "gutter": "1.5rem",
            "space-xs": "0.25rem",
            "space-lg": "1.5rem",
            "margin-desktop": "3rem",
            "margin-mobile": "1rem",
            "space-md": "1rem",
            "space-xl": "2.5rem",
            "space-2xl": "4rem",
            "margin": "2rem",
            "space-sm": "0.5rem"
          },
          fontFamily: {
            "label-lg": ["Be Vietnam Pro", "sans-serif"],
            "display-hero": ["Space Grotesk", "sans-serif"],
            "headline-lg": ["Space Grotesk", "sans-serif"],
            "headline-lg-mobile": ["Space Grotesk", "sans-serif"],
            "label-md": ["Be Vietnam Pro", "sans-serif"],
            "body-lg": ["Be Vietnam Pro", "sans-serif"],
            "body-sm": ["Be Vietnam Pro", "sans-serif"],
            "headline-md": ["Space Grotesk", "sans-serif"],
            "headline-sm": ["Space Grotesk", "sans-serif"],
            "display-hero-mobile": ["Space Grotesk", "sans-serif"],
            "label-sm": ["Be Vietnam Pro", "sans-serif"],
            "body-md": ["Be Vietnam Pro", "sans-serif"]
          },
          fontSize: {
            "label-lg": ["14px", { "lineHeight": "20px", "letterSpacing": "0.01em", "fontWeight": "600" }],
            "display-hero": ["56px", { "lineHeight": "64px", "letterSpacing": "-0.03em", "fontWeight": "700" }],
            "headline-lg": ["36px", { "lineHeight": "44px", "letterSpacing": "-0.02em", "fontWeight": "700" }],
            "headline-lg-mobile": ["28px", { "lineHeight": "36px", "letterSpacing": "-0.01em", "fontWeight": "700" }],
            "label-md": ["12px", { "lineHeight": "16px", "letterSpacing": "0.02em", "fontWeight": "600" }],
            "body-lg": ["18px", { "lineHeight": "28px", "fontWeight": "400" }],
            "body-sm": ["14px", { "lineHeight": "20px", "fontWeight": "400" }],
            "headline-md": ["24px", { "lineHeight": "32px", "letterSpacing": "-0.01em", "fontWeight": "600" }],
            "headline-sm": ["20px", { "lineHeight": "28px", "fontWeight": "600" }],
            "display-hero-mobile": ["36px", { "lineHeight": "44px", "letterSpacing": "-0.02em", "fontWeight": "700" }],
            "label-sm": ["11px", { "lineHeight": "14px", "letterSpacing": "0.04em", "fontWeight": "700" }],
            "body-md": ["16px", { "lineHeight": "24px", "fontWeight": "400" }]
          }
        }
      }
    };
  </script>
  {% block extra_head %}{% endblock %}
</head>
<body class="bg-surface font-body-md text-on-surface antialiased {% block body_class %}{% endblock %}">
  <!-- Header -->
  <header class="fixed top-0 left-0 right-0 z-50 bg-surface-container-lowest/90 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)]">
    <div class="flex flex-col justify-between max-w-7xl mx-auto px-6 lg:px-12">
      <div class="flex items-center justify-between min-h-[5rem] py-2">
        <div class="flex items-center gap-space-md">
          <a href="/">
            <img alt="DUE Logo" class="h-16 sm:h-20 w-auto object-contain py-1 drop-shadow-sm transition-all" src="https://lh3.googleusercontent.com/aida-public/AB6AXuC0SZKiA3qgvDQxaYkxsR3w1ej_sMxTuegQNml68FZ966VgfiyacVxxCVBp1S46Q8ZfFcj89zJFmRbki2mFVxwDK3mA_1FmeZlpvSq9GsILj2z2HzeolTI-1aztUgTZFmj50c5hiIbGUH4ETZRF2d42e6mKwe70Fwob0_OrZ8Y8qXAT69PRCagSk7LI9OJze_odv3CZfAw5_B28JRczw9Dj1w2HYnD-Z0VxQ9a8E-IZYEvv1QN0wLCekQ">
          </a>
        </div>
        <div class="flex items-center gap-space-md">
          <div class="relative hidden md:block w-72">
            <input class="w-full pl-10 pr-4 py-2 bg-surface-container-low text-on-surface rounded-full font-body-sm text-body-sm focus:outline-none focus:ring-2 focus:ring-secondary-container transition-all" placeholder="Tìm kiếm..." type="text">
            <span class="material-symbols-outlined absolute left-3 top-2.5 text-outline text-[18px]">search</span>
          </div>
          {% if user.is_authenticated %}
          <div class="relative group">
            <button class="flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-primary-container text-white text-xs sm:text-sm font-bold shadow-sm hover:bg-primary transition-all cursor-pointer">
              <span class="material-symbols-outlined text-[18px]">account_circle</span>
              <span>{{ user.first_name|default:user.username }}</span>
              <span class="material-symbols-outlined text-[16px]">expand_more</span>
            </button>
            <div class="absolute right-0 top-full pt-1 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 min-w-[200px]">
              <div class="bg-white rounded-2xl shadow-xl border border-slate-200 py-2 overflow-hidden">
                <div class="px-4 py-2 border-b border-slate-100 text-[11px] text-slate-500">
                  Đăng nhập: <strong class="text-slate-800">{{ user.username }}</strong>
                </div>
                {% if user.is_staff %}
                <a href="/admin/" class="flex items-center gap-2.5 px-4 py-2.5 text-xs sm:text-sm text-slate-700 hover:bg-slate-50 hover:text-primary transition-colors font-semibold">
                  <span class="material-symbols-outlined text-[18px] text-blue-600">dashboard</span>
                  <span>Trang quản trị Admin</span>
                </a>
                {% endif %}
                <a href="{% url 'admissions:logout' %}" class="flex items-center gap-2.5 px-4 py-2.5 text-xs sm:text-sm text-red-600 hover:bg-red-50 transition-colors font-semibold">
                  <span class="material-symbols-outlined text-[18px]">logout</span>
                  <span>Đăng xuất</span>
                </a>
              </div>
            </div>
          </div>
          {% else %}
          <!-- Authentication và login Popover Dropdown -->
          <div class="relative" id="dueLoginContainer">
            <div class="flex items-center gap-1.5 sm:gap-2">
              <button type="button" onclick="toggleDueLoginPopover(event)" class="text-[#0056b3] hover:text-[#003d82] text-xs sm:text-sm font-semibold transition-colors cursor-pointer py-1 px-1">
                Đăng nhập
              </button>
              <button type="button" onclick="toggleDueLoginPopover(event)" id="dueAvatarBtn" class="w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-white hover:bg-slate-50 border border-slate-300 flex items-center justify-center transition-all shadow-sm cursor-pointer relative" title="Đăng nhập tài khoản">
                <svg class="w-5 h-5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm0 18a8 8 0 0 1-5.5-2.2c.3-1.6 1.8-2.8 3.5-2.8h4c1.7 0 3.2 1.2 3.5 2.8A8 8 0 0 1 12 20z"></path>
                  <circle cx="12" cy="9" r="3.2"></circle>
                </svg>
              </button>
            </div>

            <!-- THE EXACT POPOVER CARD AS IN SCREENSHOT -->
            <div id="dueLoginPopover" class="hidden absolute right-0 top-full mt-2 w-[285px] sm:w-[310px] max-w-[calc(100vw-24px)] bg-white rounded-md shadow-[0_10px_25px_-5px_rgba(0,0,0,0.25),0_8px_10px_-6px_rgba(0,0,0,0.15)] border border-slate-200 z-[120] text-slate-800 transition-all select-none">
              
              <!-- Upward Caret Pointer pointing directly up to the avatar -->
              <div class="absolute -top-[7px] right-[13px] sm:right-[15px] w-3.5 h-3.5 bg-white border-t border-l border-slate-200 transform rotate-45 z-20"></div>

              <div class="relative z-10 pt-4 px-4 pb-0">
                <!-- Feedback Alert inside Popover -->
                <div id="popoverAlert" class="hidden mb-3 p-2 rounded text-xs leading-normal"></div>

                <form id="dueLoginForm" onsubmit="handleDueLoginSubmit(event)">
                  <!-- Tên đăng nhập -->
                  <div class="relative mb-3">
                    <input type="text" id="p_username" name="username" placeholder="Tên đăng nhập" required autocomplete="username"
                           class="w-full px-3 py-2 pr-9 text-xs sm:text-sm text-slate-800 bg-white border border-[#ced4da] rounded focus:outline-none focus:border-[#0056b3] focus:ring-1 focus:ring-[#0056b3] placeholder:text-slate-400 transition-colors">
                    <span class="absolute inset-y-0 right-0 flex items-center pr-2.5 pointer-events-none text-slate-400">
                      <!-- User silhouette icon like the screenshot -->
                      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"></path>
                      </svg>
                    </span>
                  </div>

                  <!-- Mật khẩu -->
                  <div class="relative mb-3">
                    <input type="password" id="p_password" name="password" placeholder="Mật khẩu" required autocomplete="current-password"
                           class="w-full px-3 py-2 pr-9 text-xs sm:text-sm text-slate-800 bg-white border border-[#ced4da] rounded focus:outline-none focus:border-[#0056b3] focus:ring-1 focus:ring-[#0056b3] placeholder:text-slate-400 transition-colors">
                    <span class="absolute inset-y-0 right-0 flex items-center pr-2.5 pointer-events-none text-slate-400">
                      <!-- Lock icon like the screenshot -->
                      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"></path>
                      </svg>
                    </span>
                  </div>

                  <!-- Ghi nhớ tài khoản -->
                  <div class="flex items-center mb-3">
                    <input id="p_remember" name="remember" type="checkbox" class="w-4 h-4 text-[#0056b3] border-slate-300 rounded focus:ring-[#0056b3] cursor-pointer">
                    <label for="p_remember" class="ml-2 text-xs text-slate-700 cursor-pointer select-none">Ghi nhớ tài khoản</label>
                  </div>

                  <!-- Demo accounts shortcut -->
                  <div class="flex items-center justify-between text-[11px] text-slate-500 mb-3 bg-[#f8f9fa] px-2 py-1 rounded border border-slate-200/70">
                    <span class="text-slate-400">Tài khoản mẫu:</span>
                    <div class="space-x-1 font-medium">
                      <button type="button" onclick="quickFillCreds('thisinh2026','thisinh123')" class="text-[#0056b3] hover:underline cursor-pointer">Thí sinh</button>
                      <span class="text-slate-300">|</span>
                      <button type="button" onclick="quickFillCreds('canbo','canbo123')" class="text-[#0056b3] hover:underline cursor-pointer">Cán bộ</button>
                      <span class="text-slate-300">|</span>
                      <button type="button" onclick="quickFillCreds('admin','admin123')" class="text-[#0056b3] hover:underline cursor-pointer">Admin</button>
                    </div>
                  </div>

                  <!-- LOGIN button (solid blue like screenshot) -->
                  <button type="submit" id="p_submit_btn" class="w-full py-2 px-4 bg-[#0056b3] hover:bg-[#004494] active:bg-[#003366] text-white font-bold text-sm rounded shadow-sm transition-colors cursor-pointer text-center">
                    Đăng nhập
                  </button>
                </form>
              </div>

              <!-- Quên mật khẩu footer section (exact as screenshot) -->
              <div class="bg-[#f8f9fa] px-4 py-2.5 border-t border-slate-200 mt-3 rounded-b-md text-left">
                <a href="javascript:void(0)" onclick="alert('Quý thí sinh hoặc cán bộ vui lòng liên hệ Ban Đào tạo và tuyển sinh DUE qua Hotline (0236) 3836 169 để được hỗ trợ cấp lại mật khẩu.')" class="text-xs text-[#0056b3] hover:underline font-normal">
                  Quên mật khẩu?
                </a>
              </div>
            </div>
          </div>
          {% endif %}
        </div>
      </div>
      <div class="h-12 flex items-center justify-between overflow-x-auto" style="overflow: visible;">
        <nav class="flex items-center gap-space-lg h-full" data-active-classes="text-secondary-container font-headline-sm border-b-2 border-secondary-container">
          <a class="h-full flex items-center font-label-lg text-label-lg uppercase whitespace-nowrap font-bold {% block nav_home %}text-on-surface-variant hover:text-primary-container{% endblock %}" data-path="trang-chu" href="/">TRANG CHỦ</a>
          <!-- GIỚI THIỆU - Dropdown -->
          <div class="relative h-full flex items-center" id="nav-gioithieu">
            <button
              class="h-full flex items-center gap-1 font-label-lg text-label-lg text-on-surface-variant hover:text-primary-container transition-colors uppercase whitespace-nowrap focus:outline-none cursor-pointer"
              aria-haspopup="true"
              aria-expanded="false"
              id="nav-gioithieu-btn"
              type="button"
            >
              GIỚI THIỆU
              <svg id="nav-gioithieu-chevron" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="transition:transform .2s;"><path d="M6 9l6 6 6-6"/></svg>
            </button>
          </div>
          <!-- THÔNG TIN TUYỂN SINH - Dropdown -->
          <div class="relative h-full flex items-center" id="nav-ttts">
            <button
              class="h-full flex items-center gap-1 font-label-lg text-label-lg text-on-surface-variant hover:text-primary-container transition-colors uppercase whitespace-nowrap focus:outline-none"
              aria-haspopup="true"
              aria-expanded="false"
              id="nav-ttts-btn"
            >
              THÔNG TIN TUYỂN SINH
              <svg id="nav-ttts-chevron" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="transition:transform .2s;"><path d="M6 9l6 6 6-6"/></svg>
            </button>
          </div>
          <!-- KHOA - Dropdown (Cơ cấu mới 2026: 8 Khoa + Viện ĐTQT) -->
          <div class="relative h-full flex items-center" id="nav-khoa">
            <button
              class="h-full flex items-center gap-1 font-label-lg text-label-lg uppercase whitespace-nowrap focus:outline-none {% block nav_khoa %}text-on-surface-variant hover:text-primary-container transition-colors{% endblock %}"
              aria-haspopup="true"
              aria-expanded="false"
              id="nav-khoa-btn"
              type="button"
            >
              KHOA
              <svg id="nav-khoa-chevron" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="transition:transform .2s;"><path d="M6 9l6 6 6-6"/></svg>
            </button>
          </div>
          <a class="h-full flex items-center font-label-lg text-label-lg uppercase whitespace-nowrap {% block nav_hocphi %}text-on-surface-variant hover:text-primary-container transition-colors{% endblock %}" data-path="hoc-phi" href="/hoc-phi/">HỌC PHÍ</a>
          <!-- DÀNH CHO SINH VIÊN - Dropdown -->
          <div class="relative h-full flex items-center" id="nav-dcsv">
            <button
              class="h-full flex items-center gap-1 font-label-lg text-label-lg text-on-surface-variant hover:text-primary-container transition-colors uppercase whitespace-nowrap focus:outline-none {% block nav_sinhvien %}{% endblock %}"
              aria-haspopup="true"
              aria-expanded="false"
              id="nav-dcsv-btn"
              type="button"
            >
              DÀNH CHO SINH VIÊN
              <svg id="nav-dcsv-chevron" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="transition:transform .2s;"><path d="M6 9l6 6 6-6"/></svg>
            </button>
          </div>
          <a class="h-full flex items-center font-label-lg text-label-lg uppercase whitespace-nowrap {% block nav_career %}text-on-surface-variant hover:text-primary-container transition-colors{% endblock %}" data-path="tu-van-chon-nganh" href="{% url 'admissions:career_advisory' %}">TƯ VẤN CHỌN NGÀNH</a>
          <a class="h-full flex items-center font-label-lg text-label-lg uppercase whitespace-nowrap {% block nav_chatbot %}text-on-surface-variant hover:text-primary-container transition-colors{% endblock %}" data-path="chat-ai" href="/chatbot/">CHAT VỚI DUE</a>
        </nav>
      </div>
    </div>
  </header>

      <!-- Dropdown panel for GIỚI THIỆU -->
  <div
    id="nav-gioithieu-dropdown"
    style="position:fixed;display:none;z-index:9999;width:245px;background:#fff;border-radius:12px;box-shadow:0 10px 30px rgba(0,0,0,0.12);border:1px solid #e2e8f0;padding:6px 0;"
    role="menu"
  >
    <a
      href="/lich-su-phat-trien/"
      class="due-dropdown-link"
      style="width:100%;display:flex;align-items:center;gap:12px;padding:10px 18px;text-decoration:none;font-size:14px;font-weight:600;color:#334155;transition:all .15s;"
      onmouseover="this.style.background='#eff6ff';this.style.color='#0072BC'"
