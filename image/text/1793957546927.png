          <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
            <!-- Left Hero Content -->
            <div class="lg:col-span-7 flex flex-col items-start gap-6">
              <h1 class="font-display-hero text-headline-lg-mobile sm:text-headline-lg lg:text-display-hero text-on-surface font-bold tracking-tight leading-[1.15]">
                Khởi đầu <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary-container via-surface-tint to-secondary-container">Tương Lai Vững Vàng</span> Tại DUE
              </h1>

              <p class="font-body-lg text-body-md sm:text-body-lg text-on-surface-variant max-w-2xl leading-relaxed">
                Trường Đại học Kinh tế - Đại học Đà Nẵng là trung tâm đào tạo, nghiên cứu khoa học kinh tế, quản trị hàng đầu miền Trung và cả nước. Nơi chắp cánh cho thế hệ công dân toàn cầu với chương trình đào tạo chuẩn quốc tế AUN-QA.
              </p>

              <!-- CTA Buttons -->
              <div class="flex flex-wrap items-center gap-4 pt-2 w-full sm:w-auto">
                                <a href="/khoa/" class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-secondary-container hover:bg-[#e0610f] text-white font-label-lg shadow-lg shadow-secondary-container/25 hover:shadow-xl transition-all duration-200 font-semibold">
                  <span class="material-symbols-outlined text-[20px]">school</span>
