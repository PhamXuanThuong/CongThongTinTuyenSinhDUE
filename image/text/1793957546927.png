    writer = csv.writer(response)
    writer.writerow(['ID', 'Họ tên', 'Giới tính', 'SĐT', 'Email', 'Trường THPT', 'Tỉnh/TP', 'Mã Holland', 'R', 'I', 'A', 'S', 'E', 'C', 'Ngành đề xuất', 'Ngày tạo'])
    for obj in queryset:
