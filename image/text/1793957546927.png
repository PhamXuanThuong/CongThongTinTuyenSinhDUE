    ],
    "level": "Khoa Luật",
    "faculty_id": "luat",
    "category": "Học thuật và chuyên ngành",
    "founded": "2012-08-10",
    "slogan": "Thượng tôn pháp luật – Vững vàng chuyên môn – Tự hào Sinh viên Luật",
    "description": "CLB Khoa học Pháp lý là câu lạc bộ học thuật trực thuộc Khoa Luật, Trường Đại học Kinh tế – ĐH Đà Nẵng. Với tôn chỉ thượng tôn pháp luật và tinh thần công lý, CLB là nơi rèn luyện kỹ năng phân tích luật, tư duy phản biện, kỹ năng tranh tụng thông qua mô hình 'Phiên tòa giả định' danh tiếng và các hội thảo nghiên cứu khoa học pháp lý thực tiễn.",
    "intro": "Cái nôi rèn giũa bản lĩnh của những luật gia tương lai, nơi lý thuyết pháp luật biến thành kỹ năng tranh tụng và giải quyết tranh chấp thực tế.",
    "mission": "Nâng cao năng lực nghiên cứu khoa học pháp lý, rèn luyện kỹ năng hành nghề luật và lan tỏa kiến thức pháp luật đến cộng đồng sinh viên.",
    "vision": "Trở thành câu lạc bộ học thuật Luật uy tín hàng đầu miền Trung, cung cấp nguồn nhân lực pháp lý chất lượng cao cho các tòa án, viện kiểm sát và công ty luật.",
    "departments": [
      {
        "name": "Ban Chuyên môn và tranh tụng",
        "desc": "Nghiên cứu hồ sơ vụ án, soạn thảo cáo trạng, bản luận cứ và chuẩn bị kịch bản cho các phiên tòa giả định."
      },
      {
        "name": "Ban Sự kiện và tuyên truyền",
        "desc": "Tổ chức các phiên tòa lưu động, diễn đàn pháp luật học đường và chiến dịch tuyên truyền văn hóa pháp lý."
      },
      {
        "name": "Ban Truyền thông và báo chí",
        "desc": "Sản xuất bản tin pháp luật 'Điểm tin Pháp lý', infographics giải thích điều luật và quản trị Fanpage."
      },
      {
        "name": "Ban Đối ngoại và nhân sự",
        "desc": "Kết nối với các Đoàn Luật sư, Tòa án, Viện kiểm sát và chăm sóc đời sống hội viên."
      }
    ],
    "highlights": [
      "Phiên tòa giả định (Moot Court) thường niên – Sự kiện học thuật quy mô lớn với sự tham gia của Thẩm phán và Luật sư thật",
      "Bản tin pháp lý 'Law Weekly' cập nhật những thay đổi mới nhất của hệ thống luật pháp Việt Nam",
      "Các chuyến đi thực tế tìm hiểu tại Tòa án nhân dân, Trại giam và Trung tâm Trợ giúp Pháp lý",
      "Tư vấn pháp luật miễn phí và diễn đàn giải đáp thắc mắc pháp lý dành cho sinh viên"
    ],
    "recent_activities": [
      "Tổ chức thành công Phiên tòa giả định số 14 chủ đề 'Trói Buộc' thu hút hơn 500 sinh viên tham dự",
      "Kỷ niệm 81 năm Ngày truyền thống Luật sư Việt Nam (10/10/2026)",
      "Đồng hành và hỗ trợ nhóm sinh viên Khoa Luật đạt giải cao tại giải thưởng sinh viên NCKH Euréka",
      "Tuyển thành viên khóa mới và công bố cơ cấu nhân sự nhiệm kỳ 2026–2027"
    ],
    "achievements": [
      "14 năm liên tiếp tổ chức thành công chuỗi Phiên tòa giả định được các cơ quan tư pháp đánh giá cao",
      "Nhiều thành viên đạt giải Nhất, Nhì Nghiên cứu khoa học cấp Trường, cấp Đại học Đà Nẵng và cấp Bộ",
      "Hàng trăm cựu thành viên hiện là Thẩm phán, Kiểm sát viên, Luật sư danh tiếng tại các hãng luật lớn"
    ],
    "recruitment": "Tuyển thành viên vào đầu năm học (tháng 9 – 10). Mở rộng cho sinh viên Luật và các bạn đam mê tìm hiểu pháp luật.",
    "recruitment_steps": [
      {
        "step": "Vòng 1",
        "title": "Đơn đăng ký trực tuyến",
        "desc": "Điền thông tin và trả lời câu hỏi tình huống pháp lý ngắn."
      },
      {
        "step": "Vòng 2",
        "title": "Kiểm tra kiến thức pháp lý",
