  <!-- Footer -->
  <footer class="w-full bg-[#ecf2f4] mt-0 pt-10 pb-6 border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10">
        <!-- Column 1: Info -->
        <div class="lg:col-span-2 flex flex-col gap-4">
          <div class="flex items-center gap-3">
            <span class="font-bold text-on-surface text-[17px] tracking-tight">TRƯỜNG ĐẠI HỌC KINH TẾ - ĐH ĐÀ NẴNG</span>
          </div>
          <p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">
            Trung tâm đào tạo đại học, sau đại học, nghiên cứu khoa học và tư vấn chuyển giao công nghệ trong lĩnh vực kinh tế, quản lý hàng đầu tại Việt Nam.
          </p>
          <div class="flex flex-col gap-2 font-body-sm text-on-surface-variant mt-1">
            <div class="flex items-start gap-2.5">
              <span class="material-symbols-outlined text-[18px] text-secondary-container shrink-0 mt-0.5">location_on</span>
              <span>71 Ngũ Hành Sơn, Bắc Mỹ An, Ngũ Hành Sơn, Đà Nẵng</span>
            </div>
            <div class="flex items-center gap-2.5">
              <span class="material-symbols-outlined text-[18px] text-secondary-container shrink-0">call</span>
              <span>(0236) 3836 169 - Tuyển sinh: (0236) 3950 110</span>
            </div>
            <div class="flex items-center gap-2.5">
              <span class="material-symbols-outlined text-[18px] text-secondary-container shrink-0">mail</span>
              <span>tuyensinh@due.edu.vn</span>
            </div>
          </div>
        </div>

        <!-- Column 2: Tìm hiểu về chúng tôi -->
        <div class="flex flex-col gap-3">
          <h4 class="font-bold text-on-surface text-[16px]">Tìm hiểu về chúng tôi</h4>
          <ul class="flex flex-col gap-2 text-on-surface-variant font-body-sm">
            <li class="hover:text-primary-container transition-colors"><a data-path="thong-tin-tuyen-sinh" href="#" class="">Thông tin tuyển sinh</a></li>
            <li class="hover:text-primary-container transition-colors"><a data-path="khoa" href="/khoa/" class="">Các chương trình đào tạo</a></li>
          </ul>
        </div>

        <!-- Column 3: Các liên kết khác -->
