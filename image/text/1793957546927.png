      <!-- ==================== BẢNG SO SÁNH TỔNG HỢP 3 LOẠI HÌNH ==================== -->
      <section class="mt-12 bg-surface-container-lowest rounded-3xl p-6 sm:p-8 shadow-sm border border-outline-variant/40">
        <div class="mb-6">
          <span class="text-xs uppercase font-bold text-secondary-container tracking-wider block">Bảng đối sánh trực quan</span>
          <h3 class="text-xl sm:text-2xl font-headline-md font-bold text-slate-900">So Sánh Đặc Điểm 3 Loại Hình Đào Tạo Tại DUE</h3>
          <p class="text-xs sm:text-sm text-slate-500 mt-1">Giúp thí sinh và phụ huynh dễ dàng lựa chọn chương trình phù hợp với năng lực ngoại ngữ và định hướng nghề nghiệp.</p>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse min-w-[750px]">
            <thead>
              <tr class="bg-primary-container text-white text-xs uppercase tracking-wider">
                <th class="py-4 px-5 rounded-tl-2xl w-1/4">Tiêu chí so sánh</th>
                <th class="py-4 px-5 w-1/4 bg-orange-600 text-white font-bold">Toàn phần tiếng Anh</th>
                <th class="py-4 px-5 w-1/4 bg-blue-700 text-white font-bold">Bán phần tiếng Anh</th>
                <th class="py-4 px-5 rounded-tr-2xl w-1/4 bg-emerald-700 text-white font-bold">Tiêu chuẩn</th>
              </tr>
            </thead>
            <tbody class="text-xs sm:text-sm divide-y divide-slate-200">
              <tr class="hover:bg-slate-50/70">
                <td class="py-3.5 px-5 font-bold text-slate-800 bg-slate-50/60">Tỷ lệ ngôn ngữ tiếng Anh</td>
                <td class="py-3.5 px-5 font-semibold text-orange-700">100% môn chuyên môn</td>
                <td class="py-3.5 px-5 font-semibold text-blue-700">30% - 50% môn chuyên ngành</td>
                <td class="py-3.5 px-5 text-slate-700">Tiếng Việt + Học phần TA chuyên ngành</td>
              </tr>
              <tr class="hover:bg-slate-50/70">
                <td class="py-3.5 px-5 font-bold text-slate-800 bg-slate-50/60">Điều kiện tiếng Anh đầu vào</td>
                <td class="py-3.5 px-5 text-slate-700">IELTS ≥ 5.5 / VSTEP Bậc 3-4 trở lên</td>
                <td class="py-3.5 px-5 text-slate-700">IELTS ≥ 4.5 - 5.0 / VSTEP Bậc 3 trở lên</td>
                <td class="py-3.5 px-5 text-slate-700">Không bắt buộc chứng chỉ quốc tế đầu vào</td>
              </tr>
              <tr class="hover:bg-slate-50/70">
                <td class="py-3.5 px-5 font-bold text-slate-800 bg-slate-50/60">Phương thức xét tuyển áp dụng</td>
                <td class="py-3.5 px-5 font-bold text-orange-800">Phương thức 1 và phương thức 2</td>
                <td class="py-3.5 px-5 font-bold text-blue-800">Phương thức 1 và phương thức 2</td>
                <td class="py-3.5 px-5 font-bold text-emerald-800">Phương thức 1, 3 và 4</td>
              </tr>
              <tr class="hover:bg-slate-50/70">
                <td class="py-3.5 px-5 font-bold text-slate-800 bg-slate-50/60">Số lượng và chỉ tiêu tuyển sinh</td>
                <td class="py-3.5 px-5 font-bold text-slate-800">4 chương trình (360 chỉ tiêu)</td>
                <td class="py-3.5 px-5 font-bold text-slate-800">13 chương trình (1.240 chỉ tiêu)</td>
