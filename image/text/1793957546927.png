    color: #334155;
    transition: all 0.15s ease;
    white-space: nowrap;
  }
  .sv-tab-btn:hover {
    background-color: #e2e8f0;
    color: #0072BC;
  }
  .sv-tab-btn.active {
    background-color: #dbeafe;
    color: #0072BC;
    font-weight: 700;
  }
  .sv-tab-bullet {
    font-size: 11px;
    margin-right: 8px;
    color: #64748b;
    flex-shrink: 0;
    line-height: 1;
  }
  .sv-tab-btn.active .sv-tab-bullet {
    color: #0072BC;
  }
  .sv-tab-name {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .sv-pane {
    animation: svFadeIn 0.2s ease forwards;
  }
  @keyframes svFadeIn {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>


--- FILE: CongthongtintuyensinhDUE/templates/portal/dormitory.html ---
{% extends 'layouts/base.html' %}

{% block title %}Hệ Thống Ký Túc Xá Sinh Viên - Trường Đại học Kinh tế DUE{% endblock %}

{% block nav_sinhvien %}text-secondary-container font-headline-sm border-b-2 border-secondary-container uppercase whitespace-nowrap font-bold{% endblock %}

{% block extra_head %}
<style>
  .ktx-card {
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .ktx-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 32px -4px rgba(0, 168, 89, 0.12);
  }
</style>
{% endblock %}

{% block content %}
<main class="w-full pt-32 sm:pt-36 pb-6 bg-surface min-h-[calc(100vh-28rem)] flex-1">
  <div class="max-w-7xl mx-auto px-6 lg:px-12 pt-8 pb-4">

    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs sm:text-sm text-on-surface-variant mb-6 font-medium">
      <a href="/" class="hover:text-primary-container transition-colors">Trang chủ</a>
      <span class="material-symbols-outlined text-[14px]">chevron_right</span>
      <a href="/sinh-vien/" class="hover:text-primary-container transition-colors">Dành cho sinh viên</a>
      <span class="material-symbols-outlined text-[14px]">chevron_right</span>
      <span class="text-secondary-container font-semibold">Ký túc xá sinh viên</span>
    </nav>

    <!-- Header Hero Banner -->
    <div class="bg-gradient-to-r from-[#003366] via-[#004f8c] to-[#00A859] rounded-3xl p-6 sm:p-10 text-white shadow-xl relative overflow-hidden mb-12">
      <div class="absolute -right-16 -top-16 w-80 h-80 rounded-full bg-emerald-400/20 blur-3xl pointer-events-none"></div>
      <div class="absolute -left-16 -bottom-16 w-80 h-80 rounded-full bg-blue-400/20 blur-3xl pointer-events-none"></div>

      <div class="relative z-10 max-w-3xl">
        <h1 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold font-headline-lg tracking-tight mb-3">
          Hệ Thống Ký Túc Xá Sinh Viên DUE
        </h1>

        <p class="text-slate-100 text-sm sm:text-base leading-relaxed mb-6">
          Môi trường sống <strong>an toàn, tiện nghi, văn minh và tiết kiệm tối đa chi phí</strong> dành cho sinh viên và tân sinh viên DUE. Với vị trí liền kề giảng đường, hệ thống phòng khép kín trang bị điều hòa, wifi tốc độ cao và an ninh 24/7, Ký túc xá là ngôi nhà thứ hai lý tưởng để bạn an tâm học tập.
        </p>

        <div class="flex flex-wrap items-center gap-3 text-xs sm:text-sm font-medium">
          <a href="#bang-gia" class="flex items-center gap-2 bg-[#fd761a] hover:bg-[#ea6509] text-white px-5 py-2.5 rounded-full shadow-md transition-all hover:scale-105 font-bold">
            <span class="material-symbols-outlined text-[18px]">payments</span>
            <span>Bảng giá và loại phòng</span>
          </a>
          <a href="#dang-ky" class="flex items-center gap-2 bg-white text-[#003366] hover:bg-slate-100 px-5 py-2.5 rounded-full shadow-md transition-all hover:scale-105 font-bold">
            <span class="material-symbols-outlined text-[18px]">how_to_reg</span>
            <span>Hướng dẫn đăng ký</span>
          </a>
          <div class="flex items-center gap-2 bg-white/10 px-4 py-2.5 rounded-full border border-white/15">
            <span class="font-bold text-amber-300">2.500+</span> Chỗ nội trú
          </div>
        </div>
      </div>
    </div>


    <!-- ====================================================
         1. GIỚI THIỆU 2 KHU KÝ TÚC XÁ CHÍNH
         ==================================================== -->
    <div class="mb-14">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <span class="px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold uppercase tracking-wider">Vị trí thuận tiện</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 font-headline-lg mt-2 mb-3">
          Hai Khu Ký Túc Xá Phục Vụ Sinh Viên DUE
        </h2>
        <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
          Tùy theo nhu cầu và sở thích, sinh viên có thể lựa chọn đăng ký nội trú tại KTX Khu Đông (nằm ngay sát khuôn viên trường) hoặc KTX Tập trung Thành phố.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        
        <!-- KHU 1: KTX KHU ĐÔNG NGŨ HÀNH SƠN -->
        <div class="ktx-card rounded-3xl bg-white border border-slate-200 p-6 sm:p-8 shadow-sm flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="px-3 py-1 rounded-full bg-blue-100 text-[#003366] font-bold text-xs uppercase">
                Đi bộ 3 phút đến trường
              </span>
              <span class="text-xs text-emerald-600 font-bold flex items-center gap-1">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                Ưu tiên Tân sinh viên K50K
              </span>
            </div>

            <div class="w-full h-48 rounded-2xl overflow-hidden mb-5 bg-slate-100 relative">
              <img 
                src="/static/img/khoa/tcnh_gallery_2.jpg" 
                alt="KTX Khu Đông DUE" 
                class="w-full h-full object-cover"
                onerror="this.onerror=null; this.src='/static/img/khoa/tcnh_cover.jpg';"
              />
              <div class="absolute bottom-3 left-3 bg-slate-900/80 backdrop-blur-sm text-white px-3 py-1 rounded-xl text-xs font-semibold">
                Khuôn viên KTX Khu Đông
              </div>
            </div>

            <h3 class="text-xl font-bold text-slate-900 mb-2">KTX Khu Đông Ngũ Hành Sơn</h3>
            <p class="text-xs text-slate-500 mb-4 flex items-center gap-1">
              <span class="material-symbols-outlined text-[16px] text-slate-400">location_on</span>
              <span>Đường Doãn Uẩn, Liền kề cổng sau Trường ĐH Kinh tế DUE</span>
            </p>

            <ul class="text-xs sm:text-sm text-slate-600 space-y-2 mb-6">
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-emerald-600 text-[18px] shrink-0 mt-0.5">check_circle</span>
                <span><strong>Quy mô:</strong> Tòa nhà 6 tầng kiên cố, hơn 1.200 chỗ ở, bảo vệ 24/24.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-emerald-600 text-[18px] shrink-0 mt-0.5">check_circle</span>
                <span><strong>Trang bị:</strong> Giường tầng chắc chắn, bàn học cá nhân, điều hòa nhiệt độ, bình nóng lạnh.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-emerald-600 text-[18px] shrink-0 mt-0.5">check_circle</span>
                <span><strong>Tiện ích liền kề:</strong> Căng tin sinh viên, sân bóng mini cỏ nhân tạo, thư viện tự học.</span>
              </li>
            </ul>
          </div>

          <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
            <div>
              <span class="text-[11px] text-slate-400 block uppercase font-bold">Mức phí nội trú</span>
              <span class="text-base font-extrabold text-[#00A859]">250.000đ – 450.000đ<span class="text-xs text-slate-500 font-normal">/tháng</span></span>
            </div>
            <a href="#dang-ky" class="px-4 py-2 rounded-xl bg-[#003366] hover:bg-[#002244] text-white text-xs font-bold transition-colors">
              Đăng ký khu này
            </a>
          </div>
        </div>

        <!-- KHU 2: KTX TẬP TRUNG THÀNH PHỐ ĐÀ NẴNG -->
        <div class="ktx-card rounded-3xl bg-white border border-slate-200 p-6 sm:p-8 shadow-sm flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="px-3 py-1 rounded-full bg-purple-100 text-purple-800 font-bold text-xs uppercase">
                Hiện đại và chuẩn Quốc tế
              </span>
              <span class="text-xs text-blue-600 font-bold flex items-center gap-1">
                <span class="material-symbols-outlined text-[16px]">directions_bus</span>
                Tuyến xe buýt tận cổng
              </span>
            </div>

            <div class="w-full h-48 rounded-2xl overflow-hidden mb-5 bg-slate-100 relative">
              <img 
                src="/static/img/khoa/tcnh_gallery_1.jpg" 
                alt="KTX Tập trung Sinh viên" 
                class="w-full h-full object-cover"
                onerror="this.onerror=null; this.src='/static/img/khoa/tcnh_cover.jpg';"
              />
              <div class="absolute bottom-3 left-3 bg-slate-900/80 backdrop-blur-sm text-white px-3 py-1 rounded-xl text-xs font-semibold">
                Khu Đô thị KTX Sinh viên TP
              </div>
            </div>

            <h3 class="text-xl font-bold text-slate-900 mb-2">KTX Sinh Viên Tập Trung TP. Đà Nẵng</h3>
            <p class="text-xs text-slate-500 mb-4 flex items-center gap-1">
              <span class="material-symbols-outlined text-[16px] text-slate-400">location_on</span>
              <span>Khu Đô thị Nam Cẩm Lệ / Khu Tây Bắc, kết nối thẳng xe buýt trợ giá đến DUE</span>
            </p>

            <ul class="text-xs sm:text-sm text-slate-600 space-y-2 mb-6">
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-emerald-600 text-[18px] shrink-0 mt-0.5">check_circle</span>
                <span><strong>Quy mô:</strong> Cụm chung cư cao tầng hiện đại bậc nhất miền Trung với sức chứa 3.000+ sinh viên.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-emerald-600 text-[18px] shrink-0 mt-0.5">check_circle</span>
                <span><strong>Môi trường:</strong> Ban công thoáng mát, thang máy thẻ từ, khu tự học thông minh có điều hòa.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="material-symbols-outlined text-emerald-600 text-[18px] shrink-0 mt-0.5">check_circle</span>
                <span><strong>Sinh hoạt:</strong> Siêu thị tiện lợi, phòng tập Gym, sân thể thao đa môn, máy giặt công cộng.</span>
              </li>
            </ul>
          </div>

          <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
            <div>
              <span class="text-[11px] text-slate-400 block uppercase font-bold">Mức phí nội trú</span>
              <span class="text-base font-extrabold text-[#00A859]">350.000đ – 650.000đ<span class="text-xs text-slate-500 font-normal">/tháng</span></span>
            </div>
            <a href="#dang-ky" class="px-4 py-2 rounded-xl bg-[#00A859] hover:bg-[#008f4c] text-white text-xs font-bold transition-colors">
              Đăng ký khu này
            </a>
          </div>
        </div>

      </div>
    </div>


    <!-- ====================================================
         2. BẢNG GIÁ và CÁC LOẠI PHÒNG (MINH BẠCH)
         ==================================================== -->
    <div id="bang-gia" class="mb-14 scroll-mt-36">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <span class="px-3 py-1 rounded-full bg-blue-100 text-[#003366] text-xs font-bold uppercase tracking-wider">Minh bạch và trợ giá</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 font-headline-lg mt-2 mb-3">
          Bảng Giá và các Loại Phòng Năm Học 2026
        </h2>
        <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
          Mức phí được Nhà nước và Trường Đại học Kinh tế trợ giá nhằm hỗ trợ tối đa cho sinh viên yên tâm học tập:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <!-- Loại 1: Phòng Tiêu Chuẩn 8 Người -->
        <div class="p-6 rounded-3xl bg-white border border-slate-200 shadow-sm flex flex-col justify-between hover:border-emerald-300 transition-all">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="px-2.5 py-1 rounded-full bg-slate-100 text-slate-700 text-xs font-bold">Phổ thông</span>
              <span class="text-xs text-slate-400 font-mono">8 Sinh viên/phòng</span>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-1">Phòng Tiêu Chuẩn 8 Giường</h3>
            <p class="text-xs text-slate-500 mb-4">Lựa chọn tiết kiệm nhất cho sinh viên</p>
            <div class="text-2xl font-extrabold text-emerald-600 mb-4">
              250.000đ <span class="text-xs text-slate-400 font-normal">/ tháng / sinh viên</span>
            </div>
            <ul class="text-xs text-slate-600 space-y-2 mb-6">
              <li class="flex items-center gap-2">
                <span class="material-symbols-outlined text-emerald-500 text-[16px]">check</span>
                <span>Quạt trần và thông gió tự nhiên</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="material-symbols-outlined text-emerald-500 text-[16px]">check</span>
                <span>Nhà vệ sinh và phòng tắm khép kín</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="material-symbols-outlined text-emerald-500 text-[16px]">check</span>
                <span>Bàn học và tủ đồ cá nhân</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="material-symbols-outlined text-emerald-500 text-[16px]">check</span>
                <span>Wifi miễn phí toàn phòng</span>
              </li>
            </ul>
          </div>
          <a href="#dang-ky" class="w-full text-center py-2.5 rounded-xl border border-emerald-600 text-emerald-700 hover:bg-emerald-50 text-xs font-bold transition-colors">
            Đăng ký loại 8 người
          </a>
        </div>

        <!-- Loại 2: Phòng Tiện Nghi 6 Người (Có Điều Hòa) - Nổi Bật -->
        <div class="p-6 rounded-3xl bg-gradient-to-b from-emerald-50/60 to-white border-2 border-emerald-500 shadow-lg flex flex-col justify-between relative">
          <div class="absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-0.5 rounded-full bg-emerald-600 text-white text-[11px] font-bold uppercase tracking-wider shadow-sm">
            Đăng ký nhiều nhất
          </div>
          <div>
            <div class="flex items-center justify-between mb-3 mt-2">
              <span class="px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold">Tiện nghi cao</span>
              <span class="text-xs text-emerald-700 font-mono">6 Sinh viên/phòng</span>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-1">Phòng Tiện Nghi Điều Hòa</h3>
            <p class="text-xs text-slate-500 mb-4">Cân bằng hoàn hảo giữa tiện nghi và chi phí</p>
            <div class="text-2xl font-extrabold text-emerald-600 mb-4">
              450.000đ <span class="text-xs text-slate-400 font-normal">/ tháng / sinh viên</span>
            </div>
            <ul class="text-xs text-slate-600 space-y-2 mb-6">
              <li class="flex items-center gap-2">
                <span class="material-symbols-outlined text-emerald-600 text-[16px]">check</span>
                <span><strong>Điều hòa nhiệt độ Inverter 2 chiều</strong></span>
              </li>
              <li class="flex items-center gap-2">
                <span class="material-symbols-outlined text-emerald-600 text-[16px]">check</span>
                <span><strong>Bình nước nóng năng lượng mặt trời</strong></span>
              </li>
              <li class="flex items-center gap-2">
                <span class="material-symbols-outlined text-emerald-600 text-[16px]">check</span>
                <span>Nhà vệ sinh khép kín sạch sẽ</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="material-symbols-outlined text-emerald-600 text-[16px]">check</span>
                <span>Bàn học cá nhân có giá sách riêng</span>
              </li>
            </ul>
          </div>
          <a href="#dang-ky" class="w-full text-center py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold shadow-md transition-all hover:scale-[1.02]">
            Đăng ký loại 6 người
          </a>
        </div>

        <!-- Loại 3: Phòng 4 Người VIP -->
        <div class="p-6 rounded-3xl bg-white border border-slate-200 shadow-sm flex flex-col justify-between hover:border-emerald-300 transition-all">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="px-2.5 py-1 rounded-full bg-purple-100 text-purple-800 text-xs font-bold">Cao cấp VIP</span>
              <span class="text-xs text-slate-400 font-mono">4 Sinh viên/phòng</span>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-1">Phòng Cao Cấp 4 Người</h3>
            <p class="text-xs text-slate-500 mb-4">Không gian rộng rãi, yên tĩnh tối đa</p>
            <div class="text-2xl font-extrabold text-purple-700 mb-4">
              650.000đ <span class="text-xs text-slate-400 font-normal">/ tháng / sinh viên</span>
            </div>
            <ul class="text-xs text-slate-600 space-y-2 mb-6">
              <li class="flex items-center gap-2">
                <span class="material-symbols-outlined text-emerald-500 text-[16px]">check</span>
                <span>Chỉ 4 sinh viên, không gian cực kỳ yên tĩnh</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="material-symbols-outlined text-emerald-500 text-[16px]">check</span>
                <span>Điều hòa + Bình nóng lạnh + Tủ lạnh mini</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="material-symbols-outlined text-emerald-500 text-[16px]">check</span>
                <span>Ban công riêng phơi đồ đón gió biển</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="material-symbols-outlined text-emerald-500 text-[16px]">check</span>
                <span>Ưu tiên sinh viên NCKH và học vượt</span>
              </li>
            </ul>
          </div>
          <a href="#dang-ky" class="w-full text-center py-2.5 rounded-xl border border-purple-600 text-purple-700 hover:bg-purple-50 text-xs font-bold transition-colors">
            Đăng ký loại 4 người
          </a>
        </div>

      </div>
    </div>


    <!-- ====================================================
         3. HỆ THỐNG TIỆN ÍCH NỘI KHU KTX
         ==================================================== -->
    <div class="mb-14 p-6 sm:p-10 rounded-3xl bg-slate-50 border border-slate-200">
      <div class="max-w-3xl mb-8">
        <span class="px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold uppercase">Hệ sinh thái tiện nghi</span>
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 font-headline-md mt-2">
          Tiện Ích và hoạt Động Thể Thao Tại Ký Túc Xá
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="p-4 rounded-2xl bg-white border border-slate-200/80 shadow-xs">
          <div class="w-10 h-10 rounded-xl bg-orange-100 text-orange-600 flex items-center justify-center mb-3">
            <span class="material-symbols-outlined text-[22px]">restaurant</span>
          </div>
          <h4 class="font-bold text-slate-800 text-sm mb-1">Căng Tin và nhà Ăn 3 Bữa</h4>
          <p class="text-xs text-slate-500 leading-relaxed">Suất ăn 20.000đ – 30.000đ đảm bảo chuẩn Vệ sinh An toàn Thực phẩm của Bộ Y tế.</p>
        </div>

        <div class="p-4 rounded-2xl bg-white border border-slate-200/80 shadow-xs">
          <div class="w-10 h-10 rounded-xl bg-green-100 text-green-600 flex items-center justify-center mb-3">
            <span class="material-symbols-outlined text-[22px]">sports_soccer</span>
          </div>
          <h4 class="font-bold text-slate-800 text-sm mb-1">Sân Thể Thao Đa Năng</h4>
          <p class="text-xs text-slate-500 leading-relaxed">Sân bóng đá cỏ nhân tạo, bóng rổ, cầu lông mở cửa miễn phí cho cư dân KTX rèn luyện.</p>
        </div>

        <div class="p-4 rounded-2xl bg-white border border-slate-200/80 shadow-xs">
          <div class="w-10 h-10 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center mb-3">
            <span class="material-symbols-outlined text-[22px]">local_laundry_service</span>
          </div>
          <h4 class="font-bold text-slate-800 text-sm mb-1">Khu Giặt Tự Động</h4>
          <p class="text-xs text-slate-500 leading-relaxed">Hệ thống máy giặt sấy thông minh quẹt mã QR, giặt sạch sấy khô nhanh chóng.</p>
        </div>

        <div class="p-4 rounded-2xl bg-white border border-slate-200/80 shadow-xs">
          <div class="w-10 h-10 rounded-xl bg-purple-100 text-purple-600 flex items-center justify-center mb-3">
            <span class="material-symbols-outlined text-[22px]">shield</span>
          </div>
          <h4 class="font-bold text-slate-800 text-sm mb-1">An Ninh 24/7</h4>
          <p class="text-xs text-slate-500 leading-relaxed">Camera an ninh toàn khuôn viên, bảo vệ túc trực 24/24, kiểm soát ra vào bằng thẻ từ thông minh.</p>
        </div>
      </div>
    </div>


    <!-- ====================================================
         4. QUY TRÌNH và HƯỚNG DẪN ĐĂNG KÝ (STEP-BY-STEP)
         ==================================================== -->
    <div id="dang-ky" class="mb-14 scroll-mt-36">
      <div class="p-6 sm:p-10 rounded-3xl bg-white border border-slate-200 shadow-sm">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-8 pb-6 border-b border-slate-100">
          <div>
            <span class="px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-bold uppercase">Hồ sơ đơn giản</span>
            <h2 class="text-xl sm:text-2xl font-bold text-slate-900 font-headline-md mt-2">
              Quy Trình 3 Bước Đăng Ký Nội Trú KTX
            </h2>
          </div>
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-[#00A859] text-[20px]">phone_in_talk</span>
            <span class="text-xs text-slate-500 font-medium">Hotline Ban Quản lý KTX: <strong class="text-slate-800">0236 3836 999</strong></span>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200/70">
            <div class="w-8 h-8 rounded-full bg-[#003366] text-white flex items-center justify-center font-bold text-sm mb-3">1</div>
            <h4 class="font-bold text-slate-900 text-sm mb-1.5">Đăng ký trực tuyến</h4>
            <p class="text-xs text-slate-600 leading-relaxed">
              Điền thông tin và lựa chọn loại phòng mong muốn tại Cổng thông tin Tuyển sinh DUE hoặc liên hệ hotline ban quản lý.
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200/70">
            <div class="w-8 h-8 rounded-full bg-[#00A859] text-white flex items-center justify-center font-bold text-sm mb-3">2</div>
            <h4 class="font-bold text-slate-900 text-sm mb-1.5">Xét duyệt và báo phòng</h4>
            <p class="text-xs text-slate-600 leading-relaxed">
              Ban quản lý KTX gửi thông báo kết quả duyệt phòng, số phòng và số giường qua Email và SMS trong vòng 24 giờ.
            </p>
          </div>

          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200/70">
            <div class="w-8 h-8 rounded-full bg-[#fd761a] text-white flex items-center justify-center font-bold text-sm mb-3">3</div>
            <h4 class="font-bold text-slate-900 text-sm mb-1.5">Nộp hồ sơ và nhận phòng</h4>
            <p class="text-xs text-slate-600 leading-relaxed">
              Mang theo CCCD và Giấy báo trúng tuyển đến Văn phòng KTX Khu Đông để ký hợp đồng và nhận chìa khóa phòng.
            </p>
          </div>
        </div>

        <div class="mt-8 pt-6 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <p class="text-xs text-slate-500">
            * Thời gian tiếp nhận đăng ký: Mở liên tục từ ngày công bố điểm chuẩn trúng tuyển đến hết đợt nhập học.
          </p>
          <a href="tel:02363836999" class="inline-flex items-center justify-center gap-2 px-6 py-2.5 rounded-full bg-[#00A859] hover:bg-[#008f4c] text-white font-bold text-xs shadow-md transition-all hover:scale-105">
            <span class="material-symbols-outlined text-[18px]">call</span>
            <span>Gọi Tư Vấn KTX: (0236) 3836 999</span>
          </a>
        </div>
      </div>
    </div>

  </div>
</main>
{% endblock %}



--- FILE: CongthongtintuyensinhDUE/templates/portal/enrollment_guide.html ---
{% extends 'layouts/base.html' %}

{% block title %}Hướng dẫn nhập học - Cổng thông tin tuyển sinh DUE{% endblock %}

{% block content %}
<main class="w-full pt-32 sm:pt-36 pb-6 bg-surface min-h-[calc(100vh-28rem)] flex-1">
  <div class="max-w-7xl mx-auto px-6 lg:px-12 pt-8 pb-4">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs sm:text-sm text-on-surface-variant mb-6 font-medium">
      <a href="/" class="hover:text-primary-container transition-colors">Trang chủ</a>
      <span class="material-symbols-outlined text-[14px]">chevron_right</span>
      <span>Thông tin tuyển sinh</span>
      <span class="material-symbols-outlined text-[14px]">chevron_right</span>
      <span class="text-secondary-container font-semibold">Hướng dẫn nhập học</span>
    </nav>

    <!-- Header Banner -->
    <div class="bg-gradient-to-r from-[#003366] via-[#0056b3] to-[#0072BC] rounded-3xl p-6 sm:p-10 text-white shadow-xl mb-8 relative overflow-hidden">
      <div class="absolute -right-10 -bottom-10 w-60 h-60 rounded-full bg-white/10 blur-2xl pointer-events-none"></div>
      <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div>
          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight">Hướng Dẫn Nhập Học Chi Tiết</h1>
          <p class="text-white/85 text-sm sm:text-base mt-2 max-w-2xl leading-relaxed">
            Quy trình kê khai thông tin trực tuyến, đóng học phí, hồ sơ cần nộp và chuẩn bị đón năm học mới tại Trường Đại học Kinh tế - ĐH Đà Nẵng.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row md:flex-col gap-3 shrink-0">
          <a href="/lich-trinh-tan-sinh-vien/" class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-full bg-white/15 hover:bg-white/25 text-white font-semibold text-xs sm:text-sm backdrop-blur-md border border-white/20 transition-all">
            <span class="material-symbols-outlined text-[18px]">calendar_month</span>
            <span>Xem Lịch trình Tân SV</span>
          </a>
          <a href="http://nhaphoc.due.udn.vn" target="_blank" class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-full bg-[#f37021] hover:bg-[#e0610f] text-white font-bold text-xs sm:text-sm shadow-md transition-all">
            <span class="material-symbols-outlined text-[18px]">open_in_new</span>
            <span>Cổng nhập học trực tuyến</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Main Content Card -->
    <div class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200/80 shadow-md">
      {% include 'portal/components/enrollment_guide_content.html' %}
    </div>
  </div>
</main>
{% endblock %}


--- FILE: CongthongtintuyensinhDUE/templates/portal/faculties.html ---
{% extends 'layouts/base.html' %}

{% block title %}Khoa Đào Tạo và đơn Vị Chuyên Môn - Trường Đại học Kinh tế (DUE) 2026{% endblock %}

{% block nav_khoa %}text-secondary-container font-headline-sm border-b-2 border-secondary-container uppercase whitespace-nowrap font-bold{% endblock %}

{% block extra_head %}
<style>
  .faculty-card-modern {
    transition: all .25s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .faculty-card-modern:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 32px -4px rgba(0, 51, 102, 0.12);
  }
</style>
{% endblock %}

{% block content %}
<main class="w-full pt-32 sm:pt-36 pb-6 bg-surface min-h-[calc(100vh-28rem)] flex-1">
  <div class="max-w-7xl mx-auto px-6 lg:px-12 pt-8 pb-4">

    <!-- Breadcrumb và header Hero -->
    <div class="mb-10">
      <nav class="flex items-center gap-2 text-xs sm:text-sm text-on-surface-variant mb-6 font-medium">
        <a href="/" class="hover:text-primary-container transition-colors">Trang chủ</a>
        <span class="material-symbols-outlined text-[14px]">chevron_right</span>
        <span class="text-secondary-container font-semibold">Khoa và phòng ban</span>
      </nav>
      
      <div class="bg-gradient-to-r from-[#001e40] via-[#003366] to-[#004b73] rounded-3xl p-6 sm:p-10 text-white shadow-xl relative overflow-hidden">
        <div class="absolute -right-16 -top-16 w-80 h-80 rounded-full bg-white/10 blur-3xl pointer-events-none"></div>
        <div class="relative z-10 max-w-3xl">
          <h1 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold font-headline-lg tracking-tight mb-3">
            Hệ Thống Khoa và viện Đào Tạo DUE
          </h1>
          <p class="text-slate-200 text-sm sm:text-base leading-relaxed mb-6">
            Khám phá <strong>8 Khoa chuyên môn và Viện Đào tạo Quốc tế</strong> với 39 ngành và chuyên ngành đào tạo đạt chuẩn quốc tế AUN-QA. Bấm vào từng khoa để khám phá <strong>chương trình đào tạo chi tiết, học vị, cơ hội nghề nghiệp và liên hệ trực tiếp với Thầy/Cô tư vấn</strong>.
          </p>
          <div class="flex flex-wrap items-center gap-3 text-xs sm:text-sm font-medium">
            <a href="https://www.facebook.com/FaceDue" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 bg-[#1877F2] hover:bg-[#166fe5] text-white px-4 py-2.5 rounded-full shadow-md transition-all">
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.469h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"></path></svg>
              <span>Fanpage DUE Tuyển sinh</span>
            </a>
            <div class="flex items-center gap-2 bg-white/10 px-4 py-2.5 rounded-full border border-white/15">
              <span class="font-bold text-amber-300">8</span> Khoa Đào tạo + <span class="font-bold text-cyan-300">1</span> Viện ĐTQT
            </div>
            <div class="flex items-center gap-2 bg-white/10 px-4 py-2.5 rounded-full border border-white/15">
              <span class="font-bold text-green-300">39</span> Chuyên ngành năm 2026
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Thanh tìm kiếm và lọc nhanh theo Khối ngành -->
    <div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
      <!-- Search Input -->
      <div class="relative w-full md:w-80">
        <input 
          type="text" 
          id="facultySearchInput" 
          placeholder="Tìm tên khoa, chuyên ngành..." 
          class="w-full pl-10 pr-4 py-2.5 rounded-full border border-slate-200 bg-white text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#003366] shadow-sm transition-all"
        />
        <span class="material-symbols-outlined absolute left-3 top-2.5 text-slate-400 text-[20px]">search</span>
      </div>

      <!-- Category Filter Pills -->
      <div class="flex items-center gap-2 overflow-x-auto no-scrollbar py-1 text-xs font-semibold">
        <button class="filter-btn active px-3.5 py-1.5 rounded-full bg-[#003366] text-white shadow-sm transition-all" data-filter="all">
          Tất cả ({{ faculty_count }})
        </button>
        <button class="filter-btn px-3.5 py-1.5 rounded-full bg-slate-100 text-slate-600 hover:bg-slate-200 transition-all" data-filter="kinh-te-tai-chinh">
          Tài chính và kinh tế
        </button>
        <button class="filter-btn px-3.5 py-1.5 rounded-full bg-slate-100 text-slate-600 hover:bg-slate-200 transition-all" data-filter="quan-tri-du-lich">
          Quản trị và du lịch
        </button>
        <button class="filter-btn px-3.5 py-1.5 rounded-full bg-slate-100 text-slate-600 hover:bg-slate-200 transition-all" data-filter="cong-nghe-so">
          Công nghệ số và TMĐT
        </button>
        <button class="filter-btn px-3.5 py-1.5 rounded-full bg-slate-100 text-slate-600 hover:bg-slate-200 transition-all" data-filter="luat-ly-luan">
          Luật và lý luận
        </button>
        <button class="filter-btn px-3.5 py-1.5 rounded-full bg-slate-100 text-slate-600 hover:bg-slate-200 transition-all" data-filter="quoc-te">
          Quốc tế
        </button>
      </div>
    </div>


    <!-- ====================================================
         DANH SÁCH 9 KHOA và VIỆN ĐÀO TẠO NĂM 2026
         (Mỗi thẻ chuyển thẳng sang trang riêng /khoa/<id>/)
         ==================================================== -->
    <div class="mb-20">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="facultiesGrid">
        {% for f in faculties %}
        <div 
          class="faculty-item faculty-card-modern bg-white rounded-3xl border border-slate-200/90 overflow-hidden shadow-sm flex flex-col justify-between group"
          data-id="{{ f.id }}"
          data-name="{{ f.name|lower }}"
          data-slogan="{{ f.slogan|lower }}"
          data-keywords="{{ f.formed_from|lower }} {% for m in f.majors_2026 %}{{ m.name|lower }} {{ m.major_name|lower }} {% endfor %}"
          data-category="{% if f.id == 'tcnh' or f.id == 'kt' or f.id == 'ketoan' %}kinh-te-tai-chinh{% elif f.id == 'dlkdqt' or f.id == 'qtkd' %}quan-tri-du-lich{% elif f.id == 'tmdt_mkt_cns' %}cong-nghe-so{% elif f.id == 'luat' or f.id == 'llct' %}luat-ly-luan{% elif f.id == 'vdtqt' %}quoc-te{% else %}all{% endif %}"
        >
          <!-- Top Cover Banner -->
          <div class="relative h-44 bg-slate-800 overflow-hidden">
            <img 
              src="{{ f.cover_url }}" 
              alt="{{ f.name }}" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-70"
              onerror="this.onerror=null; this.src='/static/img/khoa/tcnh_cover.jpg';"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
            
            <!-- Category Badge -->
            <span class="absolute top-3 left-3 px-3 py-1 rounded-full bg-white/20 backdrop-blur-md text-white text-[11px] font-bold border border-white/20">
              {{ f.category_tag|default:"Khoa Đào tạo" }}
            </span>

            <!-- Logo badge floating on cover -->
            <div class="absolute bottom-3 left-4 flex items-center gap-3">
              <div class="w-14 h-14 rounded-2xl bg-white p-1.5 shadow-xl border-2 border-white/90 shrink-0 overflow-hidden flex items-center justify-center">
                <img 
                  src="{{ f.logo_url }}" 
                  alt="Logo {{ f.name }}" 
                  class="w-full h-full object-contain"
                  onerror="this.onerror=null; this.src='/static/img/khoa/tcnh_logo.png';"
                />
              </div>
              <div class="text-white drop-shadow">
                <span class="text-[11px] text-amber-300 font-bold block">{{ f.majors_2026|length }} Chuyên ngành 2026</span>
                <span class="text-xs text-slate-200">Chuẩn AUN-QA</span>
              </div>
            </div>
          </div>

          <!-- Body Info -->
          <div class="p-5 flex-1 flex flex-col justify-between">
            <div>
              <h2 class="text-lg font-bold text-slate-900 group-hover:text-[#003366] transition-colors leading-snug mb-1.5">
                <a href="/khoa/{{ f.id }}/" class="hover:underline">
                  {{ f.name }}
                </a>
              </h2>
              <p class="text-xs text-amber-700 font-semibold italic mb-2 line-clamp-1">
                &ldquo;{{ f.slogan|default:"Chất lượng đào tạo tiên phong" }}&rdquo;
              </p>
              <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed mb-4">
                Kế thừa từ: <strong>{{ f.formed_from }}</strong>. {{ f.intro }}
              </p>

              <!-- Specialization pills preview -->
              <div class="space-y-1 mb-4">
                <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider block">Các ngành tiêu biểu:</span>
                <div class="flex flex-wrap gap-1.5">
                  {% for m in f.majors_2026|slice:":3" %}
                  <span class="px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 text-[11px] font-medium truncate max-w-[220px]">
                    {{ m.name }}
                  </span>
                  {% endfor %}
                  {% if f.majors_2026|length > 3 %}
                  <span class="px-2 py-0.5 rounded-md bg-blue-50 text-blue-700 text-[11px] font-bold">
                    +{{ f.majors_2026|length|add:"-3" }} ngành khác
                  </span>
                  {% endif %}
                </div>
              </div>
            </div>

            <!-- Footer Action Buttons (Navigates to dedicated page) -->
            <div class="pt-4 border-t border-slate-100 flex items-center justify-between gap-2">
              <a 
                href="/khoa/{{ f.id }}/" 
                class="flex-1 inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-full bg-[#003366] hover:bg-[#002244] text-white font-bold text-xs shadow-md transition-all group-hover:bg-[#fd761a]"
              >
                <span>Xem chi tiết Khoa</span>
                <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
              </a>

              {% if f.contact.messenger %}
              <a 
                href="{{ f.contact.messenger }}" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="p-2.5 rounded-full bg-blue-50 hover:bg-blue-100 text-[#0072BC] transition-colors"
                title="Chat tư vấn tuyển sinh với Khoa"
              >
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2C6.477 2 2 6.145 2 11.258c0 2.914 1.455 5.517 3.735 7.21V22l3.39-1.86c.91.252 1.88.388 2.875.388 5.523 0 10-4.145 10-9.258C22 6.145 17.523 2 12 2zm1.066 12.443l-2.573-2.744-5.021 2.744 5.524-5.86 2.64 2.744 4.954-2.744-5.524 5.86z"></path></svg>
              </a>
              {% endif %}
            </div>

          </div>
        </div>
        {% endfor %}
      </div>
      
      <!-- Empty state when searching -->
      <div id="noResultsMsg" class="hidden text-center py-16">
        <span class="material-symbols-outlined text-slate-300 text-[48px] mb-2">search_off</span>
        <h3 class="text-base font-bold text-slate-700">Không tìm thấy khoa hoặc chuyên ngành phù hợp</h3>
        <p class="text-xs text-slate-500 mt-1">Vui lòng thử lại với từ khóa khác hoặc xóa bộ lọc.</p>
      </div>
    </div>


    <!-- ====================================================
         HỆ THỐNG PHÒNG BAN CHỨC NĂNG và TRUNG TÂM HỖ TRỢ
         ==================================================== -->
    <section class="pt-16 border-t border-slate-200">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 font-headline-lg tracking-tight mb-3">
          Phòng Ban Chức Năng và trung Tâm DUE
        </h2>
        <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
          Đội ngũ các phòng ban chuyên trách luôn sẵn sàng hỗ trợ tân sinh viên và sinh viên về học vụ, học phí, học bổng, cơ sở vật chất, hoạt động phong trào và việc làm.
        </p>
      </div>

      <!-- Grid 9 Phòng Ban Chức Năng và trung Tâm -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {% for pb in phongban_list %}
        <div class="p-6 rounded-3xl bg-white border border-slate-200 hover:border-blue-300 shadow-sm hover:shadow-lg transition-all flex flex-col justify-between group">
          <div>
            <!-- Header Badge và icon -->
            <div class="flex items-center justify-between mb-4">
              <div class="w-12 h-12 rounded-2xl flex items-center justify-center text-white shadow-md {{ pb.color|default:'bg-[#003366]' }} group-hover:scale-105 transition-transform">
                <span class="material-symbols-outlined text-[24px]">{{ pb.icon|default:'apartment' }}</span>
              </div>
              <span class="px-2.5 py-1 rounded-full bg-slate-100 text-slate-700 font-bold text-[11px] border border-slate-200/80">
                {{ pb.badge|default:"Phòng chức năng" }}
              </span>
            </div>

            <!-- Name và tagline -->
            <h3 class="text-base sm:text-lg font-bold text-slate-900 group-hover:text-[#003366] transition-colors mb-1.5 leading-snug">
              {{ pb.name }}
            </h3>
            <p class="text-xs text-blue-700 font-medium mb-3">
              {{ pb.tagline }}
            </p>
            <p class="text-xs text-slate-500 leading-relaxed mb-4">
              {{ pb.desc }}
            </p>

            <!-- Key Functions / Duties -->
            <div class="space-y-1.5 mb-5 pt-3 border-t border-slate-100 text-xs text-slate-600">
              <span class="font-bold text-slate-700 block text-[11px] uppercase tracking-wider">Nhiệm vụ trọng tâm hỗ trợ:</span>
              {% for fn in pb.duties %}
              <div class="flex items-start gap-1.5">
                <span class="material-symbols-outlined text-emerald-600 text-[14px] shrink-0 mt-0.5">check_circle</span>
                <span class="leading-snug">{{ fn }}</span>
              </div>
              {% endfor %}
            </div>
          </div>

          <!-- Contact details footer -->
          <div class="pt-4 border-t border-slate-100 text-xs text-slate-500 space-y-1.5 bg-slate-50/70 -mx-6 -mb-6 p-4 rounded-b-3xl">
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-slate-400 text-[15px] shrink-0">location_on</span>
              <span class="font-medium text-slate-700 truncate">{{ pb.location }}</span>
            </div>
            <div class="flex items-center justify-between gap-2">
              <div class="flex items-center gap-2">
                <span class="material-symbols-outlined text-slate-400 text-[15px] shrink-0">call</span>
                <a href="tel:{{ pb.phone }}" class="text-blue-700 font-semibold hover:underline">{{ pb.phone }}</a>
              </div>
              <div class="flex items-center gap-1">
                <span class="material-symbols-outlined text-slate-400 text-[15px] shrink-0">mail</span>
                <a href="mailto:{{ pb.email }}" class="text-slate-600 hover:text-blue-600 truncate max-w-[130px]" title="{{ pb.email }}">{{ pb.email }}</a>
              </div>
            </div>
          </div>

        </div>
        {% endfor %}
      </div>
    </section>

  </div>
</main>
{% endblock %}

{% block extra_js %}
<script>
  // Filter & Search faculties logic
  const searchInput = document.getElementById('facultySearchInput');
  const filterBtns = document.querySelectorAll('.filter-btn');
  const facultyItems = document.querySelectorAll('.faculty-item');
  const noResultsMsg = document.getElementById('noResultsMsg');

  let currentFilter = 'all';
  let searchQuery = '';

  function applyFilters() {
    let visibleCount = 0;
    facultyItems.forEach(item => {
      const category = item.getAttribute('data-category');
      const name = item.getAttribute('data-name');
      const slogan = item.getAttribute('data-slogan') || '';
      const keywords = item.getAttribute('data-keywords') || '';
      
      const fullText = (name + ' ' + slogan + ' ' + keywords).toLowerCase();

      const matchesFilter = (currentFilter === 'all') || (category === currentFilter);
      const matchesSearch = !searchQuery || fullText.includes(searchQuery);

      if (matchesFilter && matchesSearch) {
        item.style.display = '';
        visibleCount++;
      } else {
        item.style.display = 'none';
      }
    });

    if (visibleCount === 0) {
      noResultsMsg.classList.remove('hidden');
    } else {
      noResultsMsg.classList.add('hidden');
    }
  }

  if (searchInput) {
    searchInput.addEventListener('input', function(e) {
      searchQuery = e.target.value.toLowerCase().trim();
      applyFilters();
    });
  }

  filterBtns.forEach(btn => {
    btn.addEventListener('click', function() {
      filterBtns.forEach(b => {
        b.classList.remove('bg-[#003366]', 'text-white', 'shadow-sm', 'active');
        b.classList.add('bg-slate-100', 'text-slate-600');
      });
      this.classList.remove('bg-slate-100', 'text-slate-600');
      this.classList.add('bg-[#003366]', 'text-white', 'shadow-sm', 'active');
      currentFilter = this.getAttribute('data-filter');
      applyFilters();
    });
  });
</script>
{% endblock %}


--- FILE: CongthongtintuyensinhDUE/templates/portal/faculty_detail.html ---
{% extends 'layouts/base.html' %}

{% block title %}{{ faculty.name }} - Cổng thông tin Tuyển sinh Trường Đại học Kinh tế (DUE) 2026{% endblock %}

{% block nav_khoa %}text-secondary-container font-headline-sm border-b-2 border-secondary-container uppercase whitespace-nowrap font-bold{% endblock %}

{% block extra_head %}
<style>
  html {
    scroll-behavior: smooth;
  }
  .sticky-subnav {
    position: sticky;
    top: 72px;
    z-index: 30;
    backdrop-filter: blur(12px);
    background: rgba(255, 255, 255, 0.94);
    border-bottom: 1px solid #e2e8f0;
  }
  .subnav-link {
    display: inline-flex;
    align-items: center;
    padding: 12px 15px;
    font-size: 13.5px;
    font-weight: 600;
    color: #475569;
    text-decoration: none;
    border-bottom: 2px solid transparent;
    white-space: nowrap;
    transition: all .15s ease;
  }
  .subnav-link:hover, .subnav-link.active {
    color: #003366;
    border-bottom-color: #fd761a;
  }
  .glass-card {
    background: #ffffff;
    border: 1px solid #eef2f6;
    box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.05);
    border-radius: 24px;
  }
  .stat-card {
    background: linear-gradient(145deg, #f8fafc 0%, #f1f5f9 100%);
    border: 1px solid #e2e8f0;
    border-radius: 16px;
  }
</style>
{% endblock %}

{% block content %}
<main class="w-full pt-32 sm:pt-36 pb-6 bg-surface min-h-[calc(100vh-28rem)] flex-1">

  <!-- ====================================================
       1. HERO BANNER CHI TIẾT KHOA
       ==================================================== -->
  <section class="max-w-7xl mx-auto px-6 lg:px-12 pt-8 pb-4 mb-4">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs sm:text-sm text-on-surface-variant mb-6 font-medium" aria-label="Breadcrumb">
      <a href="/" class="hover:text-primary-container transition-colors">Trang chủ</a>
      <span class="material-symbols-outlined text-[14px]">chevron_right</span>
      <a href="/khoa/" class="hover:text-primary-container transition-colors">Khoa và đơn vị đào tạo</a>
      <span class="material-symbols-outlined text-[14px]">chevron_right</span>
      <span class="text-secondary-container font-semibold truncate">{{ faculty.name }}</span>
    </nav>

    <!-- Hero Card with Cover và gradient Overlay -->
    <div class="relative rounded-3xl overflow-hidden shadow-2xl border border-slate-200">
      
      <!-- Cover Image Background -->
      <div class="absolute inset-0 bg-slate-900">
        <img 
          src="{{ faculty.cover_url }}" 
          alt="{{ faculty.name }}" 
          class="w-full h-full object-cover opacity-35 filter brightness-90 transform scale-105 transition-transform duration-1000"
          onerror="this.onerror=null; this.src='/static/img/khoa/tcnh_cover.jpg';"
        />
        <!-- DUE Gradient Vignette -->
        <div class="absolute inset-0 bg-gradient-to-r from-[#001e40] via-[#003366]/90 to-[#004b73]/75"></div>
      </div>

      <!-- Hero Content -->
      <div class="relative z-10 p-6 sm:p-10 lg:p-12 text-white flex flex-col justify-between min-h-[380px]">
        
        <!-- Top Tags -->
        <div class="flex flex-wrap items-center gap-2.5 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-white/15 backdrop-blur-md text-white text-xs font-bold border border-white/20">
            <span class="material-symbols-outlined text-[16px] text-amber-300">verified</span>
            {{ faculty.category_tag|default:"Khoa Đào tạo Chuyên sâu" }}
          </span>
        </div>

        <!-- Main Identity Info (Logo + Name + Slogan) -->
        <div class="flex flex-col md:flex-row items-start md:items-center gap-6 my-auto">
          <!-- Logo Container -->
          <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-2xl bg-white p-3 shadow-2xl border-2 border-white/90 shrink-0 flex items-center justify-center overflow-hidden group">
            <img 
              src="{{ faculty.logo_url }}" 
              alt="Logo {{ faculty.name }}" 
              class="w-full h-full object-contain group-hover:scale-105 transition-transform"
              onerror="this.onerror=null; this.src='/static/img/khoa/tcnh_logo.png';"
            />
          </div>

          <!-- Titles và slogan -->
          <div class="space-y-2">
            <h1 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold font-headline-lg tracking-tight leading-tight text-white drop-shadow-sm">
              {{ faculty.name }}
            </h1>
            <p class="text-amber-300 font-semibold text-base sm:text-lg italic tracking-wide">
              &ldquo;{{ faculty.slogan|default:"Chất lượng đào tạo tiên phong - Hội nhập kinh tế quốc tế" }}&rdquo;
            </p>
            <p class="text-slate-200 text-xs sm:text-sm max-w-3xl leading-relaxed">
              Kế thừa và phát triển từ <strong>{{ faculty.formed_from }}</strong>. Nơi đào tạo thế hệ cử nhân, thạc sĩ, tiến sĩ tài năng đáp ứng chuẩn mực hội nhập toàn cầu.
            </p>
          </div>
        </div>

        <!-- Hero Bottom Action Buttons và key Stats -->
        <div class="pt-8 border-t border-white/15 mt-6 flex flex-col lg:flex-row lg:items-center justify-between gap-4">
          
          <!-- Quick Buttons (Có nút riêng nổi bật về Liên Chi Đoàn theo yêu cầu người dùng) -->
          <div class="flex flex-wrap items-center gap-3">
            {% if faculty.url %}
            <a href="{{ faculty.url }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full bg-white text-[#003366] hover:bg-slate-100 font-bold text-xs sm:text-sm shadow-md transition-all hover:scale-105">
              <span class="material-symbols-outlined text-[18px]">language</span>
              <span>Website chính thức</span>
            </a>
            {% endif %}

            <!-- Nút riêng biệt sang TRANG RIÊNG Liên Chi Đoàn Khoa -->
            <a href="/lien-chi-doan/{{ faculty.id }}/" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full bg-gradient-to-r from-[#e11d48] to-[#f43f5e] hover:from-[#be123c] hover:to-[#e11d48] text-white font-bold text-xs sm:text-sm shadow-lg shadow-rose-500/25 transition-all hover:scale-105 border border-white/20" title="Khám phá trang riêng Liên Chi Đoàn Khoa">
              <span class="material-symbols-outlined text-[18px] text-amber-300">flag</span>
              <span>Liên Chi Đoàn Khoa &rarr;</span>
            </a>

            {% if faculty.contact.fanpage %}
            <a href="{{ faculty.contact.fanpage }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full bg-[#1877F2] hover:bg-[#166fe5] text-white font-bold text-xs sm:text-sm shadow-md transition-all hover:scale-105">
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.469h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"></path></svg>
              <span>Fanpage Khoa</span>
            </a>
            {% endif %}

            {% if faculty.contact.messenger %}
            <a href="{{ faculty.contact.messenger }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full bg-gradient-to-r from-[#0084FF] to-[#00C6FF] hover:opacity-95 text-white font-bold text-xs sm:text-sm shadow-md transition-all hover:scale-105">
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2C6.477 2 2 6.145 2 11.258c0 2.914 1.455 5.517 3.735 7.21V22l3.39-1.86c.91.252 1.88.388 2.875.388 5.523 0 10-4.145 10-9.258C22 6.145 17.523 2 12 2zm1.066 12.443l-2.573-2.744-5.021 2.744 5.524-5.86 2.64 2.744 4.954-2.744-5.524 5.86z"></path></svg>
              <span>Nhắn tin tư vấn</span>
            </a>
            {% endif %}

            <a href="#chuyen-nganh-2026" class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-full bg-[#fd761a] hover:bg-[#e0610f] text-white font-bold text-xs sm:text-sm shadow-md transition-all hover:scale-105">
              <span>Xem chuyên ngành 2026</span>
              <span class="material-symbols-outlined text-[18px]">arrow_downward</span>
            </a>
          </div>

          <!-- Highlight Figures -->
          <div class="flex items-center gap-4 text-xs font-medium">
            <div class="bg-white/10 px-3.5 py-1.5 rounded-xl border border-white/10 backdrop-blur-sm">
              <span class="text-amber-300 font-bold text-base block">{{ faculty.majors_2026|length }}</span>
              <span class="text-slate-300">Chuyên ngành 2026</span>
            </div>
            <div class="bg-white/10 px-3.5 py-1.5 rounded-xl border border-white/10 backdrop-blur-sm">
              <span class="text-green-300 font-bold text-base block">100%</span>
              <span class="text-slate-300">ThS và TS trở lên</span>
            </div>
            <div class="bg-white/10 px-3.5 py-1.5 rounded-xl border border-white/10 backdrop-blur-sm">
              <span class="text-sky-300 font-bold text-base block">&gt; 96%</span>
              <span class="text-slate-300">Việc làm sau ra trường</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>


  <!-- ====================================================
       2. STICKY SUB-NAVIGATION BAR (Thanh điều hướng nhanh)
       ==================================================== -->
  <div class="sticky-subnav shadow-sm mb-10">
    <div class="max-w-7xl mx-auto px-6 lg:px-12 flex items-center overflow-x-auto no-scrollbar py-1">
      <a href="#gioi-thieu" class="subnav-link">
        <span class="material-symbols-outlined text-[18px] mr-1.5">info</span> Giới thiệu và sứ mệnh
      </a>
      <a href="#chuyen-nganh-2026" class="subnav-link">
        <span class="material-symbols-outlined text-[18px] mr-1.5">school</span> Chuyên ngành 2026
      </a>
      <a href="#sau-dai-hoc" class="subnav-link">
        <span class="material-symbols-outlined text-[18px] mr-1.5">workspace_premium</span> Sau đại học
      </a>
      <a href="#doi-ngu" class="subnav-link">
        <span class="material-symbols-outlined text-[18px] mr-1.5">group</span> Đội ngũ và bộ môn
      </a>
      <a href="#nghe-nghiep" class="subnav-link">
        <span class="material-symbols-outlined text-[18px] mr-1.5">work</span> Cơ hội việc làm và đối tác
      </a>
      <!-- Tab Liên Chi Đoàn nổi bật -->
      <a href="#lien-chi-doan" class="subnav-link text-rose-600 font-bold">
        <span class="material-symbols-outlined text-[18px] mr-1.5 text-rose-600">flag</span> Liên Chi Đoàn
      </a>
      <a href="#hoat-dong-clb" class="subnav-link">
        <span class="material-symbols-outlined text-[18px] mr-1.5">groups</span> CLB và đội nhóm
      </a>
      <a href="#hinh-anh" class="subnav-link">
        <span class="material-symbols-outlined text-[18px] mr-1.5">photo_library</span> Thư viện ảnh
      </a>
      <a href="#phong-ban-ho-tro" class="subnav-link text-blue-700 font-bold">
        <span class="material-symbols-outlined text-[18px] mr-1.5">apartment</span> Phòng ban hỗ trợ
      </a>
    </div>
  </div>


  <!-- ====================================================
       3. NỘI DUNG CHÍNH (Cấu trúc 2 cột: Cột trái 8 phần + Cột phải 4 phần)
       ==================================================== -->
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- CỘT TRÁI: NỘI DUNG CHI TIẾT (8 Cột) -->
      <div class="lg:col-span-8 space-y-10">
        
        <!-- MỤC 1: GIỚI THIỆU CHUNG và LỊCH SỬ HÌNH THÀNH -->
        <section id="gioi-thieu" class="glass-card p-6 sm:p-8 scroll-mt-36">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-xl bg-blue-100 text-[#003366] flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-[24px]">history_edu</span>
            </div>
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-secondary-container">Tổng quan đơn vị</span>
              <h2 class="text-xl sm:text-2xl font-bold text-slate-900 font-headline-md">Giới thiệu chung và lịch sử hình thành</h2>
            </div>
          </div>

          <div class="prose prose-slate max-w-none text-slate-600 text-sm sm:text-base leading-relaxed space-y-4">
            <p>{{ faculty.intro }}</p>
            <p>{{ faculty.history }}</p>
          </div>

          <!-- Sứ mệnh - Tầm nhìn - Giá trị cốt lõi -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-6 pt-6 border-t border-slate-100">
            <!-- Sứ mệnh -->
            <div class="p-4 rounded-2xl bg-blue-50/70 border border-blue-100">
              <div class="flex items-center gap-2 text-blue-900 font-bold text-sm mb-2">
                <span class="material-symbols-outlined text-[20px] text-blue-700">flag</span>
                <span>Sứ mệnh</span>
              </div>
              <p class="text-xs text-slate-700 leading-relaxed">{{ faculty.mission }}</p>
            </div>

            <!-- Tầm nhìn -->
            <div class="p-4 rounded-2xl bg-emerald-50/70 border border-emerald-100">
              <div class="flex items-center gap-2 text-emerald-900 font-bold text-sm mb-2">
                <span class="material-symbols-outlined text-[20px] text-emerald-700">visibility</span>
                <span>Tầm nhìn 2030</span>
              </div>
              <p class="text-xs text-slate-700 leading-relaxed">{{ faculty.vision }}</p>
            </div>

            <!-- Giá trị cốt lõi -->
            <div class="p-4 rounded-2xl bg-amber-50/70 border border-amber-100">
              <div class="flex items-center gap-2 text-amber-900 font-bold text-sm mb-2">
                <span class="material-symbols-outlined text-[20px] text-amber-700">stars</span>
                <span>Giá trị cốt lõi</span>
              </div>
              <p class="text-xs text-slate-700 leading-relaxed">{{ faculty.core_values }}</p>
            </div>
          </div>

          <!-- Thông điệp từ Trưởng khoa -->
          {% if faculty.dean_message %}
          <div class="mt-6 p-5 rounded-2xl bg-gradient-to-r from-slate-50 to-blue-50/40 border border-slate-200/80 flex flex-col sm:flex-row items-start gap-4">
            <div class="w-14 h-14 rounded-2xl bg-[#003366] text-white flex items-center justify-center shrink-0 shadow-md">
              <span class="material-symbols-outlined text-[32px]">format_quote</span>
            </div>
            <div class="flex-1">
              <h4 class="font-bold text-slate-900 text-sm sm:text-base mb-1">Thông điệp từ Ban Chủ nhiệm Khoa</h4>
              <p class="text-slate-600 text-xs sm:text-sm italic leading-relaxed mb-3">
                &ldquo;{{ faculty.dean_message.content }}&rdquo;
              </p>
              <div class="flex items-center justify-between text-xs text-slate-500 font-medium pt-2 border-t border-slate-200/60">
                <span class="font-bold text-[#003366]">{{ faculty.dean_message.dean_title }} {{ faculty.dean_message.dean_name }}</span>
                <span>Trưởng Khoa</span>
              </div>
            </div>
          </div>
          {% endif %}
        </section>


        <!-- MỤC 2: CÁC NGÀNH và CHUYÊN NGÀNH ĐÀO TẠO 2026 (TRỌNG TÂM TUYỂN SINH) -->
        <section id="chuyen-nganh-2026" class="glass-card p-6 sm:p-8 scroll-mt-36 border-2 border-blue-100">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6 pb-4 border-b border-slate-100">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl bg-orange-100 text-secondary-container flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-[24px]">school</span>
              </div>
              <div>
                <span class="text-xs font-bold uppercase tracking-wider text-secondary-container">Đề án tuyển sinh mới 2026</span>
                <h2 class="text-xl sm:text-2xl font-bold text-slate-900 font-headline-md">Các Ngành và chuyên Ngành Đào Tạo Năm 2026</h2>
              </div>
            </div>
            <span class="px-3 py-1 rounded-full bg-blue-100 text-[#003366] text-xs font-bold">
              {{ faculty.majors_2026|length }} Chuyên ngành
            </span>
          </div>

          <p class="text-slate-600 text-sm leading-relaxed mb-6">
            Năm 2026, <strong>{{ faculty.name }}</strong> tuyển sinh đại học chính quy với các chương trình đào tạo hiện đại, đáp ứng chuẩn kiểm định khu vực Đông Nam Á AUN-QA, tích hợp công nghệ số và liên kết quốc tế:
          </p>

          <!-- Danh sách thẻ chuyên ngành 2026 -->
          <div class="space-y-4">
            {% for m in faculty.majors_2026 %}
            <div class="p-5 rounded-2xl border border-slate-200/90 hover:border-blue-400 bg-white hover:bg-blue-50/20 shadow-sm hover:shadow-md transition-all group">
              <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                
                <!-- Main Major Info -->
                <div class="space-y-1.5 flex-1">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="px-2.5 py-0.5 rounded-md bg-slate-100 text-slate-700 font-mono text-xs font-bold border border-slate-200">
                      Mã: {{ m.id }}
                    </span>
                    
                    {% if "Toàn phần" in m.program_type %}
                    <span class="px-2.5 py-0.5 rounded-full bg-purple-100 text-purple-700 text-xs font-bold">
                      Toàn phần tiếng Anh
                    </span>
                    {% elif "Bán phần" in m.program_type %}
                    <span class="px-2.5 py-0.5 rounded-full bg-sky-100 text-sky-700 text-xs font-bold">
                      Bán phần tiếng Anh
                    </span>
                    {% else %}
                    <span class="px-2.5 py-0.5 rounded-full bg-emerald-100 text-emerald-700 text-xs font-bold">
                      Chương trình Tiêu chuẩn
                    </span>
                    {% endif %}

                    {% if m.major_code %}
                    <span class="text-xs text-slate-400">Mã ngành: {{ m.major_code }}</span>
                    {% endif %}
                  </div>

                  <h3 class="text-base sm:text-lg font-bold text-slate-800 group-hover:text-[#003366] transition-colors">
                    {{ m.name }}
                  </h3>

                  <p class="text-xs text-slate-500 leading-relaxed">
                    Ngành đào tạo: <strong>{{ m.major_name }}</strong>
                  </p>
                </div>

                <!-- CTA Chat tư vấn chuyên ngành -->
                <div class="flex items-center gap-2 shrink-0">
                  <a 
                    href="{{ faculty.contact.messenger|default:'https://m.me/FaceDue' }}" 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-blue-50 hover:bg-[#003366] text-[#003366] hover:text-white font-bold text-xs border border-blue-200 hover:border-transparent transition-all shadow-sm"
                  >
                    <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 2C6.477 2 2 6.145 2 11.258c0 2.914 1.455 5.517 3.735 7.21V22l3.39-1.86c.91.252 1.88.388 2.875.388 5.523 0 10-4.145 10-9.258C22 6.145 17.523 2 12 2zm1.066 12.443l-2.573-2.744-5.021 2.744 5.524-5.86 2.64 2.744 4.954-2.744-5.524 5.86z"></path></svg>
                    <span>Tư vấn ngành này</span>
                  </a>
                </div>

              </div>
            </div>
            {% endfor %}
          </div>
        </section>


        <!-- MỤC 3: ĐÀO TẠO SAU ĐẠI HỌC và LIÊN KẾT QUỐC TẾ -->
        {% if faculty.postgraduate %}
        <section id="sau-dai-hoc" class="glass-card p-6 sm:p-8 scroll-mt-36">
          <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100">
            <div class="w-10 h-10 rounded-xl bg-purple-100 text-purple-700 flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-[24px]">workspace_premium</span>
            </div>
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-purple-700">Học vị cao cấp và chứng chỉ nghề nghiệp</span>
              <h2 class="text-xl sm:text-2xl font-bold text-slate-900 font-headline-md">Đào Tạo Sau Đại Học và chứng Chỉ Quốc Tế</h2>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <!-- Thạc sĩ -->
            <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200">
              <div class="flex items-center gap-2.5 text-[#003366] font-bold text-base mb-2">
                <span class="material-symbols-outlined text-[22px]">history_edu</span>
                <span>Chương trình Thạc sĩ (Cao học)</span>
              </div>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-3">
                {{ faculty.postgraduate.masters|default:"Đào tạo Thạc sĩ theo định hướng ứng dụng và nghiên cứu, cập nhật phương pháp định lượng và tình huống thực tiễn từ doanh nghiệp." }}
              </p>
              <span class="text-[11px] font-semibold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-md border border-emerald-200">
                Thời gian: 1.5 - 2.0 năm • Bằng Thạc sĩ chính quy
              </span>
            </div>

            <!-- Tiến sĩ -->
            <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200">
              <div class="flex items-center gap-2.5 text-purple-800 font-bold text-base mb-2">
                <span class="material-symbols-outlined text-[22px]">psychology</span>
                <span>Chương trình Nghiên cứu sinh (Tiến sĩ)</span>
              </div>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-3">
                {{ faculty.postgraduate.phd|default:"Đào tạo Tiến sĩ chuẩn quốc tế với các công bố trên các tạp chí khoa học uy tín thuộc danh mục Web of Science (ISI) và Scopus." }}
              </p>
              <span class="text-[11px] font-semibold text-purple-700 bg-purple-50 px-2.5 py-1 rounded-md border border-purple-200">
                Thời gian: 3 - 4 năm • Học bổng NCKH tài trợ
              </span>
            </div>
          </div>

          <!-- Các chứng chỉ nghề nghiệp quốc tế tích hợp -->
          <div class="mt-4 p-4 rounded-2xl bg-blue-50/60 border border-blue-100 flex items-center gap-3">
            <span class="material-symbols-outlined text-blue-700 text-[28px] shrink-0">verified_user</span>
            <div class="text-xs text-slate-700 leading-relaxed">
              <strong>Tích hợp chứng chỉ nghề nghiệp quốc tế:</strong> Sinh viên trong quá trình học tập được trang bị kiến thức và miễn giảm học phần khi thi các chứng chỉ danh giá như <strong>ACCA, CFA, CMA, CIM, FIATA, Chứng chỉ Digital Marketing quốc tế</strong>, giúp gia tăng lợi thế cạnh tranh khi tuyển dụng.
            </div>
          </div>
        </section>
        {% endif %}


        <!-- MỤC 4: ĐỘI NGŨ GIẢNG VIÊN và CÁC BỘ MÔN TRỰC THUỘC -->
        <section id="doi-ngu" class="glass-card p-6 sm:p-8 scroll-mt-36">
          <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100">
            <div class="w-10 h-10 rounded-xl bg-teal-100 text-teal-700 flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-[24px]">group</span>
            </div>
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-teal-700">Nguồn nhân lực chất lượng cao</span>
              <h2 class="text-xl sm:text-2xl font-bold text-slate-900 font-headline-md">Đội Ngũ Giảng Viên và các Bộ Môn</h2>
            </div>
          </div>

          <p class="text-slate-600 text-sm leading-relaxed mb-6">
            {{ faculty.staff_summary }}
          </p>

          <!-- Thống kê năng lực giảng viên -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
            <div class="stat-card p-3.5 text-center">
              <span class="text-xl sm:text-2xl font-extrabold text-[#003366] block">100%</span>
              <span class="text-[11px] text-slate-600 font-medium">ThS và TS đào tạo quốc tế</span>
            </div>
            <div class="stat-card p-3.5 text-center">
              <span class="text-xl sm:text-2xl font-extrabold text-[#fd761a] block">&gt; 55%</span>
              <span class="text-[11px] text-slate-600 font-medium">Giáo sư, PGS, Tiến sĩ</span>
            </div>
            <div class="stat-card p-3.5 text-center">
              <span class="text-xl sm:text-2xl font-extrabold text-emerald-600 block">50+</span>
              <span class="text-[11px] text-slate-600 font-medium">Bài báo Scopus/năm</span>
            </div>
            <div class="stat-card p-3.5 text-center">
              <span class="text-xl sm:text-2xl font-extrabold text-blue-600 block">Top 1</span>
              <span class="text-[11px] text-slate-600 font-medium">Nghiên cứu kinh tế Miền Trung</span>
            </div>
          </div>

          <!-- Các bộ môn chuyên môn trực thuộc Khoa -->
          <div class="space-y-3">
            <h4 class="font-bold text-slate-800 text-sm sm:text-base flex items-center gap-2">
              <span class="material-symbols-outlined text-teal-600 text-[20px]">account_tree</span>
              Các Bộ môn chuyên môn trực thuộc Khoa
            </h4>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {% for d in faculty.departments_list %}
              <div class="p-3.5 rounded-xl border border-slate-200/80 bg-slate-50/50 flex items-start gap-3">
                <span class="w-2.5 h-2.5 rounded-full bg-teal-500 mt-1.5 shrink-0"></span>
                <div>
                  <span class="font-bold text-slate-800 text-sm block">{{ d.name }}</span>
                  <span class="text-xs text-slate-500 leading-snug block mt-0.5">{{ d.duty }}</span>
                </div>
              </div>
              {% endfor %}
            </div>
          </div>

          <!-- Ban Chủ nhiệm khoa -->
          {% if faculty.leadership %}
          <div class="mt-6 pt-6 border-t border-slate-100">
            <h4 class="font-bold text-slate-800 text-sm mb-3">Ban Lãnh đạo Khoa đương nhiệm</h4>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div class="p-3 rounded-xl bg-blue-50/50 border border-blue-100">
                <span class="text-[11px] text-slate-500 block">Trưởng Khoa</span>
                <span class="font-bold text-[#003366] text-sm">{{ faculty.leadership.dean }}</span>
              </div>
              <div class="p-3 rounded-xl bg-slate-50 border border-slate-200">
                <span class="text-[11px] text-slate-500 block">Phó Trưởng Khoa</span>
                <span class="font-bold text-slate-800 text-sm">{{ faculty.leadership.vice_dean }}</span>
              </div>
            </div>
          </div>
          {% endif %}
        </section>


        <!-- MỤC 5: CƠ HỘI NGHỀ NGHIỆP và DOANH NGHIỆP ĐỐI TÁC -->
        <section id="nghe-nghiep" class="glass-card p-6 sm:p-8 scroll-mt-36">
          <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100">
            <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-[24px]">work</span>
            </div>
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-emerald-700">Đầu ra và việc làm</span>
              <h2 class="text-xl sm:text-2xl font-bold text-slate-900 font-headline-md">Cơ Hội Nghề Nghiệp và đối Tác Doanh Nghiệp</h2>
            </div>
          </div>

          <div class="prose prose-slate max-w-none text-slate-600 text-sm sm:text-base leading-relaxed mb-6">
            <p>{{ faculty.career_paths }}</p>
          </div>

          <!-- Mạng lưới doanh nghiệp đối tác chiến lược -->
          <div>
            <h4 class="font-bold text-slate-800 text-sm sm:text-base mb-3 flex items-center gap-2">
              <span class="material-symbols-outlined text-emerald-600 text-[20px]">handshake</span>
              Mạng lưới Doanh nghiệp và tập đoàn Đối tác chiến lược
            </h4>
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
              {% for p in faculty.partners %}
              <div class="p-3 rounded-xl border border-slate-200/80 bg-white hover:border-emerald-300 shadow-sm flex items-center gap-2.5">
                <span class="w-2 h-2 rounded-full bg-emerald-500 shrink-0"></span>
                <span class="text-xs font-semibold text-slate-700 truncate">{{ p }}</span>
              </div>
              {% endfor %}
            </div>
          </div>
        </section>


        <!-- ====================================================
             MỤC 6: ĐOÀN THANH NIÊN - LIÊN CHI ĐOÀN KHOA (TEASER CARD DẪN SANG TRANG RIÊNG)
             ==================================================== -->
        <section id="lien-chi-doan" class="glass-card p-6 sm:p-7 border-l-4 border-l-rose-500 hover:border-rose-300 transition-all shadow-sm">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-5">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-rose-600 to-red-500 text-white flex items-center justify-center shrink-0 shadow-md shadow-rose-500/25">
                <span class="material-symbols-outlined text-[26px]">flag</span>
              </div>
              <div class="space-y-1">
                <div class="flex items-center gap-2">
                  <span class="text-xs font-bold uppercase tracking-wider text-rose-600">Đoàn Thanh Niên – Hội Sinh Viên Khoa</span>
                  <span class="px-2 py-0.5 rounded-full bg-rose-50 text-rose-700 text-[10px] font-bold border border-rose-200">
                    {{ faculty.lcd.term|default:"Nhiệm kỳ 2024–2027" }}
                  </span>
                </div>
                <h3 class="text-lg sm:text-xl font-bold text-slate-900">
                  {{ faculty.lcd.name|default:faculty.lien_chi_doan }}
                </h3>
                <p class="text-xs sm:text-sm text-slate-600 max-w-2xl leading-relaxed">
                  {{ faculty.lcd.intro|truncatewords:32 }}
                </p>
                <div class="text-xs text-slate-500 pt-1 flex items-center gap-2">
                  <span class="font-semibold text-slate-700">Bí thư LCĐ:</span>
                  <span class="text-rose-700 font-bold">{{ faculty.lcd.secretary|default:"Đang cập nhật" }}</span>
                </div>
              </div>
            </div>

            <div class="shrink-0 sm:self-center">
              <a 
                href="/lien-chi-doan/{{ faculty.id }}/" 
                class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-gradient-to-r from-rose-600 to-red-500 hover:from-rose-700 hover:to-red-600 text-white text-xs sm:text-sm font-bold shadow-md shadow-rose-500/20 transition-all hover:scale-105"
              >
                <span>Xem trang riêng LCĐ</span>
                <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
              </a>
            </div>
          </div>
        </section>


        <!-- MỤC 7: CÂU LẠC BỘ và ĐỘI NHÓM SINH VIÊN TRỰC THUỘC KHOA -->
        <section id="hoat-dong-clb" class="glass-card p-6 sm:p-8 scroll-mt-36">
          <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100">
            <div class="w-10 h-10 rounded-xl bg-rose-100 text-rose-700 flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-[24px]">groups</span>
            </div>
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-rose-700">Môi trường rèn luyện kỹ năng</span>
              <h2 class="text-xl sm:text-2xl font-bold text-slate-900 font-headline-md">Câu Lạc Bộ Học Thuật và kỹ Năng</h2>
            </div>
          </div>

          <div class="space-y-4 text-slate-600 text-sm sm:text-base leading-relaxed mb-6">
            <p>
              Bên cạnh hoạt động Đoàn, sinh viên <strong>{{ faculty.name }}</strong> chủ động tham gia và điều hành các câu lạc bộ học thuật chuyên sâu. Đây là nơi nuôi dưỡng đam mê, trau dồi kỹ năng thực chiến và kết nối với các cựu sinh viên, doanh nghiệp đối tác.
            </p>
          </div>

          <!-- Danh sách Câu lạc bộ trực thuộc khoa -->
          {% if faculty.clubs_details %}
          <div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {% for c in faculty.clubs_details %}
              <div class="p-4 rounded-2xl border border-slate-200 bg-slate-50/60 hover:bg-white hover:border-blue-300 hover:shadow-md transition-all flex items-start justify-between gap-3">
                <div class="space-y-1">
                  <span class="font-bold text-slate-900 text-sm block">{{ c.name }}</span>
                  <span class="text-xs text-slate-500 block leading-tight">{{ c.desc }}</span>
                </div>
                {% if c.id %}
                <a href="/clb/{{ c.id }}/" class="shrink-0 text-blue-600 hover:text-blue-800 text-xs font-bold flex items-center gap-0.5">
                  <span>Chi tiết</span>
                  <span class="material-symbols-outlined text-[16px]">chevron_right</span>
                </a>
                {% endif %}
              </div>
              {% endfor %}
            </div>
          </div>
          {% endif %}
        </section>


        <!-- MỤC 8: THƯ VIỆN HÌNH ẢNH HOẠT ĐỘNG (GALLERY) -->
        <section id="hinh-anh" class="glass-card p-6 sm:p-8 scroll-mt-36">
          <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100">
            <div class="w-10 h-10 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-[24px]">photo_library</span>
            </div>
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-amber-700">Khoảnh khắc giảng đường và nghiên cứu</span>
              <h2 class="text-xl sm:text-2xl font-bold text-slate-900 font-headline-md">Thư Viện Hình Ảnh Hoạt Động</h2>
            </div>
          </div>

          <!-- Grid 4 Images -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {% for img in faculty.gallery %}
            <div class="group relative rounded-2xl overflow-hidden bg-slate-100 shadow-sm border border-slate-200 aspect-[4/3]">
              <img 
                src="{{ img.url }}" 
                alt="{{ img.caption }}" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                onerror="this.onerror=null; this.src='/static/img/khoa/tcnh_gallery_1.jpg';"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-900/80 via-transparent to-transparent flex items-end p-4">
                <span class="text-xs font-semibold text-white drop-shadow">{{ img.caption }}</span>
              </div>
            </div>
            {% endfor %}
          </div>
        </section>

      </div>


      <!-- CỘT PHẢI: SIDEBAR THÔNG TIN LIÊN HỆ và CHUYỂN KHOA NHANH (4 Cột) -->
      <aside class="lg:col-span-4 space-y-6 lg:sticky lg:top-36">
        
        <!-- CARD 1: THÔNG TIN LIÊN HỆ TRỰC TIẾP KHOA -->
        <div class="glass-card p-6 border-t-4 border-t-[#003366]">
          <h3 class="font-bold text-slate-900 text-lg mb-4 flex items-center gap-2">
            <span class="material-symbols-outlined text-[#003366] text-[22px]">contact_support</span>
            Liên hệ Văn phòng Khoa
          </h3>

          <div class="space-y-3.5 text-xs sm:text-sm text-slate-600">
            <div class="flex items-start gap-3">
              <span class="material-symbols-outlined text-[#003366] text-[18px] shrink-0 mt-0.5">location_on</span>
              <div>
                <span class="text-slate-400 block text-[11px]">Văn phòng Khoa:</span>
                <span class="font-semibold text-slate-800">{{ faculty.contact.office|default:"Khu Hiệu bộ, Trường ĐH Kinh tế - 71 Ngũ Hành Sơn, Đà Nẵng" }}</span>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <span class="material-symbols-outlined text-secondary-container text-[18px] shrink-0 mt-0.5">call</span>
              <div>
                <span class="text-slate-400 block text-[11px]">Hotline Khoa:</span>
                <a href="tel:{{ faculty.contact.phone|default:'02363836169' }}" class="font-bold text-secondary-container hover:underline">
                  {{ faculty.contact.phone|default:"(0236) 3836 169" }}
                </a>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <span class="material-symbols-outlined text-blue-600 text-[18px] shrink-0 mt-0.5">mail</span>
              <div>
                <span class="text-slate-400 block text-[11px]">Email chính thức:</span>
                <a href="mailto:{{ faculty.contact.email }}" class="font-medium text-slate-800 hover:text-blue-600 break-all">
                  {{ faculty.contact.email }}
                </a>
              </div>
            </div>

            {% if faculty.url %}
            <div class="flex items-start gap-3">
              <span class="material-symbols-outlined text-teal-600 text-[18px] shrink-0 mt-0.5">public</span>
              <div>
                <span class="text-slate-400 block text-[11px]">Trang tin Khoa:</span>
                <a href="{{ faculty.url }}" target="_blank" rel="noopener noreferrer" class="font-medium text-teal-700 hover:underline break-all">
                  {{ faculty.url }}
                </a>
              </div>
            </div>
            {% endif %}
          </div>

          <!-- Nút Messenger tư vấn tuyển sinh lớn -->
          <div class="mt-6 pt-5 border-t border-slate-100">
            <a 
              href="{{ faculty.contact.messenger|default:'https://m.me/FaceDue' }}" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="w-full flex items-center justify-center gap-2 px-5 py-3 rounded-2xl bg-gradient-to-r from-[#0072BC] to-[#0099FF] hover:from-[#005a96] hover:to-[#0072BC] text-white font-bold text-sm shadow-lg shadow-blue-500/25 transition-all hover:scale-[1.02]"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2C6.477 2 2 6.145 2 11.258c0 2.914 1.455 5.517 3.735 7.21V22l3.39-1.86c.91.252 1.88.388 2.875.388 5.523 0 10-4.145 10-9.258C22 6.145 17.523 2 12 2zm1.066 12.443l-2.573-2.744-5.021 2.744 5.524-5.86 2.64 2.744 4.954-2.744-5.524 5.86z"></path></svg>
              <span>Chat Messenger với Khoa</span>
            </a>
          </div>
        </div>


        <!-- CARD 2: CHUYỂN NHANH SANG CÁC KHOA KHÁC (Quick Switcher) -->
        <div class="glass-card p-6">
          <div class="flex items-center justify-between mb-4">
            <h3 class="font-bold text-slate-900 text-sm uppercase tracking-wider flex items-center gap-1.5">
              <span class="material-symbols-outlined text-[#fd761a] text-[18px]">swap_horiz</span>
              Khám phá các Khoa khác
            </h3>
            <a href="/khoa/" class="text-xs font-bold text-blue-600 hover:underline">Tất cả</a>
          </div>

          <div class="space-y-2">
            {% for of in other_faculties %}
            <a 
              href="/khoa/{{ of.id }}/" 
              class="flex items-center gap-2.5 p-2.5 rounded-xl hover:bg-slate-50 border border-transparent hover:border-slate-200 transition-all group"
            >
              <div class="w-8 h-8 rounded-lg bg-slate-100 flex items-center justify-center shrink-0 border border-slate-200 group-hover:scale-105 transition-transform overflow-hidden">
                <img 
                  src="{{ of.logo_url }}" 
                  alt="{{ of.name }}" 
                  class="w-full h-full object-contain p-1"
                  onerror="this.onerror=null; this.src='/static/img/khoa/tcnh_logo.png';"
                />
              </div>
              <div class="min-w-0 flex-1">
                <span class="text-xs font-semibold text-slate-700 group-hover:text-[#003366] transition-colors truncate block">
                  {{ of.name }}
                </span>
                <span class="text-[11px] text-slate-400 block truncate">
                  {{ of.majors_2026|length }} chuyên ngành 2026
                </span>
              </div>
              <span class="material-symbols-outlined text-slate-300 group-hover:text-[#fd761a] text-[16px] transition-colors">chevron_right</span>
            </a>
            {% endfor %}
          </div>
        </div>

      </aside>

    </div>
  </div>


  <!-- ====================================================
       4. MỤC BẮT BUỘC Ở DƯỚI CÙNG: HỆ THỐNG PHÒNG BAN CHỨC NĂNG và TRUNG TÂM
       (ĐÃ SỬA LỖI HÌNH 1: Hiển thị đầy đủ câu nhiệm vụ hỗ trợ, không bị cắt từng chữ)
       ==================================================== -->
  <section id="phong-ban-ho-tro" class="max-w-7xl mx-auto px-6 lg:px-12 mt-20 pt-16 border-t border-slate-200">
    
    <div class="text-center max-w-3xl mx-auto mb-12">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-100 text-[#003366] text-xs font-bold uppercase tracking-wider mb-3">
        <span class="w-2 h-2 rounded-full bg-[#00A859]"></span>
        Hệ sinh thái Hỗ trợ Sinh viên DUE
      </div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 font-headline-lg tracking-tight mb-3">
        Các Phòng Ban Chức Năng và trung Tâm Hỗ Trợ
      </h2>
      <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
        Bên cạnh Khoa chuyên môn, Nhà trường luôn đồng hành cùng sinh viên và quý phụ huynh thông qua hệ thống các phòng ban nghiệp vụ và trung tâm dịch vụ chuyên biệt:
      </p>
    </div>

    <!-- Grid 9 Phòng Ban Chức Năng và trung Tâm -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {% for pb in phongban_list %}
      <div class="p-6 rounded-3xl bg-white border border-slate-200 hover:border-blue-300 shadow-sm hover:shadow-lg transition-all flex flex-col justify-between group">
        <div>
          <!-- Header Badge và icon -->
          <div class="flex items-center justify-between mb-4">
            <div class="w-12 h-12 rounded-2xl flex items-center justify-center text-white shadow-md {{ pb.color|default:'bg-[#003366]' }} group-hover:scale-105 transition-transform">
              <span class="material-symbols-outlined text-[24px]">{{ pb.icon|default:'apartment' }}</span>
            </div>
            <span class="px-2.5 py-1 rounded-full bg-slate-100 text-slate-700 font-bold text-[11px] border border-slate-200/80">
              {{ pb.badge|default:"Phòng chức năng" }}
            </span>
          </div>

          <!-- Name và tagline -->
          <h3 class="text-base sm:text-lg font-bold text-slate-900 group-hover:text-[#003366] transition-colors mb-1.5 leading-snug">
            {{ pb.name }}
          </h3>
          <p class="text-xs text-blue-700 font-medium mb-3">
            {{ pb.tagline }}
          </p>
          <p class="text-xs text-slate-500 leading-relaxed mb-4">
            {{ pb.desc }}
          </p>

          <!-- Key Functions / Duties (ĐÃ SỬA LỖI HÌNH 1: Hiển thị đầy đủ danh sách nhiệm vụ) -->
          <div class="space-y-2 mb-5 pt-3 border-t border-slate-100 text-xs text-slate-600">
            <span class="font-bold text-slate-700 block text-[11px] uppercase tracking-wider">Nhiệm vụ trọng tâm hỗ trợ:</span>
            {% for fn in pb.duties %}
            <div class="flex items-start gap-1.5">
              <span class="material-symbols-outlined text-emerald-600 text-[15px] shrink-0 mt-0.5">check_circle</span>
              <span class="leading-snug">{{ fn }}</span>
            </div>
            {% endfor %}
          </div>
        </div>

        <!-- Contact details footer -->
        <div class="pt-4 border-t border-slate-100 text-xs text-slate-500 space-y-1.5 bg-slate-50/70 -mx-6 -mb-6 p-4 rounded-b-3xl">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-slate-400 text-[15px] shrink-0">location_on</span>
            <span class="font-medium text-slate-700 truncate">{{ pb.location }}</span>
          </div>
          <div class="flex items-center justify-between gap-2">
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-slate-400 text-[15px] shrink-0">call</span>
              <a href="tel:{{ pb.phone }}" class="text-blue-700 font-semibold hover:underline">{{ pb.phone }}</a>
            </div>
            <div class="flex items-center gap-1">
              <span class="material-symbols-outlined text-slate-400 text-[15px] shrink-0">mail</span>
              <a href="mailto:{{ pb.email }}" class="text-slate-600 hover:text-blue-600 truncate max-w-[130px]" title="{{ pb.email }}">{{ pb.email }}</a>
            </div>
          </div>
        </div>

      </div>
      {% endfor %}
    </div>

  </section>

</main>
{% endblock %}


--- FILE: CongthongtintuyensinhDUE/templates/portal/freshman_schedule.html ---
{% extends 'layouts/base.html' %}

{% block title %}Lịch trình Tân sinh viên - Cổng thông tin tuyển sinh DUE{% endblock %}

{% block content %}
<main class="w-full pt-32 sm:pt-36 pb-6 bg-surface min-h-[calc(100vh-28rem)] flex-1">
  <div class="max-w-7xl mx-auto px-6 lg:px-12 pt-8 pb-4">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs sm:text-sm text-on-surface-variant mb-6 font-medium">
      <a href="/" class="hover:text-primary-container transition-colors">Trang chủ</a>
      <span class="material-symbols-outlined text-[14px]">chevron_right</span>
      <span>Thông tin tuyển sinh</span>
      <span class="material-symbols-outlined text-[14px]">chevron_right</span>
      <span class="text-secondary-container font-semibold">Lịch trình Tân sinh viên</span>
    </nav>

    <!-- Header Banner -->
    <div class="bg-gradient-to-r from-[#003366] via-[#0056b3] to-[#0072BC] rounded-3xl p-6 sm:p-10 text-white shadow-xl mb-8 relative overflow-hidden">
      <div class="absolute -right-10 -bottom-10 w-60 h-60 rounded-full bg-white/10 blur-2xl pointer-events-none"></div>
      <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div>
          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight">Lịch Trình Tân Sinh Viên</h1>
          <p class="text-white/85 text-sm sm:text-base mt-2 max-w-2xl leading-relaxed">
            Các mốc thời gian quan trọng: Tuần sinh hoạt công dân đầu khóa, khám sức khỏe, kiểm tra tiếng Anh và lễ khai giảng năm học mới.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row md:flex-col gap-3 shrink-0">
          <a href="/huong-dan-nhap-hoc/" class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-full bg-white/15 hover:bg-white/25 text-white font-semibold text-xs sm:text-sm backdrop-blur-md border border-white/20 transition-all">
            <span class="material-symbols-outlined text-[18px]">menu_book</span>
            <span>Xem Hướng dẫn Nhập học</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Main Content Card -->
    <div class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200/80 shadow-md">
      {% include 'portal/components/freshman_schedule_content.html' %}
    </div>
  </div>
</main>
{% endblock %}


--- FILE: CongthongtintuyensinhDUE/templates/portal/youth_activities.html ---
{% extends 'layouts/base.html' %}

{% block title %}Đoàn Thanh Niên và hoạt Động Phong Trào - Trường Đại học Kinh tế DUE{% endblock %}

{% block nav_sinhvien %}text-secondary-container font-headline-sm border-b-2 border-secondary-container uppercase whitespace-nowrap font-bold{% endblock %}

{% block extra_head %}
<style>
  .doan-card {
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .doan-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 32px -4px rgba(225, 29, 72, 0.12);
  }
</style>
{% endblock %}

{% block content %}
<main class="w-full pt-32 sm:pt-36 pb-6 bg-surface min-h-[calc(100vh-28rem)] flex-1">
  <div class="max-w-7xl mx-auto px-6 lg:px-12 pt-8 pb-4">

    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs sm:text-sm text-on-surface-variant mb-6 font-medium">
      <a href="/" class="hover:text-primary-container transition-colors">Trang chủ</a>
      <span class="material-symbols-outlined text-[14px]">chevron_right</span>
      <a href="/sinh-vien/" class="hover:text-primary-container transition-colors">Dành cho sinh viên</a>
      <span class="material-symbols-outlined text-[14px]">chevron_right</span>
      <span class="text-secondary-container font-semibold">Hoạt động Đoàn và hội Sinh viên</span>
    </nav>

    <!-- Header Hero Banner -->
    <div class="bg-gradient-to-r from-[#001e40] via-[#831843] to-[#be123c] rounded-3xl p-6 sm:p-10 text-white shadow-xl relative overflow-hidden mb-12">
      <div class="absolute -right-16 -top-16 w-80 h-80 rounded-full bg-rose-500/20 blur-3xl pointer-events-none"></div>
      <div class="absolute -left-16 -bottom-16 w-80 h-80 rounded-full bg-blue-500/20 blur-3xl pointer-events-none"></div>

      <div class="relative z-10 max-w-3xl">
        <h1 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold font-headline-lg tracking-tight mb-3">
          Hoạt Động Đoàn và phong Trào Sinh Viên DUE
        </h1>

        <p class="text-slate-200 text-sm sm:text-base leading-relaxed mb-6">
          Đoàn Thanh niên – Hội Sinh viên DUE liên tục nhiều năm là <strong>lá cờ đầu trong công tác Đoàn và phong trào thanh niên khối trường học tại Đà Nẵng</strong>. Nơi khơi nguồn cảm hứng, tôi luyện bản lĩnh, kỹ năng lãnh đạo và tinh thần xung kích vì cộng đồng cho hơn 15.000 đoàn viên sinh viên.
        </p>

        <div class="flex flex-wrap items-center gap-3 text-xs sm:text-sm font-medium">
          <a href="/lien-chi-doan/" class="flex items-center gap-2 bg-gradient-to-r from-rose-600 to-red-500 hover:from-rose-700 hover:to-red-600 text-white px-5 py-2.5 rounded-full shadow-md transition-all hover:scale-105 font-bold">
            <span class="material-symbols-outlined text-[18px]">account_tree</span>
            <span>Khám phá 9 Liên Chi Đoàn</span>
          </a>
          <a href="/clb/" class="flex items-center gap-2 bg-white text-[#003366] hover:bg-slate-100 px-5 py-2.5 rounded-full shadow-md transition-all hover:scale-105 font-bold">
            <span class="material-symbols-outlined text-[18px]">groups</span>
            <span>Khám phá 40+ CLB</span>
          </a>
          <a href="https://www.facebook.com/FaceDue" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 bg-[#1877F2] hover:bg-[#166fe5] text-white px-4 py-2.5 rounded-full shadow-md transition-all hover:scale-105">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.469h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"></path></svg>
            <span>Fanpage FaceDue</span>
          </a>
        </div>
      </div>
    </div>


    <!-- ====================================================
         1. 4 CHIẾN DỊCH TÌNH NGUYỆN và PHONG TRÀO LỚN
         ==================================================== -->
    <div class="mb-14">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <span class="px-3 py-1 rounded-full bg-rose-100 text-rose-800 text-xs font-bold uppercase tracking-wider">Dấu ấn xung kích</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 font-headline-lg mt-2 mb-3">
          Các Chiến Dịch Tình Nguyện Trọng Tâm Của Tuổi Trẻ DUE
        </h2>
        <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
          Những dấu chân tình nguyện của sinh viên DUE in đậm khắp các bản làng vùng cao và thành phố Đà Nẵng:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        
        <!-- Chiến dịch 1: Mùa hè xanh -->
        <div class="doan-card p-6 rounded-3xl bg-white border border-slate-200 shadow-sm flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-3 mb-4">
              <div class="w-12 h-12 rounded-2xl bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-[26px]">nature_people</span>
              </div>
              <div>
                <span class="text-xs font-bold uppercase text-emerald-600">Tháng 7 hàng năm</span>
                <h3 class="text-lg sm:text-xl font-bold text-slate-900">Chiến Dịch Tình Nguyện Mùa Hè Xanh</h3>
              </div>
            </div>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-4">
              Hành quân về các xã vùng sâu, vùng xa thuộc tỉnh Quảng Nam, Kon Tum, Quảng Ngãi. Đoàn viên sinh viên trực tiếp thi công đường giao thông nông thôn, sửa chữa trường học, thắp sáng đường quê, khám chữa bệnh và tổ chức sinh hoạt hè cho hàng ngàn thiếu nhi.
            </p>
            <div class="p-3 rounded-xl bg-slate-50 border border-slate-100 text-xs text-slate-700 space-y-1">
              <div><strong>Quy mô:</strong> Hơn 500 chiến sĩ tình nguyện mỗi mùa chiến dịch.</div>
              <div><strong>Công trình tiêu biểu:</strong> 15+ sân chơi trẻ em, 10km đường bê tông nông thôn, 50 suất học bổng.</div>
            </div>
          </div>
        </div>

        <!-- Chiến dịch 2: Tiếp sức mùa thi -->
        <div class="doan-card p-6 rounded-3xl bg-white border border-slate-200 shadow-sm flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-3 mb-4">
              <div class="w-12 h-12 rounded-2xl bg-blue-100 text-blue-700 flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-[26px]">school</span>
              </div>
              <div>
                <span class="text-xs font-bold uppercase text-blue-600">Đồng hành cùng sĩ tử</span>
                <h3 class="text-lg sm:text-xl font-bold text-slate-900">Chương Trình Tiếp Sức Mùa Thi</h3>
              </div>
            </div>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-4">
              Túc trực tại các điểm thi tốt nghiệp THPT, bến xe, nhà ga Đà Nẵng để phát nước uống, đồ ăn nhẹ miễn phí, phân luồng giao thông và hỗ trợ tìm nhà trọ giá rẻ/miễn phí cho thí sinh và phụ huynh có hoàn cảnh khó khăn.
            </p>
            <div class="p-3 rounded-xl bg-slate-50 border border-slate-100 text-xs text-slate-700 space-y-1">
              <div><strong>Địa bàn hỗ trợ:</strong> 25+ điểm thi trên toàn địa bàn TP. Đà Nẵng.</div>
              <div><strong>Hỗ trợ:</strong> Hơn 20.000 chai nước suối, 5.000 suất ăn, xe ôm tình nguyện miễn phí 100%.</div>
            </div>
          </div>
        </div>

        <!-- Chiến dịch 3: Giọt hồng DUE -->
        <div class="doan-card p-6 rounded-3xl bg-white border border-slate-200 shadow-sm flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-3 mb-4">
              <div class="w-12 h-12 rounded-2xl bg-rose-100 text-rose-700 flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-[26px]">volunteer_activism</span>
              </div>
              <div>
                <span class="text-xs font-bold uppercase text-rose-600">Nghĩa cử cao đẹp</span>
                <h3 class="text-lg sm:text-xl font-bold text-slate-900">Ngày Hội Hiến Máu "Giọt Hồng DUE"</h3>
              </div>
            </div>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-4">
              Hoạt động hiến máu nhân đạo định kỳ 4 đợt trong năm phối hợp cùng Bệnh viện Đa khoa Đà Nẵng và Bệnh viện Phụ sản - Nhi. Từng giọt máu hồng của sinh viên DUE kịp thời cứu chữa hàng ngàn bệnh nhân trong lúc nguy kịch.
            </p>
            <div class="p-3 rounded-xl bg-slate-50 border border-slate-100 text-xs text-slate-700 space-y-1">
              <div><strong>Kết quả:</strong> Tiếp nhận hơn 2.500 đơn vị máu an toàn mỗi năm học.</div>
              <div><strong>Khen thưởng:</strong> Bằng khen của Hội Chữ thập đỏ TP. Đà Nẵng cho đơn vị xuất sắc.</div>
            </div>
          </div>
        </div>

        <!-- Chiến dịch 4: Xuân Tình Nguyện -->
        <div class="doan-card p-6 rounded-3xl bg-white border border-slate-200 shadow-sm flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-3 mb-4">
              <div class="w-12 h-12 rounded-2xl bg-amber-100 text-amber-700 flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined text-[26px]">celebration</span>
              </div>
              <div>
                <span class="text-xs font-bold uppercase text-amber-700">Tết ấm cho người nghèo</span>
                <h3 class="text-lg sm:text-xl font-bold text-slate-900">Xuân Tình Nguyện – Tết Yêu Thương</h3>
              </div>
            </div>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-4">
              Gây quỹ từ các đêm nhạc thiện nguyện và hội chợ xuân sinh viên, tự tay gói hàng ngàn đòn bánh chưng trao tặng các cụ già neo đơn, người vô gia cư và trẻ em khuyết tật trước thềm Tết Nguyên Đán.
            </p>
            <div class="p-3 rounded-xl bg-slate-50 border border-slate-100 text-xs text-slate-700 space-y-1">
              <div><strong>Ý nghĩa:</strong> Lan tỏa ngọn lửa nhân ái và giáo dục lòng trắc ẩn cho sinh viên.</div>
              <div><strong>Phần quà:</strong> 1.000+ đòn bánh chưng, hàng trăm phần quà tết và vé xe về quê sum vầy.</div>
            </div>
          </div>
        </div>

      </div>
    </div>


    <!-- ====================================================
         2. PHONG TRÀO "SINH VIÊN 5 TỐT" và KẾT NẠP ĐẢNG
         ==================================================== -->
    <div class="mb-14 p-6 sm:p-10 rounded-3xl bg-gradient-to-br from-blue-50/70 via-indigo-50/50 to-rose-50/50 border border-blue-100">
      <div class="max-w-3xl mb-8">
        <span class="px-3 py-1 rounded-full bg-blue-100 text-[#003366] text-xs font-bold uppercase">Danh hiệu cao quý nhất</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 font-headline-lg mt-2 mb-3">
          Phong Trào "Sinh Viên 5 Tốt" và Phát Triển Đảng Viên Trẻ
        </h2>
        <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
          Danh hiệu "Sinh viên 5 tốt" là thước đo chuẩn mực danh giá được các tập đoàn đa quốc gia và nhà tuyển dụng hàng đầu đánh giá cao khi sinh viên DUE ứng tuyển.
        </p>
      </div>

      <!-- 5 Tiêu chí vàng -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3.5 mb-8">
        <div class="p-4 rounded-2xl bg-white border border-slate-200/80 shadow-xs text-center">
          <div class="w-10 h-10 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center mx-auto mb-2 font-bold text-sm">1</div>
          <h4 class="font-bold text-slate-800 text-xs sm:text-sm mb-1">Đạo Đức Tốt</h4>
          <p class="text-[11px] text-slate-500 leading-snug">Ý thức kỷ luật, lối sống lành mạnh, điểm rèn luyện &ge; 80</p>
        </div>

        <div class="p-4 rounded-2xl bg-white border border-slate-200/80 shadow-xs text-center">
          <div class="w-10 h-10 rounded-xl bg-indigo-100 text-indigo-700 flex items-center justify-center mx-auto mb-2 font-bold text-sm">2</div>
          <h4 class="font-bold text-slate-800 text-xs sm:text-sm mb-1">Học Tập Tốt</h4>
          <p class="text-[11px] text-slate-500 leading-snug">GPA học tập &ge; 3.2/4.0, tham gia NCKH hoặc thi học thuật</p>
        </div>

        <div class="p-4 rounded-2xl bg-white border border-slate-200/80 shadow-xs text-center">
          <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center mx-auto mb-2 font-bold text-sm">3</div>
          <h4 class="font-bold text-slate-800 text-xs sm:text-sm mb-1">Thể Lực Tốt</h4>
          <p class="text-[11px] text-slate-500 leading-snug">Đạt chuẩn tiêu chuẩn thể lực sinh viên, tham gia hội thao</p>
        </div>

        <div class="p-4 rounded-2xl bg-white border border-slate-200/80 shadow-xs text-center">
          <div class="w-10 h-10 rounded-xl bg-rose-100 text-rose-700 flex items-center justify-center mx-auto mb-2 font-bold text-sm">4</div>
          <h4 class="font-bold text-slate-800 text-xs sm:text-sm mb-1">Tình Nguyện Tốt</h4>
          <p class="text-[11px] text-slate-500 leading-snug">Tham gia ít nhất 2 hoạt động tình nguyện hoặc hiến máu</p>
        </div>

        <div class="p-4 rounded-2xl bg-white border border-slate-200/80 shadow-xs text-center">
          <div class="w-10 h-10 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center mx-auto mb-2 font-bold text-sm">5</div>
          <h4 class="font-bold text-slate-800 text-xs sm:text-sm mb-1">Hội Nhập Tốt</h4>
          <p class="text-[11px] text-slate-500 leading-snug">Đạt chuẩn tiếng Anh TOEIC/IELTS, tham gia giao lưu quốc tế</p>
        </div>
      </div>

      <!-- Khối Bồi dưỡng Kết nạp Đảng -->
      <div class="p-5 rounded-2xl bg-white border border-rose-200/80 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div class="flex items-center gap-3.5">
          <div class="w-12 h-12 rounded-xl bg-red-600 text-white flex items-center justify-center shrink-0 shadow-sm">
            <span class="material-symbols-outlined text-[24px]">grade</span>
          </div>
          <div>
            <h4 class="font-bold text-slate-900 text-sm sm:text-base">Bồi Dưỡng và kết Nạp Đảng Cho Đoàn Viên Ưu Tú</h4>
            <p class="text-xs text-slate-500 mt-0.5">
              Hàng năm Đoàn trường giới thiệu và tổ chức lễ kết nạp Đảng ngay trên giảng đường cho <strong>30 – 50 đoàn viên sinh viên xuất sắc nhất</strong>.
            </p>
          </div>
        </div>
        <span class="px-4 py-2 rounded-xl bg-red-50 text-red-700 font-bold text-xs shrink-0 border border-red-200">
          Vinh dự đứng vào hàng ngũ của Đảng
        </span>
      </div>
    </div>


    <!-- ====================================================
         3. SỰ KIỆN NGHỆ THUẬT, LỄ HỘI và THỂ THAO ĐỈNH CAO
         ==================================================== -->
    <div class="mb-14">
      <div class="text-center max-w-3xl mx-auto mb-10">
        <span class="px-3 py-1 rounded-full bg-purple-100 text-purple-800 text-xs font-bold uppercase tracking-wider">Thanh xuân rực rỡ</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 font-headline-lg mt-2 mb-3">
          Chuỗi Sự Kiện Văn Hóa và thể Thao Thường Niên
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm flex flex-col justify-between hover:border-purple-300 transition-all">
          <div>
            <div class="w-10 h-10 rounded-xl bg-purple-100 text-purple-700 flex items-center justify-center mb-3">
              <span class="material-symbols-outlined text-[22px]">camping</span>
            </div>
            <h4 class="font-bold text-slate-900 text-sm mb-1">Hội Trại Truyền Thống DUE</h4>
            <p class="text-xs text-slate-500 leading-relaxed mb-3">
              Sự kiện 2 năm/lần quy mô toàn trường với hàng ngàn trại sinh, thi dựng cổng trại, trò chơi lớn và đêm nhạc hội EDM bùng nổ.
            </p>
          </div>
          <span class="text-[11px] font-bold text-purple-700">Diễn ra vào tháng 3</span>
        </div>

        <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm flex flex-col justify-between hover:border-pink-300 transition-all">
          <div>
            <div class="w-10 h-10 rounded-xl bg-pink-100 text-pink-700 flex items-center justify-center mb-3">
              <span class="material-symbols-outlined text-[22px]">diamond</span>
            </div>
            <h4 class="font-bold text-slate-900 text-sm mb-1">Hoa Khôi Sinh Viên (Miss DUE)</h4>
            <p class="text-xs text-slate-500 leading-relaxed mb-3">
              Sân chơi tôn vinh vẻ đẹp trí tuệ, nét duyên dáng và tài năng lãnh đạo của các nữ sinh viên Trường ĐH Kinh tế.
            </p>
          </div>
          <span class="text-[11px] font-bold text-pink-700">Tôn vinh tài sắc DUE</span>
        </div>

        <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm flex flex-col justify-between hover:border-green-300 transition-all">
          <div>
            <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center mb-3">
              <span class="material-symbols-outlined text-[22px]">sports_soccer</span>
            </div>
            <h4 class="font-bold text-slate-900 text-sm mb-1">Giải Bóng Đá DUE Cup</h4>
            <p class="text-xs text-slate-500 leading-relaxed mb-3">
              Giải bóng đá sinh viên nam - nữ tranh cúp truyền thống giữa các Khoa, mang lại không khí tranh tài nảy lửa trên sân cỏ.
            </p>
          </div>
          <span class="text-[11px] font-bold text-emerald-700">Rèn luyện thể lực vàng</span>
        </div>

        <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm flex flex-col justify-between hover:border-blue-300 transition-all">
          <div>
            <div class="w-10 h-10 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center mb-3">
              <span class="material-symbols-outlined text-[22px]">music_note</span>
            </div>
            <h4 class="font-bold text-slate-900 text-sm mb-1">Gala Chào Tân Sinh Viên</h4>
            <p class="text-xs text-slate-500 leading-relaxed mb-3">
              Đêm đại nhạc hội Freshers' Night với sự góp mặt của các ca sĩ, DJ nổi tiếng chào đón tân sinh viên khóa mới nhập trường.
            </p>
          </div>
          <span class="text-[11px] font-bold text-blue-700">Chào đón Khóa 50K</span>
        </div>
      </div>
    </div>


    <!-- ====================================================
         4. CẦU NỐI ĐẾN LIÊN CHI ĐOÀN VÀ CÂU LẠC BỘ
         ==================================================== -->
    <div class="mb-14 grid grid-cols-1 md:grid-cols-2 gap-6">
      
      <!-- Card 1: Khám phá 9 Liên Chi Đoàn -->
      <div class="p-6 sm:p-8 rounded-3xl bg-gradient-to-r from-rose-50 to-red-50/60 border border-rose-200 shadow-sm flex flex-col justify-between">
        <div>
          <span class="px-2.5 py-1 rounded-full bg-rose-100 text-rose-700 text-xs font-bold uppercase">Cơ sở trực thuộc</span>
          <h3 class="text-xl font-bold text-slate-900 mt-2 mb-2">Hệ Thống 9 Liên Chi Đoàn Khoa</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-6">
            Mỗi Khoa tại DUE đều có Liên Chi Đoàn riêng biệt với ban chấp hành, hoạt động học thuật và thư viện ảnh phong trào độc đáo.
          </p>
        </div>
        <a 
          href="/lien-chi-doan/" 
          class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-2xl bg-gradient-to-r from-rose-600 to-red-500 hover:from-rose-700 hover:to-red-600 text-white font-bold text-xs sm:text-sm shadow-md transition-all hover:scale-[1.02]"
        >
          <span>Khám phá Trang Riêng 9 Liên Chi Đoàn</span>
          <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
        </a>
      </div>

      <!-- Card 2: Khám phá 40+ Câu Lạc Bộ -->
      <div class="p-6 sm:p-8 rounded-3xl bg-gradient-to-r from-blue-50 to-indigo-50/60 border border-blue-200 shadow-sm flex flex-col justify-between">
        <div>
          <span class="px-2.5 py-1 rounded-full bg-blue-100 text-[#003366] text-xs font-bold uppercase">Đam mê và kỹ năng</span>
          <h3 class="text-xl font-bold text-slate-900 mt-2 mb-2">Hệ Thống 40+ Câu Lạc Bộ Sinh Viên</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-6">
            Tham gia vào các CLB học thuật, tiếng Anh, nghệ thuật, thể thao và tình nguyện để phát triển kỹ năng mềm toàn diện.
          </p>
        </div>
        <a 
          href="/clb/" 
          class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-2xl bg-[#003366] hover:bg-[#002244] text-white font-bold text-xs sm:text-sm shadow-md transition-all hover:scale-[1.02]"
        >
          <span>Khám phá Trang Riêng 40+ Câu Lạc Bộ</span>
          <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
        </a>
      </div>

    </div>


    <!-- ====================================================
         5. THÔNG TIN LIÊN HỆ VĂN PHÒNG ĐOÀN TRƯỜNG
         ==================================================== -->
    <div class="rounded-3xl bg-white border border-slate-200 p-6 sm:p-8 shadow-sm">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="space-y-2 max-w-2xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-100 text-red-700 text-xs font-bold uppercase">
            Cơ quan điều hành
          </div>
          <h3 class="text-lg sm:text-xl font-bold text-slate-900">
            Văn Phòng Đoàn Thanh Niên – Hội Sinh Viên Trường ĐH Kinh Tế
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Địa chỉ: Tầng 1, Nhà Đa Năng, 71 Ngũ Hành Sơn, Bắc Mỹ An, Ngũ Hành Sơn, TP. Đà Nẵng. Tiếp nhận thủ tục chuyển sinh hoạt đoàn, tư vấn tham gia CLB, hỗ trợ hồ sơ Sinh viên 5 tốt và bồi dưỡng đoàn viên ưu tú.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 shrink-0">
          <a 
            href="https://www.facebook.com/FaceDue" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-2xl bg-[#1877F2] hover:bg-[#166fe5] text-white font-bold text-xs sm:text-sm shadow-md transition-all hover:scale-105"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.469h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"></path></svg>
            <span>Fanpage FaceDue</span>
          </a>

          <a 
            href="tel:02363836169" 
            class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-2xl bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-xs sm:text-sm transition-colors"
          >
            <span class="material-symbols-outlined text-[18px]">call</span>
            <span>Hotline: (0236) 3836 169</span>
          </a>
        </div>
      </div>
    </div>

  </div>
</main>
{% endblock %}



--- FILE: CongthongtintuyensinhDUE/templates/portal/youth_unions.html ---
{% extends 'layouts/base.html' %}

{% block title %}Hệ Thống Liên Chi Đoàn Các Khoa - Đoàn Thanh Niên DUE{% endblock %}

{% block nav_sinhvien %}text-secondary-container font-headline-sm border-b-2 border-secondary-container uppercase whitespace-nowrap font-bold{% endblock %}

{% block extra_head %}
<style>
  .lcd-card-item {
    transition: all .25s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .lcd-card-item:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 32px -4px rgba(225, 29, 72, 0.12);
  }
</style>
{% endblock %}

{% block content %}
<main class="w-full pt-32 sm:pt-36 pb-6 bg-surface min-h-[calc(100vh-28rem)] flex-1">
  <div class="max-w-7xl mx-auto px-6 lg:px-12 pt-8 pb-4">

    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs sm:text-sm text-on-surface-variant mb-6 font-medium">
      <a href="/" class="hover:text-primary-container transition-colors">Trang chủ</a>
      <span class="material-symbols-outlined text-[14px]">chevron_right</span>
      <a href="/khoa/" class="hover:text-primary-container transition-colors">Khoa và viện Đào Tạo</a>
      <span class="material-symbols-outlined text-[14px]">chevron_right</span>
      <span class="text-secondary-container font-semibold">Liên Chi Đoàn DUE</span>
    </nav>

    <!-- Header Hero Banner -->
    <div class="bg-gradient-to-r from-[#001e40] via-[#003366] to-[#be123c] rounded-3xl p-6 sm:p-10 text-white shadow-xl relative overflow-hidden mb-12">
      <div class="absolute -right-16 -top-16 w-80 h-80 rounded-full bg-rose-500/20 blur-3xl pointer-events-none"></div>
      <div class="absolute -left-16 -bottom-16 w-80 h-80 rounded-full bg-blue-500/20 blur-3xl pointer-events-none"></div>

      <div class="relative z-10 max-w-3xl">
        <h1 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold font-headline-lg tracking-tight mb-3">
          Liên Chi Đoàn các Khoa
        </h1>

        <p class="text-slate-200 text-sm sm:text-base leading-relaxed mb-6">
          Mạng lưới <strong>9 Liên Chi Đoàn trực thuộc 8 Khoa và viện Đào tạo Quốc tế DUE</strong> là môi trường tôi luyện bản lĩnh, kỹ năng lãnh đạo và kết nối cộng đồng năng động cho hơn 15.000 đoàn viên sinh viên. Mỗi Liên Chi Đoàn có trang thông tin riêng với đầy đủ nhân sự Ban Chấp Hành, các hoạt động tiêu biểu và hình ảnh phong trào.
        </p>
      </div>
    </div>


    <!-- ====================================================
         LƯỚI 9 LIÊN CHI ĐOÀN CÁC KHOA
         ==================================================== -->
    <div class="mb-16">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 font-headline-md">
            Danh sách 9 Liên Chi Đoàn Trực Thuộc
          </h2>
        </div>

        <div class="relative w-full sm:w-72">
          <input 
            type="text" 
            id="searchLcdInput" 
            placeholder="Tìm kiếm Liên Chi Đoàn..." 
            class="w-full pl-9 pr-4 py-2 bg-white border border-slate-200 rounded-full text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-rose-500 transition-all"
            onkeyup="filterLcdCards()"
          />
          <span class="material-symbols-outlined absolute left-3 top-2.5 text-slate-400 text-[18px]">search</span>
        </div>
      </div>

      <!-- Grid 9 Thẻ LCĐ -->
      <div id="lcdGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {% for fac in faculties %}
        <div class="lcd-card-item rounded-3xl bg-white border border-slate-200 hover:border-rose-300 shadow-sm p-6 flex flex-col justify-between group" data-name="{{ fac.lcd.name|default:fac.name|lower }} {{ fac.name|lower }} {{ fac.lcd.secretary|lower }}">
          
          <div>
            <!-- Top Badges -->
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class="px-2.5 py-1 rounded-full bg-rose-50 text-rose-700 font-bold text-[11px] border border-rose-200/80 flex items-center gap-1">
                <span class="material-symbols-outlined text-[14px]">flag</span>
                <span class="font-medium">{{ fac.clubs_count }} CLB trực thuộc</span>
              </span>
            </div>

            <!-- Tên và giới thiệu -->
            <div class="flex items-start gap-3.5 mb-3.5">
              <div class="w-12 h-12 rounded-2xl bg-slate-50 p-1.5 shrink-0 border border-slate-100 flex items-center justify-center group-hover:scale-105 transition-transform">
                <img src="{{ fac.logo_url }}" alt="{{ fac.name }}" class="w-full h-full object-contain" onerror="this.onerror=null; this.src='/static/img/khoa/tcnh_logo.png';" />
              </div>
              <div>
                <h3 class="text-base sm:text-lg font-bold text-slate-900 group-hover:text-rose-600 transition-colors leading-snug">
                  {{ fac.lcd.name|default:fac.lien_chi_doan }}
                </h3>
                <span class="text-xs text-blue-700 font-medium block mt-0.5">Khoa: {{ fac.name }}</span>
              </div>
            </div>

            <!-- Bí thư LCĐ -->
            <div class="p-3 rounded-xl bg-slate-50 border border-slate-100 mb-3.5 flex items-center gap-2.5">
              <span class="material-symbols-outlined text-rose-600 text-[18px] shrink-0">badge</span>
              <div class="text-xs">
                <span class="text-slate-400 block text-[10px] uppercase font-bold">Bí thư Liên Chi Đoàn:</span>
                <span class="font-bold text-slate-800">{{ fac.lcd.secretary|default:"Đang cập nhật" }}</span>
              </div>
            </div>

            <!-- Tóm tắt giới thiệu -->
            <p class="text-xs text-slate-500 line-clamp-3 leading-relaxed mb-4">
              {{ fac.lcd.intro|default:"Tổ chức Đoàn cơ sở năng động, quy tụ các bạn sinh viên nhiệt huyết, tổ chức các cuộc thi học thuật và hoạt động tình nguyện tiêu biểu." }}
            </p>
          </div>

          <!-- Bottom Action Buttons -->
          <div class="pt-4 border-t border-slate-100 flex items-center justify-between gap-2">
            <a 
              href="/lien-chi-doan/{{ fac.id }}/" 
              class="flex-1 flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-xl bg-gradient-to-r from-rose-600 to-red-500 hover:from-rose-700 hover:to-red-600 text-white font-bold text-xs shadow-sm transition-all hover:scale-[1.02]"
            >
              <span>Xem trang riêng LCĐ</span>
              <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
            </a>

            {% if fac.lcd.fanpage %}
            <a 
              href="{{ fac.lcd.fanpage }}" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="p-2.5 rounded-xl bg-blue-50 text-[#1877F2] hover:bg-blue-100 transition-colors"
              title="Ghé thăm Fanpage LCĐ"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.469h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"></path></svg>
            </a>
            {% endif %}
          </div>

        </div>
        {% endfor %}
      </div>
    </div>


    <!-- ====================================================
         THÔNG TIN VĂN PHÒNG ĐOÀN THANH NIÊN - HỘI SINH VIÊN TRƯỜNG
         ==================================================== -->
    <div class="rounded-3xl bg-white border border-slate-200 p-6 sm:p-8 shadow-sm">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="space-y-2 max-w-2xl">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-100 text-[#003366] text-xs font-bold uppercase">
            Cơ quan thường trực
          </div>
          <h3 class="text-lg sm:text-xl font-bold text-slate-900">
            Văn Phòng Đoàn Thanh Niên – Hội Sinh Viên Trường Đại Học Kinh Tế
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Địa chỉ: Tầng 1, Nhà Đa năng, 71 Ngũ Hành Sơn, Bắc Mỹ An, Ngũ Hành Sơn, Đà Nẵng. Tiếp nhận các thủ tục chuyển sinh hoạt đoàn, giới thiệu đoàn viên ưu tú vào Đảng, tư vấn phong trào Sinh viên 5 tốt và hỗ trợ CLB đội nhóm.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 shrink-0">
          <a 
            href="https://www.facebook.com/FaceDue" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-2xl bg-[#1877F2] hover:bg-[#166fe5] text-white font-bold text-xs sm:text-sm shadow-md transition-all hover:scale-105"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.469h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"></path></svg>
            <span>Fanpage Đoàn Trường DUE</span>
          </a>

          <a 
            href="/clb/" 
            class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-2xl bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-xs sm:text-sm transition-colors"
          >
            <span>Khám phá 40+ CLB DUE</span>
            <span class="material-symbols-outlined text-[18px]">groups</span>
          </a>
        </div>
      </div>
    </div>

  </div>
</main>

<script>
  function filterLcdCards() {
    const input = document.getElementById('searchLcdInput').value.toLowerCase().trim();
    const cards = document.querySelectorAll('.lcd-card-item');
    cards.forEach(card => {
      const text = card.getAttribute('data-name') || '';
      if (!input || text.includes(input)) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }
    });
  }
</script>
{% endblock %}



--- FILE: CongthongtintuyensinhDUE/templates/portal/youth_union_detail.html ---
{% extends 'layouts/base.html' %}

{% block title %}{{ lcd.name|default:faculty.lien_chi_doan }} - Đoàn Thanh Niên DUE{% endblock %}

{% block nav_sinhvien %}text-secondary-container font-headline-sm border-b-2 border-secondary-container uppercase whitespace-nowrap font-bold{% endblock %}

{% block extra_head %}
<style>
  .lcd-glass-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 1.5rem;
    box-shadow: 0 4px 16px rgba(0, 30, 64, 0.04);
    transition: all 0.25s ease;
  }
  .lcd-glass-card:hover {
    border-color: #cbd5e1;
    box-shadow: 0 8px 24px rgba(0, 30, 64, 0.08);
  }
</style>
{% endblock %}

{% block content %}
<main class="w-full pt-32 sm:pt-36 pb-6 bg-surface min-h-[calc(100vh-28rem)] flex-1">

  <!-- ====================================================
       1. BREADCRUMB và HERO BANNER LIÊN CHI ĐOÀN
       ==================================================== -->
  <div class="max-w-7xl mx-auto px-6 lg:px-12 pt-8 pb-4 mb-4">
    
    <!-- Breadcrumb -->
    <nav class="flex flex-wrap items-center gap-2 text-xs sm:text-sm text-on-surface-variant mb-6 font-medium">
      <a href="/" class="hover:text-primary-container transition-colors">Trang chủ</a>
      <span class="material-symbols-outlined text-[14px]">chevron_right</span>
      <a href="/khoa/" class="hover:text-primary-container transition-colors">Khoa và viện Đào Tạo</a>
      <span class="material-symbols-outlined text-[14px]">chevron_right</span>
      <a href="/khoa/{{ faculty.id }}/" class="hover:text-primary-container transition-colors">{{ faculty.name }}</a>
      <span class="material-symbols-outlined text-[14px]">chevron_right</span>
      <a href="/lien-chi-doan/" class="hover:text-primary-container transition-colors">Liên Chi Đoàn</a>
      <span class="material-symbols-outlined text-[14px]">chevron_right</span>
      <span class="text-secondary-container font-semibold truncate max-w-[200px] sm:max-w-none">{{ lcd.name|default:"Chi tiết LCĐ" }}</span>
    </nav>

    <!-- Hero Card Liên Chi Đoàn -->
    <div class="rounded-3xl bg-gradient-to-r from-[#001e40] via-[#003366] to-[#be123c] p-6 sm:p-10 text-white shadow-xl relative overflow-hidden">
      <!-- Glow decoration -->
      <div class="absolute -right-16 -top-16 w-80 h-80 rounded-full bg-rose-500/20 blur-3xl pointer-events-none"></div>
      <div class="absolute -left-16 -bottom-16 w-80 h-80 rounded-full bg-blue-500/15 blur-3xl pointer-events-none"></div>

      <div class="relative z-10">
        <!-- Top Tags -->
        <div class="flex flex-wrap items-center gap-2.5 mb-5">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-rose-600 text-white text-xs font-bold shadow-sm">
            <span class="material-symbols-outlined text-[16px]">flag</span>
            Đoàn TNCS Hồ Chí Minh DUE
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/15 text-white text-xs font-semibold backdrop-blur-sm border border-white/20">
            <span class="w-2 h-2 rounded-full bg-amber-400"></span>
            {{ lcd.term|default:"Nhiệm kỳ 2024–2027" }}
          </span>
          <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-white/10 text-slate-200 text-xs">
            Trực thuộc: {{ faculty.name }}
          </span>
        </div>

        <div class="flex flex-col md:flex-row md:items-center gap-6 mb-8">
          <!-- Logo Khoa / Badge Đoàn -->
          <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-2xl bg-white p-3 shrink-0 shadow-lg border border-white/30 flex items-center justify-center">
            <img 
              src="{{ faculty.logo_url }}" 
              alt="{{ lcd.name }}" 
              class="w-full h-full object-contain"
              onerror="this.onerror=null; this.src='/static/img/khoa/tcnh_logo.png';"
            />
          </div>

          <!-- Titles -->
          <div class="space-y-2 max-w-3xl">
            <h1 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold font-headline-lg tracking-tight leading-tight text-white drop-shadow-sm">
              {{ lcd.name|default:faculty.lien_chi_doan }}
            </h1>
            <p class="text-amber-300 font-semibold text-base sm:text-lg italic tracking-wide">
              &ldquo;Tuổi trẻ {{ faculty.short_name|default:faculty.name }} - Bản lĩnh, Sáng tạo, Tiên phong, Hội nhập&rdquo;
            </p>
            <p class="text-slate-200 text-xs sm:text-sm leading-relaxed">
              Cánh tay nối dài của Đoàn trường ĐH Kinh tế – ĐH Đà Nẵng tại {{ faculty.name }}. Nơi quy tụ những trái tim nhiệt huyết, rèn luyện kỹ năng và kiến tạo các giá trị cộng đồng.
            </p>
          </div>
        </div>

        <!-- Hero Bottom Action Buttons và key Figures -->
        <div class="pt-6 border-t border-white/15 flex flex-col lg:flex-row lg:items-center justify-between gap-4">
          <!-- Action Buttons -->
          <div class="flex flex-wrap items-center gap-3">
            <a href="/khoa/{{ faculty.id }}/" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full bg-white/15 hover:bg-white/25 text-white font-bold text-xs sm:text-sm backdrop-blur-sm border border-white/20 transition-all hover:scale-105">
              <span class="material-symbols-outlined text-[18px]">arrow_back</span>
              <span>Về trang Khoa đào tạo</span>
            </a>

            {% if lcd.fanpage %}
            <a href="{{ lcd.fanpage }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full bg-[#1877F2] hover:bg-[#166fe5] text-white font-bold text-xs sm:text-sm shadow-md transition-all hover:scale-105">
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.469h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"></path></svg>
              <span>Fanpage LCĐ</span>
            </a>
            {% endif %}

            {% if lcd.messenger %}
            <a href="{{ lcd.messenger }}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full bg-gradient-to-r from-[#0084FF] to-[#00C6FF] hover:opacity-95 text-white font-bold text-xs sm:text-sm shadow-md transition-all hover:scale-105">
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2C6.477 2 2 6.145 2 11.258c0 2.914 1.455 5.517 3.735 7.21V22l3.39-1.86c.91.252 1.88.388 2.875.388 5.523 0 10-4.145 10-9.258C22 6.145 17.523 2 12 2zm1.066 12.443l-2.573-2.744-5.021 2.744 5.524-5.86 2.64 2.744 4.954-2.744-5.524 5.86z"></path></svg>
              <span>Nhắn tin tư vấn</span>
            </a>
            {% endif %}

            <a href="#hoat-dong" class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-full bg-gradient-to-r from-rose-500 to-red-600 hover:from-rose-600 hover:to-red-700 text-white font-bold text-xs sm:text-sm shadow-md transition-all hover:scale-105">
              <span>Xem hoạt động</span>
              <span class="material-symbols-outlined text-[18px]">arrow_downward</span>
            </a>
          </div>

          <!-- Quick Stats Figures -->
          <div class="flex items-center gap-3 text-xs font-medium">
            <div class="bg-white/10 px-3.5 py-1.5 rounded-xl border border-white/10 backdrop-blur-sm">
              <span class="text-amber-300 font-bold text-base block">{{ lcd.committee|length|default:15 }}+</span>
              <span class="text-slate-300">Ủy viên BCH</span>
            </div>
            <div class="bg-white/10 px-3.5 py-1.5 rounded-xl border border-white/10 backdrop-blur-sm">
              <span class="text-green-300 font-bold text-base block">{{ lcd.activities|length|default:5 }}+</span>
              <span class="text-slate-300">Phong trào/năm</span>
            </div>
            <div class="bg-white/10 px-3.5 py-1.5 rounded-xl border border-white/10 backdrop-blur-sm">
              <span class="text-sky-300 font-bold text-base block">{{ faculty_clubs|length|default:1 }}</span>
              <span class="text-slate-300">CLB trực thuộc</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>


  <!-- ====================================================
       2. NỘI DUNG CHÍNH (Cấu trúc 2 cột: Cột trái 8 phần + Cột phải 4 phần)
       ==================================================== -->
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

      <!-- CỘT TRÁI (8 Cột): TOÀN BỘ NỘI DUNG CHUYÊN SÂU VỀ LIÊN CHI ĐOÀN -->
      <div class="lg:col-span-8 space-y-8">

        <!-- MỤC 1: TỔNG QUAN và SỨ MỆNH PHONG TRÀO -->
        <section class="lcd-glass-card p-6 sm:p-8">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-xl bg-rose-100 text-rose-700 flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-[24px]">flag</span>
            </div>
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-rose-600">Tổng quan tổ chức Đoàn</span>
              <h2 class="text-xl sm:text-2xl font-bold text-slate-900 font-headline-md">Sứ Mệnh và tôn Chỉ Phong Trào</h2>
            </div>
          </div>

          <div class="prose prose-slate max-w-none text-slate-600 text-sm sm:text-base leading-relaxed space-y-4">
            <p>{{ lcd.intro }}</p>
            <p>
              Với tôn chỉ lấy đoàn viên sinh viên làm trung tâm, Liên Chi Đoàn <strong>{{ faculty.name }}</strong> không ngừng đổi mới phương thức hoạt động, gắn phong trào Đoàn với chuyên môn đào tạo, bồi dưỡng kỹ năng thực chiến và tạo bệ phóng giúp sinh viên tự tin hội nhập thị trường lao động quốc tế.
            </p>
          </div>

          <!-- 3 Trụ cột hoạt động trọng tâm -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-6 pt-6 border-t border-slate-100">
            <div class="p-4 rounded-2xl bg-rose-50/70 border border-rose-100">
              <div class="flex items-center gap-2 text-rose-900 font-bold text-sm mb-1.5">
                <span class="material-symbols-outlined text-[20px] text-rose-600">school</span>
                <span>Học thuật và NCKH</span>
              </div>
              <p class="text-xs text-slate-600 leading-relaxed">
                Đẩy mạnh các cuộc thi học thuật chuyên ngành, câu lạc bộ học tập và phong trào NCKH trong sinh viên.
              </p>
            </div>

            <div class="p-4 rounded-2xl bg-blue-50/70 border border-blue-100">
              <div class="flex items-center gap-2 text-blue-900 font-bold text-sm mb-1.5">
                <span class="material-symbols-outlined text-[20px] text-blue-600">volunteer_activism</span>
                <span>Xung kích tình nguyện</span>
              </div>
              <p class="text-xs text-slate-600 leading-relaxed">
                Tổ chức các chiến dịch Mùa hè xanh, Tiếp sức mùa thi, Đêm nhạc gây quỹ thiện nguyện và Ngày hội Giọt hồng DUE.
              </p>
            </div>

            <div class="p-4 rounded-2xl bg-amber-50/70 border border-amber-100">
              <div class="flex items-center gap-2 text-amber-900 font-bold text-sm mb-1.5">
                <span class="material-symbols-outlined text-[20px] text-amber-600">military_tech</span>
                <span>Sinh viên 5 tốt</span>
              </div>
              <p class="text-xs text-slate-600 leading-relaxed">
                Rèn luyện toàn diện về Đạo đức - Học tập - Thể lực - Tình nguyện - Hội nhập, tạo nguồn phát triển Đảng viên trẻ.
              </p>
            </div>
          </div>
        </section>


        <!-- MỤC 2: BAN CHẤP HÀNH LIÊN CHI ĐOÀN (ĐẠI BIỂU NHIỆM KỲ) -->
        <section class="lcd-glass-card p-6 sm:p-8">
          <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100">
            <div class="w-10 h-10 rounded-xl bg-rose-100 text-rose-700 flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-[24px]">badge</span>
            </div>
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-rose-600">Cơ cấu tổ chức</span>
              <h2 class="text-xl sm:text-2xl font-bold text-slate-900 font-headline-md">
                Ban Chấp Hành Liên Chi Đoàn (Nhiệm kỳ {{ lcd.term|default:'2024–2027' }})
              </h2>
            </div>
          </div>

          <!-- Cặp Lãnh đạo chủ chốt: Bí thư và phó bí thư -->
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 mb-6">
            
            <!-- Bí thư LCĐ -->
            <div class="p-4 rounded-2xl bg-gradient-to-tr from-rose-50 via-white to-red-50 border-2 border-rose-200/80 shadow-sm relative overflow-hidden">
              <span class="material-symbols-outlined text-rose-300/40 text-[72px] absolute -right-2 -bottom-2 pointer-events-none">star</span>
              <span class="text-[11px] font-bold uppercase tracking-wider text-rose-700 bg-rose-100/80 px-2.5 py-0.5 rounded-full inline-block mb-2">
                Bí thư Liên chi đoàn
              </span>
              <h3 class="font-bold text-slate-900 text-base leading-snug">
                {{ lcd.secretary|default:"Đang cập nhật" }}
              </h3>
              <p class="text-xs text-slate-500 mt-1">Phụ trách chung công tác Đoàn và phong trào thanh niên</p>
            </div>

            <!-- Các Phó Bí thư LCĐ -->
            {% if lcd.deputies %}
              {% for dep in lcd.deputies %}
              <div class="p-4 rounded-2xl bg-white border border-slate-200 shadow-sm hover:border-rose-300 transition-colors">
                <span class="text-[11px] font-bold uppercase tracking-wider text-blue-700 bg-blue-50 px-2.5 py-0.5 rounded-full inline-block mb-2">
                  Phó Bí thư Liên chi đoàn
                </span>
                <h3 class="font-bold text-slate-900 text-base leading-snug">
                  {{ dep }}
                </h3>
                <p class="text-xs text-slate-500 mt-1">Phụ trách công tác chuyên môn, học thuật và phong trào</p>
              </div>
              {% endfor %}
            {% else %}
              <div class="p-4 rounded-2xl bg-white border border-slate-200 shadow-sm sm:col-span-2">
                <span class="text-[11px] font-bold uppercase tracking-wider text-blue-700 bg-blue-50 px-2.5 py-0.5 rounded-full inline-block mb-2">
                  Phó Bí thư Liên chi đoàn
                </span>
                <h3 class="font-bold text-slate-900 text-base leading-snug">
                  Đang cập nhật danh sách nhiệm kỳ mới
                </h3>
              </div>
            {% endif %}

          </div>

          <!-- Danh sách các Ủy viên Ban Chấp Hành -->
          {% if lcd.committee %}
          <div class="p-5 rounded-2xl bg-slate-50/70 border border-slate-200/80">
            <h4 class="font-bold text-slate-800 text-xs uppercase tracking-wider mb-3 flex items-center gap-1.5">
              <span class="material-symbols-outlined text-rose-600 text-[18px]">groups</span>
              Ủy viên Ban Chấp Hành ({{ lcd.committee|length }} Đồng chí):
            </h4>
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2.5">
              {% for mem in lcd.committee %}
              <div class="p-2.5 rounded-xl bg-white border border-slate-200/70 shadow-xs flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-rose-500 shrink-0"></span>
                <span class="text-xs font-semibold text-slate-700 truncate" title="{{ mem }}">{{ mem }}</span>
              </div>
              {% endfor %}
            </div>
          </div>
          {% endif %}
        </section>


        <!-- MỤC 3: THÀNH TÍCH và BẰNG KHEN NỔI BẬT -->
        {% if lcd.achievements %}
        <section class="lcd-glass-card p-6 sm:p-8">
          <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100">
            <div class="w-10 h-10 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-[24px]">military_tech</span>
            </div>
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-amber-700">Dấu ấn thi đua</span>
              <h2 class="text-xl sm:text-2xl font-bold text-slate-900 font-headline-md">Thành Tích và khen Thưởng Tiêu Biểu</h2>
            </div>
          </div>

          <div class="space-y-3">
            {% for ach in lcd.achievements %}
            <div class="p-4 rounded-2xl bg-amber-50/50 border border-amber-200/70 hover:bg-amber-50 transition-colors flex items-start gap-3">
              <div class="w-8 h-8 rounded-full bg-amber-500 text-white flex items-center justify-center shrink-0 shadow-sm mt-0.5">
                <span class="material-symbols-outlined text-[18px]">stars</span>
              </div>
              <div>
                <p class="text-xs sm:text-sm font-semibold text-amber-950 leading-relaxed">{{ ach }}</p>
                <span class="text-[11px] text-amber-700 font-medium">Bằng khen và giấy khen thành tích xuất sắc</span>
              </div>
            </div>
            {% endfor %}
          </div>
        </section>
        {% endif %}


        <!-- MỤC 4: CÁC HOẠT ĐỘNG TIÊU BIỂU và PHONG TRÀO THƯỜNG NIÊN -->
        <section id="hoat-dong" class="lcd-glass-card p-6 sm:p-8 scroll-mt-36">
          <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100">
            <div class="w-10 h-10 rounded-xl bg-rose-100 text-rose-700 flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-[24px]">event_available</span>
            </div>
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-rose-600">Đời sống thanh niên sôi nổi</span>
              <h2 class="text-xl sm:text-2xl font-bold text-slate-900 font-headline-md">Chuỗi Hoạt Động và sự Kiện Thường Niên</h2>
            </div>
          </div>

          {% if lcd.activities %}
          <div class="space-y-3.5">
            {% for act in lcd.activities %}
            <div class="p-4 sm:p-5 rounded-2xl border border-slate-200 bg-white hover:border-rose-300 hover:shadow-md transition-all">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1.5 mb-1.5">
                <h3 class="font-bold text-slate-900 text-sm sm:text-base flex items-center gap-2">
                  <span class="w-2.5 h-2.5 rounded-full bg-rose-600 shrink-0"></span>
                  <span>{{ act.title|default:act }}</span>
                </h3>
                {% if act.date %}
                <span class="text-xs font-mono font-semibold text-rose-600 bg-rose-50 px-2.5 py-0.5 rounded-full border border-rose-200 self-start sm:self-auto">
                  {{ act.date }}
                </span>
                {% endif %}
              </div>
              {% if act.desc %}
              <p class="text-xs sm:text-sm text-slate-600 mt-1 leading-relaxed pl-4 border-l-2 border-rose-200 ml-1">
                {{ act.desc }}
              </p>
              {% elif act.summary %}
              <p class="text-xs sm:text-sm text-slate-600 mt-1 leading-relaxed pl-4 border-l-2 border-rose-200 ml-1">
                {{ act.summary }}
              </p>
              {% endif %}
            </div>
            {% endfor %}
          </div>
          {% else %}
          <p class="text-sm text-slate-500 italic">Đang cập nhật lịch hoạt động và phong trào thanh niên của nhiệm kỳ.</p>
          {% endif %}
        </section>


        <!-- MỤC 5: THƯ VIỆN HÌNH ẢNH HOẠT ĐỘNG CỦA LIÊN CHI ĐOÀN -->
        {% if lcd.images %}
        <section class="lcd-glass-card p-6 sm:p-8">
          <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100">
            <div class="w-10 h-10 rounded-xl bg-purple-100 text-purple-700 flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-[24px]">photo_library</span>
            </div>
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-purple-700">Khoảnh khắc nhiệt huyết</span>
              <h2 class="text-xl sm:text-2xl font-bold text-slate-900 font-headline-md">Thư Viện Ảnh Hoạt Động Của Liên Chi Đoàn</h2>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {% for img in lcd.images %}
            <div class="group relative rounded-2xl overflow-hidden bg-slate-100 shadow-sm border border-slate-200 aspect-[16/10]">
              <img 
                src="{{ img.url }}" 
                alt="{{ img.caption }}" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                onerror="this.onerror=null; this.src='/static/img/khoa/tcnh_gallery_1.jpg';"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/85 via-black/20 to-transparent flex items-end p-4">
                <span class="text-xs font-medium text-white drop-shadow leading-snug">{{ img.caption }}</span>
              </div>
            </div>
            {% endfor %}
          </div>
        </section>
        {% endif %}


        <!-- MỤC 6: CÂU LẠC BỘ và ĐỘI NHÓM TRỰC THUỘC KHOA -->
        {% if faculty_clubs %}
        <section class="lcd-glass-card p-6 sm:p-8">
          <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100">
            <div class="w-10 h-10 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center shrink-0">
              <span class="material-symbols-outlined text-[24px]">groups</span>
            </div>
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-blue-700">Môi trường rèn luyện thực chiến</span>
              <h2 class="text-xl sm:text-2xl font-bold text-slate-900 font-headline-md">Câu Lạc Bộ và đội Nhóm Sinh Viên Trực Thuộc</h2>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {% for c in faculty_clubs %}
            <div class="p-4 rounded-2xl border border-slate-200 bg-white hover:border-blue-300 hover:shadow-md transition-all flex flex-col justify-between">
              <div>
                <div class="flex items-center gap-3 mb-2.5">
                  {% if c.logo_url %}
                  <img src="{{ c.logo_url }}" alt="{{ c.name }}" class="w-10 h-10 rounded-xl object-contain bg-slate-50 border border-slate-100 p-1" />
                  {% else %}
                  <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center font-bold text-xs">CLB</div>
                  {% endif %}
                  <div>
                    <h3 class="font-bold text-slate-900 text-sm leading-snug">{{ c.name }}</h3>
                    <span class="text-[11px] text-slate-400">{{ c.category|default:"Học thuật chuyên sâu" }}</span>
                  </div>
                </div>
                <p class="text-xs text-slate-600 line-clamp-2 leading-relaxed mb-3">{{ c.desc }}</p>
              </div>

              <div class="pt-3 border-t border-slate-100 flex items-center justify-between">
                <span class="text-[11px] text-slate-400">Trực thuộc LCĐ Khoa</span>
                <a href="/clb/{{ c.id }}/" class="text-blue-600 hover:text-blue-800 text-xs font-bold flex items-center gap-1">
                  <span>Khám phá CLB</span>
                  <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
                </a>
              </div>
            </div>
            {% endfor %}
          </div>
        </section>
        {% endif %}

      </div>


      <!-- CỘT PHẢI (4 Cột): SIDEBAR THÔNG TIN LIÊN HỆ, KHOA và QUICK SWITCHER -->
      <div class="lg:col-span-4 space-y-6">

        <!-- CARD 1: KẾT NỐI MẠNG XÃ HỘI VỚI LIÊN CHI ĐOÀN -->
        <div class="lcd-glass-card p-6">
          <div class="flex items-center gap-2 mb-4 pb-3 border-b border-slate-100">
            <span class="material-symbols-outlined text-rose-600 text-[22px]">contact_support</span>
            <h3 class="font-bold text-slate-900 text-base">Liên Hệ Liên Chi Đoàn</h3>
          </div>

          <div class="space-y-3.5 text-xs text-slate-600 mb-6">
            <div class="flex items-start gap-2.5">
              <span class="material-symbols-outlined text-slate-400 text-[18px] shrink-0 mt-0.5">location_on</span>
              <div>
                <span class="text-slate-400 block text-[11px]">Văn phòng Đoàn:</span>
                <span class="font-semibold text-slate-800">Tầng 1 Nhà Đa Năng / Văn phòng Khoa, 71 Ngũ Hành Sơn, Đà Nẵng</span>
              </div>
            </div>

            <div class="flex items-start gap-2.5">
              <span class="material-symbols-outlined text-slate-400 text-[18px] shrink-0 mt-0.5">person</span>
              <div>
                <span class="text-slate-400 block text-[11px]">Bí thư Liên chi đoàn:</span>
                <span class="font-bold text-rose-700">{{ lcd.secretary|default:"Đang cập nhật" }}</span>
              </div>
            </div>

            <div class="flex items-start gap-2.5">
              <span class="material-symbols-outlined text-slate-400 text-[18px] shrink-0 mt-0.5">verified_user</span>
              <div>
                <span class="text-slate-400 block text-[11px]">Đoàn cấp trên:</span>
                <span class="font-semibold text-slate-800">Đoàn Thanh niên - Hội Sinh viên Trường ĐH Kinh tế</span>
              </div>
            </div>
          </div>

          <!-- Các nút hành động mạng xã hội -->
          <div class="space-y-2.5">
            {% if lcd.fanpage %}
            <a 
              href="{{ lcd.fanpage }}" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="w-full flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-[#1877F2] hover:bg-[#166fe5] text-white font-bold text-xs shadow-sm transition-all hover:scale-[1.02]"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.469h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"></path></svg>
              <span>Ghé thăm Fanpage LCĐ</span>
            </a>
            {% endif %}

            {% if lcd.messenger %}
            <a 
              href="{{ lcd.messenger }}" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="w-full flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-gradient-to-r from-[#0084FF] to-[#00C6FF] hover:opacity-95 text-white font-bold text-xs shadow-sm transition-all hover:scale-[1.02]"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2C6.477 2 2 6.145 2 11.258c0 2.914 1.455 5.517 3.735 7.21V22l3.39-1.86c.91.252 1.88.388 2.875.388 5.523 0 10-4.145 10-9.258C22 6.145 17.523 2 12 2zm1.066 12.443l-2.573-2.744-5.021 2.744 5.524-5.86 2.64 2.744 4.954-2.744-5.524 5.86z"></path></svg>
              <span>Nhắn tin Messenger LCĐ</span>
            </a>
            {% endif %}

            <div class="flex items-center gap-2 pt-2">
              {% if lcd.instagram %}
              <a href="{{ lcd.instagram }}" target="_blank" rel="noopener noreferrer" class="flex-1 flex items-center justify-center gap-1.5 py-2 rounded-xl bg-pink-50 text-pink-700 hover:bg-pink-100 text-xs font-semibold transition-colors">
                <span class="material-symbols-outlined text-[16px]">photo_camera</span>
                <span>Instagram</span>
              </a>
              {% endif %}

              {% if lcd.tiktok %}
              <a href="{{ lcd.tiktok }}" target="_blank" rel="noopener noreferrer" class="flex-1 flex items-center justify-center gap-1.5 py-2 rounded-xl bg-slate-100 text-slate-800 hover:bg-slate-200 text-xs font-semibold transition-colors">
                <span class="material-symbols-outlined text-[16px]">videocam</span>
                <span>TikTok</span>
              </a>
              {% endif %}
            </div>
          </div>
        </div>


        <!-- CARD 2: VỀ TRANG KHOA CHUYÊN MÔN -->
        <div class="lcd-glass-card p-6 bg-gradient-to-br from-blue-50/60 to-indigo-50/40 border border-blue-100">
          <div class="flex items-center gap-2 mb-3">
            <span class="material-symbols-outlined text-[#003366] text-[20px]">school</span>
            <span class="text-xs font-bold uppercase tracking-wider text-[#003366]">Đơn vị đào tạo</span>
          </div>

          <h3 class="font-bold text-slate-900 text-base mb-2">{{ faculty.name }}</h3>
          <p class="text-xs text-slate-600 leading-relaxed mb-4">
            Khám phá chi tiết chương trình đào tạo, học vị, danh sách {{ faculty.majors_2026|length }} chuyên ngành năm 2026 và đội ngũ giảng viên của Khoa.
          </p>

          <a 
            href="/khoa/{{ faculty.id }}/" 
            class="w-full flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-[#003366] hover:bg-[#002244] text-white font-bold text-xs shadow-md transition-all hover:scale-[1.02]"
          >
            <span>Xem Trang Khoa Đào Tạo</span>
            <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
          </a>
        </div>


        <!-- CARD 3: CHUYỂN NHANH SANG LCĐ CÁC KHOA KHÁC (Quick Switcher) -->
        <div class="lcd-glass-card p-6">
          <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-100">
            <h3 class="font-bold text-slate-900 text-xs uppercase tracking-wider flex items-center gap-1.5">
              <span class="material-symbols-outlined text-rose-600 text-[18px]">swap_horiz</span>
              Liên Chi Đoàn các Khoa khác
            </h3>
            <a href="/lien-chi-doan/" class="text-[11px] font-bold text-rose-600 hover:underline">Tất cả</a>
          </div>

          <div class="space-y-2">
            {% for other in other_faculties %}
            <a 
              href="/lien-chi-doan/{{ other.id }}/" 
              class="flex items-center justify-between p-2.5 rounded-xl hover:bg-rose-50/60 transition-colors group"
            >
              <div class="flex items-center gap-2.5 min-w-0">
                <span class="w-7 h-7 rounded-lg bg-rose-100 text-rose-700 flex items-center justify-center shrink-0 text-xs font-bold">
                  <span class="material-symbols-outlined text-[15px]">flag</span>
                </span>
                <span class="text-xs font-semibold text-slate-700 group-hover:text-rose-700 truncate">
                  {{ other.lcd.name|default:other.name }}
                </span>
              </div>
              <span class="material-symbols-outlined text-slate-300 group-hover:text-rose-600 text-[16px] shrink-0">chevron_right</span>
            </a>
            {% endfor %}
          </div>
        </div>

      </div>

    </div>
  </div>

</main>
{% endblock %}


===============================
