                <a href="tel:02363836169" class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-surface-container-high hover:bg-surface-container text-on-surface font-label-lg border border-outline-variant/60 transition-all duration-200">
                  <span class="material-symbols-outlined text-[20px] text-secondary-container">call</span>
                  <span>Hotline: 0236 3836 169</span>
