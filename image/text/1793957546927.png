            <li class="hover:text-primary-container transition-colors"><a href="https://due.udn.vn" target="_blank" class="">E-learning</a></li>
            <li class="hover:text-primary-container transition-colors"><a href="https://lib.due.udn.vn" target="_blank" class="">Thư viện số DUE</a></li>
          </ul>
        </div>

        <!-- Column 4: Kết nối -->
        <div class="flex flex-col gap-3">
          <h4 class="font-bold text-on-surface text-[16px]">Kết nối</h4>
          <div class="grid grid-cols-2 gap-x-4 gap-y-3 font-body-sm text-on-surface-variant">
            <a class="flex items-center gap-2 hover:opacity-80 transition-opacity" href="https://facebook.com/FaceDue" target="_blank">
              <svg class="w-6 h-6 text-[#1877F2] shrink-0" fill="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" fill="none" r="11" stroke="currentColor" stroke-width="1.5"></circle><path d="M13.5 8.5v2h2.2l-.3 2.5h-1.9V19h-2.6v-6H9.2v-2.5h1.7V8.2c0-1.8 1.1-2.7 2.7-2.7.8 0 1.5.1 1.7.1v2h-1.1c-.9 0-1.1.4-1.1 1.2z"></path></svg>
              <span class="leading-none">Facebook</span>
            </a>
            <a class="flex items-center gap-2 hover:opacity-80 transition-opacity" href="#" target="_blank">
              <svg class="w-6 h-6 text-[#FF0000] shrink-0" fill="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" fill="none" r="11" stroke="currentColor" stroke-width="1.5"></circle><path d="M15.5 12l-4.5-2.6v5.2L15.5 12z"></path></svg>
              <span class="leading-none">Youtube</span>
            </a>
            <a class="flex items-center gap-2 hover:opacity-80 transition-opacity" href="#" target="_blank">
              <svg class="w-6 h-6 text-[#000000] shrink-0" fill="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" fill="none" r="11" stroke="currentColor" stroke-width="1.5"></circle><path d="M14.5 9.2c.5.4 1.1.6 1.8.7V8.3c-.6-.1-1.1-.3-1.6-.7v3.9c0 1.2-1 2.2-2.2 2.2s-2.2-1-2.2-2.2 1-2.2 2.2-2.2c.2 0 .4 0 .6.1V11c-.2-.1-.4-.1-.6-.1-.7 0-1.2.5-1.2 1.2s.5 1.2 1.2 1.2 1.2-.5 1.2-1.2V6.5h1.4v2.7z"></path></svg>
              <span class="leading-none">TikTok</span>
            </a>
            <a class="flex items-center gap-2 hover:opacity-80 transition-opacity" href="#" target="_blank">
              <svg class="w-6 h-6 text-[#0A66C2] shrink-0" fill="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" fill="none" r="11" stroke="currentColor" stroke-width="1.5"></circle><path d="M8.2 10.2h1.8v5.5H8.2v-5.5zm.9-2.8c.6 0 1 .4 1 1s-.4 1-1 1-1-.4-1-1 .4-1 1-1zm2.3 2.8h1.7v.8h.1c.3-.5.9-.9 1.8-.9 1.9 0 2.2 1.2 2.2 2.8v3.6h-1.8v-3.2c0-.8 0-1.8-1.1-1.8-1.1 0-1.3.8-1.3 1.7v3.3h-1.8v-5.5z"></path></svg>
