{% block extra_js %}
<script>
    let currentCategory = 'all';

    function filterCategory(cat) {
      currentCategory = cat;
      
      // Đổi class nút active
      const buttons = document.querySelectorAll('.filter-btn');
      buttons.forEach(btn => {
        btn.classList.remove('active');
        btn.classList.remove('bg-primary-container', 'text-white', 'border-primary-container', 'shadow-md');
        btn.classList.add('text-slate-700');
      });

      const activeBtn = document.getElementById('btn-' + cat);
      if (activeBtn) {
        activeBtn.classList.add('active');
        activeBtn.classList.remove('text-slate-700');
      }

      applyFilters();
    }

    function searchQuota() {
      applyFilters();
    }

    function applyFilters() {
      const searchVal = document.getElementById('quotaSearch').value.toLowerCase().trim();
      const rows = document.querySelectorAll('.quota-row');
      const headers = document.querySelectorAll('.group-header');

      // Ẩn/hiện dòng dữ liệu
      rows.forEach(row => {
        const cat = row.getAttribute('data-cat');
        const text = row.textContent.toLowerCase();
        
        const matchCategory = (currentCategory === 'all' || cat === currentCategory);
        const matchSearch = (searchVal === '' || text.includes(searchVal));

        if (matchCategory && matchSearch) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });

      // Ẩn/hiện tiêu đề nhóm
      headers.forEach(h => {
        const cat = h.getAttribute('data-cat');
        if (currentCategory === 'all' || cat === currentCategory) {
          h.style.display = '';
        } else {
          h.style.display = 'none';
        }
      });
    }

    // Kết nối ô tìm kiếm trên navbar
    const navSearch = document.getElementById('quickSearchNav');
    if (navSearch) {
      navSearch.addEventListener('keyup', function() {
        const localSearch = document.getElementById('quotaSearch');
        if (localSearch) {
          localSearch.value = this.value;
          applyFilters();
        }
      });
    }
  </script>
{% endblock %}


