{% block extra_js %}
<script>
    function switchYear(year) {
      // Ẩn tất cả nội dung tab
      const contents = document.querySelectorAll('.year-content');
      contents.forEach(el => el.classList.add('hidden'));

      // Bỏ class active ở tất cả các nút
      const tabs = document.querySelectorAll('.tab-btn');
      tabs.forEach(btn => {
        btn.classList.remove('active');
        btn.classList.remove('bg-primary-container', 'text-white', 'border-primary-container', 'shadow-md');
        btn.classList.add('text-slate-700');
      });

      // Hiển thị tab được chọn
      const selectedContent = document.getElementById('content-' + year);
      if (selectedContent) {
        selectedContent.classList.remove('hidden');
      }

      // Đánh dấu nút tab đang active
      const activeTab = document.getElementById('tab-' + year);
      if (activeTab) {
        activeTab.classList.add('active');
        activeTab.classList.remove('text-slate-700');
      }

      // Xóa ô tìm kiếm khi chuyển tab
      const searchInput = document.getElementById('tableSearch');
      if (searchInput) {
        searchInput.value = '';
        filterTable();
      }
    }

    function filterTable() {
      const input = document.getElementById('tableSearch');
      const filter = input.value.toLowerCase().trim();
      
      // Lấy tab đang hiển thị
      const activeContent = document.querySelector('.year-content:not(.hidden)');
      if (!activeContent) return;

      const rows = activeContent.querySelectorAll('.row-item');
      rows.forEach(row => {
        const text = row.textContent.toLowerCase();
        if (text.includes(filter)) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    }

    // Kết nối ô tìm kiếm trên navbar với ô tìm kiếm trang
    const navSearch = document.getElementById('quickSearchNav');
    if (navSearch) {
      navSearch.addEventListener('keyup', function(e) {
        const pageSearch = document.getElementById('tableSearch');
        if (pageSearch) {
          pageSearch.value = this.value;
          filterTable();
        }
      });
    }
  </script>
{% endblock %}


--- FILE: CongthongtintuyensinhDUE/templates/admissions/career_advisory.html ---
{% extends 'layouts/base.html' %}

{% block title %}Tư vấn chọn ngành học - Trường Đại học Kinh tế, ĐH Đà Nẵng (DUE){% endblock %}

{% block nav_career %}text-secondary-container font-headline-sm border-b-2 border-secondary-container uppercase whitespace-nowrap font-bold{% endblock %}

{% block extra_head %}
<style>
  #adv { --blue:#0072BC; --navy:#003366; --orange:#F37021; --green:#00A859; }
  #adv .adv-step[hidden] { display:none !important; }
  #adv .fade-in { animation: advIn .35s ease both; }
  @keyframes advIn { from { opacity:0; transform: translateY(8px); } to { opacity:1; transform:none; } }

  #adv .adv-field { width:100%; padding:.75rem 1rem; border-radius:.875rem; border:1.5px solid #e2e8f0; background:#fff;
    font-size:.9375rem; color:#0f172a; transition: border-color .15s, box-shadow .15s; }
  #adv .adv-field::placeholder { color:#94a3b8; }
  #adv input[type=number]::-webkit-outer-spin-button, #adv input[type=number]::-webkit-inner-spin-button { -webkit-appearance:none; margin:0; }
  #adv input[type=number] { -moz-appearance:textfield; appearance:textfield; }
  #adv .adv-field:focus { outline:none; border-color:var(--blue); box-shadow:0 0 0 4px rgba(0,114,188,.12); }
  #adv .adv-field.is-invalid { border-color:#ef4444; box-shadow:0 0 0 4px rgba(239,68,68,.1); }
  #adv .adv-label { display:block; font-size:.875rem; font-weight:600; color:#334155; margin-bottom:.375rem; }
  #adv .req-star { color:#ef4444; font-weight:700; margin-left:.2rem; }
  #adv .adv-err { font-size:.75rem; color:#dc2626; margin-top:.375rem; display:none; }
  #adv .is-invalid ~ .adv-err, #adv .adv-err.show { display:block; }

  #adv .chip { display:inline-flex; align-items:center; gap:.375rem; padding:.5rem .875rem; border-radius:9999px;
    border:1.5px solid #e2e8f0; background:#fff; font-size:.8125rem; font-weight:500; color:#334155;
    cursor:pointer; transition: all .15s; user-select:none; }
  #adv .chip:hover { border-color:#94a3b8; }
  #adv .chip[aria-pressed="true"] { border-color:var(--blue); background:#eff6ff; color:var(--blue); font-weight:600; }
  #adv .chip[aria-pressed="true"]::before { content:'✓'; font-weight:700; }
  #adv .chip-suggest { border-style:dashed; color:#475569; font-size:.75rem; padding:.375rem .75rem; }
  #adv .chip-suggest:hover { border-color:var(--orange); color:var(--orange); }
  #adv .chip-suggest.used { opacity:.45; pointer-events:none; }

  #adv .quiz-opt { width:100%; text-align:left; display:flex; align-items:center; gap:.875rem; padding:1rem 1.125rem;
    border-radius:1rem; border:1.5px solid #e2e8f0; background:#fff; transition: all .15s; cursor:pointer; }
  #adv .quiz-opt:hover { border-color:var(--blue); transform: translateY(-1px); box-shadow:0 6px 18px -10px rgba(0,51,102,.35); }
  #adv .quiz-opt[aria-pressed="true"] { border-color:var(--green); background:#f0fdf6; box-shadow:0 0 0 3px rgba(0,168,89,.15); }
  #adv .quiz-opt .key { flex-shrink:0; width:2rem; height:2rem; border-radius:.625rem; display:flex; align-items:center;
    justify-content:center; font-weight:700; font-size:.8125rem; background:#f1f5f9; color:#475569; }
  #adv .quiz-opt[aria-pressed="true"] .key { background:var(--green); color:#fff; }

  #adv .stepper-dot { width:2.25rem; height:2.25rem; border-radius:9999px; display:flex; align-items:center; justify-content:center;
    font-weight:700; font-size:.875rem; border:2px solid #e2e8f0; color:#94a3b8; background:#fff; transition: all .2s; flex-shrink:0; }
  #adv .stepper-item.active .stepper-dot { border-color:var(--blue); color:var(--blue); box-shadow:0 0 0 5px rgba(0,114,188,.12); }
  #adv .stepper-item.done .stepper-dot { border-color:var(--green); background:var(--green); color:#fff; }
  #adv .stepper-item.active .stepper-label { color:#0f172a; }
  #adv .stepper-item.done .stepper-label { color:#334155; }

  #adv .orbit { position:relative; width:7rem; height:7rem; }
  #adv .orbit::before, #adv .orbit::after { content:''; position:absolute; inset:0; border-radius:9999px; border:3px solid transparent; }
  #adv .orbit::before { border-top-color:var(--blue); border-right-color:var(--blue); animation: spin 1.4s linear infinite; }
  #adv .orbit::after { inset:.75rem; border-bottom-color:var(--orange); border-left-color:var(--orange); animation: spin 1.1s linear infinite reverse; }
  @keyframes spin { to { transform: rotate(360deg); } }
  #adv .load-step { display:flex; align-items:center; gap:.75rem; font-size:.875rem; color:#94a3b8; transition: color .3s; }
  #adv .load-step .ic { width:1.5rem; height:1.5rem; border-radius:9999px; border:2px solid #e2e8f0; flex-shrink:0;
    display:flex; align-items:center; justify-content:center; font-size:.75rem; transition: all .3s; }
  #adv .load-step.run { color:#0f172a; font-weight:600; }
  #adv .load-step.run .ic { border-color:var(--blue); border-top-color:transparent; animation: spin .8s linear infinite; }
  #adv .load-step.ok { color:#334155; }
  #adv .load-step.ok .ic { border-color:var(--green); background:var(--green); color:#fff; animation:none; }
  #adv .shimmer { background: linear-gradient(90deg,#f1f5f9 25%,#e2e8f0 37%,#f1f5f9 63%); background-size:400% 100%; animation: shim 1.4s ease infinite; }
  @keyframes shim { 0% { background-position:100% 50%; } 100% { background-position:0 50%; } }

  #adv .ring { --p:0; width:4.25rem; height:4.25rem; border-radius:9999px; flex-shrink:0; display:grid; place-items:center;
    background: conic-gradient(var(--c, var(--green)) calc(var(--p)*1%), #e2e8f0 0); }
  #adv .ring > span { width:3.4rem; height:3.4rem; border-radius:9999px; background:#fff; display:grid; place-items:center;
    font-weight:800; font-size:.95rem; color:#0f172a; font-family:'Space Grotesk', sans-serif; }
  #adv .bar { height:.5rem; border-radius:9999px; background:#eef2f7; overflow:hidden; }
  #adv .bar > i { display:block; height:100%; border-radius:9999px; width:0; transition: width 1s cubic-bezier(.2,.8,.2,1); }

  @media print {
    header, footer, nav, #dueChat, #adv .no-print { display:none !important; }
    #adv .print-full { grid-column: 1 / -1 !important; }
  }
  @media (prefers-reduced-motion: reduce) { #adv * { animation:none !important; transition:none !important; } }
</style>
{% endblock %}

{% block content %}
<main id="adv" class="w-full pt-28 sm:pt-32 pb-6 bg-gradient-to-b from-slate-50 via-white to-white min-h-screen">

  <section class="max-w-[1360px] mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-8 no-print">
    <div class="flex flex-col lg:flex-row lg:items-end gap-6 justify-between">
      <div class="max-w-2xl">
        <h1 class="font-heading text-3xl sm:text-4xl font-bold text-slate-900 mt-3 leading-tight">
          Tìm <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#F37021] via-[#00A859] to-[#0072BC]">Ngành học</span> hợp với bạn tại DUE<br>
        </h1>
        <p class="text-slate-600 mt-3 leading-relaxed">
          Trả lời vài câu hỏi về tính cách, sở thích và học lực. Trợ lý AI sẽ đối chiếu với các ngành của
          <strong class="text-slate-800">Trường Đại học Kinh tế – ĐH Đà Nẵng</strong> và gợi ý những lựa chọn phù hợp nhất.
        </p>
      </div>
    </div>
  </section>

  <div class="max-w-[1360px] mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-6 xl:gap-8 items-start">

    <div class="lg:col-span-8 xl:col-span-9 print-full">

      <!-- ---------- WIZARD ---------- -->
      <section id="wizard" class="bg-white rounded-3xl border border-slate-200 shadow-xl shadow-slate-900/5 overflow-hidden">
        <div class="px-5 sm:px-8 pt-6 pb-5 border-b border-slate-100">
          <ol id="stepper" class="flex items-center justify-between gap-2">
            <li class="stepper-item flex items-center gap-2.5" data-i="0"><span class="stepper-dot">1</span><span class="stepper-label hidden sm:block text-sm font-semibold text-slate-400">Bản thân</span></li>
            <li class="h-px flex-1 bg-slate-200"></li>
            <li class="stepper-item flex items-center gap-2.5" data-i="1"><span class="stepper-dot">2</span><span class="stepper-label hidden sm:block text-sm font-semibold text-slate-400">Tính cách</span></li>
            <li class="h-px flex-1 bg-slate-200"></li>
            <li class="stepper-item flex items-center gap-2.5" data-i="2"><span class="stepper-dot">3</span><span class="stepper-label hidden sm:block text-sm font-semibold text-slate-400">Sở thích</span></li>
            <li class="h-px flex-1 bg-slate-200"></li>
            <li class="stepper-item flex items-center gap-2.5" data-i="3"><span class="stepper-dot">4</span><span class="stepper-label hidden sm:block text-sm font-semibold text-slate-400">Học lực</span></li>
          </ol>
        </div>

        <form id="advForm" novalidate class="px-5 sm:px-8 lg:px-10 py-7">

          <!-- BƯỚC 1 -->
          <div class="adv-step fade-in" data-step="0">
            <h2 class="font-heading text-xl sm:text-2xl font-bold text-slate-900">Chào bạn 👋 Mình làm quen nhé!</h2>
            <p class="text-sm text-slate-500 mt-1 mb-6">Thông tin này giúp trợ lý có thể tư vấn cụ thể cho bạn. Chúng tôi cam kết không chia sẻ thông tin này cho bên thứ ba.</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div class="sm:col-span-2">
                <label class="adv-label" for="full_name">Họ và tên của bạn</label>
                <input id="full_name" class="adv-field" type="text" autocomplete="name" placeholder="Nguyễn Văn An" data-required data-min="2" data-name="họ và tên">
                <p class="adv-err">Bạn cho mình biết tên nhé.</p>
              </div>
              <div>
                <span class="adv-label">Giới tính</span>
                <div class="flex gap-2 flex-wrap" data-chips="gender" data-required>
                  <button type="button" class="chip" data-value="Nam">Nam</button>
                  <button type="button" class="chip" data-value="Nữ">Nữ</button>
                  <button type="button" class="chip" data-value="Khác">Khác</button>
                </div>
                <input type="hidden" id="gender">
                <p class="adv-err">Chọn một lựa chọn nhé.</p>
              </div>
              <div>
                <label class="adv-label" for="date_of_birth">Ngày sinh</label>
                <input id="date_of_birth" class="adv-field" type="date" max="2012-12-31" data-required data-msg-required="Vui lòng chọn ngày sinh.">
                <p class="adv-err">Vui lòng chọn ngày sinh.</p>
              </div>
              <div>
                <label class="adv-label" for="phone_number">Số điện thoại</label>
                <input id="phone_number" class="adv-field" type="tel" inputmode="numeric" autocomplete="tel" placeholder="0987 654 321" data-required data-phone data-name="số điện thoại">
                <p class="adv-err">Số điện thoại gồm 10 chữ số, bắt đầu bằng 0.</p>
              </div>
              <div>
                <label class="adv-label" for="email">Email</label>
                <input id="email" class="adv-field" type="email" autocomplete="email" placeholder="abc@gmail.com" data-required data-email data-name="email">
                <p class="adv-err">Email chưa đúng định dạng.</p>
              </div>
              <div>
                <label class="adv-label" for="high_school">Trường THPT</label>
                <input id="high_school" class="adv-field" type="text" placeholder="Chu Văn An" data-required data-min="2" data-name="tên trường THPT">
                <p class="adv-err">Bạn đang học trường nào?</p>
              </div>
              <div>
                <label class="adv-label" for="province">Tỉnh / Thành phố</label>
                <select id="province" class="adv-field" data-required data-msg-required="Vui lòng chọn tỉnh/thành phố."><option value="">Chọn tỉnh/thành</option></select>
                <p class="adv-err">Chọn tỉnh/thành bạn đang sống.</p>
              </div>
              <div class="sm:col-span-2">
                <label class="adv-label" for="address">Địa chỉ</label>
                <input id="address" class="adv-field" type="text" autocomplete="street-address" placeholder="Số nhà, đường, phường/xã">
              </div>
            </div>
          </div>

          <!-- BƯỚC 2 -->
          <div class="adv-step" data-step="1" hidden>
            <div class="flex items-start justify-between gap-4">
              <div>
                <h2 class="font-heading text-xl sm:text-2xl font-bold text-slate-900">Bạn là người như thế nào?</h2>
                <p class="text-sm text-slate-500 mt-1">Chọn đáp án giống bạn nhất, không có đúng hay sai. Dựa trên mô hình nghề nghiệp Holland.</p>
              </div>
              <span id="quizCounter" class="shrink-0 px-3 py-1 rounded-full bg-slate-100 text-slate-600 text-xs font-bold">1/6</span>
            </div>
            <div class="flex gap-1.5 mt-5" id="quizDots"></div>
            <div id="quizBox" class="mt-6 min-h-[22rem]"></div>
            <p class="adv-err" id="quizErr">Bạn còn câu chưa trả lời.</p>
          </div>

          <!-- BƯỚC 3 -->
          <div class="adv-step" data-step="2" hidden>
            <h2 class="font-heading text-xl sm:text-2xl font-bold text-slate-900">Điều gì khiến bạn hứng thú?</h2>
            <p class="text-sm text-slate-500 mt-1 mb-6">Viết tự nhiên như đang kể với bạn bè. Bấm vào gợi ý để thêm nhanh. Càng cụ thể, AI tư vấn càng chính xác.</p>
            <div class="space-y-6">
              <div>
                <label class="adv-label" for="interests">Bạn thích làm gì lúc rảnh, hay quan tâm điều gì?</label>
                <textarea id="interests" class="adv-field" rows="3" maxlength="1000" placeholder="Ví dụ: Mình hay xem video về công nghệ, thích bán hàng online, đọc sách kinh doanh..." data-required data-min="2" data-name="sở thích của bạn"></textarea>
                <div class="flex flex-wrap gap-1.5 mt-2" data-suggest="interests">
                  <button type="button" class="chip chip-suggest">+ Công nghệ, máy tính</button>
                  <button type="button" class="chip chip-suggest">+ Kinh doanh, bán hàng</button>
                  <button type="button" class="chip chip-suggest">+ Sáng tạo nội dung, mạng xã hội</button>
                  <button type="button" class="chip chip-suggest">+ Du lịch, khám phá</button>
                  <button type="button" class="chip chip-suggest">+ Tìm hiểu tài chính, đầu tư</button>
                  <button type="button" class="chip chip-suggest">+ Đọc sách, tranh luận xã hội</button>
                </div>
                <p class="adv-err">Chia sẻ thêm một chút nhé (ít nhất 5 ký tự).</p>
              </div>
              <div>
                <label class="adv-label" for="strengths">Bạn làm tốt điều gì nhất?</label>
                <textarea id="strengths" class="adv-field" rows="3" maxlength="1000" placeholder="Ví dụ: Mình giỏi Toán, tính cẩn thận, nói chuyện trước đám đông khá tự tin..." data-required data-min="2" data-name="điểm mạnh của bạn"></textarea>
                <div class="flex flex-wrap gap-1.5 mt-2" data-suggest="strengths">
                  <button type="button" class="chip chip-suggest">+ Tư duy logic, giỏi tính toán</button>
                  <button type="button" class="chip chip-suggest">+ Giao tiếp, thuyết trình</button>
                  <button type="button" class="chip chip-suggest">+ Cẩn thận, tỉ mỉ</button>
                  <button type="button" class="chip chip-suggest">+ Ngoại ngữ tốt</button>
                  <button type="button" class="chip chip-suggest">+ Lãnh đạo, tổ chức nhóm</button>
                  <button type="button" class="chip chip-suggest">+ Viết lách, sáng tạo</button>
                </div>
                <p class="adv-err">Chia sẻ thêm một chút nhé (ít nhất 5 ký tự).</p>
              </div>
              <div>
                <label class="adv-label" for="career_goals">Sau này bạn muốn làm công việc gì?</label>
                <textarea id="career_goals" class="adv-field" rows="2" maxlength="1000" placeholder="Ví dụ: Muốn làm ở ngân hàng hoặc tự mở công ty riêng. Chưa rõ thì ghi 'chưa xác định'." data-required data-min="2" data-msg-required="Bạn muốn làm công việc gì? Chưa rõ thì ghi “chưa xác định” nhé."></textarea>
                <p class="adv-err">Chưa rõ thì ghi "chưa xác định" nhé.</p>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div>
                  <span class="adv-label">Môi trường làm việc bạn thích</span>
                  <div class="flex flex-wrap gap-2" data-chips="work_style">
                    <button type="button" class="chip" data-value="Văn phòng, ổn định">Văn phòng, ổn định</button>
                    <button type="button" class="chip" data-value="Năng động, di chuyển nhiều">Năng động, đi nhiều</button>
                    <button type="button" class="chip" data-value="Làm việc với số liệu, máy tính">Số liệu, máy tính</button>
                    <button type="button" class="chip" data-value="Giao tiếp nhiều với con người">Gặp gỡ nhiều người</button>
                    <button type="button" class="chip" data-value="Tự kinh doanh, khởi nghiệp">Tự kinh doanh</button>
                  </div>
                  <input type="hidden" id="work_style">
                </div>
                <div>
                  <span class="adv-label">Điều bạn ưu tiên nhất khi chọn nghề</span>
                  <div class="flex flex-wrap gap-2" data-chips="job_priority">
                    <button type="button" class="chip" data-value="Thu nhập cao">Thu nhập cao</button>
                    <button type="button" class="chip" data-value="Ổn định lâu dài">Ổn định</button>
                    <button type="button" class="chip" data-value="Đúng đam mê">Đúng đam mê</button>
                    <button type="button" class="chip" data-value="Cơ hội thăng tiến, ra nước ngoài">Thăng tiến, ra nước ngoài</button>
                    <button type="button" class="chip" data-value="Dễ xin việc">Dễ xin việc</button>
                  </div>
                  <input type="hidden" id="job_priority">
                </div>
              </div>
            </div>
          </div>

          <!-- BƯỚC 4 -->
          <div class="adv-step" data-step="3" hidden>
            <h2 class="font-heading text-xl sm:text-2xl font-bold text-slate-900">Học lực và nguyện vọng</h2>
            <p class="text-sm text-slate-500 mt-1 mb-6">Giúp AI đánh giá khả năng trúng tuyển. Chưa chắc thì cứ bỏ qua, bạn vẫn nhận được gợi ý.</p>
            <div class="space-y-6">
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
                <div>
                  <span class="adv-label">Bạn đang học</span>
                  <div class="flex flex-wrap gap-2" data-chips="grade_level">
                    <button type="button" class="chip" data-value="Lớp 10">Lớp 10</button>
                    <button type="button" class="chip" data-value="Lớp 11">Lớp 11</button>
                    <button type="button" class="chip" data-value="Lớp 12">Lớp 12</button>
                    <button type="button" class="chip" data-value="Đã tốt nghiệp THPT">Đã tốt nghiệp</button>
                  </div>
                  <input type="hidden" id="grade_level">
                </div>
                <div>
                  <label class="adv-label" for="expected_score">Điểm xét tuyển dự kiến</label>
                  <div class="relative">
                    <input id="expected_score" class="adv-field pr-14" type="number" min="0" max="30" step="0.25" inputmode="decimal" placeholder="24.5" data-range="0,30">
                    <span class="absolute right-4 top-[1.4rem] -translate-y-1/2 text-xs text-slate-400">/ 30</span>
                    <p class="adv-err">Điểm từ 0 đến 30.</p>
                  </div>
                </div>
                <div>
                  <label class="adv-label" for="gpa">Điểm trung bình học tập</label>
                  <div class="relative">
                    <input id="gpa" class="adv-field pr-14" type="number" min="0" max="10" step="0.1" inputmode="decimal" placeholder="8.2" data-range="0,10">
                    <span class="absolute right-4 top-[1.4rem] -translate-y-1/2 text-xs text-slate-400">/ 10</span>
                    <p class="adv-err">Điểm từ 0 đến 10.</p>
                  </div>
                </div>
              </div>

              <div>
                <span class="adv-label">Tổ hợp môn dự định xét tuyển</span>
                <div class="flex flex-wrap gap-2" data-chips="subject_combo">
                  <button type="button" class="chip" data-value="A00 (Toán, Lý, Hóa)">A00 · Toán Lý Hóa</button>
                  <button type="button" class="chip" data-value="A01 (Toán, Lý, Anh)">A01 · Toán Lý Anh</button>
                  <button type="button" class="chip" data-value="D01 (Toán, Văn, Anh)">D01 · Toán Văn Anh</button>
                  <button type="button" class="chip" data-value="D07 (Toán, Hóa, Anh)">D07 · Toán Hóa Anh</button>
                  <button type="button" class="chip" data-value="X25 (Toán, GDKT&PL, Anh)">X25 · Toán GDKT&amp;PL Anh</button>
                  <button type="button" class="chip" data-value="X26 (Toán, Tin, Anh)">X26 · Toán Tin Anh</button>
                  <button type="button" class="chip" data-value="Chưa xác định">Chưa xác định</button>
                </div>
                <input type="hidden" id="subject_combo">
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div>
                  <span class="adv-label">Môn bạn học tốt nhất <span class="font-normal text-slate-400">(chọn nhiều)</span></span>
                  <div class="flex flex-wrap gap-2" data-chips="strong_subjects" data-multi>
                    <button type="button" class="chip" data-value="Toán">Toán</button><button type="button" class="chip" data-value="Ngữ văn">Văn</button>
                    <button type="button" class="chip" data-value="Tiếng Anh">Anh</button><button type="button" class="chip" data-value="Vật lý">Lý</button>
                    <button type="button" class="chip" data-value="Hóa học">Hóa</button><button type="button" class="chip" data-value="Tin học">Tin</button>
                    <button type="button" class="chip" data-value="Lịch sử">Sử</button><button type="button" class="chip" data-value="Địa lý">Địa</button>
                    <button type="button" class="chip" data-value="GDKT&PL">GDKT&amp;PL</button>
                  </div>
                  <input type="hidden" id="strong_subjects">
                </div>
                <div>
                  <span class="adv-label">Môn bạn còn yếu <span class="font-normal text-slate-400">(chọn nhiều)</span></span>
                  <div class="flex flex-wrap gap-2" data-chips="weak_subjects" data-multi>
                    <button type="button" class="chip" data-value="Toán">Toán</button><button type="button" class="chip" data-value="Ngữ văn">Văn</button>
                    <button type="button" class="chip" data-value="Tiếng Anh">Anh</button><button type="button" class="chip" data-value="Vật lý">Lý</button>
                    <button type="button" class="chip" data-value="Hóa học">Hóa</button><button type="button" class="chip" data-value="Tin học">Tin</button>
                    <button type="button" class="chip" data-value="Lịch sử">Sử</button><button type="button" class="chip" data-value="Địa lý">Địa</button>
                    <button type="button" class="chip" data-value="GDKT&PL">GDKT&amp;PL</button>
                  </div>
                  <input type="hidden" id="weak_subjects">
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div>
                  <span class="adv-label">Trình độ tiếng Anh</span>
                  <div class="flex flex-wrap gap-2" data-chips="english_level">
                    <button type="button" class="chip" data-value="Cơ bản">Cơ bản</button>
                    <button type="button" class="chip" data-value="Khá (giao tiếp được)">Giao tiếp được</button>
                    <button type="button" class="chip" data-value="Có IELTS 5.0 - 5.5">IELTS 5.0–5.5</button>
                    <button type="button" class="chip" data-value="Có IELTS 6.0 trở lên">IELTS 6.0+</button>
                    <button type="button" class="chip" data-value="Chứng chỉ khác">Chứng chỉ khác</button>
                  </div>
                  <input type="hidden" id="english_level">
                </div>
                <div>
                  <span class="adv-label">Học phí gia đình có thể chi trả / năm</span>
                  <div class="flex flex-wrap gap-2" data-chips="budget">
                    <button type="button" class="chip" data-value="Dưới 25 triệu">&lt; 25 triệu</button>
                    <button type="button" class="chip" data-value="25 - 40 triệu">25–40 triệu</button>
                    <button type="button" class="chip" data-value="40 - 70 triệu">40–70 triệu</button>
                    <button type="button" class="chip" data-value="Trên 70 triệu">&gt; 70 triệu</button>
                  </div>
                  <input type="hidden" id="budget">
                </div>
              </div>

              <details class="group rounded-2xl border border-slate-200 bg-slate-50/60">
                <summary class="list-none cursor-pointer px-5 py-4 flex items-center justify-between text-sm font-semibold text-slate-700">
                  <span class="flex items-center gap-2"><span class="material-symbols-outlined text-[20px] text-[#0072BC]">tune</span>Thêm chi tiết để tư vấn sát hơn <span class="font-normal text-slate-400 hidden sm:inline">(không bắt buộc)</span></span>
                  <span class="material-symbols-outlined text-slate-400 transition group-open:rotate-180">expand_more</span>
                </summary>
                <div class="px-5 pb-5 space-y-5">
                  <div>
                    <span class="adv-label">Phương thức xét tuyển dự định</span>
                    <div class="flex flex-wrap gap-2" data-chips="admission_method">
                      <button type="button" class="chip" data-value="Điểm thi tốt nghiệp THPT">Điểm thi THPT</button>
                      <button type="button" class="chip" data-value="Xét học bạ">Học bạ + tiếng Anh</button>
                      <button type="button" class="chip" data-value="Đánh giá năng lực">Đánh giá năng lực</button>
                      <button type="button" class="chip" data-value="Xét tuyển thẳng/ưu tiên">Tuyển thẳng</button>
                      <button type="button" class="chip" data-value="Chưa xác định">Chưa rõ</button>
                    </div>
                    <input type="hidden" id="admission_method">
                  </div>
                  <div>
                    <span class="adv-label">Chương trình mong muốn</span>
                    <div class="flex flex-wrap gap-2" data-chips="program_type">
                      <button type="button" class="chip" data-value="Chương trình tiêu chuẩn">Tiêu chuẩn</button>
                      <button type="button" class="chip" data-value="Chương trình học bằng tiếng Anh">Học bằng tiếng Anh</button>
                      <button type="button" class="chip" data-value="Liên kết quốc tế">Liên kết quốc tế</button>
                      <button type="button" class="chip" data-value="Chưa xác định">Chưa rõ</button>
                    </div>
                    <input type="hidden" id="program_type">
                  </div>
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <div>
                      <label class="adv-label" for="considered_majors">Ngành bạn đang cân nhắc</label>
                      <input id="considered_majors" class="adv-field" type="text" maxlength="300" placeholder="Marketing, Kế toán...">
                    </div>
                    <div>
                      <label class="adv-label" for="family_wish">Gia đình mong muốn bạn học gì?</label>
                      <input id="family_wish" class="adv-field" type="text" maxlength="300" placeholder="Bố mẹ muốn mình học Tài chính...">
                    </div>
                  </div>
                  <div>
                    <label class="adv-label" for="extra_notes">Điều gì khác bạn muốn chia sẻ?</label>
                    <textarea id="extra_notes" class="adv-field" rows="2" maxlength="1000" placeholder="Muốn học gần nhà, muốn đi du học sau này..."></textarea>
                  </div>
                </div>
              </details>
            </div>
          </div>

          <div class="flex items-center justify-between gap-3 mt-8 pt-6 border-t border-slate-100">
            <button type="button" id="btnBack" class="invisible inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl text-sm font-semibold text-slate-600 hover:bg-slate-100 transition">
              <span class="material-symbols-outlined text-[18px]">arrow_back</span> Quay lại
            </button>
            <p id="draftNote" class="hidden sm:block text-xs text-slate-400"></p>
            <button type="submit" id="btnNext" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-[#0072BC] hover:opacity-95 text-white text-sm font-bold shadow-lg shadow-blue-600/25 transition active:scale-[.98]">
              <span id="btnNextText">Tiếp tục</span><span class="material-symbols-outlined text-[18px]">arrow_forward</span>
            </button>
          </div>
        </form>
      </section>

      <!-- ---------- CHỜ AI ---------- -->
      <section id="loading" hidden class="bg-white rounded-3xl border border-slate-200 shadow-xl shadow-slate-900/5 p-6 sm:p-10">
        <div class="flex flex-col sm:flex-row items-center gap-8">
          <div class="orbit shrink-0 grid place-items-center">
            <span class="material-symbols-outlined text-[34px] text-[#0072BC]">neurology</span>
          </div>
          <div class="flex-1 w-full">
            <h2 class="font-heading text-xl sm:text-2xl font-bold text-slate-900 text-center sm:text-left">AI đang phân tích hồ sơ của <span id="loadName">bạn</span></h2>
            <p class="text-sm text-slate-500 mt-1 text-center sm:text-left">Thường mất 10–20 giây. Đừng tắt trang nhé.</p>
            <ul class="mt-6 space-y-3.5" id="loadSteps">
              <li class="load-step"><span class="ic"></span>Đọc thông tin và sở thích của bạn</li>
              <li class="load-step"><span class="ic"></span>Phân tích nhóm tính cách Holland</li>
              <li class="load-step"><span class="ic"></span>Đối chiếu 43 chương trình đào tạo của DUE</li>
              <li class="load-step"><span class="ic"></span>So sánh với điểm chuẩn các năm</li>
              <li class="load-step"><span class="ic"></span>Viết lời khuyên dành riêng cho bạn</li>
            </ul>
          </div>
        </div>
        <div class="mt-8 grid gap-3">
          <div class="h-20 rounded-2xl shimmer"></div>
          <div class="h-20 rounded-2xl shimmer"></div>
          <div class="h-20 rounded-2xl shimmer opacity-60"></div>
        </div>
        <p id="loadTip" class="mt-6 text-center text-xs text-slate-500 italic transition-opacity duration-500"></p>
      </section>

      <!-- ---------- KẾT QUẢ ---------- -->
      <section id="result" hidden class="space-y-6"></section>
    </div>

    <aside class="lg:col-span-4 xl:col-span-3 space-y-5 lg:sticky lg:top-40 no-print">
      <div class="rounded-3xl bg-gradient-to-br from-[#003366] via-[#0072BC] to-[#0a8fd8] text-white p-6 shadow-xl shadow-blue-900/20 relative overflow-hidden">
        <div class="absolute -right-10 -top-10 w-40 h-40 rounded-full bg-white/10"></div>
        <h3 class="font-heading font-bold text-lg relative">Bạn sẽ nhận được</h3>
        <ul class="mt-4 space-y-3 text-sm text-blue-50 relative">
          <li class="flex gap-3"><span class="material-symbols-outlined text-[20px] text-[#7dd3a8]">psychology</span>Nhận xét về tính cách và thế mạnh của bạn</li>
          <li class="flex gap-3"><span class="material-symbols-outlined text-[20px] text-[#7dd3a8]">school</span>3–5 ngành phù hợp nhất tại DUE kèm % phù hợp</li>
          <li class="flex gap-3"><span class="material-symbols-outlined text-[20px] text-[#7dd3a8]">query_stats</span>Đánh giá khả năng trúng tuyển theo điểm chuẩn</li>
          <li class="flex gap-3"><span class="material-symbols-outlined text-[20px] text-[#7dd3a8]">tips_and_updates</span>Lời khuyên sắp xếp nguyện vọng</li>
        </ul>
      </div>
      <div class="rounded-3xl bg-white border border-slate-200 p-6">
        <h3 class="font-heading font-bold text-slate-900">Cần người tư vấn trực tiếp?</h3>
        <div class="mt-4 space-y-1 text-sm">
          <a href="tel:02363836169" class="flex items-center gap-3 p-3 rounded-2xl hover:bg-slate-50 transition">
            <span class="w-9 h-9 rounded-xl bg-orange-50 text-[#F37021] grid place-items-center"><span class="material-symbols-outlined text-[20px]">call</span></span>
            <span><span class="block text-xs text-slate-500">Hotline tuyển sinh</span><span class="font-semibold text-slate-800">0236 3836 169</span></span>
          </a>
          <a href="mailto:tuyensinh@due.edu.vn" class="flex items-center gap-3 p-3 rounded-2xl hover:bg-slate-50 transition">
            <span class="w-9 h-9 rounded-xl bg-blue-50 text-[#0072BC] grid place-items-center"><span class="material-symbols-outlined text-[20px]">mail</span></span>
            <span><span class="block text-xs text-slate-500">Email</span><span class="font-semibold text-slate-800">tuyensinh@due.edu.vn</span></span>
          </a>
          <a href="https://facebook.com/FaceDue" target="_blank" rel="noopener" class="flex items-center gap-3 p-3 rounded-2xl hover:bg-slate-50 transition">
            <span class="w-9 h-9 rounded-xl bg-emerald-50 text-[#00A859] grid place-items-center"><span class="material-symbols-outlined text-[20px]">forum</span></span>
            <span><span class="block text-xs text-slate-500">Fanpage tuyển sinh</span><span class="font-semibold text-slate-800">facebook.com/FaceDue</span></span>
          </a>
        </div>
      </div>
      <p class="text-[11px] text-slate-400 leading-relaxed px-2">Kết quả do AI gợi ý, mang tính tham khảo. Thông tin tuyển sinh chính thức xem tại due.udn.vn.</p>
    </aside>
  </div>
</main>
{% endblock %}

{% block extra_js %}
<script>
(function () {
  var $ = function (id) { return document.getElementById(id); };
  var form = $('advForm');
  var STEP = 0, LAST = 3, quizIndex = 0;

  var PROVINCES = ['Đà Nẵng','Quảng Nam','Thừa Thiên Huế','Quảng Ngãi','Bình Định','Quảng Trị','Quảng Bình','Hà Tĩnh','Nghệ An','Thanh Hóa','Phú Yên','Khánh Hòa','Ninh Thuận','Bình Thuận','Kon Tum','Gia Lai','Đắk Lắk','Đắk Nông','Lâm Đồng','Hà Nội','TP. Hồ Chí Minh','Bình Phước','Tây Ninh','Bình Dương','Đồng Nai','Bà Rịa - Vũng Tàu','Long An','Tiền Giang','Bến Tre','Trà Vinh','Vĩnh Long','Đồng Tháp','An Giang','Kiên Giang','Cần Thơ','Hậu Giang','Sóc Trăng','Bạc Liêu','Cà Mau','Vĩnh Phúc','Bắc Ninh','Quảng Ninh','Hải Dương','Hải Phòng','Hưng Yên','Thái Bình','Hà Nam','Nam Định','Ninh Bình','Hà Giang','Cao Bằng','Bắc Kạn','Tuyên Quang','Lào Cai','Yên Bái','Thái Nguyên','Lạng Sơn','Bắc Giang','Phú Thọ','Điện Biên','Lai Châu','Sơn La','Hòa Bình'];
  var QUIZ = [
    { q: 'Nếu được chọn một hoạt động cho buổi ngoại khóa, bạn sẽ thích…', o: [
      ['R','Lắp ráp, làm thí nghiệm hoặc hoạt động ngoài trời'],['I','Tìm hiểu một chủ đề mới rồi giải thích lại cho mọi người'],
      ['A','Làm poster, quay video hoặc sáng tạo nội dung'],['S','Tham gia tình nguyện, hỗ trợ mọi người'],
      ['E','Tổ chức trò chơi và điều phối cả nhóm'],['C','Lên danh sách, sắp xếp công việc cho mọi người']]},
    { q: 'Khi làm bài tập nhóm, bạn thường…', o: [
      ['R','Nhận phần thực hành, phần cần làm cụ thể'],['I','Phân tích đề và tìm cách giải quyết'],
      ['A','Nghĩ ra ý tưởng mới cho nhóm'],['S','Kết nối mọi người để nhóm làm việc vui vẻ'],
      ['E','Phân chia nhiệm vụ và thúc đẩy tiến độ'],['C','Ghi chép, kiểm tra lại để tránh sai sót']]},
    { q: 'Bạn cảm thấy vui nhất khi…', o: [
      ['R','Tự tay làm ra một sản phẩm cụ thể'],['I','Giải được một bài toán, câu hỏi khó'],
      ['A','Được thể hiện cá tính và ý tưởng riêng'],['S','Giúp ai đó giải quyết được vấn đề'],
      ['E','Đạt thành tích hoặc dẫn đầu'],['C','Hoàn thành công việc gọn gàng, đúng kế hoạch']]},
    { q: 'Khi gặp một vấn đề, bạn thường…', o: [
      ['R','Thử làm ngay để xem cách nào hiệu quả'],['I','Nghĩ kỹ xem vì sao nó xảy ra'],
      ['A','Tìm một cách làm khác, sáng tạo hơn'],['S','Hỏi ý kiến mọi người rồi cùng xử lý'],
      ['E','Quyết định nhanh và bắt tay thực hiện'],['C','Viết ra từng bước để giải quyết']]},
    { q: 'Môi trường học tập, làm việc bạn thích nhất là…', o: [
      ['R','Năng động, có nhiều hoạt động thực tế'],['I','Yên tĩnh để tập trung suy nghĩ'],
      ['A','Tự do, không quá gò bó'],['S','Có nhiều người để trò chuyện, hợp tác'],
      ['E','Có mục tiêu rõ ràng và thử thách cao'],['C','Có kế hoạch cụ thể, mọi thứ rõ ràng']]},
    { q: 'Bạn bè thường nhận xét bạn là người…', o: [
      ['R','Thực tế, làm được việc'],['I','Logic, hay đặt câu hỏi "vì sao"'],
      ['A','Sáng tạo, nhiều ý tưởng lạ'],['S','Dễ gần, biết lắng nghe'],
      ['E','Năng nổ, thích dẫn dắt'],['C','Cẩn thận, làm việc có tổ chức']]}
  ];
  var HOLLAND = {
    R: { n: 'Kỹ thuật – Thực tế', c: '#64748b', d: 'thích làm việc cụ thể, thực hành và thấy được kết quả' },
    I: { n: 'Nghiên cứu – Phân tích', c: '#0072BC', d: 'tò mò, thích phân tích, giải quyết vấn đề bằng logic' },
    A: { n: 'Nghệ thuật – Sáng tạo', c: '#a855f7', d: 'giàu ý tưởng, thích tự do thể hiện bản thân' },
    S: { n: 'Xã hội – Hỗ trợ', c: '#00A859', d: 'thân thiện, thích giúp đỡ và làm việc với con người' },
    E: { n: 'Quản lý – Kinh doanh', c: '#F37021', d: 'năng động, thích dẫn dắt, thuyết phục và chinh phục mục tiêu' },
    C: { n: 'Nghiệp vụ – Tổ chức', c: '#0f766e', d: 'cẩn thận, ngăn nắp, làm việc có quy trình rõ ràng' }
  };
  var TIPS = [
    'Mẹo: Bạn được đăng ký tối đa 15 nguyện vọng trên hệ thống của Bộ GD&ĐT.',
    'DUE có 3 loại hình đào tạo: Tiêu chuẩn, Bán phần tiếng Anh và Toàn phần tiếng Anh.',
    'Có IELTS từ 5.5 trở lên giúp bạn mở rộng lựa chọn chương trình học bằng tiếng Anh.',
    'Năm 2026, DUE có quỹ học bổng hơn 10 tỷ đồng cho tân sinh viên tài năng.'
  ];
  var answers = QUIZ.map(function () { return null; });

  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }
  function sGet(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }
  function sSet(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }
  function sDel(k) { try { localStorage.removeItem(k); } catch (e) {} }

  /* ---- Dấu * đỏ cho ô bắt buộc ---- */
  form.querySelectorAll('[data-required]').forEach(function (el) {
    var label = el.id ? form.querySelector('label[for="' + el.id + '"]') : null;
    if (!label) label = el.parentElement.querySelector('.adv-label');
    if (label && !label.querySelector('.req-star')) {
      label.insertAdjacentHTML('beforeend', '<span class="req-star" aria-hidden="true">*</span>');
      if (el.id) el.setAttribute('aria-required', 'true');
    }
  });
  form.querySelectorAll('.adv-step').forEach(function (step) {
    if (!step.querySelector('.req-star')) return;
    var intro = step.querySelector('h2 + p');
    if (intro) intro.insertAdjacentHTML('beforeend', ' <span class="whitespace-nowrap text-slate-400">(<span class="req-star" style="margin-left:0">*</span> là thông tin bắt buộc)</span>');
  });

  var sel = $('province');
  PROVINCES.forEach(function (p) { var o = document.createElement('option'); o.value = o.textContent = p; sel.appendChild(o); });

  /* ---- Chip ---- */
  function syncChip(group) {
    var vals = Array.prototype.filter.call(group.querySelectorAll('.chip'), function (x) { return x.getAttribute('aria-pressed') === 'true'; })
      .map(function (x) { return x.dataset.value; });
    $(group.dataset.chips).value = vals.join(', ');
  }
  function setChipGroup(group, value) {
    var list = value ? String(value).split(', ') : [];
    group.querySelectorAll('.chip').forEach(function (b) { b.setAttribute('aria-pressed', list.indexOf(b.dataset.value) > -1 ? 'true' : 'false'); });
  }
  document.querySelectorAll('[data-chips]').forEach(function (group) {
    var multi = group.hasAttribute('data-multi');
    group.querySelectorAll('.chip').forEach(function (b) {
      b.setAttribute('aria-pressed', 'false');
      b.addEventListener('click', function () {
        var on = b.getAttribute('aria-pressed') !== 'true';
        if (!multi) group.querySelectorAll('.chip').forEach(function (x) { x.setAttribute('aria-pressed', 'false'); });
        b.setAttribute('aria-pressed', on ? 'true' : 'false');
        syncChip(group);
        var err = group.parentElement.querySelector('.adv-err'); if (err) err.classList.remove('show');
        saveDraft();
      });
    });
  });

  document.querySelectorAll('[data-suggest]').forEach(function (box) {
    var ta = $(box.dataset.suggest);
    box.querySelectorAll('.chip-suggest').forEach(function (b) {
      b.addEventListener('click', function () {
        var t = b.textContent.replace(/^\+\s*/, '');
        ta.value = ta.value.trim() ? ta.value.trim().replace(/[.,;]$/, '') + ', ' + t.toLowerCase() : t;
        b.classList.add('used'); validField(ta); ta.focus(); saveDraft();
      });
    });
  });

  /* ---- Trắc nghiệm ---- */
  function renderQuiz() {
    var q = QUIZ[quizIndex];
    $('quizCounter').textContent = (quizIndex + 1) + '/' + QUIZ.length;
    $('quizDots').innerHTML = QUIZ.map(function (_, i) {
      var cls = answers[i] ? 'bg-[#00A859]' : (i === quizIndex ? 'bg-[#0072BC]' : 'bg-slate-200');
      return '<button type="button" data-q="' + i + '" aria-label="Câu ' + (i + 1) + '" class="h-1.5 flex-1 rounded-full transition ' + cls + '"></button>';
    }).join('');
    $('quizBox').innerHTML =
      '<div class="fade-in"><p class="text-xs font-bold text-[#0072BC] uppercase tracking-wider">Câu ' + (quizIndex + 1) + '</p>' +
      '<h3 class="font-heading text-lg sm:text-xl font-bold text-slate-900 mt-1 mb-5">' + esc(q.q) + '</h3>' +
      '<div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-3">' + q.o.map(function (o, i) {
        return '<button type="button" class="quiz-opt" data-v="' + o[0] + '" aria-pressed="' + (answers[quizIndex] === o[0]) + '">' +
          '<span class="key">' + 'ABCDEF'[i] + '</span><span class="text-sm text-slate-700 leading-snug">' + esc(o[1]) + '</span></button>';
      }).join('') + '</div>' +
      '<div class="flex justify-between mt-5 text-sm">' +
        '<button type="button" id="qPrev" class="text-slate-500 hover:text-slate-800 font-semibold ' + (quizIndex ? '' : 'invisible') + '">← Câu trước</button>' +
        '<button type="button" id="qNext" class="text-[#0072BC] font-semibold ' + (answers[quizIndex] && quizIndex < QUIZ.length - 1 ? '' : 'invisible') + '">Câu sau →</button>' +
      '</div></div>';
    $('quizBox').querySelectorAll('.quiz-opt').forEach(function (b) {
      b.addEventListener('click', function () {
        answers[quizIndex] = b.dataset.v;
        $('quizErr').classList.remove('show'); saveDraft();
        $('quizBox').querySelectorAll('.quiz-opt').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
        setTimeout(function () {
          var next = answers.findIndex(function (a, i) { return !a && i > quizIndex; });
          if (next === -1) next = answers.findIndex(function (a) { return !a; });
          if (next > -1) { quizIndex = next; renderQuiz(); } else { renderQuiz(); go(STEP + 1); }
        }, 280);
      });
    });
    $('quizDots').querySelectorAll('button').forEach(function (d) { d.addEventListener('click', function () { quizIndex = +d.dataset.q; renderQuiz(); }); });
    var p = $('qPrev'), n = $('qNext');
    p && p.addEventListener('click', function () { quizIndex--; renderQuiz(); });
    n && n.addEventListener('click', function () { quizIndex++; renderQuiz(); });
  }

  /* ---- Kiểm tra ---- */
  // Trả về thông báo lỗi cụ thể cho từng trường hợp, rỗng nếu hợp lệ
  function fieldError(el) {
    var v = (el.value || '').trim();
    var name = el.dataset.name || 'thông tin này';
    if (!v) return el.hasAttribute('data-required') ? (el.dataset.msgRequired || ('Vui lòng nhập ' + name + '.')) : '';
    if (el.dataset.min && v.length < +el.dataset.min)
      return 'Cần ít nhất ' + el.dataset.min + ' ký tự (bạn mới nhập ' + v.length + ').';
    if (el.type === 'date') {
      var y = parseInt(v.slice(0, 4), 10), now = new Date().getFullYear();
      if (isNaN(y)) return 'Ngày sinh chưa hợp lệ.';
      if (y > now - 13) return 'Năm sinh có vẻ chưa đúng, bạn kiểm tra lại nhé (học sinh THPT thường sinh trước ' + (now - 13) + ').';
      if (y < now - 60) return 'Năm sinh có vẻ chưa đúng, bạn kiểm tra lại nhé.';
    }
    if (el.hasAttribute('data-phone')) {
      var digits = v.replace(/[\s.\-]/g, '');
      if (!/^\d+$/.test(digits)) return 'Số điện thoại chỉ gồm chữ số.';
      if (digits[0] !== '0') return 'Số điện thoại phải bắt đầu bằng số 0.';
      if (digits.length !== 10) return 'Số điện thoại cần đủ 10 chữ số (bạn đang nhập ' + digits.length + ').';
    }
    if (el.hasAttribute('data-email') && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v))
      return 'Email chưa đúng định dạng, ví dụ: ten@gmail.com';
    if (el.dataset.range) {
      var r = el.dataset.range.split(',').map(Number), n = parseFloat(v.replace(',', '.'));
      if (isNaN(n)) return 'Vui lòng nhập một con số.';
      if (n < r[0] || n > r[1]) return 'Điểm phải nằm trong khoảng ' + r[0] + ' – ' + r[1] + '.';
    }
    return '';
  }
  function errBox(el) {
    var box = el.parentElement.querySelector('.adv-err');
    if (!box && el.parentElement.parentElement) box = el.parentElement.parentElement.querySelector('.adv-err');
    return box;
  }
  function validField(el) {
    var msg = fieldError(el), box = errBox(el);
    el.classList.toggle('is-invalid', !!msg);
    el.setAttribute('aria-invalid', msg ? 'true' : 'false');
    if (box) {
      if (msg) box.innerHTML = '<span class="inline-flex items-start gap-1"><span class="material-symbols-outlined text-[15px] leading-4">error</span><span>' + esc(msg) + '</span></span>';
      box.classList.toggle('show', !!msg);
    }
    return !msg;
  }
  function validateStep(i) {
    var box = form.querySelector('[data-step="' + i + '"]'), ok = true, first = null;
    box.querySelectorAll('input:not([type=hidden]), select, textarea').forEach(function (el) {
      if (!validField(el)) { ok = false; first = first || el; }
    });
    box.querySelectorAll('[data-chips][data-required]').forEach(function (g) {
      var err = g.parentElement.querySelector('.adv-err');
      if (!$(g.dataset.chips).value) { ok = false; err.classList.add('show'); first = first || g; } else err.classList.remove('show');
    });
    if (i === 1) {
      var miss = answers.findIndex(function (a) { return !a; });
      if (miss > -1) { ok = false; quizIndex = miss; renderQuiz(); $('quizErr').classList.add('show'); }
    }
    if (first) { first.scrollIntoView({ behavior: 'smooth', block: 'center' }); if (first.focus) first.focus({ preventScroll: true }); }
    return ok;
  }
  form.querySelectorAll('.adv-field').forEach(function (el) {
    el.addEventListener('blur', function () { if (el.value) validField(el); });
    el.addEventListener('input', function () { if (el.classList.contains('is-invalid')) validField(el); saveDraft(); });
  });

  /* ---- Chuyển bước ---- */
  function go(i) {
    STEP = Math.max(0, Math.min(LAST, i));
    form.querySelectorAll('.adv-step').forEach(function (s) {
      var on = +s.dataset.step === STEP;
      s.hidden = !on;
      if (on) { s.classList.remove('fade-in'); void s.offsetWidth; s.classList.add('fade-in'); }
    });
    document.querySelectorAll('.stepper-item').forEach(function (it) {
      var k = +it.dataset.i;
      it.classList.toggle('active', k === STEP);
      it.classList.toggle('done', k < STEP);
      it.querySelector('.stepper-dot').innerHTML = k < STEP ? '<span class="material-symbols-outlined text-[18px]">check</span>' : (k + 1);
    });
    $('btnBack').classList.toggle('invisible', STEP === 0);
    $('btnNextText').textContent = STEP === LAST ? 'Xem gợi ý từ AI' : 'Tiếp tục';
    $('btnNext').style.background = STEP === LAST ? 'linear-gradient(90deg,#F37021,#0072BC)' : '';
    if (STEP === 1) renderQuiz();
    var top = $('wizard').getBoundingClientRect().top + window.scrollY - 170;
    if (window.scrollY > top) window.scrollTo({ top: top, behavior: 'smooth' });
  }
  document.querySelectorAll('.stepper-item').forEach(function (it) {
    it.style.cursor = 'pointer';
    it.addEventListener('click', function () { var k = +it.dataset.i; if (k < STEP) go(k); });
  });
  $('btnBack').addEventListener('click', function () { go(STEP - 1); });
  form.addEventListener('submit', function (e) {
    e.preventDefault();
    if (!validateStep(STEP)) return;
    if (STEP < LAST) go(STEP + 1); else submit();
  });

  /* ---- Lưu nháp ---- */
  var FIELDS = ['full_name','gender','date_of_birth','phone_number','email','high_school','province','address','interests','strengths','career_goals',
    'work_style','job_priority','grade_level','subject_combo','expected_score','gpa','strong_subjects','weak_subjects','english_level','admission_method',
    'program_type','budget','considered_majors','family_wish','extra_notes'];
  var draftTimer;
  function saveDraft() {
    clearTimeout(draftTimer);
    draftTimer = setTimeout(function () {
      var d = { answers: answers };
      FIELDS.forEach(function (f) { d[f] = $(f).value; });
      sSet('due_advisory_draft', JSON.stringify(d));
      $('draftNote').textContent = 'Đã tự lưu nháp';
    }, 400);
  }
  (function loadDraft() {
    var d; try { d = JSON.parse(sGet('due_advisory_draft') || 'null'); } catch (e) { d = null; }
    if (!d) return;
    FIELDS.forEach(function (f) { if (d[f] != null) $(f).value = d[f]; });
    if (Array.isArray(d.answers)) answers = QUIZ.map(function (_, i) { return d.answers[i] || null; });
    document.querySelectorAll('[data-chips]').forEach(function (g) { setChipGroup(g, $(g.dataset.chips).value); });
    $('draftNote').textContent = 'Đã khôi phục bản nháp trước đó';
  })();

  /* ---- Chờ AI ---- */
  var loadTimer, tipTimer;
  function startLoading(name) {
    $('loadName').textContent = (name || '').trim().replace(/\s+/g, ' ') || 'bạn';
    $('wizard').hidden = true; $('result').hidden = true; $('loading').hidden = false;
    window.scrollTo({ top: $('loading').getBoundingClientRect().top + window.scrollY - 170, behavior: 'smooth' });
    var steps = $('loadSteps').children, k = 0;
    Array.prototype.forEach.call(steps, function (s) { s.className = 'load-step'; s.querySelector('.ic').textContent = ''; });
    (function tick() {
      if (k > 0) { steps[k - 1].className = 'load-step ok'; steps[k - 1].querySelector('.ic').textContent = '✓'; }
      if (k < steps.length - 1) { steps[k].className = 'load-step run'; k++; loadTimer = setTimeout(tick, 2600); }
      else { steps[k].className = 'load-step run'; }   // bước cuối chạy tới khi có kết quả
    })();
    var t = 0; $('loadTip').textContent = TIPS[0]; $('loadTip').style.opacity = 1;
    tipTimer = setInterval(function () {
      t = (t + 1) % TIPS.length; $('loadTip').style.opacity = 0;
      setTimeout(function () { $('loadTip').textContent = TIPS[t]; $('loadTip').style.opacity = 1; }, 400);
    }, 4500);
  }
  function stopLoading() {
    clearTimeout(loadTimer); clearInterval(tipTimer);
    Array.prototype.forEach.call($('loadSteps').children, function (s) { s.className = 'load-step ok'; s.querySelector('.ic').textContent = '✓'; });
  }

  function submit() {
    var scores = { R: 0, I: 0, A: 0, S: 0, E: 0, C: 0 };
    answers.forEach(function (a) { if (a) scores[a]++; });
    var payload = {};
    FIELDS.forEach(function (f) { payload[f] = $(f).value.trim(); });
    payload.phone_number = payload.phone_number.replace(/[\s.\-]/g, '');   // khớp với phần kiểm tra
    ['expected_score', 'gpa'].forEach(function (f) { payload[f] = payload[f].replace(',', '.'); });
    Object.keys(scores).forEach(function (k) { payload['score_' + k.toLowerCase()] = scores[k]; });

    var started = Date.now();
    startLoading(payload.full_name);
    fetch('/api/tu-van-huong-nghiep/', {
      method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
      body: JSON.stringify(payload)
    })
    .then(function (r) { return r.json().catch(function () { return {}; }).then(function (j) { return { status: r.status, body: j }; }); })
    .then(function (res) {
      setTimeout(function () {
        stopLoading();
        if (res.status === 429) return showError('Bạn vừa gửi khá nhiều lần. Vui lòng chờ khoảng 1 phút rồi thử lại nhé.');
        if (!res.body || res.body.status !== 'success') return showError((res.body && res.body.message) || 'Có lỗi xảy ra, bạn thử lại nhé.');
        sDel('due_advisory_draft');
        setTimeout(function () { renderResult(res.body.data, payload, scores); }, 450);
      }, Math.max(0, 2500 - (Date.now() - started)));
    })
    .catch(function () { stopLoading(); showError('Không kết nối được máy chủ. Bạn kiểm tra mạng rồi thử lại nhé.'); });
  }

  function showError(msg) {
    $('loading').hidden = true; $('wizard').hidden = false;
    var box = document.createElement('div');
    box.className = 'fade-in mb-6 p-4 rounded-2xl bg-red-50 border border-red-200 text-sm text-red-700 flex gap-3 items-start';
    box.innerHTML = '<span class="material-symbols-outlined text-[20px]">error</span><span>' + esc(msg) + '</span>';
    form.prepend(box); setTimeout(function () { box.remove(); }, 8000);
  }

  /* ---- Kết quả ---- */
  function chanceTone(text) {
    var t = (text || '').toLowerCase();
    if (/chưa có|tham khảo/.test(t)) return ['bg-slate-50 text-slate-600 border-slate-200', 'info'];
    if (/cạnh tranh|sát|thấp hơn|khó|thử thách/.test(t)) return ['bg-amber-50 text-amber-800 border-amber-200', 'balance'];
    if (/rất cao|an toàn|vượt|dư|cao/.test(t)) return ['bg-emerald-50 text-emerald-700 border-emerald-200', 'trending_up'];
    return ['bg-blue-50 text-[#0072BC] border-blue-200', 'insights'];
  }

  function renderResult(d, payload, scores) {
    var majors = d.suggested_majors || [], isAI = !!d.ai;
    var order = Object.keys(scores).sort(function (a, b) { return scores[b] - scores[a]; });
    var max = scores[order[0]] || 1, top = order[0];
    var first = (payload.full_name || '').trim().replace(/\s+/g, ' ') || 'Bạn';
    var ringColors = ['#00A859', '#0072BC', '#F37021', '#a855f7', '#0f766e'];
    var html = '';

    html += '<div class="fade-in rounded-3xl overflow-hidden bg-white border border-slate-200 shadow-xl shadow-slate-900/5">' +
      '<div class="bg-gradient-to-r from-[#003366] via-[#0072BC] to-[#0a8fd8] text-white px-6 sm:px-8 py-7 relative overflow-hidden">' +
        '<div class="absolute -right-12 -bottom-16 w-56 h-56 rounded-full bg-white/10"></div>' +
        '<p class="text-xs font-bold uppercase tracking-wider text-blue-100 relative">Kết quả tư vấn' + (isAI ? ' · Phân tích bởi AI' : '') + '</p>' +
        '<h2 class="font-heading text-2xl sm:text-3xl font-bold mt-1 relative">' + esc(first) + ' thuộc nhóm ' + esc(HOLLAND[top].n) + '</h2>' +
        '<p class="text-blue-50 text-sm mt-2 max-w-xl relative">Người thuộc nhóm này thường ' + esc(HOLLAND[top].d) + '.</p>' +
        '<span class="inline-flex mt-4 px-3 py-1 rounded-full bg-white/15 ring-1 ring-white/25 text-xs font-bold relative">Mã Holland của bạn: ' + esc(d.holland_code || order.slice(0, 3).join('')) + '</span>' +
      '</div>' +
      '<div class="px-6 sm:px-8 py-6 grid sm:grid-cols-2 gap-x-8 gap-y-3">' + order.map(function (k) {
        return '<div><div class="flex justify-between text-xs mb-1"><span class="font-semibold text-slate-700">' + k + ' · ' + esc(HOLLAND[k].n) + '</span>' +
          '<span class="text-slate-400">' + scores[k] + '/6</span></div><div class="bar"><i data-w="' + (scores[k] / max * 100) + '" style="background:' + HOLLAND[k].c + '"></i></div></div>';
      }).join('') + '</div></div>';

    if (isAI && d.tong_quan) {
      html += '<div class="fade-in rounded-3xl bg-white border border-slate-200 p-6 sm:p-7 flex gap-4">' +
        '<span class="shrink-0 w-11 h-11 rounded-2xl bg-blue-50 text-[#0072BC] grid place-items-center"><span class="material-symbols-outlined">psychology</span></span>' +
        '<div><h3 class="font-heading font-bold text-slate-900">Nhận xét về bạn</h3><p class="text-sm text-slate-600 leading-relaxed mt-1.5">' + esc(d.tong_quan) + '</p></div></div>';
    } else if (!isAI) {
      html += '<div class="fade-in rounded-2xl bg-amber-50 border border-amber-200 p-4 text-sm text-amber-800 flex gap-3">' +
        '<span class="material-symbols-outlined text-[20px]">info</span><span>Trợ lý AI đang bận nên các gợi ý dưới đây được lấy theo kết quả trắc nghiệm tính cách. Bạn có thể thử lại sau ít phút để nhận phân tích chi tiết hơn.</span></div>';
    }

    html += '<div class="fade-in"><div class="flex items-end justify-between mb-3 px-1"><h3 class="font-heading text-xl font-bold text-slate-900">' +
      (isAI ? majors.length + ' ngành phù hợp nhất với bạn' : 'Các ngành gợi ý') + '</h3><span class="text-xs text-slate-400 hidden sm:inline">Xếp theo mức độ phù hợp</span></div><div class="space-y-4">';
    majors.forEach(function (m, i) {
      var pct = m.phu_hop != null && m.phu_hop !== '' ? Math.round(m.phu_hop) : null, tone = chanceTone(m.kha_nang);
      var score = m.diem && m.diem !== '—' ? m.diem : null;
      html += '<article class="rounded-3xl bg-white border ' + (i === 0 ? 'border-[#0072BC]/40 ring-4 ring-[#0072BC]/5' : 'border-slate-200') + ' p-5 sm:p-6 hover:shadow-lg transition">' +
        '<div class="flex gap-4 items-center">' +
          (pct != null ? '<div class="ring" style="--p:' + pct + ';--c:' + ringColors[i % 5] + '"><span>' + pct + '%</span></div>'
                       : '<div class="w-12 h-12 rounded-2xl bg-blue-50 text-[#0072BC] grid place-items-center font-heading font-bold shrink-0">#' + (i + 1) + '</div>') +
          '<div class="flex-1 min-w-0">' +
            '<div class="flex flex-wrap items-center gap-2">' + (i === 0 ? '<span class="px-2 py-0.5 rounded-full bg-[#F37021] text-white text-[10px] font-bold uppercase">Phù hợp nhất</span>' : '') +
              '<span class="text-[11px] font-semibold text-slate-400">Mã ' + esc(m.ma) + (m.khoa ? ' · ' + esc(m.khoa) : '') + '</span></div>' +
            '<h4 class="font-heading text-base sm:text-lg font-bold text-slate-900 mt-1 leading-snug">' + esc(m.ten) + '</h4>' +
          '</div></div>' +
        (m.ly_do ? '<p class="text-sm text-slate-600 leading-relaxed mt-4">' + esc(m.ly_do) + '</p>' : '') +
        '<div class="flex flex-wrap gap-2 mt-4">' +
          (score ? '<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-slate-100 text-slate-700 text-xs font-semibold"><span class="material-symbols-outlined text-[15px]">leaderboard</span>Điểm chuẩn' + (m.nam_diem ? ' ' + esc(m.nam_diem) : '') + ': ' + esc(score) + (m.phuong_thuc_diem ? ' (' + esc(m.phuong_thuc_diem) + ')' : '') + '</span>' : '') +
          (m.to_hop ? '<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-slate-100 text-slate-700 text-xs font-semibold"><span class="material-symbols-outlined text-[15px]">menu_book</span>' + esc(m.to_hop) + '</span>' : '') +
        '</div>' +
        (m.kha_nang ? '<div class="mt-3 px-3.5 py-2.5 rounded-2xl border text-xs leading-relaxed flex gap-2 ' + tone[0] + '"><span class="material-symbols-outlined text-[16px]">' + tone[1] + '</span><span>' + esc(m.kha_nang) + '</span></div>' : '') +
        '<div class="mt-4 pt-4 border-t border-slate-100 flex flex-wrap gap-2 no-print">' +
          '<button type="button" data-ask="' + esc(m.ten) + '" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-blue-50 text-[#0072BC] text-xs font-bold hover:bg-blue-100 transition"><span class="material-symbols-outlined text-[16px]">chat</span>Hỏi thêm về ngành này</button>' +
        '</div></article>';
    });
    html += '</div></div>';

    if (isAI && d.loi_khuyen) {
      html += '<div class="fade-in rounded-3xl bg-gradient-to-br from-orange-50 to-amber-50 border border-orange-200 p-6 sm:p-7 flex gap-4">' +
        '<span class="shrink-0 w-11 h-11 rounded-2xl bg-[#F37021] text-white grid place-items-center"><span class="material-symbols-outlined">tips_and_updates</span></span>' +
        '<div><h3 class="font-heading font-bold text-slate-900">Lời khuyên chọn nguyện vọng</h3><p class="text-sm text-slate-700 leading-relaxed mt-1.5">' + esc(d.loi_khuyen) + '</p></div></div>';
    }

    html += '<div class="fade-in flex flex-wrap gap-3 no-print">' +
      '<button type="button" id="btnRestart" class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-white border border-slate-200 text-sm font-bold text-slate-700 hover:bg-slate-50"><span class="material-symbols-outlined text-[18px]">restart_alt</span>Làm lại từ đầu</button>' +
      '<button type="button" id="btnEdit" class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-white border border-slate-200 text-sm font-bold text-slate-700 hover:bg-slate-50"><span class="material-symbols-outlined text-[18px]">edit</span>Sửa câu trả lời</button>' +
      '<button type="button" id="btnPrint" class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-white border border-slate-200 text-sm font-bold text-slate-700 hover:bg-slate-50"><span class="material-symbols-outlined text-[18px]">print</span>In / Lưu PDF</button>' +
      '<a href="tel:02363836169" class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-[#00A859] text-white text-sm font-bold hover:opacity-95"><span class="material-symbols-outlined text-[18px]">support_agent</span>Gọi cán bộ tư vấn</a>' +
    '</div><p class="text-xs text-slate-400 px-1">Kết quả mang tính tham khảo. Hồ sơ của bạn đã được lưu để cán bộ tuyển sinh DUE hỗ trợ thêm khi cần.</p>';

    var box = $('result');
    box.innerHTML = html;
    $('loading').hidden = true; box.hidden = false;
    window.scrollTo({ top: box.getBoundingClientRect().top + window.scrollY - 170, behavior: 'smooth' });
    setTimeout(function () { box.querySelectorAll('.bar > i').forEach(function (b) { b.style.width = b.dataset.w + '%'; }); }, 150);

    box.querySelectorAll('[data-ask]').forEach(function (b) {
      b.addEventListener('click', function () { askChat('Cho em hỏi thêm về ngành ' + b.dataset.ask + ': học những gì, ra trường làm gì và học phí bao nhiêu?'); });
    });
    $('btnRestart').addEventListener('click', function () { sDel('due_advisory_draft'); window.location.reload(); });
    $('btnEdit').addEventListener('click', function () { box.hidden = true; $('wizard').hidden = false; go(0); });
    $('btnPrint').addEventListener('click', function () { window.print(); });
  }

  function askChat(q) {
    var t = $('dcToggle'), input = $('dcInput'), f = $('dcForm');
    if (!t || !input || !f) { window.location.href = '/chatbot/'; return; }
    if (t.getAttribute('aria-expanded') !== 'true') t.click();
    setTimeout(function () {
      input.value = q;
      if (f.requestSubmit) f.requestSubmit(); else f.dispatchEvent(new Event('submit', { cancelable: true }));
    }, 300);
  }

  go(0);
})();
</script>
{% endblock %}


--- FILE: CongthongtintuyensinhDUE/templates/admissions/chatbot.html ---
{% extends 'layouts/base.html' %}

{% block title %}Chat với DUE - Cổng thông tin tuyển sinh DUE{% endblock %}

{% block nav_chatbot %}text-secondary-container font-headline-sm border-b-2 border-secondary-container uppercase whitespace-nowrap font-bold{% endblock %}

{% block floating_chat %}{# Ẩn nút chat nổi vì đang ở chính trang Chatbot #}{% endblock %}

{% block extra_head %}
<style>
  .custom-scroll {
    scrollbar-width: thin;
    scrollbar-color: rgba(148, 163, 184, 0.35) transparent;
  }
  /* Typing animation */
  @keyframes typingBounce {
    0%, 80%, 100% { transform: translateY(0); }
    40% { transform: translateY(-5px); }
  }
  .typing-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #0072BC;
    animation: typingBounce 1.2s infinite ease-in-out;
  }
  .typing-dot:nth-child(2) { animation-delay: 0.2s; }
  .typing-dot:nth-child(3) { animation-delay: 0.4s; }
</style>
{% endblock %}

{% block content %}
<main class="w-full pt-32 sm:pt-36 pb-6 bg-surface min-h-[calc(100vh-28rem)] flex-1">

    <!-- 3-Panel Workspace Container -->
    <div class="max-w-7xl w-full mx-auto px-6 lg:px-12 py-6 flex-1 grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      
      <!-- ==============================================
           PANEL 1: NGUỒN TÀI LIỆU (CÁN BỘ TƯ VẤN UPLOAD) - 3 COLS
           ============================================== -->
      <div class="lg:col-span-3 bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden flex flex-col">
        <!-- Panel Header -->
        <div class="p-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/70">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-[20px] text-[#0072BC]">folder_open</span>
            <h3 class="font-heading text-sm font-bold text-slate-800">Nguồn tài liệu</h3>
          </div>
          <span id="sources-count-badge" class="px-2 py-0.5 rounded-full bg-slate-100 text-slate-600 text-xs font-semibold">0 tệp</span>
        </div>

        <div class="p-4 space-y-4">
          {% if user.is_staff %}
          <!-- Upload Box dành cho Cán bộ tư vấn -->
          <div class="p-4 rounded-xl border-2 border-dashed border-slate-200 hover:border-[#0072BC] bg-slate-50/50 hover:bg-blue-50/30 transition-all text-center">
            <input type="file" id="staff-file-input" multiple onchange="handleStaffUpload(event)" class="hidden" accept=".pdf,.doc,.docx,.txt,.csv,.md,.xlsx">
            
            <label for="staff-file-input" class="cursor-pointer block">
              <div class="w-10 h-10 mx-auto rounded-full bg-blue-100 text-[#0072BC] flex items-center justify-center mb-2">
                <span class="material-symbols-outlined text-[22px]">cloud_upload</span>
              </div>
              <p class="text-xs font-bold text-[#0072BC]">Tải lên tài liệu mới</p>
              <p class="text-[10px] text-slate-400 mt-0.5">PDF, DOCX, XLSX, CSV, TXT, MD</p>
            </label>
          </div>
          {% endif %}

          <!-- Empty State (Khi chưa có file tải lên) -->
          <div id="sources-empty-state" class="py-6 px-2 text-center text-slate-400">
            <span class="material-symbols-outlined text-[28px] mb-1 text-slate-300">hourglass_empty</span>
            <p class="text-xs font-medium text-slate-600">Chưa có nguồn tài liệu</p>
          </div>

          <!-- File list (Rendered dynamically khi cán bộ upload) -->
          <div id="sources-list" class="space-y-2 hidden"></div>
        </div>

        <!-- Role tag -->
        <div class="p-3 bg-slate-50 border-t border-slate-100 text-[11px] text-slate-500 flex items-center gap-1.5">
          <span class="material-symbols-outlined text-[15px] text-[#F37021]">admin_panel_settings</span>
          {% if user.is_staff %}
            <a href="/can-bo/hoi-dap/" class="font-bold text-[#0072BC] hover:underline">Trả lời câu hỏi đang chờ</a>
            <span id="staff-pending-badge" class="ml-auto px-1.5 py-0.5 rounded-full bg-red-100 text-red-600 font-bold hidden"></span>
          {% else %}
            <span>Tài liệu do cán bộ tuyển sinh DUE cung cấp</span>
          {% endif %}
        </div>
      </div>

      <!-- ==============================================
           PANEL 2: KHUNG CHAT TRUNG TÂM (6 COLS)
           ============================================== -->
      <div class="lg:col-span-6 bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden flex flex-col h-[720px]">
        
        <!-- Chat Cover Header (Cam - Xanh lá - Xanh dương) -->
        <div class="h-2 w-full bg-gradient-to-r from-[#F37021] via-[#00A859] to-[#0072BC]"></div>
        
        <!-- Messages Area -->
        <div id="chat-messages-container" class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-4 custom-scroll">
          
          <!-- Welcome Box -->
          <div class="p-5 rounded-2xl bg-gradient-to-br from-blue-50/70 via-white to-orange-50/30 border border-slate-200/80">
            <div class="flex items-center gap-2 mb-2">
              <span class="px-2 py-0.5 rounded bg-[#0072BC] text-white text-[11px] font-bold">DUE AI BOT</span>
            </div>
            <h3 class="font-heading text-base font-bold text-slate-900 mb-1">
              Xin chào! Tôi có thể giúp gì cho bạn về tuyển sinh và thông tin mà bạn đang thắc mắc tại DUE?
            </h3>
          </div>

          <!-- Suggestion Chips -->
          <div id="suggestions-block" class="space-y-2 pt-1">
            <p class="text-xs font-heading font-bold text-slate-400 uppercase tracking-wider flex items-center gap-1">
              <span class="material-symbols-outlined text-[15px] text-[#F37021]">lightbulb</span>
              Câu hỏi thường gặp:
            </p>
            <div class="flex flex-col gap-1.5">
              <button onclick="askPreset('Các phương thức xét tuyển và tổ hợp môn của DUE năm 2026?')"
                class="w-full text-left p-2.5 rounded-xl bg-slate-50 hover:bg-blue-50 hover:border-blue-200 border border-slate-200 text-xs text-slate-700 transition-all flex items-center justify-between group">
                <span class="group-hover:text-[#0072BC]">Các phương thức xét tuyển và tổ hợp môn của DUE năm 2026?</span>
                <span class="material-symbols-outlined text-[15px] text-slate-400 group-hover:text-[#0072BC]">arrow_forward</span>
              </button>
              <button onclick="askPreset('Điều kiện và cách tính điểm xét tuyển học bạ PT2 ra sao?')"
                class="w-full text-left p-2.5 rounded-xl bg-slate-50 hover:bg-emerald-50 hover:border-emerald-200 border border-slate-200 text-xs text-slate-700 transition-all flex items-center justify-between group">
                <span class="group-hover:text-[#00A859]">Điều kiện và cách tính điểm xét tuyển học bạ PT2 ra sao?</span>
                <span class="material-symbols-outlined text-[15px] text-slate-400 group-hover:text-[#00A859]">arrow_forward</span>
              </button>
              <button onclick="askPreset('Chính sách học bổng và học phí các hệ đào tạo tại DUE?')"
                class="w-full text-left p-2.5 rounded-xl bg-slate-50 hover:bg-orange-50 hover:border-orange-200 border border-slate-200 text-xs text-slate-700 transition-all flex items-center justify-between group">
                <span class="group-hover:text-[#F37021]">Chính sách học bổng và học phí các hệ đào tạo tại DUE?</span>
                <span class="material-symbols-outlined text-[15px] text-slate-400 group-hover:text-[#F37021]">arrow_forward</span>
              </button>
            </div>
          </div>

          <!-- Dynamic Chat Messages List -->
          <div id="messages-list" class="space-y-4"></div>

        </div>

        <!-- Chat Input Omnibar -->
        <div class="p-3.5 sm:p-4 border-t border-slate-200 bg-white">
          <form onsubmit="handleChatSubmit(event)" class="relative rounded-xl border border-slate-300 focus-within:border-[#0072BC] focus-within:ring-2 focus-within:ring-blue-100 transition-all bg-white shadow-sm">
            <textarea
              id="chat-input"
              rows="2"
              placeholder="Hỏi DUE AI BOT"
              onkeydown="handleKey(event)"
              class="w-full bg-transparent text-sm text-slate-800 placeholder-slate-400 p-3 pr-24 resize-none focus:outline-none"
            ></textarea>

            <div class="absolute right-2.5 bottom-2.5 flex items-center gap-1.5">
              <button
                type="submit"
                class="w-8 h-8 rounded-lg bg-gradient-to-r from-[#F37021] to-[#0072BC] hover:opacity-95 text-white flex items-center justify-center transition-all shadow active:scale-95"
                title="Gửi câu hỏi"
              >
                <span class="material-symbols-outlined text-[18px]">arrow_upward</span>
              </button>
            </div>
          </form>
          <p class="text-[11px] text-slate-400 text-center mt-2">
            Chatbot AI DUE trả lời dựa trên thông tin chính thức. Vui lòng đối chiếu thêm tại <a href="https://due.udn.vn" target="_blank" class="text-[#0072BC] underline">due.udn.vn</a>.
          </p>
        </div>

      </div>

      <!-- ==============================================
           PANEL 3: STUDIO và TÀI LIỆU TUYỂN SINH - 3 COLS
           ============================================== -->
      <div class="lg:col-span-3 bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden flex flex-col space-y-4 p-4">
        
        <div class="pb-3 border-b border-slate-100 flex items-center gap-2">
          <span class="material-symbols-outlined text-[20px] text-[#00A859]">info</span>
          <h3 class="font-heading text-sm font-bold text-slate-800">Thông tin quan trọng</h3>
        </div>

        <!-- Highlight 1 -->
        <div class="p-3.5 rounded-xl bg-orange-50/70 border border-orange-100 text-xs space-y-1">
          <div class="font-bold text-[#F37021] flex items-center gap-1.5">
            <span class="material-symbols-outlined text-[16px]">school</span>
            <span>Chỉ tiêu tuyển sinh</span>
          </div>
          <p class="text-slate-600 leading-relaxed">
            Năm 2026, Trường Đại học Kinh tế tuyển sinh <strong>4.600 chỉ tiêu</strong> cho 31 ngành và chuyên ngành đào tạo.
          </p>
        </div>

        <!-- Highlight 2 -->
        <div class="p-3.5 rounded-xl bg-blue-50/70 border border-blue-100 text-xs space-y-1">
          <div class="font-bold text-[#0072BC] flex items-center gap-1.5">
            <span class="material-symbols-outlined text-[16px]">call</span>
            <span>Liên hệ tư vấn viên</span>
          </div>
          <p class="text-slate-600">
            Hotline: <strong class="text-slate-800">0236 3836 169</strong><br>
            Email: <strong class="text-slate-800">tuyensinh@due.edu.vn</strong><br>
            Địa chỉ: 71 Ngũ Hành Sơn, Đà Nẵng
          </p>
        </div>

        <!-- Link sang trang Tư vấn chọn ngành -->
        <a href="{% url 'admissions:career_advisory' %}" class="mt-2 w-full py-2.5 px-3 rounded-xl bg-slate-100 hover:bg-slate-200 text-xs font-bold text-[#F37021] flex items-center justify-center gap-1.5 transition-colors">
          <span class="material-symbols-outlined text-[16px]">psychology</span>
          <span>Làm trắc nghiệm Holland</span>
        </a>

      </div>

    </div>

  </main>
{% endblock %}

{% block extra_js %}
<script>
    /* ---- Danh sách nguồn tài liệu do Cán bộ tải lên ---- */
    var uploadedSources = [];
    var chatHistory = [];
    var IS_STAFF = Boolean('{% if user.is_staff %}1{% endif %}');
    var CSRF_TOKEN = '{{ csrf_token }}';

    /* ---- Mã phiên chat của người hỏi (để nhận câu trả lời của cán bộ) ---- */
    function storageGet(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }
    function storageSet(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }
    var CLIENT_ID = storageGet('due_chat_client_id');
    if (!CLIENT_ID || !/^[A-Za-z0-9_-]{8,64}$/.test(CLIENT_ID)) {
      CLIENT_ID = 'c' + Date.now().toString(36) + Math.random().toString(36).slice(2, 12);
      storageSet('due_chat_client_id', CLIENT_ID);
    }
    var seenAnswers = {};
    try { seenAnswers = JSON.parse(storageGet('due_chat_seen') || '{}') || {}; } catch (e) { seenAnswers = {}; }
    var pendingCount = 0;
    var pollTimer = null;

    async function pollStaffAnswers() {
      try {
        var res = await fetch('/api/chat/updates/?client_id=' + encodeURIComponent(CLIENT_ID));
        var json = await res.json();
        if (json.status !== 'success') return;
        pendingCount = 0;
        json.data.forEach(function (q) {
          if (q.trang_thai === 'cho') { pendingCount++; return; }
          if (seenAnswers[q.id]) return;
          seenAnswers[q.id] = 1;
          appendMessage('staff', '**Trả lời cho câu hỏi:** "' + q.cau_hoi + '"\n\n' + q.tra_loi);
          chatHistory.push({ role: 'assistant', content: q.tra_loi });
        });
        storageSet('due_chat_seen', JSON.stringify(seenAnswers));
      } catch (e) {}
      schedulePoll();
    }

    function schedulePoll() {
      clearTimeout(pollTimer);
      if (pendingCount > 0) pollTimer = setTimeout(pollStaffAnswers, 5000);
    }

    async function refreshStaffBadge() {
      if (!IS_STAFF) return;
      try {
        var res = await fetch('/api/can-bo/cau-hoi/?trang_thai=cho');
        var json = await res.json();
        var b = document.getElementById('staff-pending-badge');
        if (b && json.status === 'success') {
          b.textContent = json.pending_count + ' chờ';
          b.classList.toggle('hidden', json.pending_count === 0);
        }
      } catch (e) {}
    }

    function escapeHtml(s) {
      return String(s).replace(/[&<>"']/g, function (c) {
        return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
      });
    }

    async function loadSources() {
      var res = await fetch('/api/tailieu/');
      var json = await res.json();
      uploadedSources = json.data.map(function (d) {
        return { id: d.id, name: d.name, size: d.size, date: d.date };
      });
      renderSourcesList();
    }

    async function handleStaffUpload(e) {
      var files = e.target.files;
      if (!files || files.length === 0) return;
      var fd = new FormData();
      for (var i = 0; i < files.length; i++) fd.append('files', files[i]);
      e.target.value = '';

      document.getElementById('sources-count-badge').textContent = 'Đang xử lý...';
      try {
        var res = await fetch('/api/tailieu/upload/', { method: 'POST', body: fd, headers: { 'X-CSRFToken': CSRF_TOKEN } });
        var json = await res.json();
        if (json.status !== 'success') throw new Error(json.message);
        var errs = json.data.filter(function (d) { return d.error; });
        var msg = 'Đã nạp ' + (json.data.length - errs.length) + ' tài liệu vào AI.';
        if (errs.length) msg += '\nLỗi: ' + errs.map(function (d) { return d.name + ' - ' + d.error; }).join('\n');
        alert(msg);
      } catch (err) {
        alert('Tải lên thất bại: ' + err.message);
      }
      loadSources();
    }

    function formatBytes(bytes) {
      if (bytes === 0) return '0 B';
      var k = 1024;
      var sizes = ['B', 'KB', 'MB', 'GB'];
      var i = Math.floor(Math.log(bytes) / Math.log(k));
      return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
    }

    async function removeSource(id) {
      if (!confirm('Xóa tài liệu này khỏi cơ sở tri thức?')) return;
      await fetch('/api/tailieu/' + id + '/delete/', { method: 'POST', headers: { 'X-CSRFToken': CSRF_TOKEN } });
      loadSources();
    }

    /* ---- Chat gọi API RAG ---- */
    async function handleChatSubmit(e) {
      e.preventDefault();
      var input = document.getElementById('chat-input');
      var query = input.value.trim();
      if (!query) return;
      input.value = '';

      var sug = document.getElementById('suggestions-block');
      if (sug) sug.style.display = 'none';

      appendMessage('user', query);
      var typingId = appendTypingIndicator();

      try {
        var res = await fetch('/api/chat/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ message: query, history: chatHistory, client_id: CLIENT_ID })
        });
        var json = await res.json();
        removeTypingIndicator(typingId);
        if (res.status === 429) {
          appendMessage('assistant', '⚠️ Bạn đang gửi quá nhanh, vui lòng chờ khoảng 1 phút rồi hỏi tiếp nhé.');
          return;
        }
        if (json.status !== 'success') {
          appendMessage('assistant', '⚠️ ' + (json.message || 'Có lỗi xảy ra'));
          return;
        }
        var text = json.reply;
        if (json.sources && json.sources.length) {
          text += '\n\n**Nguồn tham khảo:** ' + json.sources.join(', ');
        }
        appendMessage(json.handoff ? 'handoff' : 'assistant', text);
        chatHistory.push({ role: 'user', content: query });
        if (!json.handoff) chatHistory.push({ role: 'assistant', content: json.reply });
        if (json.handoff) { pendingCount++; schedulePoll(); refreshStaffBadge(); }
      } catch (err) {
        removeTypingIndicator(typingId);
        appendMessage('assistant', '⚠️ Không kết nối được máy chủ.');
      }
    }

    document.addEventListener('DOMContentLoaded', function () {
      loadSources();
      pollStaffAnswers();   // nhận câu trả lời cán bộ gửi khi người hỏi đã rời trang
      refreshStaffBadge();
    });

    function renderSourcesList() {
      var listEl = document.getElementById('sources-list');
      var emptyEl = document.getElementById('sources-empty-state');
      var countBadge = document.getElementById('sources-count-badge');
      var topIndicator = document.getElementById('active-source-indicator');

      var total = uploadedSources.length;
      countBadge.textContent = total + ' tệp';
      topIndicator.textContent = total;

      if (total === 0) {
        emptyEl.classList.remove('hidden');
        listEl.classList.add('hidden');
        listEl.innerHTML = '';
        return;
      }

      emptyEl.classList.add('hidden');
      listEl.classList.remove('hidden');

      var html = '';
      uploadedSources.forEach(function(src) {
        html += '<div class="p-2.5 rounded-xl bg-slate-50 border border-slate-200 flex items-center justify-between gap-2 text-xs group">' +
                  '<div class="flex items-center gap-2 min-w-0 flex-1">' +
                    '<span class="material-symbols-outlined text-[18px] text-[#0072BC] flex-shrink-0">article</span>' +
                    '<div class="min-w-0 flex-1">' +
                      '<p class="font-semibold text-slate-800 truncate" title="' + escapeHtml(src.name) + '">' + escapeHtml(src.name) + '</p>' +
                      '<p class="text-[10px] text-slate-400">' + src.size + ' • Lúc ' + src.date + '</p>' +
                    '</div>' +
                  '</div>' +
                  (IS_STAFF ?
                  '<button onclick="removeSource(\'' + src.id + '\')" class="w-6 h-6 rounded-md hover:bg-red-50 text-slate-400 hover:text-red-500 flex items-center justify-center transition-colors flex-shrink-0" title="Xóa tài liệu">' +
                    '<span class="material-symbols-outlined text-[16px]">delete</span>' +
                  '</button>' : '') +
                '</div>';
      });

      listEl.innerHTML = html;
    }

    

    function handleKey(e) {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        handleChatSubmit(e);
      }
    }

    function askPreset(q) {
      document.getElementById('chat-input').value = q;
      handleChatSubmit(new Event('submit'));
    }


    function appendMessage(sender, text) {
      var list = document.getElementById('messages-list');
      var msgDiv = document.createElement('div');
      msgDiv.className = 'flex items-start gap-3 ' + (sender === 'user' ? 'justify-end' : 'justify-start');

      var formatted = escapeHtml(text).replace(/\n/g, '<br>').replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');

      if (sender === 'user') {
        msgDiv.innerHTML = '<div class="max-w-[85%] rounded-2xl p-3.5 bg-[#0072BC] text-white text-xs sm:text-sm shadow-sm">' +
                           formatted + '</div>' +
                           '<div class="w-7 h-7 rounded-full bg-slate-300 flex items-center justify-center text-xs font-bold text-slate-700 flex-shrink-0">Tôi</div>';
      } else if (sender === 'staff' || sender === 'handoff') {
        var isStaff = sender === 'staff';
        msgDiv.innerHTML = '<div class="w-7 h-7 rounded-full ' + (isStaff ? 'bg-[#00A859]' : 'bg-[#F37021]') + ' flex items-center justify-center text-white text-xs flex-shrink-0 shadow-sm">' +
                           '<span class="material-symbols-outlined text-[16px]">' + (isStaff ? 'support_agent' : 'forward_to_inbox') + '</span></div>' +
                           '<div class="max-w-[88%] rounded-2xl p-4 ' + (isStaff ? 'bg-emerald-50 border-emerald-200' : 'bg-orange-50 border-orange-200') + ' border text-slate-800 text-xs sm:text-sm shadow-sm leading-relaxed">' +
                           '<div class="flex items-center gap-1.5 mb-1.5 text-xs font-semibold ' + (isStaff ? 'text-[#00A859]' : 'text-[#F37021]') + '">' +
                           (isStaff ? 'Cán bộ tuyển sinh DUE' : 'Đã chuyển cho cán bộ tuyển sinh') +
                           '</div>' + formatted + '</div>';
      } else {
        msgDiv.innerHTML = '<div class="w-7 h-7 rounded-full bg-gradient-to-tr from-[#F37021] to-[#0072BC] flex items-center justify-center text-white text-xs flex-shrink-0 shadow-sm">' +
                           '<span class="material-symbols-outlined text-[16px]">smart_toy</span></div>' +
                           '<div class="max-w-[88%] rounded-2xl p-4 bg-slate-50 border border-slate-200 text-slate-800 text-xs sm:text-sm shadow-sm leading-relaxed">' +
                           '<div class="flex items-center gap-1.5 mb-1.5 text-xs text-slate-400 font-semibold">' +
                           '<span class="text-[#0072BC]">AI DUE Assistant</span>' +
                           '<span>•</span>' +
                           '<span>Xác thực</span>' +
                           '</div>' +
                           formatted + '</div>';
      }

      list.appendChild(msgDiv);
      scrollToBottom();
    }

    function appendTypingIndicator() {
      var list = document.getElementById('messages-list');
      var id = 'typing-' + Date.now();
      var div = document.createElement('div');
      div.id = id;
      div.className = 'flex items-center gap-2.5 justify-start';
      div.innerHTML = '<div class="w-7 h-7 rounded-full bg-gradient-to-tr from-[#F37021] to-[#0072BC] flex items-center justify-center text-white text-xs flex-shrink-0">' +
                      '<span class="material-symbols-outlined text-[16px]">smart_toy</span></div>' +
                      '<div class="rounded-xl px-3 py-2 bg-slate-100 border border-slate-200 flex items-center gap-1.5">' +
                      '<span class="typing-dot"></span><span class="typing-dot"></span><span class="typing-dot"></span>' +
                      '</div>';
      list.appendChild(div);
      scrollToBottom();
      return id;
    }

    function removeTypingIndicator(id) {
      var el = document.getElementById(id);
      if (el) el.remove();
    }

    function scrollToBottom() {
      var container = document.getElementById('chat-messages-container');
      container.scrollTop = container.scrollHeight;
    }

    function newChat() {
      document.getElementById('messages-list').innerHTML = '';
      chatHistory = [];
      var suggestions = document.getElementById('suggestions-block');
      if (suggestions) suggestions.style.display = 'block';
    }

    /* ---- Dropdown Header & Modal logic ---- */
    (function () {
      var btn      = document.getElementById('nav-ttts-btn');
      var dropdown = document.getElementById('nav-ttts-dropdown');
      var chevron  = document.getElementById('nav-ttts-chevron');
      var isOpen   = false;

      function positionDropdown() {
        var rect = btn.getBoundingClientRect();
        dropdown.style.top  = (rect.bottom + 6) + 'px';
        dropdown.style.left = rect.left + 'px';
      }

      function openDropdown() {
        positionDropdown();
        isOpen = true;
        dropdown.style.display = 'block';
        chevron.style.transform = 'rotate(180deg)';
        btn.setAttribute('aria-expanded', 'true');
      }
      function closeDropdown() {
        isOpen = false;
        dropdown.style.display = 'none';
        chevron.style.transform = '';
        btn.setAttribute('aria-expanded', 'false');
      }

      btn.addEventListener('click', function (e) {
        e.stopPropagation();
        isOpen ? closeDropdown() : openDropdown();
      });
      document.addEventListener('click', function (e) {
        if (!dropdown.contains(e.target) && e.target !== btn) closeDropdown();
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeDropdown();
      });
    })();

        /* ---- Modal 1: Hướng dẫn nhập học ---- */
    var _hdBackdrop = document.getElementById('huong-dan-modal-backdrop');
    var _hdModal    = document.getElementById('huong-dan-modal');

    function openHuongDanModal() {
      document.getElementById('nav-ttts-dropdown').style.display = 'none';
      _hdBackdrop.style.display = 'flex';
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          _hdModal.style.opacity   = '1';
          _hdModal.style.transform = 'scale(1) translateY(0)';
        });
      });
    }

    function closeHuongDanModal() {
      _hdModal.style.opacity   = '0';
      _hdModal.style.transform = 'scale(0.97) translateY(12px)';
      setTimeout(function () {
        _hdBackdrop.style.display = 'none';
        document.body.style.overflow = '';
      }, 220);
    }

    if (_hdBackdrop) {
      _hdBackdrop.addEventListener('click', function (e) {
        if (e.target === _hdBackdrop) closeHuongDanModal();
      });
    }

    /* ---- Modal 2: Lịch trình của Tân sinh viên ---- */
    var _ltBackdrop = document.getElementById('lich-trinh-modal-backdrop');
    var _ltModal    = document.getElementById('lich-trinh-modal');

    function openLichTrinhModal() {
      document.getElementById('nav-ttts-dropdown').style.display = 'none';
      _ltBackdrop.style.display = 'flex';
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          _ltModal.style.opacity   = '1';
          _ltModal.style.transform = 'scale(1) translateY(0)';
        });
      });
    }

    function closeLichTrinhModal() {
      _ltModal.style.opacity   = '0';
      _ltModal.style.transform = 'scale(0.97) translateY(12px)';
      setTimeout(function () {
        _ltBackdrop.style.display = 'none';
        document.body.style.overflow = '';
      }, 220);
    }

    if (_ltBackdrop) {
      _ltBackdrop.addEventListener('click', function (e) {
        if (e.target === _ltBackdrop) closeLichTrinhModal();
      });
    }

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        if (_hdBackdrop && _hdBackdrop.style.display === 'flex') closeHuongDanModal();
        if (_ltBackdrop && _ltBackdrop.style.display === 'flex') closeLichTrinhModal();
      }
    });

    </script>
{% endblock %}


--- FILE: CongthongtintuyensinhDUE/templates/admissions/history.html ---
{% extends 'layouts/base.html' %}
{% load static %}

{% block title %}Lịch Sử Phát Triển - Trường Đại học Kinh tế, ĐH Đà Nẵng (DUE){% endblock %}

{% block content %}
<!-- Main Content -->
  <main class="w-full pt-32 sm:pt-36 pb-6 bg-surface min-h-[calc(100vh-28rem)] flex-1">
    <!-- Top Ambient Background Glows -->
    <div class="relative w-full overflow-hidden pb-4">
      <div class="absolute -top-40 right-1/4 w-[500px] h-[500px] rounded-full bg-secondary-container/10 blur-[130px] pointer-events-none"></div>
      <div class="absolute top-20 -left-20 w-[420px] h-[420px] rounded-full bg-primary-container/5 blur-[120px] pointer-events-none"></div>

      <!-- Banner Header Section -->
      <section class="max-w-7xl mx-auto px-6 lg:px-12 pt-8 pb-12">
        <!-- Breadcrumb -->
        <nav class="flex items-center gap-2 text-xs sm:text-sm text-on-surface-variant mb-6 font-medium">
          <a href="/" class="hover:text-primary-container transition-colors">Trang chủ</a>
          <span class="material-symbols-outlined text-[14px]">chevron_right</span>
          <span>Giới thiệu</span>
          <span class="material-symbols-outlined text-[14px]">chevron_right</span>
          <span class="text-secondary-container font-semibold">Lịch sử phát triển</span>
        </nav>

        <div class="border-b border-outline-variant/30 pb-8 text-center flex flex-col items-center">
          <h1 class="font-display-hero text-3xl sm:text-4xl lg:text-5xl font-bold text-on-surface tracking-tight">
            Lịch sử hình thành và phát triển
          </h1>
          <p class="text-on-surface-variant text-base sm:text-lg max-w-2xl mt-3 leading-relaxed mx-auto">
            Trường Đại học Kinh tế - Đại học Đà Nẵng (DUE): Hành trình 50 năm từ Khoa Kinh tế đầu tiên đến trung tâm đào tạo, nghiên cứu khoa học kinh tế hàng đầu cả nước.
          </p>
        </div>
      </section>

      <!-- Section: Chuyến tàu ký ức 50 năm DUE (Sử dụng ảnh cổng chào 50 năm) -->
      <section class="max-w-7xl mx-auto px-6 lg:px-12 py-6">
        <div class="relative rounded-3xl overflow-hidden bg-surface-container-lowest border border-outline-variant/30 shadow-lg">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-0">
            <!-- Cột hình ảnh 1: Cổng chào 50 năm -->
            <div class="lg:col-span-7 relative h-[360px] sm:h-[440px] overflow-hidden group">
              <img class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700" 
                   src="{% static 'images/history_50nam.png' %}" 
                   alt="Kỷ niệm 50 năm xây dựng và phát triển Trường Đại học Kinh tế - Đại học Đà Nẵng">
              <div class="absolute inset-0 bg-gradient-to-t from-primary/75 via-transparent to-transparent"></div>
              <div class="absolute bottom-6 left-6 right-6 text-white">
                <span class="inline-block px-3 py-1 rounded-full bg-secondary-container text-white text-xs font-bold uppercase mb-2">Chuyến tàu ký ức 50 DUE</span>
                <p class="text-xl sm:text-2xl font-bold font-headline-sm">Kỷ niệm 50 năm Xây dựng và Phát triển (1975 - 2025)</p>
                <p class="text-xs sm:text-sm text-white/80 mt-1">Cổng chính 71 Ngũ Hành Sơn - Nơi lưu dấu biết bao thế hệ sinh viên, giảng viên</p>
              </div>
            </div>

            <!-- Cột văn bản tóm tắt cột mốc -->
            <div class="lg:col-span-5 p-8 lg:p-10 flex flex-col justify-between bg-surface-container-low/40">
              <div>
                <span class="text-xs uppercase tracking-wider font-bold text-secondary-container block mb-2">Khát vọng vươn tầm</span>
                <h2 class="text-2xl font-bold font-headline-sm text-on-surface mb-4 leading-snug">Vị Thế Trường Đại Học Trọng Điểm Quốc Gia</h2>
                <p class="text-on-surface-variant text-sm leading-relaxed mb-4">
                  Trải qua nửa thế kỷ bền bỉ phấn đấu, Trường Đại học Kinh tế – Đại học Đà Nẵng không ngừng đổi mới chương trình đào tạo, đạt chuẩn kiểm định quốc tế AUN-QA và vươn lên thành trường đại học nghiên cứu hàng đầu khu vực miền Trung - Tây Nguyên.
                </p>
                <div class="space-y-3 pt-2">
                  <div class="flex items-start gap-3">
                    <span class="w-6 h-6 rounded-full bg-primary-fixed text-primary-container flex items-center justify-center shrink-0 mt-0.5">
                      <span class="material-symbols-outlined text-[16px]">check</span>
                    </span>
                    <span class="text-xs sm:text-sm text-on-surface font-medium">Hơn 70.000 cử nhân, thạc sĩ, tiến sĩ đã tốt nghiệp và cống hiến cho đất nước.</span>
                  </div>
                  <div class="flex items-start gap-3">
                    <span class="w-6 h-6 rounded-full bg-secondary-fixed text-secondary-container flex items-center justify-center shrink-0 mt-0.5">
                      <span class="material-symbols-outlined text-[16px]">check</span>
                    </span>
                    <span class="text-xs sm:text-sm text-on-surface font-medium">Tiên phong chuyển đổi số trong giáo dục và kiểm định chất lượng đào tạo quốc tế.</span>
                  </div>
                </div>
              </div>

              <div class="pt-6 border-t border-outline-variant/30 flex items-center justify-between text-xs text-on-surface-variant">
                <span>Since 1975</span>
                <span class="font-bold text-primary-container">Đại học Đà Nẵng</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Section: Timeline Tiến trình Lịch sử 4 Giai đoạn -->
      <section class="max-w-7xl mx-auto px-6 lg:px-12 py-12">
        <div class="text-center max-w-3xl mx-auto mb-14">
          <span class="text-xs uppercase tracking-wider font-bold text-secondary-container block mb-2">Dấu ấn thời gian</span>
          <h2 class="font-headline-lg text-2xl sm:text-3xl lg:text-4xl font-bold text-on-surface tracking-tight">Các Giai Đoạn Phát Triển Trọng Đại</h2>
          <p class="text-on-surface-variant text-sm sm:text-base mt-2">Theo tiến trình lịch sử chính thức được công bố trên cổng thông tin due.udn.vn</p>
        </div>

        <div class="relative border-l-2 border-primary-container/20 ml-4 md:ml-32 space-y-12">
          
          <!-- Mốc 1: 1975 - 1985 (Có ảnh tòa nhà truyền thống) -->
          <div class="relative pl-8 md:pl-12 group">
            <!-- Timeline dot -->
            <div class="absolute -left-[17px] top-1.5 w-8 h-8 rounded-full bg-primary-container text-white flex items-center justify-center shadow-md font-bold text-xs ring-4 ring-surface">
              1
            </div>

            <div class="bg-surface-container-lowest rounded-3xl p-6 sm:p-8 border border-outline-variant/30 shadow-sm hover:shadow-xl transition-all">
              <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                <span class="px-3 py-1 rounded-full bg-primary-fixed text-primary-container font-bold text-xs">
                  Tháng 10/1975 – Tháng 12/1985
                </span>
                <span class="text-xs text-outline font-semibold">Giai đoạn hình thành nền móng</span>
              </div>
              
              <h3 class="text-xl sm:text-2xl font-bold text-on-surface mb-3 group-hover:text-primary-container transition-colors">
                Thành lập Khoa Kinh tế - Viện Đại học Đà Nẵng / Đại học Bách khoa Đà Nẵng
              </h3>

              <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
                <div class="md:col-span-7">
                  <p class="text-on-surface-variant text-sm leading-relaxed mb-4">
                    Tháng 10 năm 1975, ngay sau ngày đất nước thống nhất, Khoa Kinh tế chính thức được thành lập và tiến hành chiêu sinh khóa đào tạo đại học chính quy đầu tiên. Đây là cái nôi đầu tiên đào tạo cán bộ quản lý kinh tế cho toàn bộ dải đất miền Trung và Tây Nguyên.
                  </p>
                  <p class="text-on-surface-variant text-sm leading-relaxed">
                    Trong giai đoạn đầu này, Khoa đảm nhiệm đào tạo 6 chuyên ngành chủ lực phục vụ tái thiết đất nước: <strong>Kế hoạch hóa Kinh tế Quốc dân, Kinh tế Công nghiệp, Kinh tế Nông nghiệp, Kinh tế Thương nghiệp, Thống kê và Kế toán</strong>.
                  </p>
                </div>

                <!-- Cột ảnh 2: Tòa nhà cổ kính truyền thống của trường -->
                <div class="md:col-span-5 flex justify-center">
                  <div class="rounded-2xl overflow-hidden border border-outline-variant/40 shadow-md bg-surface-container-low max-w-[280px]">
                    <img class="w-full h-auto object-contain hover:scale-105 transition-transform duration-500" 
                         src="{% static 'images/history_cu.png' %}" 
                         alt="Tòa nhà giảng đường Khoa Kinh tế - Trường Đại học Kinh tế giai đoạn đầu">
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Mốc 2: 1985 - 1988 -->
          <div class="relative pl-8 md:pl-12 group">
            <div class="absolute -left-[17px] top-1.5 w-8 h-8 rounded-full bg-secondary-container text-white flex items-center justify-center shadow-md font-bold text-xs ring-4 ring-surface">
              2
            </div>

            <div class="bg-surface-container-lowest rounded-3xl p-6 sm:p-8 border border-outline-variant/30 shadow-sm hover:shadow-xl transition-all">
              <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                <span class="px-3 py-1 rounded-full bg-secondary-fixed text-on-secondary-fixed-variant font-bold text-xs">
                  Tháng 12/1985 – Tháng 10/1988
                </span>
                <span class="text-xs text-outline font-semibold">Tách lập và mở rộng cơ sở</span>
              </div>
              
              <h3 class="text-xl sm:text-2xl font-bold text-on-surface mb-3 group-hover:text-primary-container transition-colors">
                Giai đoạn phân hiệu Đại học Kinh tế Đà Nẵng
              </h3>

              <p class="text-on-surface-variant text-sm leading-relaxed mb-4">
                Tháng 12/1985, khối ngành Kinh tế được tách ra để thành lập <strong>phân hiệu Đại học Kinh tế Đà Nẵng</strong> đặt tại cơ sở Bắc Mỹ An (nay là số 71 Ngũ Hành Sơn). Phân hiệu thời điểm đó tổ chức gồm 3 khoa đào tạo chuyên sâu:
              </p>

              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <div class="p-3.5 rounded-2xl bg-surface-container-low border border-outline-variant/30 text-center">
                  <span class="material-symbols-outlined text-primary-container text-[22px] mb-1">storefront</span>
                  <p class="text-xs font-bold text-on-surface">Khoa Công Thương</p>
                </div>
                <div class="p-3.5 rounded-2xl bg-surface-container-low border border-outline-variant/30 text-center">
                  <span class="material-symbols-outlined text-secondary-container text-[22px] mb-1">query_stats</span>
                  <p class="text-xs font-bold text-on-surface">Khoa Thống kê - Kế toán - Tài chính</p>
                </div>
                <div class="p-3.5 rounded-2xl bg-surface-container-low border border-outline-variant/30 text-center">
                  <span class="material-symbols-outlined text-primary-container text-[22px] mb-1">school</span>
                  <p class="text-xs font-bold text-on-surface">Khoa Tại chức</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Mốc 3: 1988 - 1994 -->
          <div class="relative pl-8 md:pl-12 group">
            <div class="absolute -left-[17px] top-1.5 w-8 h-8 rounded-full bg-primary-container text-white flex items-center justify-center shadow-md font-bold text-xs ring-4 ring-surface">
              3
            </div>

            <div class="bg-surface-container-lowest rounded-3xl p-6 sm:p-8 border border-outline-variant/30 shadow-sm hover:shadow-xl transition-all">
              <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                <span class="px-3 py-1 rounded-full bg-primary-fixed text-primary-container font-bold text-xs">
                  Tháng 10/1988 – Tháng 04/1994
                </span>
                <span class="text-xs text-outline font-semibold">Tích hợp và chuẩn bị mô hình đại học vùng</span>
              </div>
              
              <h3 class="text-xl sm:text-2xl font-bold text-on-surface mb-3 group-hover:text-primary-container transition-colors">
                Tái sáp nhập và củng cố chất lượng chuyên môn
              </h3>

              <p class="text-on-surface-variant text-sm leading-relaxed">
                Đến tháng 10 năm 1988, thực hiện chủ trương tinh gọn bộ máy, phân hiệu sáp nhập trở lại Trường Đại học Bách khoa Đà Nẵng nhưng vẫn giữ vững nhiệm vụ cốt lõi: đào tạo và bồi dưỡng đội ngũ chuyên gia kinh tế, chuẩn bị mọi tiền đề vững chắc cho việc thành lập một trường đại học kinh tế chuyên nghiệp quy mô vùng.
              </p>
            </div>
          </div>

          <!-- Mốc 4: 1994 đến nay (Có ảnh Welcome to DUE và giảng viên sinh viên) -->
          <div class="relative pl-8 md:pl-12 group">
            <div class="absolute -left-[17px] top-1.5 w-8 h-8 rounded-full bg-secondary-container text-white flex items-center justify-center shadow-md font-bold text-xs ring-4 ring-surface">
              4
            </div>

            <div class="bg-surface-container-lowest rounded-3xl p-6 sm:p-8 border border-outline-variant/30 shadow-sm hover:shadow-xl transition-all">
              <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                <span class="px-3 py-1 rounded-full bg-secondary-fixed text-on-secondary-fixed-variant font-bold text-xs">
                  Tháng 04/1994 – Nay
                </span>
                <span class="text-xs text-outline font-semibold">Hội nhập quốc tế và đột phá toàn diện</span>
              </div>
              
              <h3 class="text-xl sm:text-2xl font-bold text-on-surface mb-3 group-hover:text-primary-container transition-colors">
                Trường Đại học Kinh tế - Thành viên chủ lực Đại học Đà Nẵng
              </h3>

              <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
                <div class="md:col-span-7">
                  <p class="text-on-surface-variant text-sm leading-relaxed mb-4">
                    Ngày 04/04/1994, Chính phủ ban hành Nghị định số 32/CP thành lập Đại học Đà Nẵng. Trên cơ sở đó, <strong>Trường Đại học Kinh tế</strong> chính thức trở thành trường đại học thành viên độc lập, giữ vai trò lá cờ đầu về đào tạo cử nhân, thạc sĩ, tiến sĩ ngành kinh tế, kinh doanh và quản lý.
                  </p>
                  <p class="text-on-surface-variant text-sm leading-relaxed">
                    Hiện nay, DUE sở hữu khuôn viên xanh hiện đại, hơn 30 chuyên ngành đào tạo đón đầu kỷ nguyên kinh tế số, đạt chuẩn kiểm định AUN-QA và có quan hệ hợp tác học thuật với hàng trăm trường đại học uy tín trên toàn cầu.
                  </p>
                </div>

                <!-- Cột ảnh 3: Sinh viên và giảng viên trước chữ WELCOME TO DUE -->
                <div class="md:col-span-5">
                  <div class="rounded-2xl overflow-hidden border border-outline-variant/40 shadow-md bg-surface-container-low">
                    <img class="w-full h-auto object-cover hover:scale-105 transition-transform duration-500" 
                         src="{% static 'images/history_welcome.png' %}" 
                         alt="Tập thể giảng viên và sinh viên Trường Đại học Kinh tế - DUE">
                  </div>
                </div>
              </div>
            </div>
          </div>

        </div>
      </section>

    </div>
  </main>

  <!-- Footer -->
{% endblock %}


