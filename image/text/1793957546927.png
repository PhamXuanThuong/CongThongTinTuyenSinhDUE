      {
        "name": "Ban Sự kiện và hậu cần",
        "desc": "Chuẩn bị sân khấu, âm thanh, ánh sáng, bán vé và điều phối các đêm Minishow thường niên."
      },
      {
        "name": "Ban Truyền thông và media",
        "desc": "Quay dựng các bản cover acoustic, sản xuất video ca nhạc và quản lý Fanpage 10K theo dõi."
