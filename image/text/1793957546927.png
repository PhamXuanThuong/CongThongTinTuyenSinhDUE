            <!-- PT4 -->
            <a href="/phuong-thuc-xet-tuyen/#pt4" class="group relative bg-surface-container-lowest rounded-3xl p-6 shadow-sm hover:shadow-xl transition-all duration-300 border border-amber-200/70 flex flex-col justify-between hover:-translate-y-1 cursor-pointer block text-left">
              <div class="absolute top-0 left-0 right-0 h-2 bg-amber-500 rounded-t-3xl"></div>
              <div>
                <div class="flex items-center justify-between mb-4 mt-1">
                  <span class="inline-block px-3 py-1 rounded-full bg-amber-100 text-amber-800 text-xs font-bold">PT 4</span>
                  <span class="w-10 h-10 rounded-2xl bg-amber-50 text-amber-700 flex items-center justify-center font-bold">
                    <span class="material-symbols-outlined">psychology</span>
                  </span>
                </div>
                <h3 class="text-base font-bold text-on-surface mb-2 group-hover:text-amber-700 transition-colors">ĐGNL ĐHQG-HCM 2026</h3>
                <p class="text-xs text-on-surface-variant leading-relaxed mb-4">
                  Xét tuyển dựa trên kết quả bài thi Đánh giá năng lực của ĐHQG TP. Hồ Chí Minh năm 2026 quy đổi sang thang 30.
                </p>
              </div>
              <div class="pt-3 border-t border-slate-100 flex items-center justify-between">
                <div class="flex items-center gap-1.5 text-xs font-semibold text-amber-700">
                  <span class="material-symbols-outlined text-[16px]">check_circle</span>
                  <span>Chương trình Tiêu chuẩn</span>
                </div>
                <span class="material-symbols-outlined text-amber-600 text-[18px] opacity-70 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all">arrow_forward</span>
              </div>
            </a>
          </div>
        </section>

        <!-- 4. BẢNG TIN TUYỂN SINH và SỰ KIỆN NỔI BẬT -->
                <!-- SECTION: CÁC KHOA ĐÀO TẠO TIÊU BIỂU (CƠ CẤU 2026) -->
        <section class="max-w-7xl mx-auto px-6 lg:px-12 py-10">
          <div class="bg-gradient-to-br from-slate-50 to-white rounded-3xl p-6 sm:p-10 border border-slate-200/80 shadow-sm">
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
              <div>
                <span class="font-label-md text-label-md text-secondary-container uppercase tracking-wider block mb-1 font-bold">Chuyên môn và đào tạo</span>
                <h2 class="font-headline-lg text-2xl sm:text-3xl font-bold text-slate-800 tracking-tight flex items-center gap-2">
                  <span class="material-symbols-outlined text-primary-container text-[28px]">account_balance</span>
                  Hệ Thống Khoa và viện Đào Tạo DUE 2026
                </h2>
                <p class="text-slate-600 text-sm mt-1">8 khoa chuyên môn và Viện Đào tạo Quốc tế đào tạo chuẩn quốc tế AUN-QA, tích hợp công nghệ số và liên kết quốc tế.</p>
