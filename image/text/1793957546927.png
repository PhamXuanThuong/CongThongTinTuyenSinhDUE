                "nam_hoc_3": 75.00,
                "nam_hoc_4": 80.00,
                "order": 2
            },
            {
                "nhom": "Cử nhân chính quy, Toàn phần tiếng Anh",
                "slug": "toan-phan-ta",
                "nam_hoc_1": 43.00,
                "nam_hoc_2": 47.00,
                "nam_hoc_3": 51.00,
                "nam_hoc_4": 55.00,
                "order": 3
            },
            {
