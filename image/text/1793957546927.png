  {
   "id": "see-club",
   "name": "SEE CLUB – Speak English Easily",
   "level": "Trường (trực thuộc Hội SV)",
   "faculty_id": null,
   "category": "Ngoại ngữ – Tiếng Anh",
   "founded": null,
   "description": "CLB tiếng Anh duy nhất trực thuộc Hội Sinh viên DUE; môi trường học, trải nghiệm, kết nối, giao lưu văn hóa qua tiếng Anh.",
   "slogan": "SEE The World, Speak Your Word",
   "leaders": null,
   "advisors": null,
   "achievements": [],
   "recruitment": "Tuyển hằng năm vào khoảng tháng 8–9: nộp đơn online → Vòng 1 làm bài test online → Vòng 2 hoạt động nhóm và phỏng vấn cá nhân.",
   "followers": "20K",
   "contact": {
    "facebook": "https://www.facebook.com/seeclub",
    "email": "seeclub.due@gmail.com",
    "phone": "0969 200 206 (Ms. Châu An); 0848 187 246 (Ms. Yến Nhi)"
   },
   "note": null,
   "sources": [
    "https://www.facebook.com/seeclub",
    "https://due.udn.vn/vi-vn/tuvantuyensinh2026/gt/cid/6039"
   ],
   "source_type": "facebook_fanpage_2026-10-29",
   "logo": "assets/img/clb/see-club-logo.jpg",
   "cover": "assets/img/clb/see-club-cover.jpg",
   "updated": "2026-10-31",
   "intro": "SEE CLUB (Speak English Easily) là câu lạc bộ tiếng Anh duy nhất trực thuộc Hội Sinh viên Trường Đại học Kinh tế – ĐHĐN. CLB là môi trường để sinh viên học và thực hành tiếng Anh, giao lưu văn hóa, kết nối và trưởng thành; các bài đăng của CLB thường song ngữ Việt – Anh. Thông điệp tuyển thành viên 2026: “SEE The World, Speak Your Word” – chỉ cần sự tò mò, nhiệt huyết và mong muốn bước ra khỏi vùng an toàn.",
   "highlights": [
    "Sinh hoạt, thực hành giao tiếp tiếng Anh",
