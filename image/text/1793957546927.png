{% extends 'layouts/base.html' %}
{% load static %}

{% block title %}Điểm Chuẩn Các Năm - Trường Đại học Kinh tế, ĐH Đà Nẵng (DUE){% endblock %}

{% block extra_head %}
<style>
.tab-btn.active {
  background-color: #003366;
  color: #ffffff;
  border-color: #003366;
  box-shadow: 0 4px 14px 0 rgba(0, 51, 102, 0.25);
}
</style>
{% endblock %}

{% block content %}
<!-- Main Content -->
  <main class="w-full pt-32 sm:pt-36 pb-6 bg-surface min-h-[calc(100vh-28rem)] flex-1">
    <!-- Top Glows -->
    <div class="relative w-full overflow-hidden">
      <div class="absolute -top-40 right-1/4 w-[550px] h-[550px] rounded-full bg-secondary-container/10 blur-[130px] pointer-events-none"></div>
      <div class="absolute top-20 -left-20 w-[450px] h-[450px] rounded-full bg-primary-container/10 blur-[120px] pointer-events-none"></div>

      <!-- Breadcrumbs -->
      <div class="max-w-7xl mx-auto px-6 lg:px-12 pt-8 pb-4">
        <nav class="flex items-center gap-2 text-xs sm:text-sm text-on-surface-variant mb-6 font-medium">
          <a href="/" class="hover:text-primary-container transition-colors">Trang chủ</a>
          <span class="material-symbols-outlined text-xs">chevron_right</span>
          <span class="text-on-surface-variant">Thông tin tuyển sinh</span>
          <span class="material-symbols-outlined text-xs">chevron_right</span>
          <span class="text-secondary-container font-semibold">Điểm chuẩn các năm</span>
        </nav>
      </div>

      <!-- HERO BANNER -->
      <section class="max-w-7xl mx-auto px-6 lg:px-12 pt-6 pb-8">
        <div class="relative rounded-3xl overflow-hidden p-8 sm:p-12 bg-gradient-to-br from-[#002244] via-[#003366] to-[#0d4f91] text-white shadow-2xl border border-white/10">
          <div class="absolute top-0 right-0 -mt-10 -mr-10 w-96 h-96 rounded-full bg-secondary-container/20 blur-3xl pointer-events-none"></div>
          
          <div class="relative z-10 max-w-3xl">
            <h1 class="font-display-hero text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight leading-tight text-white mb-4">
              Điểm Chuẩn <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-400 via-amber-300 to-yellow-200">Các Năm</span>
            </h1>
            
            <p class="font-body-md text-base sm:text-lg text-slate-200 leading-relaxed mb-6">
              Tra cứu nhanh điểm trúng tuyển Đại học Chính quy Trường Đại học Kinh tế – Đại học Đà Nẵng qua các năm <strong>2025, 2024, 2023, 2022</strong>. Hỗ trợ thí sinh định hướng ngành nghề và lựa chọn nguyện vọng tối ưu nhất.
            </p>

            <!-- Quick Stat Highlights -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-4 border-t border-white/15">
              <div>
                <p class="text-xs text-slate-300 uppercase font-medium">Ngành top đầu</p>
                <p class="text-xl sm:text-2xl font-bold text-amber-300 font-display-hero">26.5 – 27.0</p>
                <p class="text-[11px] text-slate-300">Kinh doanh QT, Marketing</p>
              </div>
              <div>
                <p class="text-xs text-slate-300 uppercase font-medium">Khoảng điểm phổ biến</p>
                <p class="text-xl sm:text-2xl font-bold text-white font-display-hero">23.0 – 25.5</p>
                <p class="text-[11px] text-slate-300">Các ngành kinh tế, tài chính</p>
              </div>
              <div>
                <p class="text-xs text-slate-300 uppercase font-medium">Dữ liệu tra cứu</p>
                <p class="text-xl sm:text-2xl font-bold text-white font-display-hero">4 Năm</p>
                <p class="text-[11px] text-slate-300">Từ 2022 đến 2025</p>
              </div>
              <div>
                <p class="text-xs text-slate-300 uppercase font-medium">Mã xét tuyển</p>
                <p class="text-xl sm:text-2xl font-bold text-secondary-container font-display-hero">DDQ</p>
                <p class="text-[11px] text-slate-300">Mã trường ĐH Kinh tế ĐHĐN</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- BỘ LỌC VÀ CHUYỂN TAB CÁC NĂM -->
      <section class="max-w-7xl mx-auto px-6 lg:px-12 py-6">
        <div class="bg-surface-container-lowest rounded-3xl p-6 shadow-sm border border-outline-variant/40">
          <div class="flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-4">
            
            <!-- Tabs Năm -->
            <div class="flex flex-wrap items-center gap-2 pb-2 lg:pb-0" id="yearTabs">
              <button onclick="switchYear('2025')" id="tab-2025" class="tab-btn active px-5 py-2.5 rounded-2xl text-sm font-bold border border-slate-200 transition-all cursor-pointer whitespace-nowrap">
                Năm 2025
              </button>
              <button onclick="switchYear('2024')" id="tab-2024" class="tab-btn px-5 py-2.5 rounded-2xl text-sm font-bold border border-slate-200 text-slate-700 hover:bg-slate-50 transition-all cursor-pointer whitespace-nowrap">
                Năm 2024
              </button>
              <button onclick="switchYear('2023')" id="tab-2023" class="tab-btn px-5 py-2.5 rounded-2xl text-sm font-bold border border-slate-200 text-slate-700 hover:bg-slate-50 transition-all cursor-pointer whitespace-nowrap">
                Năm 2023
              </button>
              <button onclick="switchYear('2022')" id="tab-2022" class="tab-btn px-5 py-2.5 rounded-2xl text-sm font-bold border border-slate-200 text-slate-700 hover:bg-slate-50 transition-all cursor-pointer whitespace-nowrap">
                Năm 2022
              </button>
              <button onclick="switchYear('compare')" id="tab-compare" class="tab-btn px-5 py-2.5 rounded-2xl text-sm font-bold border border-secondary-container/40 text-secondary-container hover:bg-orange-50 transition-all cursor-pointer whitespace-nowrap flex items-center gap-1.5">
                <span class="material-symbols-outlined text-[18px]">query_stats</span>
                <span>So sánh 4 năm</span>
              </button>
            </div>

            <!-- Tìm kiếm ngành nhanh -->
            <div class="relative w-full lg:w-80">
              <input id="tableSearch" onkeyup="filterTable()" class="w-full pl-10 pr-4 py-2.5 bg-slate-50 text-on-surface rounded-2xl text-sm border border-slate-200 focus:outline-none focus:ring-2 focus:ring-primary focus:bg-white transition-all" placeholder="Tìm tên ngành (VD: Marketing, Kế toán...)" type="text">
              <span class="material-symbols-outlined absolute left-3 top-3 text-slate-400 text-[18px]">search</span>
            </div>

          </div>
        </div>
      </section>

      <!-- NỘI DUNG CÁC BẢNG ĐIỂM CHUẨN -->
      <section class="max-w-7xl mx-auto px-6 lg:px-12 py-4 mb-16">

        <!-- ===== TAB NĂM 2025 ===== -->
        <div id="content-2025" class="year-content">
          <div class="bg-surface-container-lowest rounded-3xl p-6 sm:p-8 shadow-md border border-outline-variant/40">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-4 border-b border-slate-100">
              <div>
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 text-emerald-800 text-xs font-bold uppercase mb-1">
                  <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                  Điểm chuẩn ĐHCQ 2025
                </div>
                <h3 class="text-xl sm:text-2xl font-bold text-on-surface">Điểm Chuẩn Đại Học Chính Quy Năm 2025</h3>
                <p class="text-xs sm:text-sm text-on-surface-variant mt-1">
                  Bao gồm Điểm chuẩn thi tốt nghiệp THPT và Điểm quy đổi Đánh giá năng lực (ĐGNL ĐHQG-HCM) theo 3 loại hình: <strong>E</strong> (Toàn phần tiếng Anh), <strong>P</strong> (Bán phần tiếng Anh), <strong>S</strong> (Tiêu chuẩn).
                </p>
              </div>
              <div class="flex items-center gap-2 text-xs text-slate-500">
                <span class="material-symbols-outlined text-secondary-container text-[18px]">info</span>
                <span>Thang điểm: THPT (30) / ĐGNL (1200)</span>
              </div>
            </div>

            <!-- Bảng 2025 -->
            <div class="overflow-x-auto rounded-2xl border border-slate-200">
              <table class="w-full text-left border-collapse text-sm target-table">
                <thead>
                  <tr class="bg-primary text-white text-xs uppercase font-bold tracking-wider">
                    <th class="p-3.5 w-12 text-center">STT</th>
                    <th class="p-3.5 min-w-[220px]">Ngành đào tạo</th>
                    <th class="p-3.5 min-w-[130px] text-center">Mã xét tuyển</th>
                    <th class="p-3.5 min-w-[140px] text-center">Loại hình chương trình</th>
                    <th class="p-3.5 min-w-[150px] text-center bg-[#002a54] text-amber-300">Điểm chuẩn (THPT)</th>
                    <th class="p-3.5 min-w-[150px] text-center bg-[#003366] text-sky-200">Điểm QĐ ĐGNL</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-slate-700 font-medium">
                  <!-- 1. Kinh doanh quốc tế -->
                  <tr class="hover:bg-slate-50 transition-colors row-item">
                    <td class="p-3 text-center text-slate-400 font-bold" rowspan="3">01</td>
                    <td class="p-3 font-bold text-slate-900" rowspan="3">Kinh doanh quốc tế</td>
                    <td class="p-3 text-center font-mono text-xs">7340120E</td>
                    <td class="p-3 text-center"><span class="px-2.5 py-1 rounded-full bg-purple-50 text-purple-700 text-xs font-semibold">Toàn phần Tiếng Anh</span></td>
                    <td class="p-3 text-center font-bold text-secondary-container text-base">27,00</td>
                    <td class="p-3 text-center font-bold text-primary-container">820</td>
                  </tr>
                  <tr class="hover:bg-slate-50 transition-colors row-item">
                    <td class="p-3 text-center font-mono text-xs">7340120P</td>
                    <td class="p-3 text-center"><span class="px-2.5 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-semibold">Bán phần Tiếng Anh</span></td>
                    <td class="p-3 text-center font-bold text-secondary-container text-base">26,00</td>
                    <td class="p-3 text-center font-bold text-primary-container">780</td>
                  </tr>
                  <tr class="hover:bg-slate-50 transition-colors row-item border-b-2 border-slate-200">
                    <td class="p-3 text-center font-mono text-xs">7340120S</td>
                    <td class="p-3 text-center"><span class="px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-semibold">Tiêu chuẩn</span></td>
                    <td class="p-3 text-center font-bold text-slate-900 text-base">24,00</td>
                    <td class="p-3 text-center font-bold text-primary-container">968</td>
                  </tr>

                  <!-- 2. Marketing -->
                  <tr class="hover:bg-slate-50 transition-colors row-item">
                    <td class="p-3 text-center text-slate-400 font-bold" rowspan="3">02</td>
                    <td class="p-3 font-bold text-slate-900" rowspan="3">Marketing</td>
                    <td class="p-3 text-center font-mono text-xs">7340115E</td>
                    <td class="p-3 text-center"><span class="px-2.5 py-1 rounded-full bg-purple-50 text-purple-700 text-xs font-semibold">Toàn phần Tiếng Anh</span></td>
                    <td class="p-3 text-center font-bold text-secondary-container text-base">27,00</td>
                    <td class="p-3 text-center font-bold text-primary-container">820</td>
                  </tr>
                  <tr class="hover:bg-slate-50 transition-colors row-item">
                    <td class="p-3 text-center font-mono text-xs">7340115P</td>
                    <td class="p-3 text-center"><span class="px-2.5 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-semibold">Bán phần Tiếng Anh</span></td>
                    <td class="p-3 text-center font-bold text-slate-900 text-base">24,50</td>
                    <td class="p-3 text-center font-bold text-primary-container">719</td>
                  </tr>
                  <tr class="hover:bg-slate-50 transition-colors row-item border-b-2 border-slate-200">
                    <td class="p-3 text-center font-mono text-xs">7340115S</td>
                    <td class="p-3 text-center"><span class="px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-semibold">Tiêu chuẩn</span></td>
                    <td class="p-3 text-center font-bold text-slate-900 text-base">22,50</td>
                    <td class="p-3 text-center font-bold text-primary-container">902</td>
                  </tr>

                  <!-- 3. Kiểm toán -->
                  <tr class="hover:bg-slate-50 transition-colors row-item">
                    <td class="p-3 text-center text-slate-400 font-bold" rowspan="2">03</td>
                    <td class="p-3 font-bold text-slate-900" rowspan="2">Kiểm toán</td>
                    <td class="p-3 text-center font-mono text-xs">7340302P</td>
                    <td class="p-3 text-center"><span class="px-2.5 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-semibold">Bán phần Tiếng Anh</span></td>
                    <td class="p-3 text-center font-bold text-slate-900 text-base">25,00</td>
                    <td class="p-3 text-center font-bold text-primary-container">739</td>
                  </tr>
                  <tr class="hover:bg-slate-50 transition-colors row-item border-b-2 border-slate-200">
                    <td class="p-3 text-center font-mono text-xs">7340302S</td>
                    <td class="p-3 text-center"><span class="px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-semibold">Tiêu chuẩn</span></td>
                    <td class="p-3 text-center font-bold text-slate-900 text-base">20,25</td>
                    <td class="p-3 text-center font-bold text-primary-container">771</td>
                  </tr>

                  <!-- 4. Công nghệ tài chính -->
                  <tr class="hover:bg-slate-50 transition-colors row-item">
                    <td class="p-3 text-center text-slate-400 font-bold" rowspan="2">04</td>
                    <td class="p-3 font-bold text-slate-900" rowspan="2">Công nghệ tài chính</td>
                    <td class="p-3 text-center font-mono text-xs">7340205P</td>
                    <td class="p-3 text-center"><span class="px-2.5 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-semibold">Bán phần Tiếng Anh</span></td>
                    <td class="p-3 text-center font-bold text-slate-900 text-base">24,00</td>
                    <td class="p-3 text-center font-bold text-primary-container">699</td>
                  </tr>
                  <tr class="hover:bg-slate-50 transition-colors row-item border-b-2 border-slate-200">
                    <td class="p-3 text-center font-mono text-xs">7340205S</td>
                    <td class="p-3 text-center"><span class="px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-semibold">Tiêu chuẩn</span></td>
                    <td class="p-3 text-center font-bold text-slate-900 text-base">21,50</td>
                    <td class="p-3 text-center font-bold text-primary-container">846</td>
                  </tr>

                  <!-- 5. Luật -->
                  <tr class="hover:bg-slate-50 transition-colors row-item border-b-2 border-slate-200">
                    <td class="p-3 text-center text-slate-400 font-bold">05</td>
                    <td class="p-3 font-bold text-slate-900">Luật</td>
                    <td class="p-3 text-center font-mono text-xs">7380101S</td>
                    <td class="p-3 text-center"><span class="px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-semibold">Tiêu chuẩn</span></td>
                    <td class="p-3 text-center font-bold text-slate-900 text-base">20,00</td>
                    <td class="p-3 text-center font-bold text-primary-container">751</td>
                  </tr>

                  <!-- 6. Kinh tế -->
                  <tr class="hover:bg-slate-50 transition-colors row-item">
                    <td class="p-3 text-center text-slate-400 font-bold" rowspan="2">06</td>
                    <td class="p-3 font-bold text-slate-900" rowspan="2">Kinh tế</td>
                    <td class="p-3 text-center font-mono text-xs">7310101P</td>
                    <td class="p-3 text-center"><span class="px-2.5 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-semibold">Bán phần Tiếng Anh</span></td>
                    <td class="p-3 text-center font-bold text-slate-900 text-base">23,00</td>
                    <td class="p-3 text-center font-bold text-primary-container">659</td>
                  </tr>
                  <tr class="hover:bg-slate-50 transition-colors row-item border-b-2 border-slate-200">
                    <td class="p-3 text-center font-mono text-xs">7310101S</td>
                    <td class="p-3 text-center"><span class="px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-semibold">Tiêu chuẩn</span></td>
                    <td class="p-3 text-center font-bold text-slate-900 text-base">20,00</td>
                    <td class="p-3 text-center font-bold text-primary-container">751</td>
                  </tr>

                  <!-- 7. Quản trị khách sạn -->
                  <tr class="hover:bg-slate-50 transition-colors row-item">
                    <td class="p-3 text-center text-slate-400 font-bold" rowspan="2">07</td>
                    <td class="p-3 font-bold text-slate-900" rowspan="2">Quản trị khách sạn</td>
                    <td class="p-3 text-center font-mono text-xs">7810201P</td>
                    <td class="p-3 text-center"><span class="px-2.5 py-1 rounded-full bg-blue-50 text-blue-700 text-xs font-semibold">Bán phần Tiếng Anh</span></td>
                    <td class="p-3 text-center font-bold text-slate-900 text-base">23,00</td>
                    <td class="p-3 text-center font-bold text-primary-container">659</td>
                  </tr>
                  <tr class="hover:bg-slate-50 transition-colors row-item border-b-2 border-slate-200">
                    <td class="p-3 text-center font-mono text-xs">7810201S</td>
                    <td class="p-3 text-center"><span class="px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-semibold">Tiêu chuẩn</span></td>
                    <td class="p-3 text-center font-bold text-slate-900 text-base">20,00</td>
                    <td class="p-3 text-center font-bold text-primary-container">751</td>
                  </tr>

                  <!-- 8. Quản lý nhà nước -->
                  <tr class="hover:bg-slate-50 transition-colors row-item border-b-2 border-slate-200">
                    <td class="p-3 text-center text-slate-400 font-bold">08</td>
                    <td class="p-3 font-bold text-slate-900">Quản lý nhà nước</td>
                    <td class="p-3 text-center font-mono text-xs">7310205S</td>
                    <td class="p-3 text-center"><span class="px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 text-xs font-semibold">Tiêu chuẩn</span></td>
                    <td class="p-3 text-center font-bold text-slate-900 text-base">20,00</td>
                    <td class="p-3 text-center font-bold text-primary-container">751</td>
                  </tr>

                  <!-- 9. Thương mại điện tử -->
                  <tr class="hover:bg-slate-50 transition-colors row-item">
                    <td class="p-3 text-center text-slate-400 font-bold" rowspan="2">09</td>
                    <td class="p-3 font-bold text-slate-900" rowspan="2">Thương mại điện tử</td>
                    <td class="p-3 text-center font-mono text-xs">7340122E</td>
                    <td class="p-3 text-center"><span class="px-2.5 py-1 rounded-full bg-purple-50 text-purple-700 text-xs font-semibold">Toàn phần Tiếng Anh</span></td>
