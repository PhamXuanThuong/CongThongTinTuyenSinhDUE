--- FILE: CongthongtintuyensinhDUE/export_csv.py ---
# -*- coding: utf-8 -*-
import csv

qa_data = [
    [
        'ID',
        'ChuDe',
        'PhanLoai',
        'CauHoi_User_Variants',
        'CauTraLoi_ChiTiet',
        'TuKhoa_Search',
        'Nguon_ThamKhao'
    ],
    # 1. TỔNG QUAN VỀ TRƯỜNG
    [
        'DUE_01',
