        'chuong_trinh_ap_dung': 'Chương trình Tiêu chuẩn (DUE-Standard)',
        'nguyen_tac_xet': 'Điểm quy đổi sang thang điểm 30 = Điểm ĐGNL x 30 / 1200 + Điểm ưu tiên quy đổi.',
        'mau_sac': 'amber',
