    response['Content-Disposition'] = 'attachment; filename="danh_sach_ung_tuyen_clb.csv"'
    writer = csv.writer(response)
    writer.writerow(['ID', 'CLB', 'Họ tên', 'MSSV', 'Khóa/Lớp', 'SĐT', 'Email', 'Ban nguyện vọng', 'Lý do', 'Trạng thái', 'Ngày nộp'])
