 "doan_hoi": {
  "doan_thanh_nien": {
   "name": "Đoàn TNCS Hồ Chí Minh Trường Đại học Kinh tế - ĐHĐN",
   "website": "https://due.udn.vn/vi-vn/thanhnien",
   "facebook": "https://www.facebook.com/youthdue",
   "motto": "Thiết thực - Hiệu quả - Hội nhập",
   "functions": [
    "Tổ chức chính trị - xã hội của thanh niên; đội dự bị tin cậy của Đảng bộ Trường ĐH Kinh tế",
    "Đoàn cơ sở được Đoàn cấp trên (Đoàn ĐH Đà Nẵng) giao quyền",
    "Trường học xã hội chủ nghĩa của thanh niên; đại diện, bảo vệ quyền lợi hợp pháp của sinh viên"
   ],
   "tasks": [
    "Giáo dục lý tưởng cách mạng, đạo đức, pháp luật, truyền thống cho đoàn viên",
    "Tổ chức phong trào học tập, rèn luyện, phát triển bản thân",
    "Tham gia xây dựng Đảng: bồi dưỡng, giới thiệu đoàn viên ưu tú vào Đảng",
    "Thực hiện nhiệm vụ do Đảng ủy, Ban Giám hiệu và Đoàn cấp trên giao; chăm lo đời sống tinh thần, quyền lợi của đoàn viên"
   ],
   "term": "Đại hội XII, nhiệm kỳ 2025–2027",
   "executive_committee": {
    "bch_members": 29,
    "standing_committee_members": 9
   },
   "standing_office": [
    {
     "name": "TS. Trần Xuân Quỳnh",
     "role": "Bí thư Đoàn trường",
     "unit": "Khoa Thương mại điện tử"
    },
    {
     "name": "ThS. Văn Công Vũ",
     "role": "Phó Bí thư – Chủ tịch Hội Sinh viên",
     "unit": "Khoa Lý luận chính trị"
    },
    {
     "name": "ThS. Huỳnh Thùy Yên Khuê",
     "role": "Phó Bí thư",
     "unit": "Khoa Tài chính"
    },
    {
     "name": "ThS. Dương Việt Anh",
     "role": "Phó Bí thư",
     "unit": "Khoa Luật"
    },
    {
     "name": "ThS. Huỳnh Ngọc Danh",
     "role": "Chuyên viên hỗ trợ công tác văn phòng",
     "unit": "Phòng Công tác sinh viên"
    }
