                  <th class="p-4 min-w-[180px] text-center font-bold bg-[#002a54] border-l border-white/10">
                    <span class="block text-secondary-container">DUE-Elite</span>
                    <span class="text-xs font-normal text-slate-300">(Cử nhân tài năng - Toàn phần Tiếng Anh)</span>
                  </th>
                  <th class="p-4 min-w-[180px] text-center font-bold bg-[#003366] border-l border-white/10">
                    <span class="block text-sky-300">DUE-Global</span>
                    <span class="text-xs font-normal text-slate-300">(Cử nhân CQ - Toàn phần Tiếng Anh)</span>
                  </th>
                  <th class="p-4 min-w-[180px] text-center font-bold bg-[#003d7a] border-l border-white/10">
                    <span class="block text-emerald-300">DUE-Professional</span>
                    <span class="text-xs font-normal text-slate-300">(Cử nhân CQ - Bán phần Tiếng Anh)</span>
