# =====================================================================
#  CẤU HÌNH AI CHO CỔNG THÔNG TIN TUYỂN SINH DUE
#  Copy file này thành ".env" (cùng thư mục) rồi điền giá trị thật.
#  KHÔNG commit file .env lên git.
# =====================================================================

# --- Gemini API key (bắt buộc) ---
# Lấy tại: https://aistudio.google.com/apikey
# Để trống -> hệ thống dùng Ollama chạy local (xem phần OLLAMA bên dưới)
GEMINI_API_KEY=

# --- Model sinh câu trả lời ---
# Chatbot: nên dùng model rẻ & nhanh
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
# Form tư vấn chọn ngành: cần suy luận tốt hơn
GEMINI_ADVISOR_MODEL=gemini-3-flash-preview
# Model dự phòng khi model chính quá tải/treo/hết hạn mức (thử lần lượt, cách nhau bởi dấu phẩy)
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3-flash-preview
# Thời gian chờ tối đa mỗi lần gọi Gemini (giây)
GEMINI_TIMEOUT=30

# --- Model embedding (chuyển văn bản thành vector để tìm tài liệu) ---
# LƯU Ý: đổi model embedding thì phải chạy lại:  python manage.py tao_lai_embedding
GEMINI_EMBED_MODEL=gemini-embedding-2
GEMINI_EMBED_DIM=768

# --- Ollama (chỉ dùng khi KHÔNG có GEMINI_API_KEY) ---
# OLLAMA_BASE_URL=http://localhost:11434
